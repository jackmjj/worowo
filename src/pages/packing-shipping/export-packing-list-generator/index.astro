---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Faq from "../../../components/tools/Faq.astro";
import RelatedTools from "../../../components/tools/RelatedTools.astro";
import ToolGuide from "../../../components/tools/ToolGuide.astro";

const pageTitle = "Export Packing List Generator";
const pageDescription =
  "Create a professional export packing list online with exporter, consignee, shipment details, item lines, weights, and CBM. Print or save the final packing list as PDF.";
const canonical = "https://www.worowo.com/packing-shipping/export-packing-list-generator/";

const faqItems = [
  {
    question: "What is an export packing list?",
    answer:
      "An export packing list is a shipping document used in international trade. It typically includes exporter and consignee details, shipment routing, item lines, cartons, weights, and total measurement.",
  },
  {
    question: "Can this export packing list be printed or saved as PDF?",
    answer:
      "Yes. You can fill in the document directly on the page, choose A4 or US Letter, then print it or save it as PDF for logistics, customs support, or customer documentation.",
  },
  {
    question: "Does the generator calculate totals automatically?",
    answer:
      "Yes. Total quantity, cartons, net weight, gross weight, and CBM are calculated from the item rows automatically as you edit the packing list.",
  },
];

const relatedTools = [
  {
    name: "Packing List Generator",
    href: "/packing-shipping/packing-list-generator/",
    desc: "Create a simpler packing list for general shipping, order packing, and day-to-day warehouse use.",
  },
  {
    name: "Delivery Receipt Generator",
    href: "/packing-shipping/delivery-receipt-generator/",
    desc: "Generate a delivery receipt for handover confirmation, signatures, and receiving records.",
  },
];
---

<BaseLayout title={`${pageTitle} | Worowo`} description={pageDescription} canonical={canonical}>
  <main class="xplg-page">
    <div class="xplg-container">
      <nav class="xplg-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>></span>
        <a href="/packing-shipping/">Packing & Shipping</a>
        <span>></span>
        <span aria-current="page">Export Packing List Generator</span>
      </nav>

      <section class="xplg-hero">
        <span class="xplg-eyebrow">Packing & Shipping</span>
        <h1 class="xplg-title">{pageTitle}</h1>
        <p class="xplg-description">{pageDescription}</p>
      </section>

      <div class="xplg-toolbar">
        <div class="xplg-toolbar-left">
          <a href="/packing-shipping/" class="xplg-action-btn xplg-action-btn-secondary">Back to Packing & Shipping</a>
        </div>

        <div class="xplg-toolbar-center"></div>

        <div class="xplg-toolbar-right">
          <div class="xplg-paper-size-group">
            <span class="xplg-paper-size-label">Paper Size</span>

            <div class="xplg-paper-size-toggle" aria-label="Paper size">
              <button type="button" class="xplg-paper-btn" data-paper-size="letter">
                US Letter
              </button>
              <button type="button" class="xplg-paper-btn is-active" data-paper-size="a4">
                A4
              </button>
            </div>
          </div>

          <button type="button" class="xplg-action-btn xplg-action-btn-reset" data-reset-form-trigger>Reset Form</button>
          <button type="button" class="xplg-action-btn xplg-action-btn-primary" data-print-document>
            Print / Save as PDF
          </button>
        </div>
      </div>

      <section class="xplg-document-stage">
        <div class="xplg-document-stage-inner">
          <div id="export-packing-list-document" class="xplg-document xplg-paper-letter">
            <div class="xplg-document-inner">
              <div class="xplg-document-title-row">
                <input
                  id="documentLogoText"
                  class="xplg-document-logo-text"
                  type="text"
                  placeholder="Your Business Name"
                  aria-label="Business name or logo text"
                />

                <div class="xplg-doc-title">PACKING LIST</div>
              </div>

              <div class="xplg-doc-header">
                <div></div>
                <div class="xplg-doc-meta">
                  <div class="xplg-meta-barcode-slot">
                    <div class="xplg-barcode-block" id="xplgBarcodeBlock" hidden>
                      <svg id="xplgPackingListBarcode" aria-label="Export packing list barcode"></svg>
                      <span class="xplg-barcode-empty">Enter Packing List No.</span>
                    </div>
                  </div>
                  <div class="xplg-field-row xplg-meta-row">
                    <button type="button" class="xplg-barcode-action-btn xplg-no-print" id="toggleBarcodeBtn">
                      <span class="xplg-barcode-action-icon" aria-hidden="true">▥</span>
                      <span class="xplg-barcode-action-label">Show Barcode</span>
                    </button>
                    <span class="xplg-field-label">Packing List No.:</span>
                    <input id="packingListNo" class="xplg-doc-input xplg-inline-input xplg-meta-input" type="text" />
                  </div>
                  <div class="xplg-field-row xplg-meta-row">
                    <span class="xplg-meta-action-spacer xplg-no-print" aria-hidden="true"></span>
                    <span class="xplg-field-label">Invoice No.:</span>
                    <input id="invoiceNo" class="xplg-doc-input xplg-inline-input xplg-meta-input" type="text" />
                  </div>
                  <div class="xplg-field-row xplg-meta-row">
                    <span class="xplg-meta-action-spacer xplg-no-print" aria-hidden="true"></span>
                    <span class="xplg-field-label">Date:</span>
                    <input id="docDate" class="xplg-doc-input xplg-inline-input xplg-meta-input" type="date" />
                  </div>
                </div>
              </div>

              <section class="xplg-doc-section">
                <div class="xplg-two-col">
                  <div class="xplg-box">
                    <h2 class="xplg-section-title">Exporter / Seller</h2>
                    <div class="xplg-field-row xplg-field-row-block">
                      <span class="xplg-field-label">Name:</span>
                      <input id="exporterName" class="xplg-doc-input" type="text" />
                    </div>
                    <div class="xplg-field-row xplg-field-row-block">
                      <span class="xplg-field-label">Address:</span>
                      <textarea id="exporterAddress" class="xplg-doc-textarea xplg-compact-area" rows="2"></textarea>
                    </div>
                    <div class="xplg-field-row xplg-field-row-block">
                      <span class="xplg-field-label">Contact:</span>
                      <input id="exporterContact" class="xplg-doc-input" type="text" />
                    </div>
                  </div>

                  <div class="xplg-box">
                    <h2 class="xplg-section-title">Consignee</h2>
                    <div class="xplg-field-row xplg-field-row-block">
                      <span class="xplg-field-label">Name:</span>
                      <input id="consigneeName" class="xplg-doc-input" type="text" />
                    </div>
                    <div class="xplg-field-row xplg-field-row-block">
                      <span class="xplg-field-label">Address:</span>
                      <textarea id="consigneeAddress" class="xplg-doc-textarea xplg-compact-area" rows="2"></textarea>
                    </div>
                    <div class="xplg-field-row xplg-field-row-block">
                      <span class="xplg-field-label">Contact:</span>
                      <input id="consigneeContact" class="xplg-doc-input" type="text" />
                    </div>
                  </div>
                </div>
              </section>

              <section class="xplg-doc-section">
                <h2 class="xplg-section-title">Shipment Details</h2>
                <div class="xplg-box">
                  <div class="xplg-three-col">
                    <div>
                      <div class="xplg-field-row xplg-field-row-block">
                        <span class="xplg-field-label">From:</span>
                        <input id="shipmentFrom" class="xplg-doc-input" type="text" />
                      </div>
                      <div class="xplg-field-row xplg-field-row-block">
                        <span class="xplg-field-label">Port of Loading:</span>
                        <input id="portOfLoading" class="xplg-doc-input" type="text" />
                      </div>
                      <div class="xplg-field-row xplg-field-row-block">
                        <span class="xplg-field-label">ETD:</span>
                        <input id="etd" class="xplg-doc-input" type="date" />
                      </div>
                    </div>

                    <div>
                      <div class="xplg-field-row xplg-field-row-block">
                        <span class="xplg-field-label">To:</span>
                        <input id="shipmentTo" class="xplg-doc-input" type="text" />
                      </div>
                      <div class="xplg-field-row xplg-field-row-block">
                        <span class="xplg-field-label">Port of Discharge:</span>
                        <input id="portOfDischarge" class="xplg-doc-input" type="text" />
                      </div>
                      <div class="xplg-field-row xplg-field-row-block">
                        <span class="xplg-field-label">ETA:</span>
                        <input id="eta" class="xplg-doc-input" type="date" />
                      </div>
                    </div>

                    <div>
                      <div class="xplg-field-row xplg-field-row-block">
                        <span class="xplg-field-label">Shipment Method:</span>
                        <select id="shipmentMethod" class="xplg-doc-input xplg-doc-select">
                          <option value=""></option>
                          <option value="Sea">Sea</option>
                          <option value="Air">Air</option>
                          <option value="Courier">Courier</option>
                          <option value="Truck">Truck</option>
                          <option value="Rail">Rail</option>
                          <option value="Other">Other</option>
                        </select>
                      </div>
                      <div class="xplg-field-row xplg-field-row-block">
                        <span class="xplg-field-label">Shipping Marks:</span>
                        <textarea id="shippingMarks" class="xplg-doc-textarea xplg-compact-area" rows="2"></textarea>
                      </div>
                      <div class="xplg-field-row xplg-field-row-block">
                        <span class="xplg-field-label">Remarks:</span>
                        <textarea id="remarks" class="xplg-doc-textarea xplg-compact-area" rows="2"></textarea>
                      </div>
                    </div>
                  </div>
                </div>
              </section>

              <section class="xplg-doc-section">
                <div class="xplg-section-title-row">
                  <h2 class="xplg-section-title">Items</h2>
                  <button type="button" class="xplg-toolbar-btn xplg-add-item-inline-btn xplg-edit-only" id="addItemBtn">
                    <span class="xplg-add-item-icon" aria-hidden="true">+</span>
                    <span>Add Item</span>
                  </button>
                </div>

                <table class="xplg-doc-table xplg-packing-table">
                  <thead>
                    <tr>
                      <th style="width: 6%;">No.</th>
                      <th style="width: 31%;">Description</th>
                      <th style="width: 8%;">Qty</th>
                      <th style="width: 8%;">Unit</th>
                      <th style="width: 11%;">Cartons</th>
                      <th style="width: 12%;">Net Wt</th>
                      <th style="width: 12%;">Gross Wt</th>
                      <th style="width: 8%;">CBM</th>
                      <th class="xplg-edit-only" style="width: 4%;"></th>
                    </tr>
                  </thead>
                  <tbody id="itemsTableBody">
                    {Array.from({ length: 5 }, (_, i) => (
                      <tr class="xplg-item-row">
                        <td class="xplg-row-number">{i + 1}</td>
                        <td><input class="xplg-doc-input xplg-table-input" type="text" /></td>
                        <td><input class="xplg-doc-input xplg-table-input" type="text" /></td>
                        <td><input class="xplg-doc-input xplg-table-input" type="text" /></td>
                        <td><input class="xplg-doc-input xplg-table-input" type="text" /></td>
                        <td><input class="xplg-doc-input xplg-table-input" type="text" /></td>
                        <td><input class="xplg-doc-input xplg-table-input" type="text" /></td>
                        <td><input class="xplg-doc-input xplg-table-input" type="text" /></td>
                        <td class="xplg-edit-only xplg-action-cell">
                          <button type="button" class="xplg-remove-row-btn">×</button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>

                <div class="xplg-totals-box">
                  <div class="xplg-totals-row">
                    <span>Total Qty</span>
                    <strong id="totalQty">0</strong>
                  </div>
                  <div class="xplg-totals-row">
                    <span>Total Cartons</span>
                    <strong id="totalCartons">0</strong>
                  </div>
                  <div class="xplg-totals-row">
                    <span>Total Net Wt</span>
                    <strong><span id="totalNetWeight">0.00</span> kg</strong>
                  </div>
                  <div class="xplg-totals-row">
                    <span>Total Gross Wt</span>
                    <strong><span id="totalGrossWeight">0.00</span> kg</strong>
                  </div>
                  <div class="xplg-totals-row">
                    <span>Total CBM</span>
                    <strong id="totalCbm">0.000</strong>
                  </div>
                </div>
              </section>

              <section class="xplg-doc-section">
                <div class="xplg-two-col">
                  <div class="xplg-box">
                    <h2 class="xplg-section-title">Remarks</h2>
                    <textarea id="finalRemarks" class="xplg-doc-textarea xplg-compact-remarks" rows="2"></textarea>
                  </div>

                  <div class="xplg-box">
                    <h2 class="xplg-section-title">Prepared By</h2>
                    <div class="xplg-field-row xplg-field-row-block">
                      <span class="xplg-field-label">Name:</span>
                      <input id="preparedBy" class="xplg-doc-input" type="text" />
                    </div>
                    <div class="xplg-field-row xplg-field-row-block">
                      <span class="xplg-field-label">Authorized Signature:</span>
                      <input id="authorizedSignature" class="xplg-doc-input" type="text" />
                    </div>
                  </div>
                </div>
              </section>
            </div>
          </div>
        </div>
      </section>

      <section class="xplg-related-block">
        <div class="xplg-bottom-actions xplg-no-print">
          <div class="xplg-tool-actions-footer">
            <div class="xplg-tool-actions-footer__buttons">
              <button type="button" class="xplg-document-bottom-reset-btn" data-reset-form-trigger>Reset Form</button>
              <button type="button" class="xplg-document-bottom-print-btn" data-print-document>Print / Save as PDF</button>
            </div>
          </div>
        </div>

        <RelatedTools tools={relatedTools} />
      </section>

      <section class="xplg-seo-block">
        <ToolGuide title="How It Works & Use Cases">
          <article class="content-card">
            <h2>How This Export Packing List Generator Works</h2>
            <p>
              Enter exporter, consignee, shipment, and item details directly on the document. The page keeps the final
              export packing list in a print-ready layout while totals update automatically from the item rows.
            </p>
          </article>

          <article class="content-card">
            <h2>When to Use It</h2>
            <p>
              Use this export packing list generator for international shipments, factory dispatch paperwork, B2B order
              support, freight coordination, and customer document preparation.
            </p>
          </article>

          <article class="content-card">
            <h2>Why It Helps</h2>
            <p>
              A structured export packing list improves shipment clarity, reduces manual calculation errors, and makes
              it easier to produce a professional document for logistics teams and overseas buyers.
            </p>
          </article>
        </ToolGuide>
      </section>

      <section class="xplg-faq-block">
        <Faq items={faqItems} />
      </section>
    </div>
  </main>

  <script>
    import JsBarcode from "jsbarcode";

    document.addEventListener("DOMContentLoaded", () => {
      const documentRoot = document.getElementById("export-packing-list-document");
      const itemsTableBody = document.getElementById("itemsTableBody");
      const addItemBtn = document.getElementById("addItemBtn");
      const resetTriggers = Array.from(document.querySelectorAll("[data-reset-form-trigger]"));
      const printTriggers = Array.from(document.querySelectorAll("[data-print-document]"));
      const paperButtons = Array.from(document.querySelectorAll("[data-paper-size]"));
      const barcodeBlock = document.getElementById("xplgBarcodeBlock");
      const barcodeSvg = document.getElementById("xplgPackingListBarcode");
      const toggleBarcodeBtn = document.getElementById("toggleBarcodeBtn");
      const packingListInput = document.getElementById("packingListNo");
      let barcodeVisible = false;

      const totalQty = document.getElementById("totalQty");
      const totalCartons = document.getElementById("totalCartons");
      const totalNetWeight = document.getElementById("totalNetWeight");
      const totalGrossWeight = document.getElementById("totalGrossWeight");
      const totalCbm = document.getElementById("totalCbm");

      function toNumber(value) {
        const parsed = Number.parseFloat(value);
        return Number.isFinite(parsed) ? parsed : 0;
      }

      function renumberRows() {
        const rows = Array.from(itemsTableBody.querySelectorAll(".xplg-item-row"));
        rows.forEach((row, index) => {
          const num = row.querySelector(".xplg-row-number");
          if (num) num.textContent = String(index + 1);
        });
      }

      function updateTotals() {
        let qty = 0;
        let cartons = 0;
        let net = 0;
        let gross = 0;
        let cbm = 0;

        itemsTableBody.querySelectorAll(".xplg-item-row").forEach((row) => {
          const inputs = row.querySelectorAll(".xplg-table-input");
          qty += toNumber(inputs[1]?.value);
          cartons += toNumber(inputs[3]?.value);
          net += toNumber(inputs[4]?.value);
          gross += toNumber(inputs[5]?.value);
          cbm += toNumber(inputs[6]?.value);
        });

        totalQty.textContent = String(qty);
        totalCartons.textContent = String(cartons);
        totalNetWeight.textContent = net.toFixed(2);
        totalGrossWeight.textContent = gross.toFixed(2);
        totalCbm.textContent = cbm.toFixed(3);
      }

      function attachRowHandlers(scope = document) {
        scope.querySelectorAll(".xplg-remove-row-btn").forEach((btn) => {
          if (btn.dataset.bound === "1") return;
          btn.dataset.bound = "1";

          btn.addEventListener("click", () => {
            const rows = itemsTableBody.querySelectorAll(".xplg-item-row");
            if (rows.length <= 1) return;
            btn.closest(".xplg-item-row")?.remove();
            renumberRows();
            updateTotals();
          });
        });

        scope.querySelectorAll(".xplg-table-input").forEach((input) => {
          if (input.dataset.bound === "1") return;
          input.dataset.bound = "1";
          input.addEventListener("input", updateTotals);
        });
      }

      function createItemRow(index) {
        const tr = document.createElement("tr");
        tr.className = "xplg-item-row";
        tr.innerHTML = `
          <td class="xplg-row-number">${index}</td>
          <td><input class="xplg-doc-input xplg-table-input" type="text" /></td>
          <td><input class="xplg-doc-input xplg-table-input" type="text" /></td>
          <td><input class="xplg-doc-input xplg-table-input" type="text" /></td>
          <td><input class="xplg-doc-input xplg-table-input" type="text" /></td>
          <td><input class="xplg-doc-input xplg-table-input" type="text" /></td>
          <td><input class="xplg-doc-input xplg-table-input" type="text" /></td>
          <td><input class="xplg-doc-input xplg-table-input" type="text" /></td>
          <td class="xplg-edit-only xplg-action-cell">
            <button type="button" class="xplg-remove-row-btn">×</button>
          </td>
        `;
        return tr;
      }

      function resetForm() {
        documentRoot.querySelectorAll("input").forEach((input) => {
          input.value = "";
        });

        documentRoot.querySelectorAll("textarea").forEach((textarea) => {
          textarea.value = "";
        });

        documentRoot.querySelectorAll("select").forEach((select) => {
          select.value = "";
        });

        itemsTableBody.innerHTML = "";
        for (let i = 1; i <= 5; i += 1) {
          itemsTableBody.appendChild(createItemRow(i));
        }

        attachRowHandlers(itemsTableBody);
        renumberRows();
        updateTotals();
        applyPaper("a4");
        barcodeVisible = false;
        renderBarcode();
        updateBarcodeButton();
      }

      function applyPaper(paper) {
        documentRoot.classList.remove("xplg-paper-letter", "xplg-paper-a4");
        documentRoot.classList.add(paper === "a4" ? "xplg-paper-a4" : "xplg-paper-letter");

        paperButtons.forEach((btn) => {
          btn.classList.toggle("is-active", btn.dataset.paperSize === paper);
        });

        const styleId = "export-packing-print-page-rule";
        let styleTag = document.getElementById(styleId);

        if (!styleTag) {
          styleTag = document.createElement("style");
          styleTag.id = styleId;
          document.head.appendChild(styleTag);
        }

        if (paper === "a4") {
          styleTag.textContent =
            "@page { size: A4 portrait; margin: 18mm 16mm 18mm 16mm; }";
        } else {
          styleTag.textContent =
            "@page { size: Letter portrait; margin: 0.7in 0.65in 0.7in 0.65in; }";
        }
      }

      addItemBtn?.addEventListener("click", () => {
        const nextIndex = itemsTableBody.querySelectorAll(".xplg-item-row").length + 1;
        itemsTableBody.appendChild(createItemRow(nextIndex));
        attachRowHandlers(itemsTableBody);
        renumberRows();
        updateTotals();
      });

      paperButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          applyPaper(btn.dataset.paperSize || "a4");
        });
      });

      function renderBarcode() {
        if (!(barcodeBlock instanceof HTMLElement) || !(barcodeSvg instanceof SVGElement) || !(packingListInput instanceof HTMLInputElement)) return;
        const value = packingListInput.value.trim();
        const canRender = barcodeVisible && value !== "";
        barcodeBlock.hidden = !barcodeVisible;
        barcodeBlock.dataset.barcodeReady = canRender ? "true" : "false";
        if (!barcodeVisible || !value) {
          barcodeSvg.innerHTML = "";
          return;
        }
        try {
          JsBarcode(barcodeSvg, value, {
            format: "CODE128",
            lineColor: "#111827",
            width: 1.1,
            height: 42,
            displayValue: false,
            margin: 0,
          });
        } catch (error) {
          console.error("Failed to render export packing list barcode", error);
          barcodeSvg.innerHTML = "";
          barcodeBlock.dataset.barcodeReady = "false";
        }
      }

      function updateBarcodeButton() {
        if (!(toggleBarcodeBtn instanceof HTMLButtonElement)) return;
        toggleBarcodeBtn.classList.toggle("is-active", barcodeVisible);
        const label = toggleBarcodeBtn.querySelector(".xplg-barcode-action-label");
        if (label) label.textContent = barcodeVisible ? "Hide Barcode" : "Show Barcode";
      }

      toggleBarcodeBtn?.addEventListener("click", () => {
        barcodeVisible = !barcodeVisible;
        renderBarcode();
        updateBarcodeButton();
      });

      packingListInput?.addEventListener("input", renderBarcode);

      resetTriggers.forEach((trigger) => {
        trigger.addEventListener("click", resetForm);
      });

      printTriggers.forEach((trigger) => {
        trigger.addEventListener("click", () => {
          window.print();
        });
      });

      attachRowHandlers(document);
      updateTotals();
      applyPaper("a4");
      renderBarcode();
      updateBarcodeButton();
    });
  </script>

  <style is:global>
    .xplg-page {
      background: #f8fafc;
    }

    .xplg-container {
      width: min(1280px, calc(100% - 32px));
      margin: 0 auto;
      padding: 40px 0 72px;
    }

    .xplg-breadcrumb {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
      color: #64748b;
      font-size: 14px;
      line-height: 1.4;
      font-weight: 600;
    }

    .xplg-breadcrumb a {
      color: #64748b;
      text-decoration: none;
    }

    .xplg-breadcrumb a:hover {
      color: #2563eb;
    }

    .xplg-hero {
      margin-bottom: 24px;
    }

    .xplg-eyebrow {
      display: inline-block;
      margin-bottom: 10px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.1em;
