---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Faq from "../../components/tools/Faq.astro";
import RelatedTools from "../../components/tools/RelatedTools.astro";
import ToolGuide from "../../components/tools/ToolGuide.astro";

const pageTitle = "Packing List Generator";
const pageDescription =
  "Create a simple packing list online, fill in shipment details, and print or save a completed packing list as PDF. Ideal for small businesses, e-commerce orders, and everyday shipping use.";
const canonical = "https://www.worowo.com/packing-shipping/packing-list-generator/";

const faqItems = [
  {
    question: "What is a packing list used for?",
    answer:
      "A packing list shows what is included in a shipment, such as item descriptions, quantities, carton counts, and shipment references. It is commonly used for order checking, warehouse handoff, and delivery preparation.",
  },
  {
    question: "Can I print the packing list or save it as PDF?",
    answer:
      "Yes. You can fill in the packing list directly in the document view, then print it or save it as PDF for shipping, internal records, or customer communication.",
  },
  {
    question: "Who should use this packing list generator?",
    answer:
      "This tool is useful for small businesses, online sellers, warehouse teams, wholesalers, and anyone who needs a clean packing list for everyday shipping workflows.",
  },
];

const relatedTools = [
  {
    name: "Export Packing List Generator",
    href: "/packing-shipping/export-packing-list-generator/",
    desc:
      "Create an export-style packing list with exporter, consignee, shipment details, weights, and CBM.",
  },
  {
    name: "Delivery Receipt Generator",
    href: "/packing-shipping/delivery-receipt-generator/",
    desc: "Generate a delivery receipt for proof of handover and signature collection.",
  },
];
---

<BaseLayout
  title={`${pageTitle} | Worowo`}
  description={pageDescription}
  canonical={canonical}
>
  <main class="packing-generator-page">
    <div class="packing-generator-inner">
      <nav class="generator-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>></span>
        <a href="/packing-shipping/">Packing & Shipping</a>
        <span>></span>
        <span aria-current="page">Packing List Generator</span>
      </nav>

      <section class="generator-hero">
        <span class="generator-eyebrow">Packing & Shipping</span>
        <h1 class="generator-title">{pageTitle}</h1>
        <p class="generator-description">{pageDescription}</p>
      </section>

      <div class="document-action-bar no-print">
        <div class="document-action-bar__left">
          <a href="/packing-shipping/" class="action-btn action-btn-secondary">Back to Packing & Shipping</a>
        </div>

        <div class="document-action-bar__middle"></div>

        <div class="document-action-bar__right">
          <div class="paper-size-group">
            <span class="paper-size-label">Paper Size</span>

            <div class="paper-size-toggle" aria-label="Paper size">
              <button type="button" class="paper-btn is-active" data-paper-size="letter">
                US Letter
              </button>
              <button type="button" class="paper-btn" data-paper-size="a4">
                A4
              </button>
            </div>
          </div>

          <button type="button" class="action-btn action-btn-reset" data-reset-form-trigger>Reset Form</button>
          <button type="button" class="action-btn action-btn-primary" data-print-document>
            Print / Save as PDF
          </button>
        </div>
      </div>

      <section class="document-stage">
        <div class="document-stage-inner">
          <div id="packing-list-document" class="packing-document paper-letter">
            <div class="packing-document-inner">
              <div class="document-title-row">
                <input
                  id="documentLogoText"
                  class="document-logo-text"
                  type="text"
                  placeholder="Your Business Name"
                  aria-label="Business name or logo text"
                />

                <div class="document-title">PACKING LIST</div>
              </div>

              <div class="doc-header">
                <div></div>
                <div class="doc-meta">
                  <div class="packing-meta-barcode-slot">
                    <div class="packing-barcode-block" id="packingBarcodeBlock" hidden>
                      <svg id="packingListBarcode" aria-label="Packing list barcode"></svg>
                      <span class="packing-barcode-empty">Enter Packing List No.</span>
                    </div>
                  </div>
                  <div class="field-row packing-meta-row">
                    <button type="button" class="barcode-action-btn no-print" id="toggleBarcodeBtn">
                      <span class="barcode-action-icon" aria-hidden="true">▥</span>
                      <span class="barcode-action-label">Show Barcode</span>
                    </button>
                    <span class="field-label">Packing List No.:</span>
                    <input id="packingListNumber" class="doc-input inline-input packing-meta-input" type="text" />
                  </div>
                  <div class="field-row packing-meta-row">
                    <span class="packing-meta-action-spacer no-print" aria-hidden="true"></span>
                    <span class="field-label">Date:</span>
                    <input class="doc-input inline-input packing-meta-input" type="date" />
                  </div>
                </div>
              </div>

              <section class="doc-section">
                <div class="two-col">
                  <div class="box">
                    <h2 class="section-title">Shipper</h2>
                    <div class="field-row field-row-block">
                      <span class="field-label">Company Name:</span>
                      <input class="doc-input" type="text" />
                    </div>
                    <div class="field-row field-row-block">
                      <span class="field-label">Address:</span>
                      <textarea class="doc-textarea compact-area" rows="2"></textarea>
                    </div>
                    <div class="field-row field-row-block">
                      <span class="field-label">Contact:</span>
                      <input class="doc-input" type="text" />
                    </div>
                  </div>

                  <div class="box">
                    <h2 class="section-title">Consignee</h2>
                    <div class="field-row field-row-block">
                      <span class="field-label">Customer Name:</span>
                      <input class="doc-input" type="text" />
                    </div>
                    <div class="field-row field-row-block">
                      <span class="field-label">Delivery Address:</span>
                      <textarea class="doc-textarea compact-area" rows="2"></textarea>
                    </div>
                    <div class="field-row field-row-block">
                      <span class="field-label">Contact:</span>
                      <input class="doc-input" type="text" />
                    </div>
                  </div>
                </div>
              </section>

              <section class="doc-section">
                <h2 class="section-title">Shipment Details</h2>
                <div class="box">
                  <div class="two-col">
                    <div>
                      <div class="field-row field-row-block">
                        <span class="field-label">Reference No.:</span>
                        <input class="doc-input" type="text" />
                      </div>
                      <div class="field-row field-row-block">
                        <span class="field-label">Shipment Date:</span>
                        <input class="doc-input" type="date" />
                      </div>
                    </div>

                    <div>
                      <div class="field-row field-row-block">
                        <span class="field-label">Total Cartons:</span>
                        <input class="doc-input" type="text" />
                      </div>
                      <div class="field-row field-row-block">
                        <span class="field-label">Total Weight:</span>
                        <input class="doc-input" type="text" />
                      </div>
                    </div>
                  </div>
                </div>
              </section>

              <section class="doc-section">
                <div class="section-title-row">
                  <h2 class="section-title">Items</h2>
                  <button type="button" class="add-item-inline-btn edit-only" id="addItemBtn">
                    <span class="add-item-icon" aria-hidden="true">+</span>
                    <span>Add Item</span>
                  </button>
                </div>

                <table class="doc-table packing-table">
                  <thead>
                    <tr>
                      <th style="width: 8%;">No.</th>
                      <th style="width: 36%;">Description</th>
                      <th style="width: 12%;">Qty</th>
                      <th style="width: 12%;">Unit</th>
                      <th style="width: 14%;">Carton No.</th>
                      <th style="width: 18%;">Remarks</th>
                      <th class="edit-only" style="width: 6%;"></th>
                    </tr>
                  </thead>
                  <tbody id="itemsTableBody">
                    {Array.from({ length: 5 }, (_, i) => (
                      <tr class="item-row">
                        <td class="row-number">{i + 1}</td>
                        <td><input class="doc-input table-input" type="text" /></td>
                        <td><input class="doc-input table-input" type="text" /></td>
                        <td><input class="doc-input table-input" type="text" /></td>
                        <td><input class="doc-input table-input" type="text" /></td>
                        <td><input class="doc-input table-input" type="text" /></td>
                        <td class="edit-only action-cell">
                          <button type="button" class="remove-row-btn">×</button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </section>

              <section class="doc-section">
                <div class="two-col">
                  <div class="box">
                    <h2 class="section-title">Remarks</h2>
                    <textarea class="doc-textarea compact-remarks" rows="2"></textarea>
                  </div>

                  <div class="box">
                    <h2 class="section-title">Prepared By</h2>
                    <div class="field-row field-row-block">
                      <span class="field-label">Name:</span>
                      <input class="doc-input" type="text" />
                    </div>
                    <div class="field-row field-row-block">
                      <span class="field-label">Signature:</span>
                      <input class="doc-input" type="text" />
                    </div>
                    <div class="field-row field-row-block">
                      <span class="field-label">Date:</span>
                      <input class="doc-input" type="date" />
                    </div>
                  </div>
                </div>
              </section>
            </div>
          </div>
        </div>
      </section>

      <section class="generator-related-block">
        <div class="document-bottom-actions no-print">
          <button type="button" class="action-btn action-btn-reset" data-reset-form-trigger>Reset Form</button>
          <button type="button" class="action-btn action-btn-primary" data-print-document>
            Print / Save as PDF
          </button>
        </div>

        <RelatedTools tools={relatedTools} />
      </section>

      <section class="generator-seo-block">
        <ToolGuide title="How It Works & Use Cases">
          <article class="content-card">
            <h2>How This Packing List Generator Works</h2>
            <p>
              Fill in shipment details directly on the document, add item rows as needed, and adjust the paper size
              between US Letter and A4. The layout stays print-friendly so you can generate a finished packing list in
              just a few steps.
            </p>
          </article>

          <article class="content-card">
            <h2>When to Use It</h2>
            <p>
              Use this packing list generator for e-commerce orders, wholesale shipments, warehouse picking, carton
              summaries, and internal shipping records when you need a clean one-page document.
            </p>
          </article>

          <article class="content-card">
            <h2>Why It Helps</h2>
            <p>
              A consistent packing list reduces manual formatting work, keeps shipment contents easier to review, and
              makes it simpler to print or save a professional document for operations and customer reference.
            </p>
          </article>
        </ToolGuide>
      </section>

      <section class="generator-faq-block">
        <Faq items={faqItems} />
      </section>
    </div>
  </main>

  <style is:global>
    .packing-generator-page {
      background: #f8fafc;
    }

    .packing-generator-inner {
      width: min(1280px, calc(100% - 32px));
      margin: 0 auto;
      padding: 40px 0 72px;
    }

    .generator-hero {
      margin-bottom: 24px;
    }

    .generator-breadcrumb {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
      color: #64748b;
      font-size: 14px;
      line-height: 1.4;
      font-weight: 600;
    }

    .generator-breadcrumb a {
      color: #64748b;
      text-decoration: none;
    }

    .generator-breadcrumb a:hover {
      color: #2563eb;
    }

    .generator-eyebrow {
      display: inline-block;
      margin-bottom: 10px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #16a34a;
    }

    .generator-title {
      margin: 0 0 14px;
      font-size: clamp(34px, 4vw, 52px);
      line-height: 1.08;
      letter-spacing: -0.03em;
      color: #0f172a;
    }

    .generator-description {
      max-width: 840px;
      margin: 0;
      font-size: 18px;
      line-height: 1.75;
      color: #475569;
    }

    .generator-hero-links {
      margin-top: 14px;
    }

    .generator-inline-link {
      display: inline-flex;
      align-items: center;
      color: #2563eb;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
    }

    .document-action-bar,
    .document-bottom-actions {
      position: static;
      margin-bottom: 22px;
      padding: 14px 16px;
      border: 1px solid #dbe4ef;
      border-radius: 16px;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      box-shadow: 0 14px 34px rgba(15, 23, 42, 0.06);
    }

    .document-action-bar__left {
      flex: 0 0 auto;
    }

    .document-action-bar__middle {
      flex: 1 1 auto;
    }

    .document-action-bar__right {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 12px;
      flex-wrap: wrap;
    }

    .document-bottom-actions {
      margin: 18px 0 0;
      justify-content: flex-end;
    }

    .paper-size-group {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .paper-size-label {
      font-size: 13px;
      font-weight: 750;
      color: #6b7280;
      white-space: nowrap;
    }

    .paper-size-toggle {
      display: inline-flex;
      align-items: center;
      padding: 4px;
      border: 1px solid #d9e2ee;
      border-radius: 999px;
      background: #eef3f8;
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.8);
    }

    .paper-btn {
      min-width: 84px;
      height: 36px;
      padding: 0 12px;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: #6b7280;
      font-size: 13px;
      font-weight: 750;
      cursor: pointer;
      transition:
        background-color 0.15s ease,
        color 0.15s ease,
        box-shadow 0.15s ease;
    }

    .paper-btn.is-active {
      background: #2563eb;
      color: #ffffff;
      box-shadow: 0 6px 16px rgba(37, 99, 235, 0.22);
    }

    .paper-btn:not(.is-active):hover {
      color: #1e293b;
      background: rgba(255, 255, 255, 0.72);
    }

    .action-btn {
      min-height: 38px;
      padding: 0 14px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 800;
      line-height: 1;
      text-decoration: none;
      cursor: pointer;
      white-space: nowrap;
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease,
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }

    .action-btn-secondary {
      border: 1px solid #dbe3ef;
      background: #ffffff;
      color: #374151;
    }

    .action-btn-secondary:hover {
      border-color: #93c5fd;
      background: #eff6ff;
      color: #2563eb;
    }

    .action-btn-reset {
      border: 1px dashed #d7dce5;
      background: #ffffff;
      color: #6b7280;
    }

    .action-btn-reset:hover {
      border-color: #f59bb7;
      background: #fff8fb;
      color: #be185d;
    }

    .action-btn-primary {
      border: 1px solid #2563eb;
      background: #2563eb;
      color: #ffffff;
      box-shadow: 0 8px 18px rgba(37, 99, 235, 0.16);
    }

    .action-btn-primary:hover {
      background: #1d4ed8;
      border-color: #1d4ed8;
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(37, 99, 235, 0.18);
    }

    .document-stage {
      display: flex;
      justify-content: center;
    }

    .document-stage-inner {
      width: 100%;
      overflow: auto;
      padding: 4px 0 0;
    }

    .generator-related-block,
    .generator-seo-block,
    .generator-faq-block {
      margin-top: 28px;
    }

    .packing-document {
      margin: 0 auto;
      background: #fff;
      border: 1px solid #cbd5e1;
      box-shadow: 0 16px 36px rgba(15, 23, 42, 0.12);
    }

    .packing-document.paper-letter {
      width: 816px;
      min-height: 1056px;
    }

    .packing-document.paper-a4 {
      width: 794px;
      min-height: 1123px;
    }

    .packing-document-inner {
      padding: 54px 48px 48px;
      color: #111827;
      font-family: Arial, Helvetica, sans-serif;
    }

    .document-title-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 24px;
      margin-bottom: 24px;
    }

    .document-logo-text {
      width: 100%;
      max-width: 360px;
      min-height: 54px;
      padding: 8px 12px;
      border: 2px dashed #d1d5db;
      border-radius: 14px;
      background: #ffffff;
      color: #111827;
      font-size: 34px;
      font-weight: 850;
      letter-spacing: -0.04em;
      line-height: 1.1;
      outline: none;
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        box-shadow 0.15s ease;
    }

    .document-logo-text::placeholder {
      color: #b6beca;
    }

    .document-logo-text:hover,
    .document-logo-text:focus {
      background-color: #fffbea;
      border-color: #2563eb;
      box-shadow:
        0 0 0 4px rgba(37, 99, 235, 0.22),
        0 6px 18px rgba(37, 99, 235, 0.1);
    }

    .doc-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 24px;
      padding-bottom: 14px;
      border-bottom: 2px solid #cbd5e1;
    }

    .doc-title {
      font-size: 24px;
      font-weight: 700;
      letter-spacing: 0.06em;
    }

    .doc-meta {
      min-width: 276px;
      display: grid;
      gap: 8px;
      justify-items: stretch;
      align-content: start;
    }

    .packing-meta-barcode-slot {
      display: flex;
      justify-content: flex-end;
      min-height: 0;
    }

    .packing-meta-row {
      display: grid;
      grid-template-columns: auto 118px 15ch;
      align-items: center;
      gap: 8px;
      width: max-content;
      margin-left: auto;
    }

    .packing-meta-input {
      width: 15ch;
      min-width: 0;
      max-width: 15ch;
    }

    .packing-meta-action-spacer {
      width: 130px;
      min-width: 130px;
      height: 1px;
      display: block;
    }

    .packing-barcode-block {
      width: 3.5cm;
      height: 1.8cm;
      margin-top: 4px;
      padding: 2mm 4mm;
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #ffffff;
      border: 1px dashed #cbd5e1;
      border-radius: 6px;
      overflow: hidden;
      position: relative;
    }

    .packing-barcode-block svg {
      display: block;
      width: 100%;
      height: 100%;
    }

    .packing-barcode-empty {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #94a3b8;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-align: center;
      padding: 0 2mm;
    }

    .packing-barcode-block[data-barcode-ready="true"] .packing-barcode-empty {
      display: none;
    }

    .packing-barcode-block[hidden] {
      display: none !important;
    }

    .barcode-action-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 36px;
      padding: 0 14px;
      border: 1px solid #93c5fd;
      border-radius: 999px;
      background: #eff6ff;
      color: #2563eb;
      font-size: 13px;
      font-weight: 800;
      line-height: 1;
      cursor: pointer;
      white-space: nowrap;
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease,
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }

    .barcode-action-btn:hover,
    .barcode-action-btn.is-active {
      background: #dbeafe;
      border-color: #60a5fa;
      color: #1d4ed8;
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(37, 99, 235, 0.12);
    }

    .barcode-action-icon {
      width: 18px;
      height: 18px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #2563eb;
      color: #ffffff;
      font-size: 12px;
      line-height: 1;
      font-weight: 900;
      flex: 0 0 auto;
    }

    .doc-section {
      margin-top: 16px;
    }

    .section-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
    }

    .section-title {
      margin: 0;
      font-size: 11pt;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .box {
      border: 1px solid #cbd5e1;
      padding: 12px;
    }

    .field-row {
      display: flex;
      align-items: baseline;
      gap: 8px;
      min-height: 26px;
      font-size: 10pt;
      line-height: 1.45;
    }

    .field-row-block {
      display: grid;
      grid-template-columns: 1fr;
      gap: 6px;
      align-items: start;
      min-height: auto;
      margin-bottom: 10px;
    }

    .field-row-block:last-child {
      margin-bottom: 0;
    }

    .field-label {
      font-weight: 700;
      white-space: nowrap;
    }

    .doc-input,
    .doc-textarea {
      width: 100%;
      border: 1.5px dashed #e5e7eb;
      border-radius: 10px;
      background: #ffffff;
      color: #111827;
      font: inherit;
      padding: 9px 10px;
      outline: none;
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        box-shadow 0.15s ease;
    }

    .inline-input {
      padding: 4px 8px;
    }

    .doc-input::placeholder,
    .doc-textarea::placeholder {
      color: #6b7280;
    }

    .doc-input:hover,
    .doc-textarea:hover,
    .doc-input:focus,
    .doc-textarea:focus {
      background-color: #fffbea !important;
      border-color: #2563eb !important;
      box-shadow:
        0 0 0 4px rgba(37, 99, 235, 0.22),
        0 6px 18px rgba(37, 99, 235, 0.1) !important;
    }

    .doc-textarea {
      resize: vertical;
    }

    .compact-area,
    .compact-remarks {
      min-height: 64px;
    }

    .doc-table {
      width: 100%;
      border-collapse: collapse;
    }

    .doc-table th,
    .doc-table td {
      border: 1px solid #cbd5e1;
      padding: 7px 8px;
      font-size: 9.5pt;
      text-align: left;
      vertical-align: top;
    }

    .packing-table td {
      height: 36px;
    }

    .table-input {
      border: 1px solid transparent;
      border-radius: 8px;
      background: transparent;
      padding: 8px;
      min-height: 28px;
    }

    .table-input:hover,
    .table-input:focus {
      background-color: #fffbea !important;
      border-color: #2563eb !important;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.18) !important;
      outline: none;
    }

    .row-number {
      vertical-align: middle;
      text-align: center;
      font-weight: 700;
    }

    .action-cell {
      text-align: center;
      vertical-align: middle;
    }

    .remove-row-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      min-width: 34px;
      border: 1px solid #f9a8d4;
      border-radius: 10px;
      background: #fdf2f8;
      color: #db2777;
      font-size: 18px;
      line-height: 1;
      cursor: pointer;
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease,
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }

    .remove-row-btn:hover {
      background: #fce7f3;
      border-color: #f472b6;
      color: #be185d;
      transform: translateY(-1px);
      box-shadow: 0 8px 20px rgba(219, 39, 119, 0.12);
    }

    .add-item-inline-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 36px;
      padding: 0 14px;
      border: 1px solid #93c5fd;
      border-radius: 999px;
      background: #eff6ff;
      color: #2563eb;
      font-size: 13px;
      font-weight: 800;
      line-height: 1;
      cursor: pointer;
      white-space: nowrap;
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease,
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }

    .add-item-inline-btn:hover {
      background: #dbeafe;
      border-color: #60a5fa;
      color: #1d4ed8;
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(37, 99, 235, 0.12);
    }

    .add-item-icon {
      width: 18px;
      height: 18px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #2563eb;
      color: #ffffff;
      font-size: 14px;
      line-height: 1;
      font-weight: 900;
    }

    @media (max-width: 980px) {
      .document-action-bar {
        align-items: stretch;
        flex-direction: column;
      }

      .document-action-bar__left,
      .document-action-bar__right {
        width: 100%;
      }

      .document-action-bar__right {
        justify-content: flex-start;
      }
    }

    @media (max-width: 760px) {
      .packing-generator-inner {
        width: min(1280px, calc(100% - 24px));
        padding: 28px 0 56px;
      }

      .generator-breadcrumb {
        flex-wrap: wrap;
        gap: 8px;
      }

      .generator-description {
        font-size: 16px;
      }

      .two-col {
        grid-template-columns: 1fr;
      }

      .document-title-row {
        grid-template-columns: 1fr;
        gap: 12px;
      }

      .document-logo-text {
        max-width: none;
        font-size: 30px;
      }

      .doc-header {
        flex-direction: column;
      }

      .doc-meta {
        min-width: 0;
        width: 100%;
      }

      .packing-meta-row {
        grid-template-columns: 1fr;
        width: 100%;
        margin-left: 0;
      }

      .packing-meta-input {
        width: 100%;
        max-width: none;
      }

      .packing-meta-action-spacer {
        display: none;
      }

    }
  </style>

  <style is:global>
    @media print {
      body * {
        visibility: hidden !important;
      }

      #packing-list-document,
      #packing-list-document * {
        visibility: visible !important;
      }

      .site-header,
      .site-footer,
      .document-action-bar,
      .document-bottom-actions,
      .barcode-action-btn,
      .remove-row-btn,
      .edit-only {
        display: none !important;
      }

      #packing-list-document {
        position: absolute !important;
        left: 0 !important;
        top: 0 !important;
        margin: 0 !important;
        border: 0 !important;
        box-shadow: none !important;
        background: #fff !important;
      }

      .packing-document.paper-letter,
      .packing-document.paper-a4 {
        width: auto !important;
        min-height: auto !important;
      }

      .doc-input,
      .doc-textarea {
        border: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
        padding: 0 !important;
        border-radius: 0 !important;
        resize: none !important;
      }

      .packing-barcode-block {
        border: 0 !important;
        border-radius: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
        margin-top: 2px !important;
      }

      .document-logo-text {
        border-color: transparent !important;
        background: transparent !important;
        box-shadow: none !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
      }

      .document-logo-text::placeholder {
        color: transparent !important;
      }
    }
  </style>

  <script>
    import JsBarcode from "jsbarcode";

    const documentRoot = document.getElementById("packing-list-document");
    const itemsTableBody = document.getElementById("itemsTableBody");
    const addItemBtn = document.getElementById("addItemBtn");
    const resetTriggers = Array.from(document.querySelectorAll("[data-reset-form-trigger]"));
    const printTriggers = Array.from(document.querySelectorAll("[data-print-document]"));
    const paperButtons = Array.from(document.querySelectorAll("[data-paper-size]"));
    const barcodeBlock = document.getElementById("packingBarcodeBlock");
    const barcodeSvg = document.getElementById("packingListBarcode");
    const toggleBarcodeBtn = document.getElementById("toggleBarcodeBtn");
    const packingListNumberInput = document.getElementById("packingListNumber");
    let barcodeVisible = false;

    function renumberRows() {
      const rows = Array.from(itemsTableBody.querySelectorAll(".item-row"));
      rows.forEach((row, index) => {
        const num = row.querySelector(".row-number");
        if (num) num.textContent = String(index + 1);
      });
    }

    function attachRemoveHandlers(scope = document) {
      scope.querySelectorAll(".remove-row-btn").forEach((btn) => {
        if (btn.dataset.bound === "1") return;
        btn.dataset.bound = "1";

        btn.addEventListener("click", () => {
          const rows = itemsTableBody.querySelectorAll(".item-row");
          if (rows.length <= 1) return;
          btn.closest(".item-row")?.remove();
          renumberRows();
        });
      });
    }

    function createItemRow(index) {
      const tr = document.createElement("tr");
      tr.className = "item-row";
      tr.innerHTML = `
        <td class="row-number">${index}</td>
        <td><input class="doc-input table-input" type="text" /></td>
        <td><input class="doc-input table-input" type="text" /></td>
        <td><input class="doc-input table-input" type="text" /></td>
        <td><input class="doc-input table-input" type="text" /></td>
        <td><input class="doc-input table-input" type="text" /></td>
        <td class="edit-only action-cell">
          <button type="button" class="remove-row-btn">×</button>
        </td>
      `;
      return tr;
    }

    function resetForm() {
      documentRoot.querySelectorAll("input").forEach((input) => {
        input.value = "";
      });

      documentRoot.querySelectorAll("textarea").forEach((textarea) => {
        textarea.value = "";
      });

      itemsTableBody.innerHTML = "";
      for (let i = 1; i <= 5; i++) {
        itemsTableBody.appendChild(createItemRow(i));
      }
      attachRemoveHandlers(itemsTableBody);
      renumberRows();
      applyPaper("letter");
      barcodeVisible = false;
      renderBarcode();
      updateBarcodeButton();
    }

    function applyPaper(paper) {
      documentRoot.classList.remove("paper-letter", "paper-a4");
      documentRoot.classList.add(paper === "a4" ? "paper-a4" : "paper-letter");

      paperButtons.forEach((btn) => {
        btn.classList.toggle("is-active", btn.dataset.paperSize === paper);
      });

      const styleId = "generator-print-page-rule";
      let styleTag = document.getElementById(styleId);

      if (!styleTag) {
        styleTag = document.createElement("style");
        styleTag.id = styleId;
        document.head.appendChild(styleTag);
      }

      if (paper === "a4") {
        styleTag.textContent =
          "@page { size: A4 portrait; margin: 18mm 16mm 18mm 16mm; }";
      } else {
        styleTag.textContent =
          "@page { size: Letter portrait; margin: 0.7in 0.65in 0.7in 0.65in; }";
      }
    }

    addItemBtn?.addEventListener("click", () => {
      const nextIndex = itemsTableBody.querySelectorAll(".item-row").length + 1;
      itemsTableBody.appendChild(createItemRow(nextIndex));
      attachRemoveHandlers(itemsTableBody);
      renumberRows();
    });

    paperButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        applyPaper(btn.dataset.paperSize || "letter");
      });
    });


    function renderBarcode() {
      if (!(barcodeBlock instanceof HTMLElement) || !(barcodeSvg instanceof SVGElement) || !(packingListNumberInput instanceof HTMLInputElement)) return;
      const value = packingListNumberInput.value.trim();
      const canRender = barcodeVisible && value !== "";
      barcodeBlock.hidden = !barcodeVisible;
      barcodeBlock.dataset.barcodeReady = canRender ? "true" : "false";
      if (!barcodeVisible || !value) {
        barcodeSvg.innerHTML = "";
        return;
      }
      try {
        JsBarcode(barcodeSvg, value, {
          format: "CODE128",
          lineColor: "#111827",
          width: 1.1,
          height: 42,
          displayValue: false,
          margin: 0,
        });
      } catch (error) {
        console.error("Failed to render packing list barcode", error);
        barcodeSvg.innerHTML = "";
        barcodeBlock.dataset.barcodeReady = "false";
      }
    }

    function updateBarcodeButton() {
      if (!(toggleBarcodeBtn instanceof HTMLButtonElement)) return;
      toggleBarcodeBtn.classList.toggle("is-active", barcodeVisible);
      const label = toggleBarcodeBtn.querySelector(".barcode-action-label");
      if (label) label.textContent = barcodeVisible ? "Hide Barcode" : "Show Barcode";
    }

    toggleBarcodeBtn?.addEventListener("click", () => {
      barcodeVisible = !barcodeVisible;
      renderBarcode();
      updateBarcodeButton();
    });

    packingListNumberInput?.addEventListener("input", renderBarcode);

    resetTriggers.forEach((trigger) => {
      trigger.addEventListener("click", resetForm);
    });

    printTriggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        window.print();
      });
    });

    attachRemoveHandlers(document);
    applyPaper("letter");
    renderBarcode();
    updateBarcodeButton();
  </script>
</BaseLayout>
