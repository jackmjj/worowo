---
import DocumentGeneratorLayout from "../../components/document-generator/DocumentGeneratorLayout.astro";
import { getRelatedToolsForTool } from "../../data/toolRelations";

const pageTitle = "Delivery Receipt Generator";
const pageDescription =
  "Generate delivery receipts with store name, sender and receiver details, item rows, quantities, values, and PDF export for shipment records.";
const canonical = "https://www.worowo.com/packing-shipping/delivery-receipt-generator/";

const faqItems = [
  {
    question: "How does the delivery receipt generator work?",
    answer:
      "Enter your store name, sender, receiver, delivery date, and item details. The tool creates a delivery receipt preview that you can export as a PDF.",
  },
  {
    question: "Can I add multiple items?",
    answer:
      "Yes. You can add or remove item rows and the receipt will calculate line totals and receipt total automatically.",
  },
  {
    question: "Can I upload a logo?",
    answer:
      "No. This generator keeps the receipt simple and uses your custom store name as the personalized header.",
  },
  {
    question: "Can I export the receipt to PDF?",
    answer:
      "Yes. After generating the receipt, you can export a PDF for printing, customer confirmation, or delivery records.",
  },
];

const relatedTools = getRelatedToolsForTool("delivery_receipt_generator");
---

<DocumentGeneratorLayout
  config={{
    title: pageTitle,
    description: pageDescription,
    canonical,
    categoryName: "Packing & Shipping",
    categoryHref: "/packing-shipping/",
    breadcrumbCurrent: "Delivery Receipt Generator",
    backLabel: "Back to Packing & Shipping",
    printHref: "#print",
  }}
  relatedTools={relatedTools}
  faqItems={faqItems}
>
  <div class="inline-document-mobile-shell" slot="document">
    <div class="desktop-document-editor">
      <div id="delivery-receipt-document" class="inline-document-root delivery-document paper-a4 delivery-sentinel">
        <div class="inline-document-inner delivery-document-inner">
          <div class="document-title-row">
            <input
              id="documentLogoText"
              class="document-logo-text"
              type="text"
              placeholder="Your Business Name"
              aria-label="Business name or logo text"
              data-field="storeName"
            />
            <div class="document-title">DELIVERY RECEIPT</div>
          </div>

          <div class="doc-header">
            <div>
              <div class="doc-subtitle editor-hint no-print">Delivery receipt for shipment records</div>
            </div>

            <div class="doc-meta">
              <div class="field-row dr-meta-row">
                <span class="field-label print-label">Receipt No.:</span>
                <input
                  id="receiptNo"
                  class="doc-input inline-input dr-meta-input"
                  type="text"
                  placeholder="Receipt No."
                  data-field="receiptNo"
                />
              </div>
              <div class="field-row dr-meta-row">
                <span class="field-label print-label">Date:</span>
                <input
                  id="deliveryDate"
                  class="doc-input inline-input dr-meta-input"
                  type="date"
                  placeholder="Date"
                  data-field="deliveryDate"
                />
              </div>
            </div>
          </div>

          <section class="doc-section">
            <div class="two-col">
              <div class="box">
                <h2 class="section-title">Sender</h2>
                <div class="field-row field-row-block">
                  <input id="senderName" class="doc-input" type="text" placeholder="Sender Name" data-field="senderName" />
                </div>
                <div class="field-row field-row-block">
                  <textarea id="senderAddress" class="doc-textarea compact-area" rows="2" placeholder="Sender Address" data-field="senderAddress"></textarea>
                </div>
              </div>

              <div class="box">
                <h2 class="section-title">Receiver</h2>
                <div class="field-row field-row-block">
                  <input id="receiverName" class="doc-input" type="text" placeholder="Receiver Name" data-field="receiverName" />
                </div>
                <div class="field-row field-row-block">
                  <textarea id="receiverAddress" class="doc-textarea compact-area" rows="2" placeholder="Receiver Address" data-field="receiverAddress"></textarea>
                </div>
              </div>
            </div>
          </section>

          <section class="doc-section">
            <div class="box">
              <h2 class="section-title">Delivery Address</h2>
              <div class="field-row field-row-block">
                <textarea id="deliveryAddress" class="doc-textarea compact-area" rows="2" placeholder="Full delivery address" data-field="deliveryAddress"></textarea>
              </div>
            </div>
          </section>

          <section class="doc-section">
            <div class="section-title-row">
              <h2 class="section-title">Items</h2>
              <button type="button" class="add-item-btn edit-only" id="addItemBtn" data-add-item-trigger>
                <span class="add-item-icon" aria-hidden="true">+</span>
                <span>Add Item</span>
              </button>
            </div>

            <table class="doc-table delivery-table">
              <thead>
                <tr>
                  <th style="width: 40%;">Description</th>
                  <th style="width: 12%;">Qty</th>
                  <th style="width: 18%;">Unit Price</th>
                  <th style="width: 20%;">Amount</th>
                  <th class="edit-only" style="width: 10%;"></th>
                </tr>
              </thead>
              <tbody id="itemsTableBody"></tbody>
            </table>
          </section>

          <section class="doc-section">
            <div class="two-col notes-totals-row">
              <div class="box">
                <h2 class="section-title">Remarks</h2>
                <textarea id="receiptRemarks" class="doc-textarea compact-remarks" rows="2" data-field="receiptRemarks"></textarea>
              </div>

              <div class="box totals-box">
                <div class="totals-panel">
                  <div class="total-row total-row-grand"><span>Receipt Total</span><output id="grandTotalValue" class="total-output">$0.00</output></div>
                </div>
              </div>
            </div>
          </section>

          <div class="dr-signature-grid">
            <div class="dr-signature-box">
              <span>Delivered By</span>
              <div class="dr-signature-line"></div>
              <small>Date:</small>
            </div>
            <div class="dr-signature-box">
              <span>Received By</span>
              <div class="dr-signature-line"></div>
              <small>Date:</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mobile-document-editor no-print">
      <div class="mobile-action-card">
        <a href="/packing-shipping/" class="mobile-back-btn">Back to Packing & Shipping</a>
        <div class="mobile-paper-size">
          <span class="mobile-paper-size-label">Paper Size</span>
          <div class="mobile-paper-toggle" aria-label="Paper size">
            <button type="button" class="paper-btn" data-paper-size="letter">US Letter</button>
            <button type="button" class="paper-btn is-active" data-paper-size="a4">A4</button>
          </div>
        </div>
      </div>

      <section class="mobile-form-card">
        <h2>Receipt Header</h2>
        <input class="mobile-input mobile-logo-input" type="text" placeholder="Your Business Name" data-field="storeName" />
        <input class="mobile-input" type="text" placeholder="Receipt No." data-field="receiptNo" />
        <input class="mobile-input" type="date" data-field="deliveryDate" />
      </section>

      <section class="mobile-form-card">
        <h2>Sender</h2>
        <input class="mobile-input" type="text" placeholder="Sender Name" data-field="senderName" />
        <textarea class="mobile-textarea" placeholder="Sender Address" data-field="senderAddress"></textarea>
      </section>

      <section class="mobile-form-card">
        <h2>Receiver</h2>
        <input class="mobile-input" type="text" placeholder="Receiver Name" data-field="receiverName" />
        <textarea class="mobile-textarea" placeholder="Receiver Address" data-field="receiverAddress"></textarea>
      </section>

      <section class="mobile-form-card">
        <h2>Delivery Address</h2>
        <textarea class="mobile-textarea" placeholder="Full delivery address" data-field="deliveryAddress"></textarea>
      </section>

      <section class="mobile-form-card">
        <div class="mobile-section-header">
          <h2>Items</h2>
          <button type="button" class="mobile-add-item-btn" data-add-item-trigger>+ Add Item</button>
        </div>
        <div id="mobileItemsList" class="mobile-items-list"></div>
      </section>

      <section class="mobile-form-card">
        <h2>Remarks & Total</h2>
        <textarea class="mobile-textarea" placeholder="Remarks" data-field="receiptRemarks"></textarea>
        <div class="mobile-total-card">
          <div class="grand-total"><span>Receipt Total</span><output id="mobileGrandTotalValue" class="total-output">$0.00</output></div>
        </div>
      </section>
    </div>

    <div class="mobile-bottom-action-bar no-print">
      <button type="button" class="mobile-reset-btn" data-reset-form-trigger>
        <span class="reset-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path d="M12 5a7 7 0 1 1-6.67 9.12 1 1 0 1 1 1.91-.59A5 5 0 1 0 8.1 8.3H11a1 1 0 1 1 0 2H5a1 1 0 0 1-1-1V3a1 1 0 1 1 2 0v3.32A8.97 8.97 0 0 1 12 5z" fill="currentColor"></path>
          </svg>
        </span>
        <span>Reset</span>
      </button>

      <a
        href="#print"
        class="mobile-print-btn"
        data-print-document
        title="Print or save delivery receipt as PDF"
        aria-label="Print or save delivery receipt as PDF"
      >
        <svg class="mobile-print-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M7 2h8l5 5v3h-2V8h-4V4H7v6H5V4a2 2 0 0 1 2-2z" fill="currentColor"></path>
          <path d="M6 12h12a3 3 0 0 1 3 3v4h-4v3H7v-3H3v-4a3 3 0 0 1 3-3zm3 8h6v-4H9v4z" fill="currentColor"></path>
          <path d="M16 9h3v3h-3z" fill="currentColor"></path>
        </svg>
        <span>Print / Save as PDF</span>
      </a>
      <p class="mobile-privacy-note">Your data is processed locally in your browser and is not stored on our servers.</p>
    </div>
  </div>

  <article class="content-card" slot="guide">
    <h2>How This Delivery Receipt Generator Works</h2>
    <p>
      Use this generator to create a delivery receipt for shipped or delivered goods. Add your
      store name, delivery parties, address, and item rows, then print or save a PDF receipt for
      customers, drivers, warehouse teams, or internal records.
    </p>
  </article>

  <article class="content-card" slot="guide">
    <h2>Why Store Name Instead of Logo Upload?</h2>
    <p>
      This tool keeps the workflow fast and reliable. Your custom store name appears in the receipt
      header without requiring image upload, file handling, or extra setup.
    </p>
  </article>

  <style is:global>
    .delivery-document {
      margin: 0 auto;
      background: #fff;
      border: 1px solid rgba(203, 213, 225, 0.7);
      box-shadow:
        0 34px 78px rgba(15, 23, 42, 0.12),
        0 10px 28px rgba(15, 23, 42, 0.08);
    }

    .delivery-document.paper-letter {
      width: min(100%, 884px);
      min-height: 1144px;
    }

    .delivery-document.paper-a4 {
      width: min(100%, 860px);
      min-height: 1216px;
    }

    .delivery-document-inner {
      padding: 54px 48px 48px;
      color: #111827;
      font-family: Arial, Helvetica, sans-serif;
    }

    .delivery-table td {
      height: 36px;
    }

    .dr-meta-row {
      display: grid;
      grid-template-columns: 88px 15ch;
      align-items: center;
      gap: 8px;
      width: max-content;
      margin-left: auto;
    }

    .dr-meta-input {
      width: 15ch;
      min-width: 0;
      max-width: 15ch;
    }

    .dr-signature-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-top: 24px;
    }

    .dr-signature-box {
      min-height: 72px;
      padding: 12px;
      border: 1px solid #cbd5e1;
      display: grid;
      align-content: end;
      gap: 8px;
    }

    .dr-signature-box span {
      font-size: 9.5pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .dr-signature-line {
      border-bottom: 1px solid #111827;
      min-height: 18px;
    }

    .dr-signature-box small {
      color: #475569;
      font-size: 8.5pt;
      font-weight: 700;
    }

    @media screen and (max-width: 760px) {
      .dr-meta-row {
        grid-template-columns: 1fr;
        width: 100%;
        margin-left: 0;
      }

      .dr-meta-input {
        width: 100%;
        max-width: none;
      }

      .dr-signature-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <style is:global>
    @media print {
      .site-header,
      .site-footer,
      .generator-breadcrumb,
      .generator-hero,
      .generator-related-block,
      .generator-seo-block,
      .generator-faq-block,
      .document-action-bar,
      .document-bottom-actions,
      .mobile-document-editor,
      .mobile-bottom-action-bar,
      .editor-hint,
      .doc-subtitle,
      .field-label:not(.print-label),
      .remove-row-btn,
      .item-delete-btn,
      .edit-only,
      .no-print {
        display: none !important;
      }

      #delivery-receipt-document {
        position: static !important;
        display: block !important;
        width: auto !important;
        max-width: none !important;
        height: auto !important;
        min-height: auto !important;
        margin: 0 !important;
        border: 0 !important;
        box-shadow: none !important;
        background: #fff !important;
        overflow: visible !important;
        break-after: auto;
        break-inside: avoid;
        page-break-after: auto;
        page-break-inside: avoid;
      }

      .delivery-document.paper-letter,
      .delivery-document.paper-a4 {
        width: auto !important;
        min-height: auto !important;
      }

      .delivery-document-inner {
        padding: 38px 36px 28px !important;
      }

      .doc-header {
        gap: 14px !important;
        padding-bottom: 8px !important;
      }

      .doc-meta {
        gap: 4px !important;
      }

      .doc-section {
        margin-top: 10px !important;
      }

      .box,
      .totals-panel,
      .dr-signature-box {
        padding: 9px !important;
      }

      .doc-table th,
      .doc-table td {
        padding: 5px 6px !important;
      }

      .delivery-table td {
        height: 30px !important;
      }

      .compact-area,
      .compact-remarks {
        min-height: 48px !important;
      }

      .doc-input,
      .doc-textarea {
        border: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
        padding: 0 !important;
        border-radius: 0 !important;
        resize: none !important;
      }

      .field-label.print-label {
        display: inline !important;
        font-weight: 700 !important;
        white-space: nowrap !important;
      }
    }
  </style>

  <style>
    .delivery-sentinel {
      --delivery-sentinel: 1;
    }
  </style>

  <script>
    const documentRoot = document.getElementById("delivery-receipt-document");
    const itemsTableBody = document.getElementById("itemsTableBody");
    const mobileItemsList = document.getElementById("mobileItemsList");
    const resetTriggers = Array.from(document.querySelectorAll("[data-reset-form-trigger], #resetFormBtn"));
    const printTriggers = Array.from(document.querySelectorAll("[data-print-document]"));
    const paperButtons = Array.from(document.querySelectorAll("[data-paper-size]"));

    const syncFields = [
      "storeName",
      "receiptNo",
      "deliveryDate",
      "senderName",
      "senderAddress",
      "receiverName",
      "receiverAddress",
      "deliveryAddress",
      "receiptRemarks",
    ];

    let nextItemId = 3;

    function updateNextItemId() {
      const numericIds = state.items
        .map((item: any) => Number.parseInt(String(item.id).replace("item-", ""), 10))
        .filter((value: number) => Number.isFinite(value));
      nextItemId = numericIds.length > 0 ? Math.max(...numericIds) + 1 : 1;
    }

    function defaultFields() {
      return {
        storeName: "",
        receiptNo: "",
        deliveryDate: "",
        senderName: "",
        senderAddress: "",
        receiverName: "",
        receiverAddress: "",
        deliveryAddress: "",
        receiptRemarks: "",
      };
    }

    function createItem() {
      return {
        id: `item-${nextItemId++}`,
        description: "",
        qty: "1",
        unitPrice: "0",
      };
    }

    const state: {
      paper: string;
      fields: Record<string, string>;
      items: any[];
    } = {
      paper: "a4",
      fields: defaultFields(),
      items: [createItem(), createItem()],
    };

    function toNumber(value: string) {
      const parsed = Number.parseFloat(value);
      return Number.isFinite(parsed) ? parsed : 0;
    }

    function formatMoney(value: number) {
      return `$${value.toFixed(2)}`;
    }

    function escapeHtml(value: string) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
    }

    function lineAmount(item: any) {
      return toNumber(item.qty) * toNumber(item.unitPrice);
    }

    function calculateTotal() {
      return state.items.reduce((sum: number, item: any) => sum + lineAmount(item), 0);
    }

    function renderSharedFields() {
      syncFields.forEach((field) => {
        document.querySelectorAll(`[data-field="${field}"]`).forEach((input: any) => {
          const value = state.fields[field];
          if (input.value !== value) input.value = value;
        });
      });
    }

    function desktopItemRow(item: any) {
      const total = lineAmount(item);
      return `
        <tr class="item-row" data-item-id="${item.id}">
          <td><input class="doc-input table-input" type="text" data-item-id="${item.id}" data-item-field="description" value="${escapeHtml(item.description)}" placeholder="Item description" /></td>
          <td><input class="doc-input table-input" type="number" min="0" step="1" data-item-id="${item.id}" data-item-field="qty" value="${escapeHtml(item.qty)}" /></td>
          <td><input class="doc-input table-input" type="number" min="0" step="0.01" data-item-id="${item.id}" data-item-field="unitPrice" value="${escapeHtml(item.unitPrice)}" data-clear-zero-on-focus="true" data-default-value="0" /></td>
          <td class="amount-cell"><span class="line-amount" data-item-line-total="${item.id}">${formatMoney(total)}</span></td>
          <td class="edit-only action-cell">
            <button type="button" class="item-delete-btn" aria-label="Remove item" data-remove-item="${item.id}">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path d="M9 3h6l1 2h4v2H4V5h4l1-2zm1 6h2v8h-2V9zm4 0h2v8h-2V9zM7 9h2v8H7V9zm-1 12h12a2 2 0 0 0 2-2V7H4v12a2 2 0 0 0 2 2z" fill="currentColor" />
              </svg>
            </button>
          </td>
        </tr>
      `;
    }

    function mobileItemCard(item: any, index: number) {
      const total = lineAmount(item);
      return `
        <article class="mobile-item-card" data-item-id="${item.id}">
          <div class="mobile-item-title">
            <strong>Item ${index + 1}</strong>
            <button type="button" class="mobile-delete-item-btn" aria-label="Remove item" data-remove-item="${item.id}">Delete</button>
          </div>
          <input class="mobile-input" type="text" placeholder="Description" data-item-id="${item.id}" data-item-field="description" value="${escapeHtml(item.description)}" />
          <div class="mobile-two-col">
            <input class="mobile-input" type="number" placeholder="Qty" min="0" step="1" data-item-id="${item.id}" data-item-field="qty" value="${escapeHtml(item.qty)}" />
            <input class="mobile-input" type="number" placeholder="Unit Price" min="0" step="0.01" data-item-id="${item.id}" data-item-field="unitPrice" value="${escapeHtml(item.unitPrice)}" data-clear-zero-on-focus="true" data-default-value="0" />
          </div>
          <div class="mobile-amount-box">
            <span>Amount</span>
            <strong data-item-line-total="${item.id}">${formatMoney(total)}</strong>
          </div>
        </article>
      `;
    }

    function renderItems() {
      updateNextItemId();
      if (itemsTableBody) {
        itemsTableBody.innerHTML = state.items.map((item: any) => desktopItemRow(item)).join("");
      }
      if (mobileItemsList) {
        mobileItemsList.innerHTML = state.items.map((item: any, index: number) => mobileItemCard(item, index)).join("");
      }
    }

    function renderTotals() {
      const grandTotal = calculateTotal();

      document.querySelectorAll("[data-item-line-total]").forEach((el) => {
        const id = el.getAttribute("data-item-line-total");
        const item = state.items.find((entry: any) => entry.id === id);
        if (item) el.textContent = formatMoney(lineAmount(item));
      });

      const targets: Record<string, number> = {
        grandTotalValue: grandTotal,
        mobileGrandTotalValue: grandTotal,
      };
      Object.entries(targets).forEach(([id, value]) => {
        const el = document.getElementById(id);
        if (el) el.textContent = formatMoney(value);
      });
    }

    function applyPaper(paper: string) {
      state.paper = paper === "letter" ? "letter" : "a4";
      documentRoot?.classList.remove("paper-letter", "paper-a4");
      documentRoot?.classList.add(state.paper === "letter" ? "paper-letter" : "paper-a4");

      paperButtons.forEach((btn: any) => {
        btn.classList.toggle("is-active", btn.dataset.paperSize === state.paper);
      });

      const styleId = "delivery-receipt-print-page-rule";
      let styleTag = document.getElementById(styleId);
      if (!styleTag) {
        styleTag = document.createElement("style");
        styleTag.id = styleId;
        document.head.appendChild(styleTag);
      }
      styleTag.textContent =
        state.paper === "letter"
          ? "@page { size: Letter portrait; margin: 0.55in 0.55in 0.55in 0.55in; }"
          : "@page { size: A4 portrait; margin: 14mm 14mm 14mm 14mm; }";
    }

    function addItem() {
      if (state.items.length >= 12) return;
      state.items.push(createItem());
      renderItems();
      renderTotals();
    }

    function removeItem(itemId: string) {
      if (state.items.length <= 1) return;
      state.items = state.items.filter((item: any) => item.id !== itemId);
      renderItems();
      renderTotals();
    }

    function resetDocumentForm() {
      state.fields = defaultFields();
      state.items = [createItem(), createItem()];

      const now = new Date();
      state.fields.receiptNo = `DR-${now.toISOString().slice(0, 10).replaceAll("-", "")}-001`;
      state.fields.deliveryDate = now.toISOString().slice(0, 10);

      renderSharedFields();
      renderItems();
      applyPaper("a4");
      renderTotals();
    }

    function updateField(field: string, value: string, source: EventTarget | null) {
      state.fields[field] = value;
      document.querySelectorAll(`[data-field="${field}"]`).forEach((input: any) => {
        if (input !== source && input.value !== value) {
          input.value = value;
        }
      });
      renderTotals();
    }

    function updateItemField(itemId: string, field: string, value: string, source: EventTarget | null) {
      const item = state.items.find((entry: any) => entry.id === itemId);
      if (!item) return;
      item[field] = value;
      document.querySelectorAll(`[data-item-id="${itemId}"][data-item-field="${field}"]`).forEach((input: any) => {
        if (input !== source && input.value !== value) {
          input.value = value;
        }
      });
      renderTotals();
    }

    function preparePrintState() {
      documentRoot?.querySelectorAll("input, textarea").forEach((field: any) => {
        const value = field.value.trim();
        if (value !== "") {
          field.classList.remove("print-empty-field");
          return;
        }
        field.classList.add("print-empty-field");
        if (field.placeholder) {
          field.dataset.restorePlaceholder = field.placeholder;
          field.placeholder = "";
        }
      });
    }

    function restorePrintVisualState() {
      document.body.classList.remove("inline-doc-print-reveal");
      documentRoot?.querySelectorAll(".print-empty-field").forEach((field: any) => {
        field.classList.remove("print-empty-field");
        if (field.dataset.restorePlaceholder) {
          field.placeholder = field.dataset.restorePlaceholder;
          delete field.dataset.restorePlaceholder;
        }
      });
    }

    function handleDocumentPrint() {
      preparePrintState();
      document.body.classList.add("inline-doc-print-reveal");
      window.setTimeout(() => window.print(), 60);
    }

    function onPrintTrigger(event: Event) {
      event.preventDefault();
      event.stopPropagation();
      handleDocumentPrint();
    }

    window.addEventListener("afterprint", restorePrintVisualState);

    document.addEventListener("input", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement)) return;

      const field = target.dataset.field;
      if (field) {
        updateField(field, target.value, target);
        return;
      }

      const itemId = target.dataset.itemId;
      const itemField = target.dataset.itemField;
      if (itemId && itemField) {
        updateItemField(itemId, itemField, target.value, target);
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const removeButton = target.closest("[data-remove-item]");
      if (removeButton) {
        removeItem(removeButton.getAttribute("data-remove-item") || "");
        return;
      }

      if (target.closest("[data-add-item-trigger]")) {
        addItem();
      }
    });

    resetTriggers.forEach((trigger) => {
      trigger.addEventListener("click", resetDocumentForm);
    });

    paperButtons.forEach((btn: any) => {
      btn.addEventListener("click", () => applyPaper(btn.dataset.paperSize || "a4"));
    });

    printTriggers.forEach((trigger) => {
      trigger.addEventListener("click", onPrintTrigger);
    });

    (window as any).handleDocumentPrint = handleDocumentPrint;

    resetDocumentForm();
  </script>
</DocumentGeneratorLayout>
