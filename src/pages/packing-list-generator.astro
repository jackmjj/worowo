---
const targetPath = "/packing-shipping/packing-list-generator/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta http-equiv="refresh" content={`0;url=${targetPath}`} />
    <link rel="canonical" href={`https://www.worowo.com${targetPath}`} />
    <script>
      window.location.replace(targetPath);
    </script>
  </head>
  <body>
    <p>
      Redirecting to <a href={targetPath}>{targetPath}</a>...
    </p>
  </body>
</html>
