---
import ToolLayout from "../../layouts/ToolLayout.astro";
import CalculatorFormActions from "../../components/business-calculators/CalculatorFormActions.astro";
import CalculatorOutputActions from "../../components/business-calculators/CalculatorOutputActions.astro";

const toolMeta = {
  title: "Unit Price Comparison Calculator",
  seoTitle: "Unit Price Comparison Calculator, Supplier Quote Comparison & Procurement Tool | worowo",
  category: "Business Calculators",
  categoryHref: "/business-calculators/",
  description:
    "Compare supplier quotes, unit prices, shipping, taxes, fees, and landed unit cost to find the most cost-effective option. Add multiple suppliers and export a PDF report.",
  intro:
    "Compare supplier quotes, shipping, fees, and landed unit prices to find the most cost-effective option for your business.",
  canonical: "https://www.worowo.com/business-calculators/unit-price-comparison/",
};

const faqItems = [
  {
    question: "How does this unit price comparison calculator work?",
    answer:
      "It compares supplier quotes by converting each quote into a landed unit price. The landed unit price is calculated from total price plus shipping, tax, or fees, divided by quantity.",
  },
  {
    question: "Can I compare more than two suppliers?",
    answer:
      "Yes. Enter one supplier quote at a time on the left, add it to the comparison list, and keep adding quotes until you have all suppliers you want to compare.",
  },
  {
    question: "Should all suppliers use the same unit?",
    answer:
      "Yes. For an accurate comparison, all suppliers should be quoted using the same base unit, such as pcs, sets, or boxes. If units differ, review the result carefully.",
  },
  {
    question: "Can I export the result as a PDF?",
    answer:
      "Yes. You can export a clean supplier comparison report with the best supplier, quote comparison table, report title, and decision notes.",
  },
];

const relatedTools = [
  {
    name: "Discount Calculator",
    href: "/business-calculators/discount-calculator/",
    desc: "Calculate discounted price, savings, profit margin, and total profit.",
  },
  {
    name: "Profit Margin Calculator",
    href: "/business-calculators/profit-margin-calculator/",
    desc: "Calculate margin, markup, selling price, and profit projection.",
  },
  {
    name: "Break-Even Point Calculator",
    href: "/business-calculators/break-even-point-calculator/",
    desc: "Check how supplier cost changes the units or revenue you need to break even.",
  },
  {
    name: "Purchase Order Generator",
    href: "/quotes-invoices/purchase-order-generator/",
    desc: "Turn the winning supplier quote into a clean purchase order.",
  },
];
---

<ToolLayout
  title={toolMeta.title}
  pageTitle={toolMeta.seoTitle}
  description={toolMeta.description}
  canonical={toolMeta.canonical}
  eyebrow="Business Calculator"
  categoryLabel={toolMeta.category}
  categoryHref={toolMeta.categoryHref}
  intro={toolMeta.intro}
  faqItems={faqItems}
  currentToolKey="unit_price_comparison_calculator"
  relatedTools={relatedTools}
>
  <div slot="form" class="upc-form-card">
    <div class="upc-form-header">
      <h2>Compare Supplier Unit Prices</h2>
      <p>
        Add supplier quotes, shipping, taxes, fees, and quantities to find the lowest landed unit price.
      </p>
      <p class="upc-form-header-note">
        Use this before placing a purchase order or choosing the most cost-effective supplier.
      </p>
    </div>

    <section class="upc-entry-card upc-tone-blue" aria-labelledby="entryFormTitle">
      <div class="upc-entry-card-head">
        <h3 id="entryFormTitle" class="upc-entry-card-title">Add Supplier Quote</h3>
        <p id="editingHint" class="upc-editing-hint" hidden>Editing an existing quote</p>
      </div>

      <form id="quoteEntryForm" class="upc-entry-form" novalidate>
        <div class="upc-fields-grid">
          <label class="upc-field upc-field-inline upc-field-vendor">
            <span class="upc-label">Vendor Name</span>
            <input
              id="entryName"
              type="text"
              data-entry-field="name"
              placeholder="e.g. Supplier A"
              autocomplete="organization"
            />
          </label>

          <label class="upc-field upc-field-card upc-field-total">
            <span class="upc-label">Total Price</span>
            <div class="upc-input-prefix">
              <span>$</span>
              <input
                id="entryPrice"
                type="number"
                min="0"
                step="0.01"
                data-entry-field="price"
                placeholder="e.g. 500"
              />
            </div>
          </label>

          <label class="upc-field upc-field-card upc-field-fees">
            <span class="upc-label">Tax / Fees</span>
            <div class="upc-input-prefix">
              <span>$</span>
              <input
                id="entryFees"
                type="number"
                min="0"
                step="0.01"
                data-entry-field="fees"
                placeholder="e.g. 35"
              />
            </div>
          </label>

          <label class="upc-field upc-field-card upc-field-shipping">
            <span class="upc-label">Shipping</span>
            <div class="upc-input-prefix">
              <span>$</span>
              <input
                id="entryShipping"
                type="number"
                min="0"
                step="0.01"
                data-entry-field="shipping"
                placeholder="e.g. 10"
              />
            </div>
          </label>

          <div class="upc-field upc-field-card upc-field-quantity-unit">
            <span class="upc-label">Quantity / Unit</span>
            <div class="upc-combo-input">
              <input
                id="entryQty"
                type="number"
                min="0"
                step="1"
                data-entry-field="qty"
                placeholder="e.g. 100"
              />
              <select id="entryUnit" data-entry-field="unit" aria-label="Unit">
                <option value="pcs">pcs</option>
                <option value="units">units</option>
                <option value="sets">sets</option>
                <option value="boxes">boxes</option>
                <option value="kg">kg</option>
                <option value="lb">lb</option>
              </select>
            </div>
          </div>
        </div>

        <div class="upc-supplier-preview">
          <div>
            <span>Landed Total</span>
            <strong id="entryPreviewLanded">$0.00</strong>
          </div>
          <div>
            <span>Unit Price</span>
            <strong id="entryPreviewPrice">$0.00 / unit</strong>
          </div>
        </div>
      </form>

      <div class="upc-entry-actions">
        <button id="addQuoteButton" type="button" class="upc-add-btn">+ Add Quote</button>
        <button id="cancelEditButton" type="button" class="upc-cancel-edit" hidden>Cancel edit</button>
      </div>

      <p class="upc-entry-tip">
        Tip: When comparing suppliers, include hidden costs like domestic logistics, pallet fees, or handling charges in the total price for a more accurate supplier unit price comparison.
      </p>
    </section>

    <div class="upc-export-settings">
      <label class="upc-field">
        <span class="upc-label">PDF Report Title</span>
        <input
          id="reportTitle"
          type="text"
          value="Supplier Unit Price Comparison"
          placeholder="e.g. Supplier Unit Price Comparison"
        />
      </label>

      <label class="upc-field">
        <span class="upc-label">Decision Notes</span>
        <textarea
          id="decisionNotes"
          rows="4"
          placeholder="Optional: Supplier B has better samples, faster delivery, or lower MOQ."
        ></textarea>
      </label>
    </div>

    <div class="upc-form-divider"></div>

    <p class="upc-form-note">
      Compare landed unit prices using total quote amount, shipping, tax or fees, and quantity.
    </p>
    <p id="errorMessage" class="upc-error" aria-live="polite"></p>

    <CalculatorFormActions
      className="upc-actions"
      resetButtonId="resetButton"
      primaryButtonId="compareButton"
      primaryLabel="Compare Prices"
    />
  </div>

  <div slot="results" class="upc-results-card printable-result">
    <div class="upc-print-meta" aria-hidden="true">
      <h2 id="printReportTitle">Supplier Unit Price Comparison</h2>
      <p id="printDecisionNotes">—</p>
    </div>

    <div class="upc-hero-panel">
      <div class="upc-hero-label">Best Supplier</div>
      <div id="bestSupplierName" class="upc-hero-name">—</div>
      <div id="bestSupplierPrice" class="upc-hero-price">$0.00 / unit</div>

      <div id="savingsBanner" class="upc-savings-banner">
        Add at least two complete quotes to compare savings.
      </div>
    </div>

    <div class="upc-results-summary">
      <div class="upc-results-summary-head">
        <div>
          <h3>Supplier Quotes</h3>
          <p>Switch between input order and unit price sorting.</p>
        </div>
        <button id="sortToggleButton" type="button" class="upc-sort-toggle">
          <span class="upc-sort-toggle-icon" aria-hidden="true">↕</span>
          <span>Sort by Unit Price</span>
        </button>
      </div>

      <div id="rankingList" class="upc-ranking-list" aria-live="polite">
        <p class="upc-ranking-empty">No quotes yet. Add a supplier quote on the left.</p>
      </div>

      <div id="unitWarning" class="upc-warning" hidden>
        Supplier units are different. Review carefully before making a final comparison.
      </div>
    </div>

    <div class="upc-right-divider"></div>

    <div class="upc-procurement-box">
      <div class="upc-procurement-label">Procurement Summary</div>
      <p id="procurementSummary">
        Add at least two complete supplier quotes to see the most cost-effective option.
      </p>
    </div>

    <div class="upc-savings-grid">
      <div class="upc-savings-card">
        <span>Best Landed Unit Price</span>
        <strong id="bestUnitPriceSummary">$0.00</strong>
      </div>
      <div class="upc-savings-card">
        <span>Savings vs Highest Quote</span>
        <strong id="savingsVsHighest">$0.00</strong>
      </div>
      <div class="upc-savings-card">
        <span>Savings vs Second Best Quote</span>
        <strong id="savingsVsSecond">$0.00</strong>
      </div>
    </div>

    <div class="upc-right-divider upc-action-divider"></div>

    <div class="upc-export-row">
      <p class="upc-export-note">
        Print or save a clean supplier comparison summary after reviewing the result.
      </p>
      <p class="upc-error upc-error-placeholder" aria-hidden="true"></p>
      <CalculatorOutputActions />
    </div>
  </div>

  <div slot="content" class="content-card">
    <h2>How This Unit Price Comparison Calculator Works</h2>
    <p>
      This calculator compares supplier quotes by converting each quote into a landed unit price.
      It includes total price, shipping, tax or fees, and quantity, so you can compare offers more accurately.
    </p>
  </div>

  <div slot="content" class="content-card">
    <h2>When to Use It</h2>
    <p>
      Use this tool before placing a purchase order, comparing supplier offers, reviewing landed cost,
      or preparing a sourcing decision for your team.
    </p>
  </div>

  <div slot="content" class="content-card">
    <h2>Who This Calculator Is For</h2>
    <p>
      It is useful for traders, importers, wholesalers, ecommerce sellers, sourcing teams,
      and small businesses that buy from multiple suppliers.
    </p>
  </div>
</ToolLayout>

<script>
  (() => {
    const entryFields = {
      name: document.getElementById("entryName"),
      price: document.getElementById("entryPrice"),
      fees: document.getElementById("entryFees"),
      shipping: document.getElementById("entryShipping"),
      qty: document.getElementById("entryQty"),
      unit: document.getElementById("entryUnit"),
    };
    const entryPreviewLandedEl = document.getElementById("entryPreviewLanded");
    const entryPreviewPriceEl = document.getElementById("entryPreviewPrice");
    const quoteEntryForm = document.getElementById("quoteEntryForm");
    const addQuoteButton = document.getElementById("addQuoteButton");
    const cancelEditButton = document.getElementById("cancelEditButton");
    const editingHintEl = document.getElementById("editingHint");
    const entryFormTitleEl = document.getElementById("entryFormTitle");
    const resetButton = document.getElementById("resetButton");
    const compareButton = document.getElementById("compareButton");
    const exportPdfButton = document.querySelector(".upc-export-row [data-print-document]");
    const reportTitleInput = document.getElementById("reportTitle");
    const decisionNotesInput = document.getElementById("decisionNotes");
    const bestSupplierNameEl = document.getElementById("bestSupplierName");
    const bestSupplierPriceEl = document.getElementById("bestSupplierPrice");
    const savingsBannerEl = document.getElementById("savingsBanner");
    const rankingListEl = document.getElementById("rankingList");
    const sortToggleButton = document.getElementById("sortToggleButton");
    const sortToggleButtonLabel = sortToggleButton?.querySelector("span:last-child");
    const procurementSummaryEl = document.getElementById("procurementSummary");
    const unitWarningEl = document.getElementById("unitWarning");
    const errorMessageEl = document.getElementById("errorMessage");
    const bestUnitPriceSummaryEl = document.getElementById("bestUnitPriceSummary");
    const savingsVsHighestEl = document.getElementById("savingsVsHighest");
    const savingsVsSecondEl = document.getElementById("savingsVsSecond");
    const printReportTitleEl = document.getElementById("printReportTitle");
    const printDecisionNotesEl = document.getElementById("printDecisionNotes");

    let suppliers = [];
    let editingId = null;
    let nextId = 1;
    let sortMode = "input";

    function numberValue(value) {
      const number = Number.parseFloat(value);
      return Number.isFinite(number) ? number : 0;
    }

    function money(value) {
      return `$${numberValue(value).toFixed(2)}`;
    }

    function formatQty(value) {
      return numberValue(value).toLocaleString("en-US", { maximumFractionDigits: 2 });
    }

    function escapeHtml(value = "") {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function setError(message) {
      errorMessageEl.textContent = message;
    }

    function syncSortToggleLabel() {
      if (!sortToggleButtonLabel) return;

      if (sortMode === "asc") {
        sortToggleButtonLabel.textContent = "Sort Descending";
        return;
      }

      if (sortMode === "desc") {
        sortToggleButtonLabel.textContent = "Sort by Input Order";
        return;
      }

      sortToggleButtonLabel.textContent = "Sort by Unit Price";
    }

    function syncPrintableMeta() {
      if (printReportTitleEl) {
        printReportTitleEl.textContent = reportTitleInput.value.trim() || "Supplier Unit Price Comparison";
      }

      if (printDecisionNotesEl) {
        printDecisionNotesEl.textContent = decisionNotesInput.value.trim() || "—";
      }
    }

    function enrichSupplier(raw, index) {
      const landedTotal = raw.price + raw.fees + raw.shipping;
      const unitPrice = raw.qty > 0 ? landedTotal / raw.qty : 0;

      return {
        ...raw,
        name: raw.name || `Supplier ${index + 1}`,
        landedTotal,
        unitPrice,
        hasMinimumData: landedTotal > 0 && raw.qty > 0,
      };
    }

    function readEntryForm() {
      return {
        name: entryFields.name.value.trim(),
        price: numberValue(entryFields.price.value),
        fees: numberValue(entryFields.fees.value),
        shipping: numberValue(entryFields.shipping.value),
        qty: numberValue(entryFields.qty.value),
        unit: entryFields.unit.value || "pcs",
      };
    }

    function clearEntryForm() {
      entryFields.name.value = "";
      entryFields.price.value = "";
      entryFields.fees.value = "";
      entryFields.shipping.value = "";
      entryFields.qty.value = "";
      entryFields.unit.value = "pcs";
      updateEntryPreview();
    }

    function fillEntryForm(supplier) {
      entryFields.name.value = supplier.name;
      entryFields.price.value = supplier.price || "";
      entryFields.fees.value = supplier.fees || "";
      entryFields.shipping.value = supplier.shipping || "";
      entryFields.qty.value = supplier.qty || "";
      entryFields.unit.value = supplier.unit || "pcs";
      updateEntryPreview();
    }

    function defaultSupplierName() {
      return `Supplier ${suppliers.length + 1}`;
    }

    function setEditingMode(id) {
      editingId = id;
      const isEditing = Boolean(id);

      addQuoteButton.textContent = isEditing ? "Update Quote" : "+ Add Quote";
      addQuoteButton.classList.toggle("is-editing", isEditing);
      cancelEditButton.hidden = !isEditing;
      editingHintEl.hidden = !isEditing;
      entryFormTitleEl.textContent = isEditing ? "Edit Supplier Quote" : "Add Supplier Quote";
    }

    function cancelEdit() {
      setEditingMode(null);
      clearEntryForm();
      setError("");
    }

    function updateEntryPreview() {
      const draft = enrichSupplier(readEntryForm(), suppliers.length);

      entryPreviewLandedEl.textContent = draft.hasMinimumData ? money(draft.landedTotal) : "$0.00";
      entryPreviewPriceEl.textContent = draft.hasMinimumData
        ? `${money(draft.unitPrice)} / ${draft.unit}`
        : "$0.00 / unit";
    }

    function validateEntry(entry) {
      const landedTotal = entry.price + entry.fees + entry.shipping;

      if (landedTotal <= 0) {
        setError("Enter a total price, tax/fees, or shipping amount greater than zero.");
        return false;
      }

      if (entry.qty <= 0) {
        setError("Enter a quantity greater than zero.");
        return false;
      }

      setError("");
      return true;
    }

    function addOrUpdateQuote() {
      const entry = readEntryForm();

      if (!validateEntry(entry)) return;

      const payload = {
        name: entry.name || defaultSupplierName(),
        price: entry.price,
        fees: entry.fees,
        shipping: entry.shipping,
        qty: entry.qty,
        unit: entry.unit,
      };

      if (editingId) {
        suppliers = suppliers.map((supplier) =>
          supplier.id === editingId ? { ...supplier, ...payload } : supplier,
        );
        cancelEdit();
      } else {
        suppliers = [...suppliers, { id: nextId++, ...payload }];
        clearEntryForm();
        entryFields.name.focus();
      }

      calculateAndRender();
    }

    function removeQuote(id) {
      const row = rankingListEl.querySelector(`[data-supplier-id="${id}"]`);

      if (row) {
        row.classList.add("upc-row-removing");
        window.setTimeout(() => {
          suppliers = suppliers.filter((supplier) => supplier.id !== id);
          if (editingId === id) cancelEdit();
          calculateAndRender();
        }, 180);
        return;
      }

      suppliers = suppliers.filter((supplier) => supplier.id !== id);
      if (editingId === id) cancelEdit();
      calculateAndRender();
    }

    function startEdit(id) {
      const supplier = suppliers.find((item) => item.id === id);
      if (!supplier) return;

      fillEntryForm(supplier);
      setEditingMode(id);
      setError("");
      entryFields.name.focus();
    }

    function getDisplaySuppliers(enriched) {
      const displaySuppliers = [...enriched];

      if (sortMode === "asc") {
        displaySuppliers.sort((a, b) => a.unitPrice - b.unitPrice);
      } else if (sortMode === "desc") {
        displaySuppliers.sort((a, b) => b.unitPrice - a.unitPrice);
      }

      return displaySuppliers;
    }

    function renderQuoteResults(displaySuppliers) {
      if (suppliers.length === 0) {
        rankingListEl.innerHTML =
          '<p class="upc-ranking-empty">No quotes yet. Add a supplier quote on the left.</p>';
        return;
      }

      const highlightId = displaySuppliers.length >= 2
        ? displaySuppliers.reduce((bestId, supplier, index, list) => {
          if (index === 0) return supplier.id;
          const bestSupplier = list.find((item) => item.id === bestId);
          return supplier.unitPrice < bestSupplier.unitPrice ? supplier.id : bestId;
        }, null)
        : null;

      rankingListEl.innerHTML = displaySuppliers
        .map((supplier, displayIndex) => {
          const supplierName = escapeHtml(supplier.name);
          const unit = escapeHtml(supplier.unit);
          const rawMeta = `(${money(supplier.landedTotal)} / ${formatQty(supplier.qty)} ${unit})`;
          const isBestValue = supplier.id === highlightId;

          return `
            <article
              class="upc-compact-row ${isBestValue ? "is-best-value" : ""}"
              data-supplier-id="${supplier.id}"
            >
              <span class="upc-row-sequence" aria-hidden="true">#${displayIndex + 1}</span>
              <div class="upc-row-body">
                <div class="upc-row-title-line">
                  <strong class="upc-row-name">${supplierName}</strong>
                  <span class="upc-row-unit-price">
                    <span class="upc-row-unit-price-value">${money(supplier.unitPrice)}</span>
                    <span class="upc-row-unit-price-unit">/ ${unit}</span>
                  </span>
                </div>
                <span class="upc-row-meta">${rawMeta}</span>
              </div>
              <div class="upc-row-actions">
                <button type="button" class="upc-icon-btn upc-icon-btn-edit" data-edit-btn aria-label="Edit ${supplierName}">
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path
                      d="M3 17.25V21h3.75L17.8 9.94l-3.75-3.75L3 17.25zm14.71-9.04c.39-.39.39-1.02 0-1.41l-2.5-2.5a.996.996 0 1 0-1.41 1.41l2.5 2.5c.38.39 1.02.39 1.41 0z"
                      fill="currentColor"
                    />
                  </svg>
                </button>
                <button type="button" class="upc-icon-btn upc-icon-btn-delete" data-delete-btn aria-label="Delete ${supplierName}">
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                    <path
                      d="M9 3h6l1 2h4v2H4V5h4l1-2zm1 6h2v8h-2V9zm4 0h2v8h-2V9zM7 9h2v8H7V9zm-1 12h12a2 2 0 0 0 2-2V7H4v12a2 2 0 0 0 2 2z"
                      fill="currentColor"
                    />
                  </svg>
                </button>
              </div>
            </article>
          `;
        })
        .join("");
    }

    function renderEmptyState() {
      bestSupplierNameEl.textContent = "—";
      bestSupplierPriceEl.textContent = "$0.00 / unit";
      savingsBannerEl.textContent = "Add at least two complete quotes to compare savings.";
      procurementSummaryEl.textContent =
        "Add at least two complete supplier quotes to see the most cost-effective option.";
      bestUnitPriceSummaryEl.textContent = "$0.00";
      savingsVsHighestEl.textContent = "$0.00";
      savingsVsSecondEl.textContent = "$0.00";
      renderQuoteResults([]);
      unitWarningEl.hidden = true;
    }

    function calculateAndRender() {
      setError("");

      const enriched = suppliers.map((supplier, index) => enrichSupplier(supplier, index));
      const validSuppliers = enriched.filter((supplier) => supplier.hasMinimumData);

      if (validSuppliers.length === 0) {
        renderEmptyState();
        return validSuppliers;
      }

      renderQuoteResults(getDisplaySuppliers(enriched));

      const sorted = [...validSuppliers].sort((a, b) => a.unitPrice - b.unitPrice);
      const best = sorted[0];
      const second = sorted[1];
      const unitSet = new Set(sorted.map((supplier) => supplier.unit));

      unitWarningEl.hidden = unitSet.size <= 1;
      bestSupplierNameEl.textContent = best.name;
      bestSupplierPriceEl.textContent = `${money(best.unitPrice)} / ${best.unit}`;
      bestUnitPriceSummaryEl.textContent = `${money(best.unitPrice)} / ${best.unit}`;

      if (second) {
        const savingsPercent = second.unitPrice > 0
          ? ((second.unitPrice - best.unitPrice) / second.unitPrice) * 100
          : 0;
        const highest = sorted[sorted.length - 1];
        const savingsVsHighest = Math.max(0, highest.unitPrice - best.unitPrice);
        const savingsVsSecond = Math.max(0, second.unitPrice - best.unitPrice);
        savingsBannerEl.textContent =
          `Saves ${savingsPercent.toFixed(2)}% compared with the next cheapest quote.`;
        procurementSummaryEl.textContent =
          `${best.name} is currently the most cost-effective supplier at ${money(best.unitPrice)} per ${best.unit}.`;
        savingsVsHighestEl.textContent = `${money(savingsVsHighest)} / ${best.unit}`;
        savingsVsSecondEl.textContent = `${money(savingsVsSecond)} / ${best.unit}`;
      } else {
        savingsBannerEl.textContent = "Add one more complete quote to compare savings.";
        procurementSummaryEl.textContent =
          `${best.name} currently has the only complete quote at ${money(best.unitPrice)} per ${best.unit}.`;
        savingsVsHighestEl.textContent = "$0.00";
        savingsVsSecondEl.textContent = "$0.00";
      }

      return sorted;
    }

    function resetCalculator() {
      suppliers = [];
      nextId = 1;
      sortMode = "input";
      reportTitleInput.value = "Supplier Unit Price Comparison";
      decisionNotesInput.value = "";
      cancelEdit();
      syncSortToggleLabel();
      syncPrintableMeta();
      renderEmptyState();
      updateEntryPreview();
    }

    function exportPdf() {
      const sorted = calculateAndRender();

      if (sorted.length === 0) {
        setError("Please enter at least one complete supplier quote before exporting.");
        return;
      }
      syncPrintableMeta();
      window.print();
    }

    Object.values(entryFields).forEach((field) => {
      field.addEventListener("input", updateEntryPreview);
      field.addEventListener("change", updateEntryPreview);
    });

    quoteEntryForm.addEventListener("submit", (event) => {
      event.preventDefault();
      addOrUpdateQuote();
    });

    addQuoteButton.addEventListener("click", addOrUpdateQuote);
    cancelEditButton.addEventListener("click", cancelEdit);
    resetButton.addEventListener("click", resetCalculator);
    compareButton.addEventListener("click", calculateAndRender);
    sortToggleButton.addEventListener("click", () => {
      if (sortMode === "input") {
        sortMode = "asc";
      } else if (sortMode === "asc") {
        sortMode = "desc";
      } else {
        sortMode = "input";
      }

      syncSortToggleLabel();
      calculateAndRender();
    });
    exportPdfButton.addEventListener("click", exportPdf);
    reportTitleInput.addEventListener("input", syncPrintableMeta);
    decisionNotesInput.addEventListener("input", syncPrintableMeta);

    rankingListEl.addEventListener("click", (event) => {
      const row = event.target.closest("[data-supplier-id]");
      if (!row) return;

      const id = Number(row.dataset.supplierId);
      if (event.target.closest("[data-edit-btn]")) {
        startEdit(id);
        return;
      }

      if (event.target.closest("[data-delete-btn]")) {
        removeQuote(id);
      }
    });

    resetCalculator();
  })();
</script>

