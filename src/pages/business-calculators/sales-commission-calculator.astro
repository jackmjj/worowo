---
import SalesCommissionForm from "../../components/document-generators/sales-commission/SalesCommissionForm.astro";
import SalesCommissionPreview from "../../components/document-generators/sales-commission/SalesCommissionPreview.astro";
import CalculatorOutputActions from "../../components/business-calculators/CalculatorOutputActions.astro";
import DocumentGeneratorLayout from "../../layouts/DocumentGeneratorLayout.astro";

const title = "Sales Commission Calculator";
const description =
  "Calculate tiered sales commission, base salary, bonus, deductions, and net payout online. Review the results in a printable monthly commission statement and save as PDF in A4 or US Letter format.";
const canonical = "https://www.worowo.com/business-calculators/sales-commission-calculator/";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Business Calculators", href: "/business-calculators/" },
  { label: "Sales Commission Calculator" },
];

const faq = [
  {
    question: "What does this sales commission calculator do?",
    answer:
      "It calculates tiered commission, base salary, optional bonus, deductions, gross earnings, and final net payout from your sales inputs.",
  },
  {
    question: "How do I calculate tiered commission?",
    answer:
      "Add one or more commission tiers in order. For example, enter 10,000 at 3% for the first tier and leave the second tier open at 5% to apply 5% to all remaining sales above 10,000.",
  },
  {
    question: "Can I include base salary with commission?",
    answer:
      "Yes. Enter a base salary and the calculator will add it to tiered commission and any earned bonus before subtracting deductions.",
  },
  {
    question: "Can I print or save the commission statement as PDF?",
    answer:
      "Yes. Use the Print / Save as PDF button to print only the monthly commission statement preview and save it as PDF from your browser.",
  },
  {
    question: "Can I switch between A4 and US Letter?",
    answer:
      "Yes. The preview supports both A4 and US Letter so you can prepare a printout that matches your preferred paper size.",
  },
  {
    question: "Who can use this calculator?",
    answer:
      "It is useful for sales staff, managers, agencies, distributors, and small businesses that pay commission-based earnings.",
  },
];

const relatedTools = [
  {
    title: "Profit Margin Calculator",
    href: "/business-calculators/profit-margin-calculator/",
    description: "Calculate price, margin, markup, and projected profit from your costs and selling price.",
  },
  {
    title: "Break-even Point Calculator",
    href: "/business-calculators/break-even-point-calculator/",
    description: "Work out how many units or how much revenue you need to cover your fixed and variable costs.",
  },
  {
    title: "Quote / Estimate Generator",
    href: "/quotes-invoices/quote-estimate-generator/",
    description: "Create a client-facing quote or estimate after working out your sales incentives and pricing.",
  },
  {
    title: "Invoice Generator",
    href: "/quotes-invoices/invoice-generator/",
    description: "Create a professional invoice and print or save it as PDF once the sale is confirmed.",
  },
];
---

<DocumentGeneratorLayout
  title={title}
  pageTitle={`${title} | Worowo`}
  description={description}
  canonical={canonical}
  eyebrow="Business Calculators"
  categoryLabel="Business Calculators"
  categoryHref="/business-calculators/"
  intro="Calculate commission, bonus, deductions, and net payout, then print or save a commission statement as PDF."
  breadcrumbs={breadcrumbs}
  faq={faq}
  currentToolKey="sales_commission_calculator"
  relatedTools={relatedTools}
>
  <div slot="form" class="generator-split">
    <div class="generator-form">
      <SalesCommissionForm />
    </div>

    <div class="generator-mobile-actions">
      <div class="generator-mobile-form-actions scc-form-actions">
        <button type="button" class="scc-btn scc-btn-secondary" data-reset-form>Reset</button>
        <button type="button" class="scc-btn scc-btn-primary" data-calculate-commission>
          Calculate Commission
        </button>
      </div>
      <CalculatorOutputActions />
    </div>

    <div class="generator-preview">
      <div class="generator-preview-main">
        <div class="generator-preview-sticky">
          <SalesCommissionPreview />
        </div>
      </div>
      <div class="paper-actions">
        <p class="paper-actions-help">
          Print or save a clean commission statement after reviewing the result.
        </p>
        <CalculatorOutputActions />
      </div>
    </div>
  </div>

  <div slot="content" class="content-card">
    <h2>How This Sales Commission Calculator Works</h2>
    <p>
      Use this calculator to prepare a practical monthly commission statement without opening a spreadsheet.
      It is designed for small teams, agencies, distributors, and business owners who need something more
      realistic than a single percentage field but still faster than payroll software.
    </p>
    <ul>
      <li><strong>Tiered commission</strong> supports threshold-based rates for realistic incentive plans.</li>
      <li><strong>Base salary</strong> lets you show salary plus commission in one printable statement.</li>
      <li><strong>Bonus and deductions</strong> help you present the actual payout, not only raw commission.</li>
    </ul>
  </div>

  <div slot="content" class="content-card">
    <h2>Common Use Cases</h2>
    <p>
      This tool works well for monthly payroll review, sales incentive planning, manager approval, and internal payout records.
      It is especially useful when commission changes after a target is reached or when you need a clean statement with signature space.
    </p>
    <ul>
      <li>Monthly commission statement for a salesperson</li>
      <li>Base salary plus tiered commission compensation plans</li>
      <li>Distributor or channel partner payout review</li>
      <li>Manager sign-off before payroll processing</li>
    </ul>
  </div>
</DocumentGeneratorLayout>

<style>
  .generator-split {
    display: grid;
    grid-template-columns: minmax(360px, 0.618fr) minmax(520px, 1fr);
    gap: 28px;
    align-items: stretch;
    margin-top: 8px;
  }

  .generator-form,
  .generator-preview {
    min-width: 0;
  }

  .generator-form {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .generator-preview {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    border: 1px solid #dbe4f0;
    border-radius: 24px;
    background: #ffffff;
    padding: 24px;
    box-shadow: 0 18px 44px -34px rgba(15, 23, 42, 0.18);
    box-sizing: border-box;
  }

  .generator-preview-main {
    display: flex;
    flex-direction: column;
    gap: 18px;
    flex: 1 1 auto;
    min-height: 0;
  }

  .generator-preview-sticky {
    position: sticky;
    top: 16px;
    align-self: flex-start;
    width: 100%;
  }

  .generator-preview :global(.document-paper-shell) {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    overflow: visible;
  }

  .generator-preview :global(.document-paper) {
    width: 100%;
    max-width: 560px;
    min-height: auto;
    margin: 0 auto;
    overflow: visible;
  }

  .generator-preview :global(.document-paper-a4),
  .generator-preview :global(.document-paper-letter) {
    width: 100%;
    min-height: auto;
    padding: 32px;
  }

  .paper-actions {
    margin-top: 18px;
    display: grid;
    gap: 14px;
    padding-top: 20px;
    border-top: 1px solid #e2e8f0;
    width: 100%;
    box-sizing: border-box;
  }

  .paper-actions-help {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--text-soft);
    max-width: none;
    white-space: nowrap;
  }

  @media (max-width: 1180px) {
    .paper-actions-help {
      white-space: normal;
    }
  }

  .generator-mobile-actions {
    display: none;
  }

  .paper-actions :global(.calculator-output-actions) {
    gap: 0;
    width: 100%;
  }

  .paper-actions :global(.calculator-output-actions-main) {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
  }

  .paper-actions :global(.calculator-output-btn-primary) {
    box-shadow: 0 14px 30px -18px rgba(37, 99, 235, 0.7);
  }

  .paper-actions :global(.calculator-paper-size-control) {
    justify-self: start;
  }

  .paper-actions :global(.calculator-output-action-buttons) {
    justify-self: end;
    justify-content: flex-end;
  }

  @media (max-width: 980px) {
    .generator-split {
      grid-template-columns: 1fr;
    }

    .generator-mobile-actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
      position: sticky;
      bottom: 12px;
      z-index: 12;
      margin-top: -4px;
    }

    .generator-mobile-form-actions.scc-form-actions {
      margin-top: 0;
      padding: 12px;
      padding-top: 12px;
      border-top: 0;
      border: 1px solid #dbe4f0;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.96);
      box-shadow: 0 -12px 30px rgba(15, 23, 42, 0.08);
      backdrop-filter: blur(12px);
    }

    .generator-mobile-actions :global(.calculator-output-actions) {
      gap: 10px;
      padding: 12px;
      border: 1px solid #dbe4f0;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.96);
      box-shadow: 0 -12px 30px rgba(15, 23, 42, 0.08);
      backdrop-filter: blur(12px);
      border-top-color: #dbe4f0;
    }

    .generator-preview {
      min-height: 0;
    }

    .generator-preview-sticky {
      position: static;
    }

    .paper-actions {
      display: none;
    }
  }

  @media (max-width: 1180px) and (min-width: 981px) {
    .paper-actions :global(.calculator-output-actions-main) {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .paper-actions :global(.calculator-paper-size-control),
    .paper-actions :global(.calculator-output-action-buttons) {
      justify-self: start;
    }
  }

  @media (max-width: 1200px) and (min-width: 981px) {
    .generator-split {
      grid-template-columns: minmax(340px, 0.618fr) minmax(420px, 1fr);
      gap: 24px;
    }

    .generator-preview :global(.document-paper-shell) {
      padding: 0;
    }

    .generator-preview :global(.document-paper) {
      max-width: 520px;
    }

    .generator-preview :global(.document-paper-a4),
    .generator-preview :global(.document-paper-letter) {
      padding: 24px;
    }
  }

  @media print {
    :global(.site-header),
    :global(.tool-hero),
    :global(.tool-related),
    :global(.tool-content),
    :global(.tool-faq),
    :global(footer),
    .generator-form,
    .generator-mobile-actions,
    .paper-actions {
      display: none !important;
    }

    :global(body) {
      background: #ffffff !important;
    }

    :global(.tool-main) {
      padding: 0 !important;
    }

    :global(.container) {
      width: 100% !important;
      margin: 0 !important;
    }

    .generator-split {
      display: block !important;
      margin: 0 !important;
    }

    .generator-preview {
      min-height: 0 !important;
      width: 100% !important;
    }

    .generator-preview-sticky {
      position: static !important;
      width: 100% !important;
    }

    .generator-preview :global(.document-paper-shell) {
      background: transparent !important;
      border: 0 !important;
      box-shadow: none !important;
      padding: 0 !important;
      overflow: visible !important;
    }

    .generator-preview :global(.document-paper) {
      max-width: none !important;
      border: 0 !important;
      box-shadow: none !important;
      margin: 0 auto !important;
    }

    :global(body.print-a4 #salesCommissionPaper) {
      width: 210mm !important;
      min-height: 297mm !important;
      padding: 14mm !important;
    }

    :global(body.print-letter #salesCommissionPaper) {
      width: 8.5in !important;
      min-height: 11in !important;
      padding: 0.55in !important;
    }
  }
</style>
