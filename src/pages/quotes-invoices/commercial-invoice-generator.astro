---
import DocumentGeneratorLayout from "../../components/document-generator/DocumentGeneratorLayout.astro";
import { commonCurrencyOptions } from "../../data/currencyOptions";
import { getRelatedToolsForTool } from "../../data/toolRelations";

const pageTitle = "Commercial Invoice Generator";
const pageDescription =
  "Create a simple or professional commercial invoice for export shipments, customs records, and international trade documentation.";
const canonical = "https://www.worowo.com/quotes-invoices/commercial-invoice-generator/";

const faqItems = [
  {
    question: "What is a commercial invoice used for?",
    answer:
      "A commercial invoice is used in international trade to describe goods, declare shipment value, and support customs, freight, and buyer documentation requirements.",
  },
  {
    question: "Can I print the commercial invoice or save it as PDF?",
    answer:
      "Yes. You can fill in the commercial invoice directly in the document view, then print it or save it as PDF for shipping, customs support, and overseas customers.",
  },
  {
    question: "Does this generator calculate totals automatically?",
    answer:
      "Yes. Line values, freight, insurance, subtotal, and grand total are calculated automatically as you edit the commercial invoice.",
  },
];

const relatedTools = getRelatedToolsForTool("commercial_invoice_generator");
---

<DocumentGeneratorLayout
  config={{
    title: pageTitle,
    description: pageDescription,
    canonical,
    categoryName: "Quotes & Invoices",
    categoryHref: "/quotes-invoices/",
    breadcrumbCurrent: "Commercial Invoice Generator",
    backLabel: "Back to Quotes & Invoices",
    printHref: "#print",
  }}
  relatedTools={relatedTools}
  faqItems={faqItems}
>
  <div slot="actionBarCenter" class="action-bar-mode-control no-print" aria-label="Commercial invoice mode">
    <span class="mode-action-label">Mode</span>
    <div class="mode-toggle" role="group" aria-label="Commercial invoice mode">
      <button type="button" class="mode-toggle-btn is-active" data-commercial-mode="simple">Simple</button>
      <button type="button" class="mode-toggle-btn" data-commercial-mode="professional">Professional</button>
    </div>
  </div>

  <div class="inline-document-mobile-shell" slot="document">
    <div class="desktop-document-editor">
      <div id="commercial-invoice-document" class="inline-document-root commercial-document paper-a4 commercial-sentinel mode-simple">
        <div class="inline-document-inner commercial-document-inner">
          <div class="document-title-row">
            <input
              id="documentLogoText"
              class="document-logo-text"
              type="text"
              placeholder="Your Business Name"
              aria-label="Business name or logo text"
              data-field="logoText"
            />

            <div class="document-title">COMMERCIAL INVOICE</div>
          </div>

          <div class="doc-header">
            <div>
              <div class="doc-subtitle editor-hint no-print">Export invoice for customs and trade records</div>
            </div>

            <div class="doc-meta">
              <div class="commercial-meta-barcode-slot">
                <div class="commercial-barcode-block" id="commercialBarcodeBlock" hidden>
                  <svg id="commercialInvoiceBarcode" aria-label="Commercial invoice barcode"></svg>
                  <span class="commercial-barcode-empty">Enter Invoice No.</span>
                </div>
              </div>
              <div class="field-row commercial-meta-row commercial-meta-row-invoice">
                <button type="button" class="barcode-action-btn no-print" id="toggleBarcodeBtn">
                  <span class="barcode-action-icon" aria-hidden="true">▥</span>
                  <span class="barcode-action-label">Show Barcode</span>
                </button>
                <span class="field-label print-label">Invoice No.:</span>
                <input
                  id="invoiceNumber"
                  class="doc-input inline-input commercial-meta-input"
                  type="text"
                  maxlength="24"
                  placeholder="Invoice No."
                  data-field="invoiceNumber"
                />
              </div>
              <div class="field-row commercial-meta-row commercial-meta-row-date">
                <span class="commercial-meta-action-spacer no-print" aria-hidden="true"></span>
                <span class="field-label print-label">Date:</span>
                <input
                  id="invoiceDate"
                  class="doc-input inline-input commercial-meta-input"
                  type="date"
                  placeholder="Date"
                  data-field="invoiceDate"
                />
              </div>
            </div>
          </div>

          <section class="doc-section">
            <div class="two-col">
              <div class="box">
                <h2 class="section-title">Exporter / Seller</h2>
                <div class="field-row field-row-block">
                  <input id="sellerName" class="doc-input" type="text" placeholder="Company Name" data-field="sellerName" />
                </div>
                <div class="field-row field-row-block">
                  <textarea id="sellerAddress" class="doc-textarea compact-area" rows="2" placeholder="Address" data-field="sellerAddress"></textarea>
                </div>
                <div class="field-row field-row-block">
                  <input id="sellerContact" class="doc-input" type="text" placeholder="Email / Phone" data-field="sellerContact" />
                </div>
              </div>

              <div class="box">
                <h2 class="section-title">Consignee / Buyer</h2>
                <div class="field-row field-row-block">
                  <input id="buyerName" class="doc-input" type="text" placeholder="Company Name" data-field="buyerName" />
                </div>
                <div class="field-row field-row-block">
                  <textarea id="buyerAddress" class="doc-textarea compact-area" rows="2" placeholder="Address" data-field="buyerAddress"></textarea>
                </div>
                <div class="field-row field-row-block">
                  <input id="buyerContact" class="doc-input" type="text" placeholder="Email / Phone" data-field="buyerContact" />
                </div>
              </div>
            </div>
          </section>

          <section class="doc-section professional-only">
            <h2 class="section-title">Trade & Shipping Details</h2>
            <div class="box">
              <div class="three-col">
                <div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Ship From:</span>
                    <input id="shipFrom" class="doc-input" type="text" placeholder="Ship From" data-field="shipFrom" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Port of Loading:</span>
                    <input id="portOfLoading" class="doc-input" type="text" placeholder="Port of Loading" data-field="portOfLoading" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Country of Origin:</span>
                    <input id="countryOfOrigin" class="doc-input" type="text" placeholder="Country of Origin" data-field="countryOfOrigin" />
                  </div>
                </div>

                <div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Ship To:</span>
                    <input id="shipTo" class="doc-input" type="text" placeholder="Ship To" data-field="shipTo" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Port of Discharge:</span>
                    <input id="portOfDischarge" class="doc-input" type="text" placeholder="Port of Discharge" data-field="portOfDischarge" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Incoterms:</span>
                    <input id="incoterms" class="doc-input" type="text" placeholder="e.g. FOB, CIF, EXW" data-field="incoterms" />
                  </div>
                </div>

                <div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Shipment Method:</span>
                    <input id="shipmentMethod" class="doc-input" type="text" placeholder="Sea, Air, Courier..." data-field="shipmentMethod" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Reference No.:</span>
                    <input id="referenceNumber" class="doc-input" type="text" placeholder="Reference No." data-field="referenceNumber" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Freight / Insurance:</span>
                    <input id="freightInsurance" class="doc-input" type="number" min="0" step="0.01" value="0" placeholder="Freight / Insurance" data-clear-zero-on-focus="true" data-default-value="0" data-field="freightInsurance" />
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="doc-section">
            <div class="section-title-row">
              <h2 class="section-title">Items</h2>
              <div class="items-actions">
                <label class="currency-control no-print">
                  <span class="currency-icon" aria-hidden="true">$</span>
                  <span class="currency-label">Currency</span>
                  <select id="currencyCode" class="currency-select" data-field="currencyCode">
                    {commonCurrencyOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                  </select>
                </label>
                <button type="button" class="add-item-btn edit-only" id="addItemBtn" data-add-item-trigger>
                  <span class="add-item-icon" aria-hidden="true">+</span>
                  <span>Add Item</span>
                </button>
              </div>
            </div>

            <table class="doc-table commercial-table">
              <thead>
                <tr>
                  <th style="width: 27%;">Description</th>
                  <th class="professional-only" style="width: 14%;">HS Code</th>
                  <th style="width: 9%;">Qty</th>
                  <th style="width: 11%;">Unit</th>
                  <th style="width: 15%;">Unit Value</th>
                  <th style="width: 16%;">Amount</th>
                  <th class="edit-only" style="width: 8%;"></th>
                </tr>
              </thead>
              <tbody id="itemsTableBody">
                {["item-1", "item-2"].map((itemId) => (
                  <tr class="item-row" data-item-id={itemId}>
                    <td><input class="doc-input table-input item-description" type="text" data-item-id={itemId} data-item-field="description" value="" /></td>
                    <td class="professional-only"><input class="doc-input table-input item-hs-code" type="text" data-item-id={itemId} data-item-field="hsCode" value="" /></td>
                    <td><input class="doc-input table-input item-qty" type="number" min="0" step="1" data-item-id={itemId} data-item-field="qty" value="1" /></td>
                    <td><input class="doc-input table-input item-unit" type="text" placeholder="pcs" data-item-id={itemId} data-item-field="unit" value="pcs" /></td>
                    <td><input class="doc-input table-input item-unit-value" type="number" min="0" step="0.01" data-item-id={itemId} data-item-field="unitValue" value="0" data-clear-zero-on-focus="true" data-default-value="0" /></td>
                    <td class="amount-cell"><span class="line-amount" data-item-line-total={itemId}>USD 0.00</span></td>
                    <td class="edit-only action-cell">
                      <button type="button" class="item-delete-btn" aria-label="Remove item" data-remove-item={itemId}>
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                          <path d="M9 3h6l1 2h4v2H4V5h4l1-2zm1 6h2v8h-2V9zm4 0h2v8h-2V9zM7 9h2v8H7V9zm-1 12h12a2 2 0 0 0 2-2V7H4v12a2 2 0 0 0 2 2z" fill="currentColor" />
                        </svg>
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>

          <section class="doc-section">
            <div class="two-col notes-totals-row">
              <div class="box">
                <h2 class="section-title">Remarks</h2>
                <textarea id="invoiceRemarks" class="doc-textarea compact-remarks" rows="2" data-field="invoiceRemarks"></textarea>
              </div>

              <div class="box totals-box">
                <div class="totals-panel">
                  <div class="total-row"><span>Subtotal</span><strong id="subtotalValue">USD 0.00</strong></div>
                  <div class="total-row"><span>Freight / Insurance</span><strong id="freightValue">USD 0.00</strong></div>
                  <div class="total-row total-row-grand"><span>Total Invoice Value</span><output id="grandTotalValue" class="total-output">USD 0.00</output></div>
                </div>
              </div>
            </div>
          </section>

          <section class="doc-section professional-only">
            <h2 class="section-title">Packages & Declaration</h2>
            <div class="two-col">
              <div class="box">
                <div class="three-col package-fields-grid">
                  <div class="field-row field-row-block">
                    <span class="field-label">Packages:</span>
                    <input id="totalPackages" class="doc-input" type="text" placeholder="e.g. 5 cartons" data-field="totalPackages" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Net Weight:</span>
                    <input id="netWeight" class="doc-input" type="text" placeholder="e.g. 45 kg" data-field="netWeight" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Gross Weight:</span>
                    <input id="grossWeight" class="doc-input" type="text" placeholder="e.g. 52 kg" data-field="grossWeight" />
                  </div>
                </div>
              </div>

              <div class="box">
                <h2 class="section-title">Declaration</h2>
                <textarea id="declarationText" class="doc-textarea compact-remarks" rows="2" data-field="declarationText"></textarea>
              </div>
            </div>

            <div class="signature-grid">
              <div class="signature-box">
                <span>Prepared By</span>
                <div class="signature-line"></div>
                <small>Date:</small>
              </div>
              <div class="signature-box">
                <span>Authorized Signature</span>
                <div class="signature-line"></div>
                <small>Date:</small>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>

    <div class="mobile-document-editor no-print">
      <div class="mobile-action-card">
        <a href="/quotes-invoices/" class="mobile-back-btn">Back to Quotes & Invoices</a>
        <div class="mobile-mode-control" aria-label="Commercial invoice mode">
          <span class="mobile-mode-label">Mode</span>
          <div class="mode-toggle" role="group" aria-label="Commercial invoice mode">
            <button type="button" class="mode-toggle-btn is-active" data-commercial-mode="simple">Simple</button>
            <button type="button" class="mode-toggle-btn" data-commercial-mode="professional">Professional</button>
          </div>
        </div>
        <div class="mobile-paper-size">
          <span class="mobile-paper-size-label">Paper Size</span>
          <div class="mobile-paper-toggle" aria-label="Paper size">
            <button type="button" class="paper-btn" data-paper-size="letter">US Letter</button>
            <button type="button" class="paper-btn is-active" data-paper-size="a4">A4</button>
          </div>
        </div>
      </div>

      <section class="mobile-form-card">
        <h2>Invoice Header</h2>
        <input class="mobile-input mobile-logo-input" type="text" placeholder="Your Business Name" data-field="logoText" />
        <input class="mobile-input" type="text" placeholder="Invoice No." data-field="invoiceNumber" />
        <input class="mobile-input" type="date" data-field="invoiceDate" />
      </section>

      <section class="mobile-form-card">
        <h2>Exporter / Seller</h2>
        <input class="mobile-input" type="text" placeholder="Company Name" data-field="sellerName" />
        <textarea class="mobile-textarea" placeholder="Address" data-field="sellerAddress"></textarea>
        <input class="mobile-input" type="text" placeholder="Email / Phone" data-field="sellerContact" />
      </section>

      <section class="mobile-form-card">
        <h2>Consignee / Buyer</h2>
        <input class="mobile-input" type="text" placeholder="Company Name" data-field="buyerName" />
        <textarea class="mobile-textarea" placeholder="Address" data-field="buyerAddress"></textarea>
        <input class="mobile-input" type="text" placeholder="Email / Phone" data-field="buyerContact" />
      </section>

      <section class="mobile-form-card professional-only">
        <h2>Trade & Shipping Details</h2>
        <input class="mobile-input" type="text" placeholder="Ship From" data-field="shipFrom" />
        <input class="mobile-input" type="text" placeholder="Port of Loading" data-field="portOfLoading" />
        <input class="mobile-input" type="text" placeholder="Country of Origin" data-field="countryOfOrigin" />
        <input class="mobile-input" type="text" placeholder="Ship To" data-field="shipTo" />
        <input class="mobile-input" type="text" placeholder="Port of Discharge" data-field="portOfDischarge" />
        <input class="mobile-input" type="text" placeholder="Incoterms" data-field="incoterms" />
        <input class="mobile-input" type="text" placeholder="Shipment Method" data-field="shipmentMethod" />
        <input class="mobile-input" type="text" placeholder="Reference No." data-field="referenceNumber" />
        <input class="mobile-input" type="number" min="0" step="0.01" placeholder="Freight / Insurance" data-field="freightInsurance" data-clear-zero-on-focus="true" data-default-value="0" />
      </section>

      <section class="mobile-form-card">
        <div class="mobile-section-header">
          <h2>Items</h2>
          <div class="items-actions items-actions--mobile">
            <label class="currency-control">
              <span class="currency-icon" aria-hidden="true">$</span>
              <span class="currency-label">Currency</span>
              <select class="mobile-select currency-select" data-field="currencyCode">
                {commonCurrencyOptions.map((option) => <option value={option.value}>{option.label}</option>)}
              </select>
            </label>
            <button type="button" class="mobile-add-item-btn" data-add-item-trigger>+ Add Item</button>
          </div>
        </div>
        <div id="mobileItemsList" class="mobile-items-list">
          {[1, 2].map((itemNumber) => {
            const itemId = `item-${itemNumber}`;
            return (
              <article class="mobile-item-card" data-item-id={itemId}>
                <div class="mobile-item-title">
                  <strong>{`Item ${itemNumber}`}</strong>
                  <button type="button" class="mobile-delete-item-btn" aria-label="Remove item" data-remove-item={itemId}>Delete</button>
                </div>
                <input class="mobile-input" type="text" placeholder="Description" data-item-id={itemId} data-item-field="description" value="" />
                <input class="mobile-input professional-only" type="text" placeholder="HS Code" data-item-id={itemId} data-item-field="hsCode" value="" />
                <div class="mobile-two-col">
                  <input class="mobile-input" type="number" placeholder="Qty" min="0" step="1" data-item-id={itemId} data-item-field="qty" value="1" />
                  <input class="mobile-input" type="text" placeholder="Unit" data-item-id={itemId} data-item-field="unit" value="pcs" />
                </div>
                <input class="mobile-input" type="number" placeholder="Unit Value" min="0" step="0.01" data-item-id={itemId} data-item-field="unitValue" value="0" data-clear-zero-on-focus="true" data-default-value="0" />
                <div class="mobile-amount-box">
                  <span>Amount</span>
                  <strong data-item-line-total={itemId}>USD 0.00</strong>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <section class="mobile-form-card professional-only">
        <h2>Packages & Declaration</h2>
        <input class="mobile-input" type="text" placeholder="Total Packages" data-field="totalPackages" />
        <input class="mobile-input" type="text" placeholder="Net Weight" data-field="netWeight" />
        <input class="mobile-input" type="text" placeholder="Gross Weight" data-field="grossWeight" />
        <textarea class="mobile-textarea" placeholder="Declaration" data-field="declarationText"></textarea>
      </section>

      <section class="mobile-form-card">
        <h2>Remarks & Totals</h2>
        <textarea class="mobile-textarea" placeholder="Remarks" data-field="invoiceRemarks"></textarea>
        <div class="mobile-total-card">
          <div><span>Subtotal</span><strong id="mobileSubtotalValue">USD 0.00</strong></div>
          <div><span>Freight / Insurance</span><strong id="mobileFreightValue">USD 0.00</strong></div>
          <div class="grand-total"><span>Total Invoice Value</span><output id="mobileGrandTotalValue" class="total-output">USD 0.00</output></div>
        </div>
      </section>
    </div>

    <div class="mobile-bottom-action-bar no-print">
      <button type="button" class="mobile-reset-btn" data-reset-form-trigger>
        <span class="reset-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path d="M12 5a7 7 0 1 1-6.67 9.12 1 1 0 1 1 1.91-.59A5 5 0 1 0 8.1 8.3H11a1 1 0 1 1 0 2H5a1 1 0 0 1-1-1V3a1 1 0 1 1 2 0v3.32A8.97 8.97 0 0 1 12 5z" fill="currentColor"></path>
          </svg>
        </span>
        <span>Reset</span>
      </button>

      <a
        href="#print"
        class="mobile-print-btn"
        data-print-document
        title="Generate and download professional PDF commercial invoice"
        aria-label="Generate and download professional PDF commercial invoice"
      >
        <svg class="mobile-print-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M7 2h8l5 5v3h-2V8h-4V4H7v6H5V4a2 2 0 0 1 2-2z" fill="currentColor"></path>
          <path d="M6 12h12a3 3 0 0 1 3 3v4h-4v3H7v-3H3v-4a3 3 0 0 1 3-3zm3 8h6v-4H9v4z" fill="currentColor"></path>
          <path d="M16 9h3v3h-3z" fill="currentColor"></path>
        </svg>
        <span>Print / Save as PDF</span>
      </a>
      <p class="mobile-privacy-note">Your data is processed locally in your browser and is not stored on our servers.</p>
    </div>
  </div>

  <article class="content-card" slot="guide">
    <h2>How This Commercial Invoice Generator Works</h2>
    <p>
      Choose Simple mode for a quick commercial invoice or Professional mode for export details such as shipment information, HS codes, declaration, signature, and barcode. Totals update automatically.
    </p>
  </article>

  <article class="content-card" slot="guide">
    <h2>When to Use It</h2>
    <p>
      Use Simple mode for quick invoices and Professional mode for export shipments, customs support, B2B trade records, and formal declarations of goods and values.
    </p>
  </article>

  <article class="content-card" slot="guide">
    <h2>Why It Helps</h2>
    <p>
      A structured commercial invoice improves shipment clarity, supports customs workflows, and makes it easier
      to print or save a professional trade document without extra formatting work.
    </p>
  </article>

  <style is:global>
    :root:not([data-commercial-invoice-mode]) .professional-only,
    html[data-commercial-invoice-mode="simple"] .professional-only {
      display: none !important;
    }

    .action-bar-mode-control {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      min-height: 36px;
      padding: 0;
      font-size: 13px;
      font-weight: 750;
      line-height: 1;
    }

    .mode-action-label {
      font-size: 13px;
      font-weight: 750;
      color: #6b7280;
      white-space: nowrap;
    }

    .mode-toggle {
      display: inline-flex;
      align-items: center;
      padding: 4px;
      border: 1px solid #d9e2ee;
      border-radius: 999px;
      background: #eef3f8;
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.8);
    }

    .mode-toggle-btn {
      min-width: 84px;
      height: 36px;
      padding: 0 12px;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: #6b7280;
      font-size: 13px;
      font-weight: 750;
      cursor: pointer;
      transition:
        background-color 0.15s ease,
        color 0.15s ease,
        box-shadow 0.15s ease;
    }

    .mode-toggle-btn.is-active {
      background: #2563eb;
      color: #ffffff;
      box-shadow: 0 6px 16px rgba(37, 99, 235, 0.22);
    }

    .mode-toggle-btn:not(.is-active):hover {
      color: #1e293b;
      background: rgba(255, 255, 255, 0.72);
    }

    .mobile-mode-control {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      width: 100%;
    }

    .mobile-mode-label {
      color: #64748b;
      font-size: 13px;
      font-weight: 750;
    }

    .package-fields-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .signature-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-top: 14px;
    }

    .signature-box {
      min-height: 72px;
      padding: 12px;
      border: 1px solid #cbd5e1;
      display: grid;
      align-content: end;
      gap: 8px;
    }

    .signature-box span {
      font-size: 9.5pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .signature-line {
