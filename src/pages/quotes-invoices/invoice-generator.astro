---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Faq from "../../components/tools/Faq.astro";
import RelatedTools from "../../components/tools/RelatedTools.astro";
import ToolGuide from "../../components/tools/ToolGuide.astro";
import { getBlankTemplateForTool } from "../../data/toolRelations";

const pageTitle = "Invoice Generator";
const pageDescription =
  "Create a professional invoice online with customer details, item lines, tax, discount, and print-ready totals. Print or save the final invoice as PDF.";
const canonical = "https://www.worowo.com/quotes-invoices/invoice-generator/";
const blankTemplate = getBlankTemplateForTool("invoice_generator");

const faqItems = [
  {
    question: "Can I print the invoice or save it as PDF?",
    answer:
      "Yes. You can fill in the invoice directly in the document view, then print it or save it as PDF for billing, customer records, or internal use.",
  },
  {
    question: "Does this invoice generator calculate totals automatically?",
    answer:
      "Yes. Line amounts, subtotal, tax, discount, and grand total are calculated automatically as you edit the invoice.",
  },
  {
    question: "Who should use this invoice generator?",
    answer:
      "This tool is useful for freelancers, consultants, agencies, service businesses, and small companies that need a simple professional invoice without extra software.",
  },
];

const relatedTools = [
  {
    name: blankTemplate?.title || "Invoice Template",
    href: blankTemplate?.href || "/printable-templates/simple-invoice-template/",
    desc: "Use a printable invoice template when you need a handwritten or offline version.",
  },
  {
    name: "Packing List Generator",
    href: "/packing-shipping/packing-list-generator/",
    desc: "Create a clean packing list for shipments, carton details, and dispatch paperwork.",
  },
  {
    name: "Delivery Receipt Generator",
    href: "/packing-shipping/delivery-receipt-generator/",
    desc: "Generate a delivery receipt for handover confirmation and receiving records.",
  },
];
---

<BaseLayout
  title={`${pageTitle} | Worowo`}
  description={pageDescription}
  canonical={canonical}
>
  <main class="invoice-generator-page">
    <div class="invoice-generator-inner">
      <nav class="generator-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>></span>
        <a href="/quotes-invoices/">Quotes & Invoices</a>
        <span>></span>
        <span aria-current="page">Invoice Generator</span>
      </nav>

      <section class="generator-hero">
        <span class="generator-eyebrow">Quotes & Invoices</span>
        <h1 class="generator-title">{pageTitle}</h1>
        <p class="generator-description">{pageDescription}</p>
        {blankTemplate && (
          <div class="generator-hero-links">
            <a href={blankTemplate.href} class="generator-inline-link">
              Need a blank version for handwriting? View the {blankTemplate.title}.
            </a>
          </div>
        )}
      </section>

      <div class="document-toolbar">
        <div class="document-toolbar-left">
          <a href="/" class="brand-link">worowo</a>
        </div>

        <div class="document-toolbar-center">
          <a href="/quotes-invoices/" class="toolbar-link-btn">Back to Quotes & Invoices</a>
        </div>

        <div class="document-toolbar-right">
          <span class="toolbar-label">Paper Size</span>

          <div class="paper-toggle-group">
            <button type="button" class="toolbar-btn paper-toggle" data-paper="letter">
              US Letter
            </button>
            <button type="button" class="toolbar-btn paper-toggle is-active" data-paper="a4">
              A4
            </button>
          </div>

          <button type="button" class="toolbar-btn" id="resetBtn">Reset Form</button>
          <button type="button" class="toolbar-btn toolbar-btn-primary" id="printBtn">
            Print / Save as PDF
          </button>
        </div>
      </div>

      <section class="document-stage">
        <div class="document-stage-inner">
          <div id="invoice-document" class="invoice-document paper-a4">
            <div class="invoice-document-inner">
              <div class="doc-header">
                <div>
                  <div class="doc-title">INVOICE</div>
                  <div class="doc-subtitle">Billing document for products or services</div>
                </div>

                <div class="doc-meta">
                  <div class="field-row">
                    <span class="field-label">Invoice No.:</span>
                    <input id="invoiceNumber" class="doc-input inline-input" type="text" />
                  </div>
                  <div class="field-row">
                    <span class="field-label">Date:</span>
                    <input id="invoiceDate" class="doc-input inline-input" type="date" />
                  </div>
                  <div class="field-row">
                    <span class="field-label">Due Date:</span>
                    <input id="dueDate" class="doc-input inline-input" type="date" />
                  </div>
                </div>
              </div>

              <section class="doc-section">
                <div class="two-col">
                  <div class="box">
                    <h2 class="section-title">From</h2>
                    <div class="field-row field-row-block">
                      <span class="field-label">Business Name:</span>
                      <input id="sellerName" class="doc-input" type="text" />
                    </div>
                    <div class="field-row field-row-block">
                      <span class="field-label">Address:</span>
                      <textarea id="sellerAddress" class="doc-textarea compact-area" rows="2"></textarea>
                    </div>
                    <div class="field-row field-row-block">
                      <span class="field-label">Contact:</span>
                      <input id="sellerContact" class="doc-input" type="text" />
                    </div>
                  </div>

                  <div class="box">
                    <h2 class="section-title">Bill To</h2>
                    <div class="field-row field-row-block">
                      <span class="field-label">Client Name:</span>
                      <input id="buyerName" class="doc-input" type="text" />
                    </div>
                    <div class="field-row field-row-block">
                      <span class="field-label">Address:</span>
                      <textarea id="buyerAddress" class="doc-textarea compact-area" rows="2"></textarea>
                    </div>
                    <div class="field-row field-row-block">
                      <span class="field-label">Contact:</span>
                      <input id="buyerContact" class="doc-input" type="text" />
                    </div>
                  </div>
                </div>
              </section>

              <section class="doc-section">
                <div class="section-title-row">
                  <h2 class="section-title">Items</h2>
                  <button type="button" class="toolbar-btn add-item-inline-btn edit-only" id="addItemBtn">
                    Add Item
                  </button>
                </div>

                <table class="doc-table invoice-table">
                  <thead>
                    <tr>
                      <th style="width: 38%;">Description</th>
                      <th style="width: 11%;">Qty</th>
                      <th style="width: 16%;">Unit Price</th>
                      <th style="width: 11%;">Tax %</th>
                      <th style="width: 18%;">Amount</th>
                      <th class="edit-only" style="width: 6%;"></th>
                    </tr>
                  </thead>
                  <tbody id="itemsTableBody">
                    {Array.from({ length: 2 }, () => (
                      <tr class="item-row">
                        <td><input class="doc-input table-input item-description" type="text" /></td>
                        <td><input class="doc-input table-input item-qty" type="number" min="0" step="1" value="1" /></td>
                        <td><input class="doc-input table-input item-unit-price" type="number" min="0" step="0.01" value="0" /></td>
                        <td><input class="doc-input table-input item-tax-rate" type="number" min="0" step="0.01" value="0" /></td>
                        <td class="amount-cell"><span class="line-amount">$0.00</span></td>
                        <td class="edit-only action-cell">
                          <button type="button" class="remove-row-btn">×</button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </section>

              <section class="doc-section">
                <div class="two-col notes-totals-row">
                  <div class="box">
                    <h2 class="section-title">Notes</h2>
                    <textarea id="invoiceNotes" class="doc-textarea compact-remarks" rows="2"></textarea>
                  </div>

                  <div class="box totals-box">
                    <div class="field-row field-row-block">
                      <span class="field-label">Currency Symbol:</span>
                      <input id="currencySymbol" class="doc-input short-input" type="text" value="$" maxlength="4" />
                    </div>
                    <div class="field-row field-row-block">
                      <span class="field-label">Discount:</span>
                      <input id="discountValue" class="doc-input short-input" type="number" min="0" step="0.01" value="0" />
                    </div>

                    <div class="totals-panel">
                      <div class="total-row"><span>Subtotal</span><strong id="subtotalValue">$0.00</strong></div>
                      <div class="total-row"><span>Tax</span><strong id="taxValue">$0.00</strong></div>
                      <div class="total-row"><span>Discount</span><strong id="discountPreviewValue">$0.00</strong></div>
                      <div class="total-row total-row-grand"><span>Grand Total</span><strong id="grandTotalValue">$0.00</strong></div>
                    </div>
                  </div>
                </div>
              </section>
            </div>
          </div>
        </div>
      </section>

      <section class="generator-related-block">
        <RelatedTools tools={relatedTools} />
      </section>

      <section class="generator-seo-block">
        <ToolGuide title="How It Works & Use Cases">
          <article class="content-card">
            <h2>How This Invoice Generator Works</h2>
            <p>
              Fill in your business details, customer information, and invoice items directly on the document. The
              invoice stays print-ready while totals update automatically as you edit.
            </p>
          </article>

          <article class="content-card">
            <h2>When to Use It</h2>
            <p>
              Use this invoice generator for freelance work, agency projects, consulting services, product sales, and
              small business billing when you need a clean professional invoice quickly.
            </p>
          </article>

          <article class="content-card">
            <h2>Why It Helps</h2>
            <p>
              A structured invoice reduces formatting work, keeps customer billing clearer, and makes it easy to print
              or save a polished PDF without switching into spreadsheet software.
            </p>
          </article>
        </ToolGuide>
      </section>

      <section class="generator-faq-block">
        <Faq items={faqItems} />
      </section>
    </div>
  </main>

  <style is:global>
    .invoice-generator-page {
      background: #f8fafc;
    }

    .invoice-generator-inner {
      width: min(1280px, calc(100% - 32px));
      margin: 0 auto;
      padding: 40px 0 72px;
    }

    .generator-hero {
      margin-bottom: 24px;
    }

    .generator-breadcrumb {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
      color: #64748b;
      font-size: 14px;
      line-height: 1.4;
      font-weight: 600;
    }

    .generator-breadcrumb a {
      color: #64748b;
      text-decoration: none;
    }

    .generator-breadcrumb a:hover {
      color: #2563eb;
    }

    .generator-eyebrow {
      display: inline-block;
      margin-bottom: 10px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #2563eb;
    }

    .generator-title {
      margin: 0 0 14px;
      font-size: clamp(34px, 4vw, 52px);
      line-height: 1.08;
      letter-spacing: -0.03em;
      color: #0f172a;
    }

    .generator-description {
      max-width: 840px;
      margin: 0;
      font-size: 18px;
      line-height: 1.75;
      color: #475569;
    }

    .generator-hero-links {
      margin-top: 14px;
    }

    .generator-inline-link {
      display: inline-flex;
      align-items: center;
      color: #2563eb;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
    }

    .document-toolbar {
      position: sticky;
      top: 79px;
      z-index: 30;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 18px;
      padding: 14px 16px;
      margin-bottom: 22px;
      border: 1px solid #dbe3ee;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(8px);
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    }

    .document-toolbar-left {
      display: flex;
      align-items: center;
    }

    .document-toolbar-center {
      display: flex;
      justify-content: center;
    }

    .document-toolbar-right {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 10px;
    }

    .brand-link {
      color: #0f172a;
      text-decoration: none;
      font-size: 20px;
      font-weight: 800;
      letter-spacing: -0.05em;
      line-height: 1;
      white-space: nowrap;
    }

    .brand-link:hover {
      color: #2563eb;
    }

    .toolbar-link-btn,
    .toolbar-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      padding: 0 14px;
      border-radius: 10px;
      border: 1px solid #dbe3ee;
      background: #fff;
      color: #0f172a;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: 0.18s ease;
    }

    .toolbar-link-btn:hover,
    .toolbar-btn:hover {
      border-color: #94a3b8;
      background: #f8fafc;
    }

    .toolbar-btn-primary {
      background: #2563eb;
      border-color: #2563eb;
      color: #fff;
    }

    .toolbar-btn-primary:hover {
      background: #1d4ed8;
      border-color: #1d4ed8;
    }

    .toolbar-label {
      font-size: 14px;
      font-weight: 700;
      color: #475569;
      white-space: nowrap;
    }

    .paper-toggle-group {
      display: inline-flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .paper-toggle.is-active {
      background: #dbeafe;
      color: #1d4ed8;
      border-color: #93c5fd;
    }

    .document-stage {
      display: flex;
      justify-content: center;
    }

    .document-stage-inner {
      width: 100%;
      overflow: auto;
      padding: 4px 0 0;
    }

    .invoice-document {
      margin: 0 auto;
      background: #fff;
      border: 1px solid #cbd5e1;
      box-shadow: 0 16px 36px rgba(15, 23, 42, 0.12);
    }

    .invoice-document.paper-letter {
      width: 816px;
      min-height: 1056px;
    }

    .invoice-document.paper-a4 {
      width: 794px;
      min-height: 1123px;
    }

    .invoice-document-inner {
      padding: 54px 48px 48px;
      color: #111827;
      font-family: Arial, Helvetica, sans-serif;
    }

    .doc-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 24px;
      padding-bottom: 14px;
      border-bottom: 2px solid #cbd5e1;
    }

    .doc-title {
      font-size: 24px;
      font-weight: 700;
      letter-spacing: 0.06em;
    }

    .doc-subtitle {
      margin-top: 8px;
      color: #64748b;
      font-size: 12px;
      line-height: 1.5;
    }

    .doc-meta {
      min-width: 250px;
    }

    .doc-section {
      margin-top: 16px;
    }

    .section-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
    }

    .section-title {
      margin: 0;
      font-size: 11pt;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .box {
      border: 1px solid #cbd5e1;
      padding: 12px;
    }

    .field-row {
      display: flex;
      align-items: baseline;
      gap: 8px;
      min-height: 26px;
      font-size: 10pt;
      line-height: 1.45;
    }

    .field-row-block {
      display: grid;
      grid-template-columns: 1fr;
      gap: 6px;
      align-items: start;
      min-height: auto;
      margin-bottom: 10px;
    }

    .field-row-block:last-child {
      margin-bottom: 0;
    }

    .field-label {
      font-weight: 700;
      white-space: nowrap;
    }

    .doc-input,
    .doc-textarea {
      width: 100%;
      border: 1px solid transparent;
      border-radius: 8px;
      background: transparent;
      color: #0f172a;
      font: inherit;
      padding: 6px 8px;
      outline: none;
      transition: 0.18s ease;
    }

    .inline-input {
      padding: 2px 6px;
    }

    .short-input {
      max-width: 180px;
    }

    .doc-input:hover,
    .doc-textarea:hover {
      border-color: #dbe3ee;
      background: #f8fafc;
    }

    .doc-input:focus,
    .doc-textarea:focus {
      border-color: #93c5fd;
      background: #fff;
      box-shadow: 0 0 0 3px rgba(147, 197, 253, 0.22);
    }

    .doc-textarea {
      resize: vertical;
    }

    .compact-area,
    .compact-remarks {
      min-height: 64px;
    }

    .doc-table {
      width: 100%;
      border-collapse: collapse;
    }

    .doc-table th,
    .doc-table td {
      border: 1px solid #cbd5e1;
      padding: 7px 8px;
      font-size: 9.5pt;
      text-align: left;
      vertical-align: top;
    }

    .invoice-table td {
      height: 36px;
    }

    .table-input {
      padding: 4px 6px;
      min-height: 28px;
      border-radius: 6px;
    }

    .amount-cell {
      vertical-align: middle;
    }

    .line-amount {
      display: inline-block;
      font-weight: 700;
      color: #0f172a;
    }

    .action-cell {
      text-align: center;
      vertical-align: middle;
    }

    .remove-row-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border-radius: 999px;
      border: 1px solid #dbe3ee;
      background: #fff;
      color: #64748b;
      font-size: 16px;
      line-height: 1;
      cursor: pointer;
      transition: 0.18s ease;
    }

    .remove-row-btn:hover {
      border-color: #94a3b8;
      background: #f8fafc;
    }

    .add-item-inline-btn {
      min-height: 34px;
      padding: 0 12px;
      font-size: 13px;
    }

    .notes-totals-row {
      align-items: start;
    }

    .totals-box {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .totals-panel {
      margin-top: 6px;
      border: 1px solid #dbe3ee;
      padding: 12px;
    }

    .total-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 12px;
      padding: 4px 0;
      font-size: 9.5pt;
      color: #475569;
    }

    .total-row-grand {
      margin-top: 4px;
      padding-top: 8px;
      border-top: 1px solid #dbe3ee;
      color: #0f172a;
      font-weight: 700;
    }

    .generator-seo-block,
    .generator-faq-block,
    .generator-related-block {
      margin-top: 28px;
    }

    @media (max-width: 980px) {
      .document-toolbar {
        grid-template-columns: 1fr;
        gap: 12px;
      }

      .document-toolbar-left,
      .document-toolbar-center,
      .document-toolbar-right {
        justify-content: flex-start;
      }

    }

    @media (max-width: 760px) {
      .invoice-generator-inner {
        width: min(1280px, calc(100% - 24px));
        padding: 28px 0 56px;
      }

      .generator-breadcrumb {
        flex-wrap: wrap;
        gap: 8px;
      }

      .generator-description {
        font-size: 16px;
      }

      .two-col {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <style is:global>
    @media print {
      body * {
        visibility: hidden !important;
      }

      #invoice-document,
      #invoice-document * {
        visibility: visible !important;
      }

      .site-header,
      .site-footer,
      .document-toolbar,
      .remove-row-btn,
      .edit-only {
        display: none !important;
      }

      #invoice-document {
        position: absolute !important;
        left: 0 !important;
        top: 0 !important;
        margin: 0 !important;
        border: 0 !important;
        box-shadow: none !important;
        background: #fff !important;
      }

      .invoice-document.paper-letter,
      .invoice-document.paper-a4 {
        width: auto !important;
        min-height: auto !important;
      }

      .doc-input,
      .doc-textarea {
        border: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
        padding: 0 !important;
        border-radius: 0 !important;
        resize: none !important;
      }
    }
  </style>

  <script>
    const documentRoot = document.getElementById("invoice-document");
    const itemsTableBody = document.getElementById("itemsTableBody");
    const addItemBtn = document.getElementById("addItemBtn");
    const resetBtn = document.getElementById("resetBtn");
    const printBtn = document.getElementById("printBtn");
    const paperButtons = Array.from(document.querySelectorAll(".paper-toggle"));
    const currencyInput = document.getElementById("currencySymbol");
    const discountInput = document.getElementById("discountValue");

    function currencySymbol() {
      return currencyInput?.value?.trim() || "$";
    }

    function formatMoney(value) {
      return `${currencySymbol()}${value.toFixed(2)}`;
    }

    function toNumber(value) {
      const parsed = Number.parseFloat(value);
      return Number.isFinite(parsed) ? parsed : 0;
    }

    function recalcRowsAndTotals() {
      const rows = Array.from(itemsTableBody.querySelectorAll(".item-row"));
      let subtotal = 0;
      let taxTotal = 0;

      rows.forEach((row) => {
        const qty = toNumber(row.querySelector(".item-qty")?.value);
        const unitPrice = toNumber(row.querySelector(".item-unit-price")?.value);
        const taxRate = toNumber(row.querySelector(".item-tax-rate")?.value);
        const lineSubtotal = qty * unitPrice;
        const lineTax = (lineSubtotal * taxRate) / 100;
        subtotal += lineSubtotal;
        taxTotal += lineTax;
        const amount = row.querySelector(".line-amount");
        if (amount) amount.textContent = formatMoney(lineSubtotal);
      });

      const discount = toNumber(discountInput?.value);
      const grandTotal = Math.max(0, subtotal + taxTotal - discount);

      const subtotalValue = document.getElementById("subtotalValue");
      const taxValue = document.getElementById("taxValue");
      const discountPreviewValue = document.getElementById("discountPreviewValue");
      const grandTotalValue = document.getElementById("grandTotalValue");

      if (subtotalValue) subtotalValue.textContent = formatMoney(subtotal);
      if (taxValue) taxValue.textContent = formatMoney(taxTotal);
      if (discountPreviewValue) discountPreviewValue.textContent = formatMoney(discount);
      if (grandTotalValue) grandTotalValue.textContent = formatMoney(grandTotal);
    }

    function attachInputHandlers(scope = document) {
      scope.querySelectorAll(".item-qty, .item-unit-price, .item-tax-rate").forEach((input) => {
        if (input.dataset.bound === "1") return;
        input.dataset.bound = "1";
        input.addEventListener("input", recalcRowsAndTotals);
      });

      if (currencyInput && currencyInput.dataset.bound !== "1") {
        currencyInput.dataset.bound = "1";
        currencyInput.addEventListener("input", recalcRowsAndTotals);
      }

      if (discountInput && discountInput.dataset.bound !== "1") {
        discountInput.dataset.bound = "1";
        discountInput.addEventListener("input", recalcRowsAndTotals);
      }
    }

    function attachRemoveHandlers(scope = document) {
      scope.querySelectorAll(".remove-row-btn").forEach((btn) => {
        if (btn.dataset.bound === "1") return;
        btn.dataset.bound = "1";

        btn.addEventListener("click", () => {
          const rows = itemsTableBody.querySelectorAll(".item-row");
          if (rows.length <= 1) return;
          btn.closest(".item-row")?.remove();
          recalcRowsAndTotals();
        });
      });
    }

    function createItemRow() {
      const tr = document.createElement("tr");
      tr.className = "item-row";
      tr.innerHTML = `
        <td><input class="doc-input table-input item-description" type="text" /></td>
        <td><input class="doc-input table-input item-qty" type="number" min="0" step="1" value="1" /></td>
        <td><input class="doc-input table-input item-unit-price" type="number" min="0" step="0.01" value="0" /></td>
        <td><input class="doc-input table-input item-tax-rate" type="number" min="0" step="0.01" value="0" /></td>
        <td class="amount-cell"><span class="line-amount">${formatMoney(0)}</span></td>
        <td class="edit-only action-cell">
          <button type="button" class="remove-row-btn">×</button>
        </td>
      `;
      return tr;
    }

    function resetForm() {
      documentRoot.querySelectorAll("input").forEach((input) => {
        if (input.id === "currencySymbol") {
          input.value = "$";
        } else if (input.type === "number") {
          if (input.classList.contains("item-qty")) {
            input.value = "1";
          } else {
            input.value = "0";
          }
        } else {
          input.value = "";
        }
      });

      documentRoot.querySelectorAll("textarea").forEach((textarea) => {
        textarea.value = "";
      });

      itemsTableBody.innerHTML = "";
      itemsTableBody.appendChild(createItemRow());
      itemsTableBody.appendChild(createItemRow());
      attachRemoveHandlers(itemsTableBody);
      attachInputHandlers(itemsTableBody);
      applyPaper("a4");
      recalcRowsAndTotals();
    }

    function applyPaper(paper) {
      documentRoot.classList.remove("paper-letter", "paper-a4");
      documentRoot.classList.add(paper === "letter" ? "paper-letter" : "paper-a4");

      paperButtons.forEach((btn) => {
        btn.classList.toggle("is-active", btn.dataset.paper === paper);
      });

      const styleId = "invoice-print-page-rule";
      let styleTag = document.getElementById(styleId);

      if (!styleTag) {
        styleTag = document.createElement("style");
        styleTag.id = styleId;
        document.head.appendChild(styleTag);
      }

      if (paper === "letter") {
        styleTag.textContent =
          "@page { size: Letter portrait; margin: 0.7in 0.65in 0.7in 0.65in; }";
      } else {
        styleTag.textContent =
          "@page { size: A4 portrait; margin: 18mm 16mm 18mm 16mm; }";
      }
    }

    addItemBtn?.addEventListener("click", () => {
      itemsTableBody.appendChild(createItemRow());
      attachRemoveHandlers(itemsTableBody);
      attachInputHandlers(itemsTableBody);
      recalcRowsAndTotals();
    });

    resetBtn?.addEventListener("click", resetForm);

    paperButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        applyPaper(btn.dataset.paper || "a4");
      });
    });

    printBtn?.addEventListener("click", () => {
      window.print();
    });

    attachRemoveHandlers(document);
    attachInputHandlers(document);
    applyPaper("a4");
    recalcRowsAndTotals();
  </script>
</BaseLayout>
