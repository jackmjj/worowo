---
import DocumentGeneratorLayout from "../../components/document-generator/DocumentGeneratorLayout.astro";
import { getBlankTemplateForTool } from "../../data/toolRelations";

const pageTitle = "Invoice Generator";
const pageDescription =
  "Create a professional invoice online with customer details, item lines, tax, discount, and print-ready totals. Print or save the final invoice as PDF.";
const canonical = "https://www.worowo.com/quotes-invoices/invoice-generator/";
const blankTemplate = getBlankTemplateForTool("invoice_generator");

const faqItems = [
  {
    question: "Can I print the invoice or save it as PDF?",
    answer:
      "Yes. You can fill in the invoice directly in the document view, then print it or save it as PDF for billing, customer records, or internal use.",
  },
  {
    question: "Does this invoice generator calculate totals automatically?",
    answer:
      "Yes. Line amounts, subtotal, tax, discount, and grand total are calculated automatically as you edit the invoice.",
  },
  {
    question: "Who should use this invoice generator?",
    answer:
      "This tool is useful for freelancers, consultants, agencies, service businesses, and small companies that need a simple professional invoice without extra software.",
  },
];

const relatedTools = [
  {
    name: "Quote / Estimate Generator",
    href: "/quotes-invoices/quote-estimate-generator/",
    desc: "Create a quote or estimate before turning a job or order into an invoice.",
  },
  {
    name: "Proforma Invoice Generator",
    href: "/quotes-invoices/proforma-invoice-generator/",
    desc: "Prepare a preliminary invoice for customer review, payment reference, or trade planning.",
  },
  {
    name: "Commercial Invoice Generator",
    href: "/quotes-invoices/commercial-invoice-generator/",
    desc: "Create an export invoice with trade, customs, and shipment details.",
  },
  {
    name: "Purchase Order Generator",
    href: "/quotes-invoices/purchase-order-generator/",
    desc: "Prepare a purchase order for ordering goods or services from a supplier.",
  },
];
---

<DocumentGeneratorLayout
  config={{
    title: pageTitle,
    description: pageDescription,
    canonical,
    categoryName: "Quotes & Invoices",
    categoryHref: "/quotes-invoices/",
    breadcrumbCurrent: "Invoice Generator",
    backLabel: "Back to Quotes & Invoices",
    templateLink: blankTemplate
      ? {
          text: "Need a blank version for handwriting?",
          href: blankTemplate.href,
          label: `View the ${blankTemplate.title}.`,
        }
      : undefined,
  }}
  relatedTools={relatedTools}
  faqItems={faqItems}
>
  <div id="invoice-document" class="inline-document-root invoice-document paper-a4" slot="document">
    <div class="inline-document-inner invoice-document-inner">
              <div class="document-title-row">
                <input
                  id="invoiceLogoText"
                  class="document-logo-text"
                  type="text"
                  placeholder="Your Business Name"
                  aria-label="Business name or logo text"
                />

                <div class="document-title">INVOICE</div>
              </div>

              <div class="doc-header">
                <div>
                  <div class="doc-subtitle editor-hint no-print">Billing document for products or services</div>
                </div>

                <div class="doc-meta">
                  <div class="field-row">
                    <span class="field-label print-label">Invoice No.:</span>
                    <input id="invoiceNumber" class="doc-input inline-input" type="text" placeholder="Invoice No." />
                  </div>
                  <div class="field-row">
                    <span class="field-label print-label">Date:</span>
                    <input id="invoiceDate" class="doc-input inline-input" type="date" placeholder="Invoice Date" />
                  </div>
                  <div class="field-row">
                    <span class="field-label print-label">Due Date:</span>
                    <input id="dueDate" class="doc-input inline-input" type="date" placeholder="Due Date" />
                  </div>
                </div>
              </div>

              <section class="doc-section">
                <div class="two-col">
                  <div class="box">
                    <h2 class="section-title">From</h2>
                    <div class="field-row field-row-block">
                      <input id="sellerName" class="doc-input" type="text" placeholder="Business Name" />
                    </div>
                    <div class="field-row field-row-block">
                      <textarea id="sellerAddress" class="doc-textarea compact-area" rows="2" placeholder="Address"></textarea>
                    </div>
                    <div class="field-row field-row-block">
                      <input id="sellerContact" class="doc-input" type="text" placeholder="Email / Phone" />
                    </div>
                  </div>

                  <div class="box">
                    <h2 class="section-title">Bill To</h2>
                    <div class="field-row field-row-block">
                      <input id="buyerName" class="doc-input" type="text" placeholder="Client Name" />
                    </div>
                    <div class="field-row field-row-block">
                      <textarea id="buyerAddress" class="doc-textarea compact-area" rows="2" placeholder="Address"></textarea>
                    </div>
                    <div class="field-row field-row-block">
                      <input id="buyerContact" class="doc-input" type="text" placeholder="Email / Phone" />
                    </div>
                  </div>
                </div>
              </section>

              <section class="doc-section">
                <div class="items-section-header">
                  <h2 class="section-title">Items</h2>
                  <button type="button" id="addItemBtn" class="add-item-btn edit-only">
                    <span class="add-item-icon" aria-hidden="true">+</span>
                    <span>Add Item</span>
                  </button>
                </div>

                <table class="doc-table invoice-table">
                  <thead>
                    <tr>
                      <th style="width: 38%;">Description</th>
                      <th style="width: 11%;">Qty</th>
                      <th style="width: 16%;">Unit Price</th>
                      <th style="width: 11%;">Tax %</th>
                      <th style="width: 18%;">Amount</th>
                      <th class="edit-only" style="width: 6%;"></th>
                    </tr>
                  </thead>
                  <tbody id="itemsTableBody">
                    {Array.from({ length: 2 }, () => (
                      <tr class="item-row">
                        <td><input class="doc-input table-input item-description" type="text" /></td>
                        <td><input class="doc-input table-input item-qty" type="number" min="0" step="1" value="1" /></td>
                        <td><input class="doc-input table-input item-unit-price" type="number" min="0" step="0.01" value="0" data-clear-zero-on-focus="true" data-default-value="0" /></td>
                        <td><input class="doc-input table-input item-tax-rate" type="number" min="0" step="0.01" value="0" data-clear-zero-on-focus="true" data-default-value="0" /></td>
                        <td class="amount-cell"><span class="line-amount">$0.00</span></td>
                        <td class="edit-only action-cell">
                          <button type="button" class="item-delete-btn" aria-label="Remove item">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                              <path
                                d="M9 3h6l1 2h4v2H4V5h4l1-2zm1 6h2v8h-2V9zm4 0h2v8h-2V9zM7 9h2v8H7V9zm-1 12h12a2 2 0 0 0 2-2V7H4v12a2 2 0 0 0 2 2z"
                                fill="currentColor"
                              />
                            </svg>
                          </button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </section>

              <section class="doc-section">
                <div class="two-col notes-totals-row">
                  <div class="box">
                    <h2 class="section-title">Notes</h2>
                    <textarea id="invoiceNotes" class="doc-textarea compact-remarks" rows="2"></textarea>
                  </div>

                  <div class="box totals-box">
                    <div class="field-row field-row-block">
                      <span class="field-label print-label">Currency Symbol:</span>
                      <input id="currencySymbol" class="doc-input short-input" type="text" value="$" maxlength="4" placeholder="$" />
                    </div>
                    <div class="field-row field-row-block">
                      <span class="field-label print-label">Discount:</span>
                      <input id="discountValue" class="doc-input short-input" type="number" min="0" step="0.01" value="0" placeholder="Discount" data-clear-zero-on-focus="true" data-default-value="0" />
                    </div>

                    <div class="totals-panel">
                      <div class="total-row"><span>Subtotal</span><strong id="subtotalValue">$0.00</strong></div>
                      <div class="total-row"><span>Tax</span><strong id="taxValue">$0.00</strong></div>
                      <div class="total-row"><span>Discount</span><strong id="discountPreviewValue">$0.00</strong></div>
                      <div class="total-row total-row-grand"><span>Grand Total</span><strong id="grandTotalValue">$0.00</strong></div>
                    </div>
                  </div>
                </div>
              </section>
    </div>
  </div>

  <article class="content-card" slot="guide">
    <h2>How This Invoice Generator Works</h2>
    <p>
      Fill in your business details, customer information, and invoice items directly on the document. The invoice
      stays print-ready while totals update automatically as you edit.
    </p>
  </article>

  <article class="content-card" slot="guide">
    <h2>When to Use It</h2>
    <p>
      Use this invoice generator for freelance work, agency projects, consulting services, product sales, and small
      business billing when you need a clean professional invoice quickly.
    </p>
  </article>

  <article class="content-card" slot="guide">
    <h2>Why It Helps</h2>
    <p>
      A structured invoice reduces formatting work, keeps customer billing clearer, and makes it easy to print or save a
      polished PDF without switching into spreadsheet software.
    </p>
  </article>

  <style is:global>
    .invoice-generator-page {
      background: #f8fafc;
    }

    .invoice-generator-inner {
      width: min(1280px, calc(100% - 32px));
      margin: 0 auto;
      padding: 40px 0 72px;
    }

    .generator-hero {
      margin-bottom: 24px;
    }

    .generator-breadcrumb {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
      color: #64748b;
      font-size: 14px;
      line-height: 1.4;
      font-weight: 600;
    }

    .generator-breadcrumb a {
      color: #64748b;
      text-decoration: none;
    }

    .generator-breadcrumb a:hover {
      color: #2563eb;
    }

    .generator-eyebrow {
      display: inline-block;
      margin-bottom: 10px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #2563eb;
    }

    .generator-title {
      margin: 0 0 14px;
      font-size: clamp(34px, 4vw, 52px);
      line-height: 1.08;
      letter-spacing: -0.03em;
      color: #0f172a;
    }

    .generator-description {
      max-width: 840px;
      margin: 0;
      font-size: 18px;
      line-height: 1.75;
      color: #475569;
    }

    .generator-hero-links {
      margin-top: 14px;
    }

    .generator-inline-link {
      display: inline-flex;
      align-items: center;
      color: #2563eb;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
    }

    .invoice-action-bar {
      position: static;
      top: auto;
      z-index: auto;
      margin: 18px 0 20px;
      padding: 14px 16px;
      border: 1px solid #e5e7eb;
      border-radius: 18px;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      box-shadow: 0 12px 30px rgba(15, 23, 42, 0.05);
    }

    .invoice-action-bar__left {
      flex: 0 0 auto;
    }

    .invoice-action-bar__right {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 12px;
      flex-wrap: wrap;
    }

    .paper-size-group {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .paper-size-label {
      font-size: 13px;
      font-weight: 750;
      color: #6b7280;
      white-space: nowrap;
    }

    .paper-size-toggle {
      display: inline-flex;
      align-items: center;
      padding: 4px;
      border-radius: 999px;
      background: #f3f4f6;
    }

    .paper-btn {
      min-width: 84px;
      height: 34px;
      padding: 0 12px;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: #6b7280;
      font-size: 13px;
      font-weight: 750;
      cursor: pointer;
      transition:
        background-color 0.15s ease,
        color 0.15s ease,
        box-shadow 0.15s ease;
    }

    .paper-btn.is-active {
      background: #ffffff;
      color: #2563eb;
      box-shadow: 0 3px 10px rgba(15, 23, 42, 0.08);
    }

    .action-btn {
      min-height: 36px;
      padding: 0 14px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 750;
      line-height: 1;
      text-decoration: none;
      cursor: pointer;
      white-space: nowrap;
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease,
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }

    .action-btn-secondary {
      border: 1px solid #dbe3ef;
      background: #ffffff;
      color: #374151;
    }

    .action-btn-secondary:hover {
      border-color: #93c5fd;
      background: #eff6ff;
      color: #2563eb;
    }

    .action-btn-ghost {
      border: 1px solid #e5e7eb;
      background: #ffffff;
      color: #4b5563;
    }

    .action-btn-ghost:hover {
      border-color: #cbd5e1;
      background: #f8fafc;
      color: #111827;
    }

    .action-btn-primary {
      border: 1px solid #2563eb;
      background: #2563eb;
      color: #ffffff;
    }

    .action-btn-primary:hover {
      background: #1d4ed8;
      border-color: #1d4ed8;
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(37, 99, 235, 0.18);
    }

    .document-stage {
      display: flex;
      justify-content: center;
      padding: 10px 0 0;
    }

    .document-stage-inner {
      width: 100%;
      overflow: auto;
      padding: 12px 0 4px;
    }

    .invoice-document {
      margin: 0 auto;
      background: #fff;
      border: 1px solid rgba(203, 213, 225, 0.7);
      box-shadow:
        0 26px 70px rgba(15, 23, 42, 0.14),
        0 4px 18px rgba(15, 23, 42, 0.06);
    }

    .invoice-document.paper-letter {
      width: min(100%, 884px);
      min-height: 1144px;
    }

    .invoice-document.paper-a4 {
      width: min(100%, 860px);
      min-height: 1216px;
    }

    .invoice-document-inner {
      padding: 54px 48px 48px;
      color: #111827;
      font-family: Arial, Helvetica, sans-serif;
    }

    .invoice-title-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 24px;
      margin-bottom: 24px;
    }

    .invoice-logo-text {
      width: 100%;
      max-width: 360px;
      min-height: 54px;
      padding: 8px 12px;
      border: 2px dashed #d1d5db;
      border-radius: 14px;
      background: #ffffff;
      color: #111827;
      font-size: 34px;
      font-weight: 850;
      letter-spacing: -0.04em;
      line-height: 1.1;
      outline: none;
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        box-shadow 0.15s ease;
    }

    .invoice-logo-text::placeholder {
      color: #b6beca;
    }

    .invoice-logo-text:hover,
    .invoice-logo-text:focus {
      background-color: #fffbea;
      border-color: #2563eb;
      box-shadow:
        0 0 0 4px rgba(37, 99, 235, 0.22),
        0 6px 18px rgba(37, 99, 235, 0.1);
      outline: none;
    }

    .invoice-title {
      font-size: 34px;
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.04em;
      color: #111827;
      white-space: nowrap;
    }

    .doc-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 24px;
      padding-bottom: 14px;
      border-bottom: 2px solid #cbd5e1;
    }

    .doc-subtitle {
      margin-top: 0;
      color: #64748b;
      font-size: 12px;
      line-height: 1.5;
    }

    .doc-meta {
      min-width: 250px;
    }

    .doc-section {
      margin-top: 16px;
    }

    .items-section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 8px;
    }

    .items-section-header h2 {
      margin: 0;
      font-size: 12px;
      font-weight: 850;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #111827;
    }

    .section-title {
      margin: 0;
      font-size: 11pt;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .box {
      border: 1px solid #cbd5e1;
      padding: 12px;
    }

    .field-row {
      display: flex;
      align-items: baseline;
      gap: 8px;
      min-height: 26px;
      font-size: 10pt;
      line-height: 1.45;
    }

    .field-row-block {
      display: grid;
      grid-template-columns: 1fr;
      gap: 6px;
      align-items: start;
      min-height: auto;
      margin-bottom: 10px;
    }

    .field-row-block:last-child {
      margin-bottom: 0;
    }

    .field-label {
      font-weight: 700;
      white-space: nowrap;
    }

    .doc-input,
    .doc-textarea {
      width: 100%;
      border: 1.5px dashed #e5e7eb;
      border-radius: 10px;
      background: #ffffff;
      color: #111827;
      font: inherit;
      padding: 9px 10px;
      outline: none;
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        box-shadow 0.15s ease;
    }

    .doc-input::placeholder,
    .doc-textarea::placeholder {
      color: #6b7280;
    }

    .inline-input {
      padding: 4px 8px;
    }

    .short-input {
      max-width: 180px;
    }

    .doc-input:hover,
    .doc-textarea:hover,
    .doc-input:focus,
    .doc-textarea:focus {
      background-color: #fffbea !important;
      border-color: #2563eb !important;
      box-shadow:
        0 0 0 4px rgba(37, 99, 235, 0.22),
        0 6px 18px rgba(37, 99, 235, 0.1) !important;
      outline: none;
    }

    .doc-textarea {
      resize: vertical;
    }

    .compact-area,
    .compact-remarks {
      min-height: 64px;
    }

    .doc-table {
      width: 100%;
      border-collapse: collapse;
    }

    .doc-table th,
    .doc-table td {
      border: 1px solid #cbd5e1;
      padding: 7px 8px;
      font-size: 9.5pt;
      text-align: left;
      vertical-align: top;
    }

    .invoice-table td {
      height: 36px;
    }

    .table-input {
      border: 1px solid transparent;
      border-radius: 8px;
      background: transparent;
      padding: 8px;
      min-height: 28px;
    }

    .table-input:hover,
    .table-input:focus {
      background-color: #fffbea !important;
      border-color: #2563eb !important;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.18) !important;
      outline: none;
    }

    .amount-cell {
      vertical-align: middle;
    }

    .line-amount {
      display: inline-block;
      font-weight: 700;
      color: #0f172a;
    }

    .action-cell {
      text-align: center;
      vertical-align: middle;
    }

    .item-delete-btn {
      width: 34px;
      height: 34px;
      min-width: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #f9a8d4;
      border-radius: 10px;
      background: #fdf2f8;
      color: #db2777;
      cursor: pointer;
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease,
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }

    .item-delete-btn svg {
      width: 16px;
      height: 16px;
      display: block;
    }

    .item-delete-btn:hover {
      background: #fce7f3;
      border-color: #f472b6;
      color: #be185d;
      transform: translateY(-1px);
      box-shadow: 0 8px 20px rgba(219, 39, 119, 0.12);
    }

    .item-delete-btn:focus-visible {
      outline: none;
      box-shadow: 0 0 0 4px rgba(244, 114, 182, 0.22);
    }

    .add-item-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 36px;
      padding: 0 14px;
      border: 1px solid #93c5fd;
      border-radius: 999px;
      background: #eff6ff;
      color: #2563eb;
      font-size: 13px;
      font-weight: 800;
      line-height: 1;
      cursor: pointer;
      white-space: nowrap;
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease,
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }

    .add-item-btn:hover {
      background: #dbeafe;
      border-color: #60a5fa;
      color: #1d4ed8;
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(37, 99, 235, 0.12);
    }

    .add-item-btn:focus-visible {
      outline: none;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.2);
    }

    .add-item-icon {
      width: 18px;
      height: 18px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #2563eb;
      color: #ffffff;
      font-size: 14px;
      line-height: 1;
      font-weight: 900;
    }

    .notes-totals-row {
      align-items: start;
    }

    .totals-box {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .totals-panel {
      margin-top: 6px;
      border: 1px solid #dbe3ee;
      padding: 12px;
    }

    .total-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 12px;
      padding: 4px 0;
      font-size: 9.5pt;
      color: #475569;
    }

    .total-row-grand {
      margin-top: 4px;
      padding-top: 8px;
      border-top: 1px solid #dbe3ee;
      color: #0f172a;
      font-weight: 700;
    }

    .generator-related-block {
      margin: 44px calc(50% - 50vw) 0;
      padding: 38px max(16px, calc((100vw - 1280px) / 2 + 16px)) 10px;
      border-top: 1px solid #e5e7eb;
      border-bottom: 1px solid #e5e7eb;
      background: #f9fafb;
    }

    .generator-seo-block {
      margin: 0 calc(50% - 50vw);
      padding: 38px max(16px, calc((100vw - 1280px) / 2 + 16px)) 10px;
      background: #ffffff;
    }

    .generator-faq-block {
      margin: 0 calc(50% - 50vw);
      padding: 10px max(16px, calc((100vw - 1280px) / 2 + 16px)) 8px;
      background: #ffffff;
    }

    @media (max-width: 900px) {
      .invoice-action-bar {
        align-items: stretch;
        flex-direction: column;
      }

      .invoice-action-bar__left,
      .invoice-action-bar__right {
        width: 100%;
      }

      .invoice-action-bar__right {
        justify-content: flex-start;
      }
    }

    @media (max-width: 760px) {
      .invoice-generator-inner {
        width: min(1280px, calc(100% - 24px));
        padding: 28px 0 56px;
      }

      .generator-breadcrumb {
        flex-wrap: wrap;
        gap: 8px;
      }

      .generator-description {
        font-size: 16px;
      }

      .two-col {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .invoice-title-row {
        grid-template-columns: 1fr;
        gap: 12px;
      }

      .invoice-logo-text {
        max-width: none;
        font-size: 30px;
      }

      .invoice-title {
        font-size: 30px;
      }

      .invoice-action-bar {
        padding: 12px;
        border-radius: 16px;
      }

      .invoice-action-bar__right {
        gap: 10px;
      }

      .paper-size-group {
        width: 100%;
        align-items: flex-start;
        flex-direction: column;
        gap: 8px;
      }

      .paper-size-toggle {
        width: 100%;
      }

      .paper-btn {
        flex: 1 1 0;
        min-width: 0;
      }

      .action-btn {
        min-height: 38px;
      }
    }
  </style>

  <style is:global>
    @media print {
      .site-header,
      .site-footer,
      .generator-breadcrumb,
      .generator-hero,
      .generator-related-block,
      .generator-seo-block,
      .generator-faq-block,
      .no-print,
      .invoice-action-bar,
      .editor-hint,
      .doc-subtitle,
      .field-label:not(.print-label),
      .item-delete-btn,
      .edit-only {
        display: none !important;
      }

      #invoice-document {
        position: static !important;
        display: block !important;
        width: auto !important;
        max-width: none !important;
        height: auto !important;
        min-height: auto !important;
        margin: 0 !important;
        border: 0 !important;
        box-shadow: none !important;
        background: #fff !important;
        overflow: visible !important;
        break-after: auto;
        break-inside: avoid;
        page-break-after: auto;
        page-break-inside: avoid;
      }

      .invoice-document.paper-letter,
      .invoice-document.paper-a4 {
        width: auto !important;
        min-height: auto !important;
      }

      .doc-input,
      .doc-textarea {
        border: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
        padding: 0 !important;
        border-radius: 0 !important;
        resize: none !important;
      }

      .field-label.print-label {
        display: inline !important;
        font-weight: 700 !important;
        white-space: nowrap !important;
      }

      .invoice-logo-text {
        border-color: transparent !important;
        background: transparent !important;
        box-shadow: none !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
      }

      .invoice-logo-text::placeholder,
      .doc-input::placeholder,
      .doc-textarea::placeholder {
        color: transparent !important;
      }
    }
  </style>

  <script>
    const documentRoot = document.getElementById("invoice-document");
    const itemsTableBody = document.getElementById("itemsTableBody");
    const addItemBtn = document.getElementById("addItemBtn");
    const resetBtn = document.getElementById("resetFormBtn");
    const printBtn = document.getElementById("printDocumentBtn");
    const paperButtons = Array.from(document.querySelectorAll("[data-paper-size]"));
    const currencyInput = document.getElementById("currencySymbol");
    const discountInput = document.getElementById("discountValue");

    function currencySymbol() {
      return currencyInput?.value?.trim() || "$";
    }

    function formatMoney(value) {
      return `${currencySymbol()}${value.toFixed(2)}`;
    }

    function toNumber(value) {
      const parsed = Number.parseFloat(value);
      return Number.isFinite(parsed) ? parsed : 0;
    }

    function recalcRowsAndTotals() {
      const rows = Array.from(itemsTableBody.querySelectorAll(".item-row"));
      let subtotal = 0;
      let taxTotal = 0;

      rows.forEach((row) => {
        const qty = toNumber(row.querySelector(".item-qty")?.value);
        const unitPrice = toNumber(row.querySelector(".item-unit-price")?.value);
        const taxRate = toNumber(row.querySelector(".item-tax-rate")?.value);
        const lineSubtotal = qty * unitPrice;
        const lineTax = (lineSubtotal * taxRate) / 100;
        subtotal += lineSubtotal;
        taxTotal += lineTax;
        const amount = row.querySelector(".line-amount");
        if (amount) amount.textContent = formatMoney(lineSubtotal);
      });

      const discount = toNumber(discountInput?.value);
      const grandTotal = Math.max(0, subtotal + taxTotal - discount);

      const subtotalValue = document.getElementById("subtotalValue");
      const taxValue = document.getElementById("taxValue");
      const discountPreviewValue = document.getElementById("discountPreviewValue");
      const grandTotalValue = document.getElementById("grandTotalValue");

      if (subtotalValue) subtotalValue.textContent = formatMoney(subtotal);
      if (taxValue) taxValue.textContent = formatMoney(taxTotal);
      if (discountPreviewValue) discountPreviewValue.textContent = formatMoney(discount);
      if (grandTotalValue) grandTotalValue.textContent = formatMoney(grandTotal);
    }

    function attachInputHandlers(scope = document) {
      scope.querySelectorAll(".item-qty, .item-unit-price, .item-tax-rate").forEach((input) => {
        if (input.dataset.bound === "1") return;
        input.dataset.bound = "1";
        input.addEventListener("input", recalcRowsAndTotals);
      });

      if (currencyInput && currencyInput.dataset.bound !== "1") {
        currencyInput.dataset.bound = "1";
        currencyInput.addEventListener("input", recalcRowsAndTotals);
      }

      if (discountInput && discountInput.dataset.bound !== "1") {
        discountInput.dataset.bound = "1";
        discountInput.addEventListener("input", recalcRowsAndTotals);
      }
    }

    function attachRemoveHandlers(scope = document) {
      scope.querySelectorAll(".item-delete-btn").forEach((btn) => {
        if (btn.dataset.bound === "1") return;
        btn.dataset.bound = "1";

        btn.addEventListener("click", () => {
          const rows = itemsTableBody.querySelectorAll(".item-row");
          if (rows.length <= 1) return;
          btn.closest(".item-row")?.remove();
          recalcRowsAndTotals();
        });
      });
    }

    function createItemRow() {
      const tr = document.createElement("tr");
      tr.className = "item-row";
      tr.innerHTML = `
        <td><input class="doc-input table-input item-description" type="text" /></td>
        <td><input class="doc-input table-input item-qty" type="number" min="0" step="1" value="1" /></td>
        <td><input class="doc-input table-input item-unit-price" type="number" min="0" step="0.01" value="0" data-clear-zero-on-focus="true" data-default-value="0" /></td>
        <td><input class="doc-input table-input item-tax-rate" type="number" min="0" step="0.01" value="0" data-clear-zero-on-focus="true" data-default-value="0" /></td>
        <td class="amount-cell"><span class="line-amount">${formatMoney(0)}</span></td>
        <td class="edit-only action-cell">
          <button type="button" class="item-delete-btn" aria-label="Remove item">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M9 3h6l1 2h4v2H4V5h4l1-2zm1 6h2v8h-2V9zm4 0h2v8h-2V9zM7 9h2v8H7V9zm-1 12h12a2 2 0 0 0 2-2V7H4v12a2 2 0 0 0 2 2z"
                fill="currentColor"
              />
            </svg>
          </button>
        </td>
      `;
      return tr;
    }

    function resetForm() {
      documentRoot.querySelectorAll("input").forEach((input) => {
        if (input.id === "currencySymbol") {
          input.value = "$";
        } else if (input.type === "number") {
          if (input.classList.contains("item-qty")) {
            input.value = "1";
          } else {
            input.value = "0";
          }
        } else {
          input.value = "";
        }
      });

      documentRoot.querySelectorAll("textarea").forEach((textarea) => {
        textarea.value = "";
      });

      itemsTableBody.innerHTML = "";
      itemsTableBody.appendChild(createItemRow());
      itemsTableBody.appendChild(createItemRow());
      attachRemoveHandlers(itemsTableBody);
      attachInputHandlers(itemsTableBody);
      applyPaper("a4");
      recalcRowsAndTotals();
    }

    function applyPaper(paper) {
      documentRoot.classList.remove("paper-letter", "paper-a4");
      documentRoot.classList.add(paper === "letter" ? "paper-letter" : "paper-a4");

      paperButtons.forEach((btn) => {
        btn.classList.toggle("is-active", btn.dataset.paperSize === paper);
      });

      const styleId = "invoice-print-page-rule";
      let styleTag = document.getElementById(styleId);

      if (!styleTag) {
        styleTag = document.createElement("style");
        styleTag.id = styleId;
        document.head.appendChild(styleTag);
      }

      if (paper === "letter") {
        styleTag.textContent =
          "@page { size: Letter portrait; margin: 0.7in 0.65in 0.7in 0.65in; }";
      } else {
        styleTag.textContent =
          "@page { size: A4 portrait; margin: 18mm 16mm 18mm 16mm; }";
      }
    }

    addItemBtn?.addEventListener("click", () => {
      itemsTableBody.appendChild(createItemRow());
      attachRemoveHandlers(itemsTableBody);
      attachInputHandlers(itemsTableBody);
      recalcRowsAndTotals();
    });

    resetBtn?.addEventListener("click", resetForm);

    paperButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        applyPaper(btn.dataset.paperSize || "a4");
      });
    });

    printBtn?.addEventListener("click", () => {
      window.print();
    });

    attachRemoveHandlers(document);
    attachInputHandlers(document);
    applyPaper("a4");
    recalcRowsAndTotals();
  </script>
</DocumentGeneratorLayout>
