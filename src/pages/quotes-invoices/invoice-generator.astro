---
import DocumentGeneratorLayout from "../../components/document-generator/DocumentGeneratorLayout.astro";
import { commonCurrencyOptions } from "../../data/currencyOptions";
import { getBlankTemplateForTool, getRelatedToolsForTool } from "../../data/toolRelations";

const pageTitle = "Invoice Generator";
const pageDescription =
  "Create a professional invoice online with customer details, item lines, payment terms, payment instructions, tax, discount, barcode, and print-ready totals. Print or save the final invoice as PDF.";
const canonical = "https://www.worowo.com/quotes-invoices/invoice-generator/";
const blankTemplate = getBlankTemplateForTool("invoice_generator");

const faqItems = [
  {
    question: "Can I print the invoice or save it as PDF?",
    answer:
      "Yes. You can fill in the invoice directly in the document view, then print it or save it as PDF for billing, customer records, or internal use.",
  },
  {
    question: "Does this invoice generator calculate totals automatically?",
    answer:
      "Yes. Line amounts, subtotal, tax, discount, and grand total are calculated automatically as you edit the invoice.",
  },
  {
    question: "Who should use this invoice generator?",
    answer:
      "This tool is useful for freelancers, consultants, agencies, service businesses, and small companies that need a simple professional invoice without extra software.",
  },
];

const relatedTools = getRelatedToolsForTool("invoice_generator");
---

<DocumentGeneratorLayout
  config={{
    title: pageTitle,
    description: pageDescription,
    canonical,
    categoryName: "Quotes & Invoices",
    categoryHref: "/quotes-invoices/",
    breadcrumbCurrent: "Invoice Generator",
    backLabel: "Back to Quotes & Invoices",
    printHref: "#print",
    templateLink: blankTemplate
      ? {
          text: "Need a blank version for handwriting?",
          href: blankTemplate.href,
          label: `View the ${blankTemplate.title}.`,
        }
      : undefined,
  }}
  relatedTools={relatedTools}
  faqItems={faqItems}
>
  <div class="invoice-editor-shell inline-document-mobile-shell" slot="document">
    <div class="desktop-document-editor">
      <div id="invoice-document" class="inline-document-root invoice-document paper-a4">
        <div class="inline-document-inner invoice-document-inner">
          <div class="document-title-row">
            <input
              id="invoiceLogoText"
              class="document-logo-text"
              type="text"
              placeholder="Your Business Name"
              aria-label="Business name or logo text"
              data-field="businessName"
            />

            <div class="document-title">INVOICE</div>
          </div>

          <div class="doc-header">
            <div>
              <div class="doc-subtitle editor-hint no-print">Billing document for products or services</div>
              <div class="invoice-barcode-block" id="invoiceBarcodeBlock" hidden>
                <svg id="invoiceBarcode" aria-label="Invoice barcode"></svg>
                <span class="barcode-empty-text">Enter Invoice No.</span>
              </div>
            </div>

            <div class="doc-meta">
              <button type="button" class="barcode-action-btn no-print" id="toggleBarcodeBtn">
                <span class="barcode-action-icon" aria-hidden="true">▥</span>
                <span class="barcode-action-label">Show Barcode</span>
              </button>
              <div class="field-row">
                <span class="field-label print-label">Invoice No.:</span>
                <input id="invoiceNumber" class="doc-input inline-input" type="text" placeholder="Invoice No." data-field="invoiceNo" />
              </div>
              <div class="field-row">
                <span class="field-label print-label">Date:</span>
                <input id="invoiceDate" class="doc-input inline-input" type="date" placeholder="Invoice Date" data-field="invoiceDate" />
              </div>
              <div class="field-row">
                <span class="field-label print-label">Due Date:</span>
                <input id="dueDate" class="doc-input inline-input" type="date" placeholder="Due Date" data-field="dueDate" />
              </div>
            </div>
          </div>

          <section class="doc-section">
            <div class="two-col">
              <div class="box">
                <h2 class="section-title">From</h2>
                <div class="field-row field-row-block">
                  <input id="sellerName" class="doc-input" type="text" placeholder="Business Name" data-field="fromName" />
                </div>
                <div class="field-row field-row-block">
                  <textarea id="sellerAddress" class="doc-textarea compact-area" rows="2" placeholder="Address" data-field="fromAddress"></textarea>
                </div>
                <div class="field-row field-row-block">
                  <input id="sellerContact" class="doc-input" type="text" placeholder="Email / Phone" data-field="fromContact" />
                </div>
              </div>

              <div class="box">
                <h2 class="section-title">Bill To</h2>
                <div class="field-row field-row-block">
                  <input id="buyerName" class="doc-input" type="text" placeholder="Client Name" data-field="billToName" />
                </div>
                <div class="field-row field-row-block">
                  <textarea id="buyerAddress" class="doc-textarea compact-area" rows="2" placeholder="Address" data-field="billToAddress"></textarea>
                </div>
                <div class="field-row field-row-block">
                  <input id="buyerContact" class="doc-input" type="text" placeholder="Email / Phone" data-field="billToContact" />
                </div>
              </div>
            </div>
          </section>

          <section class="doc-section">
            <div class="items-section-header">
              <h2 class="section-title">Items</h2>
              <div class="items-actions">
                <label class="currency-control no-print">
                  <span class="currency-icon" aria-hidden="true">$</span>
                  <span class="currency-label">Currency</span>
                  <select id="currencyCode" class="currency-select" data-field="currencyCode">
                    {commonCurrencyOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                  </select>
                </label>
                <button type="button" id="addItemBtn" class="add-item-btn edit-only" data-add-item-trigger>
                  <span class="add-item-icon" aria-hidden="true">+</span>
                  <span>Add Item</span>
                </button>
              </div>
            </div>

            <table class="doc-table invoice-table">
              <thead>
                <tr>
                  <th style="width: 38%;">Description</th>
                  <th style="width: 11%;">Qty</th>
                  <th style="width: 16%;">Unit Price</th>
                  <th style="width: 11%;">Tax %</th>
                  <th style="width: 18%;">Amount</th>
                  <th class="edit-only" style="width: 6%;"></th>
                </tr>
              </thead>
              <tbody id="itemsTableBody"></tbody>
            </table>
          </section>

          <section class="doc-section">
            <div class="two-col notes-totals-row">
              <div class="box payment-notes-box">
                <h2 class="section-title">Payment & Notes</h2>
                <div class="field-row field-row-block">
                  <span class="field-label">Payment Terms:</span>
                  <input id="paymentTerms" class="doc-input" type="text" placeholder="e.g. Net 30, Due on receipt" data-field="paymentTerms" />
                </div>
                <div class="field-row field-row-block">
                  <span class="field-label">Payment Instructions:</span>
                  <textarea id="paymentInstructions" class="doc-textarea compact-payment" rows="2" placeholder="Bank transfer, PayPal, Stripe, check payable to..." data-field="paymentInstructions"></textarea>
                </div>
                <div class="field-row field-row-block">
                  <span class="field-label">Notes:</span>
                  <textarea id="invoiceNotes" class="doc-textarea compact-remarks" rows="2" data-field="notes"></textarea>
                </div>
              </div>

              <div class="box totals-box">
                <div class="field-row field-row-block">
                  <span class="field-label print-label">Discount:</span>
                  <input id="discountValue" class="doc-input short-input" type="number" min="0" step="0.01" value="0" placeholder="Discount" data-field="discount" data-clear-zero-on-focus="true" data-default-value="0" />
                </div>

                <div class="totals-panel">
                  <div class="total-row"><span>Subtotal</span><strong id="subtotalValue">USD 0.00</strong></div>
                  <div class="total-row"><span>Tax</span><strong id="taxValue">USD 0.00</strong></div>
                  <div class="total-row"><span>Discount</span><strong id="discountPreviewValue">USD 0.00</strong></div>
                  <div class="total-row total-row-grand"><span>Grand Total</span><output id="grandTotalValue" class="total-output">USD 0.00</output></div>
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>

    <div class="mobile-document-editor no-print">
      <div class="mobile-action-card">
        <a href="/quotes-invoices/" class="mobile-back-btn">Back to Quotes & Invoices</a>

        <div class="mobile-paper-size">
          <span class="mobile-paper-size-label">Paper Size</span>
          <div class="mobile-paper-toggle" aria-label="Paper size">
            <button type="button" class="paper-btn" data-paper-size="letter">US Letter</button>
            <button type="button" class="paper-btn is-active" data-paper-size="a4">A4</button>
          </div>
        </div>
      </div>

      <section class="mobile-form-card">
        <h2>Business & Invoice Info</h2>

        <input class="mobile-input mobile-logo-input" type="text" placeholder="Your Business Name" data-field="businessName" />
        <input class="mobile-input" type="text" placeholder="Invoice No." data-field="invoiceNo" />
        <button type="button" class="barcode-action-btn barcode-action-btn--mobile" data-mobile-barcode-toggle>
          <span class="barcode-action-icon" aria-hidden="true">▥</span>
          <span class="barcode-action-label">Show Barcode</span>
        </button>
        <input class="mobile-input" type="date" data-field="invoiceDate" />
        <input class="mobile-input" type="date" data-field="dueDate" />
      </section>

      <section class="mobile-form-card">
        <h2>From</h2>

        <input class="mobile-input" type="text" placeholder="Business Name" data-field="fromName" />
        <textarea class="mobile-textarea" placeholder="Address" data-field="fromAddress"></textarea>
        <input class="mobile-input" type="text" placeholder="Email / Phone" data-field="fromContact" />
      </section>

      <section class="mobile-form-card">
        <h2>Bill To</h2>

        <input class="mobile-input" type="text" placeholder="Client Name" data-field="billToName" />
        <textarea class="mobile-textarea" placeholder="Address" data-field="billToAddress"></textarea>
        <input class="mobile-input" type="text" placeholder="Email / Phone" data-field="billToContact" />
      </section>

      <section class="mobile-form-card">
        <div class="mobile-section-header">
          <h2>Items</h2>
          <div class="items-actions items-actions--mobile">
            <label class="currency-control">
              <span class="currency-icon" aria-hidden="true">$</span>
              <span class="currency-label">Currency</span>
              <select class="mobile-select currency-select" data-field="currencyCode">
                {commonCurrencyOptions.map((option) => <option value={option.value}>{option.label}</option>)}
              </select>
            </label>
            <button type="button" class="mobile-add-item-btn" data-add-item-trigger>+ Add Item</button>
          </div>
        </div>

        <div id="mobileItemsList" class="mobile-items-list"></div>
      </section>

      <section class="mobile-form-card">
        <h2>Notes & Totals</h2>

        <input class="mobile-input" type="text" placeholder="Payment Terms" data-field="paymentTerms" />
        <textarea class="mobile-textarea" placeholder="Payment Instructions" data-field="paymentInstructions"></textarea>
        <textarea class="mobile-textarea" placeholder="Notes" data-field="notes"></textarea>

        <input class="mobile-input" type="number" placeholder="Discount" data-field="discount" data-clear-zero-on-focus="true" data-default-value="0" />

        <div class="mobile-total-card">
          <div><span>Subtotal</span><strong id="mobileSubtotalValue">USD 0.00</strong></div>
          <div><span>Tax</span><strong id="mobileTaxValue">USD 0.00</strong></div>
          <div><span>Discount</span><strong id="mobileDiscountPreviewValue">USD 0.00</strong></div>
          <div class="grand-total"><span>Grand Total</span><output id="mobileGrandTotalValue" class="total-output">USD 0.00</output></div>
        </div>
      </section>
    </div>

    <div id="invoice-print-document" class="print-document invoice-print-document">
      <div class="invoice-document-inner">
        <div class="document-title-row">
          <div class="print-logo-text" data-print-field="businessName"></div>
          <div class="document-title">INVOICE</div>
        </div>

        <div class="doc-header">
          <div></div>

          <div class="doc-meta">
            <div class="field-row">
              <span class="field-label print-label">Invoice No.:</span>
              <span class="print-inline-value" data-print-field="invoiceNo"></span>
            </div>
            <div class="field-row">
              <span class="field-label print-label">Date:</span>
              <span class="print-inline-value" data-print-field="invoiceDate"></span>
            </div>
            <div class="field-row">
              <span class="field-label print-label">Due Date:</span>
              <span class="print-inline-value" data-print-field="dueDate"></span>
            </div>
          </div>
        </div>

        <section class="doc-section">
          <div class="two-col">
            <div class="box">
              <h2 class="section-title">From</h2>
              <div class="print-block-lines">
                <div data-print-field="fromName"></div>
                <div data-print-field="fromAddress"></div>
                <div data-print-field="fromContact"></div>
              </div>
            </div>

            <div class="box">
              <h2 class="section-title">Bill To</h2>
              <div class="print-block-lines">
                <div data-print-field="billToName"></div>
                <div data-print-field="billToAddress"></div>
                <div data-print-field="billToContact"></div>
              </div>
            </div>
          </div>
        </section>

        <section class="doc-section">
          <div class="items-section-header">
            <h2 class="section-title">Items</h2>
          </div>

          <table class="doc-table invoice-table">
            <thead>
              <tr>
                <th style="width: 38%;">Description</th>
                <th style="width: 11%;">Qty</th>
                <th style="width: 16%;">Unit Price</th>
                <th style="width: 11%;">Tax %</th>
                <th style="width: 18%;">Amount</th>
              </tr>
            </thead>
            <tbody id="printItemsTableBody"></tbody>
          </table>
        </section>

        <section class="doc-section">
          <div class="two-col notes-totals-row">
            <div class="box">
              <h2 class="section-title">Payment & Notes</h2>
              <div class="print-block-lines">
                <div><strong>Payment Terms:</strong> <span data-print-field="paymentTerms"></span></div>
                <div><strong>Payment Instructions:</strong></div>
                <div class="print-multiline" data-print-field="paymentInstructions"></div>
                <div><strong>Notes:</strong></div>
                <div class="print-multiline" data-print-field="notes"></div>
              </div>
            </div>

            <div class="box totals-box">
              <div class="field-row">
                <span class="field-label print-label">Discount:</span>
                <span class="print-inline-value" id="printDiscountFieldValue"></span>
              </div>

              <div class="totals-panel">
                <div class="total-row"><span>Subtotal</span><strong id="printSubtotalValue">USD 0.00</strong></div>
                <div class="total-row"><span>Tax</span><strong id="printTaxValue">USD 0.00</strong></div>
                <div class="total-row"><span>Discount</span><strong id="printDiscountPreviewValue">USD 0.00</strong></div>
                <div class="total-row total-row-grand"><span>Grand Total</span><strong id="printGrandTotalValue">USD 0.00</strong></div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>

    <div class="mobile-bottom-action-bar no-print">
      <button type="button" class="mobile-reset-btn" data-reset-form-trigger>
        <span class="reset-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path d="M12 5a7 7 0 1 1-6.67 9.12 1 1 0 1 1 1.91-.59A5 5 0 1 0 8.1 8.3H11a1 1 0 1 1 0 2H5a1 1 0 0 1-1-1V3a1 1 0 1 1 2 0v3.32A8.97 8.97 0 0 1 12 5z" fill="currentColor"></path>
          </svg>
        </span>
        <span>Reset</span>
      </button>

      <a href="#print" class="mobile-print-btn" data-print-document title="Generate and download professional PDF invoice" aria-label="Generate and download professional PDF invoice">
        <svg class="mobile-print-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M7 2h8l5 5v3h-2V8h-4V4H7v6H5V4a2 2 0 0 1 2-2z" fill="currentColor"></path>
          <path d="M6 12h12a3 3 0 0 1 3 3v4h-4v3H7v-3H3v-4a3 3 0 0 1 3-3zm3 8h6v-4H9v4z" fill="currentColor"></path>
          <path d="M16 9h3v3h-3z" fill="currentColor"></path>
        </svg>
        <span>Print / Save as PDF</span>
      </a>

      <p class="mobile-privacy-note">
        Private and secure. Data stays in your browser.
      </p>
    </div>
  </div>

  <article class="content-card" slot="guide">
    <h2>How This Invoice Generator Works</h2>
    <p>
      Fill in your business details, customer information, and invoice items directly on the document. The invoice
      stays print-ready while totals update automatically as you edit.
    </p>
  </article>

  <article class="content-card" slot="guide">
    <h2>When to Use It</h2>
    <p>
      Use this invoice generator for freelance work, agency projects, consulting services, product sales, and small
      business billing when you need a clean professional invoice quickly.
    </p>
  </article>

  <article class="content-card" slot="guide">
    <h2>Why It Helps</h2>
    <p>
      A structured invoice reduces formatting work, keeps customer billing clearer, and makes it easy to print or save a
      polished PDF without switching into spreadsheet software.
    </p>
  </article>

  <style is:global>
    .invoice-generator-page {
      background: #f8fafc;
    }

    .invoice-generator-inner {
      width: min(1280px, calc(100% - 32px));
      margin: 0 auto;
      padding: 40px 0 72px;
    }

    .generator-hero {
      margin-bottom: 24px;
    }

    .generator-breadcrumb {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
      color: #64748b;
      font-size: 14px;
      line-height: 1.4;
      font-weight: 600;
    }

    .generator-breadcrumb a {
      color: #64748b;
      text-decoration: none;
    }

    .generator-breadcrumb a:hover {
      color: #2563eb;
    }

    .generator-eyebrow {
      display: inline-block;
      margin-bottom: 10px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #2563eb;
    }

    .generator-title {
      margin: 0 0 14px;
      font-size: clamp(34px, 4vw, 52px);
      line-height: 1.08;
      letter-spacing: -0.03em;
      color: #0f172a;
    }

    .generator-description {
      max-width: 840px;
      margin: 0;
      font-size: 18px;
      line-height: 1.75;
      color: #475569;
    }

    .generator-hero-links {
      margin-top: 14px;
    }

    .generator-inline-link {
      display: inline-flex;
      align-items: center;
      color: #2563eb;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
    }

    .invoice-action-bar {
      position: static;
      top: auto;
      z-index: auto;
      margin: 18px 0 20px;
      padding: 14px 16px;
      border: 1px solid #dbe4ef;
      border-radius: 16px;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      box-shadow: 0 14px 34px rgba(15, 23, 42, 0.06);
    }

    .invoice-action-bar__left {
      flex: 0 0 auto;
    }

    .invoice-action-bar__right {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 12px;
      flex-wrap: wrap;
    }

    .paper-size-group {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .paper-size-label {
      font-size: 13px;
      font-weight: 750;
      color: #6b7280;
      white-space: nowrap;
    }

    .paper-size-toggle {
      display: inline-flex;
      align-items: center;
      padding: 4px;
      border: 1px solid #d9e2ee;
      border-radius: 999px;
      background: #eef3f8;
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.8);
    }

    .paper-btn {
      min-width: 84px;
      height: 36px;
      padding: 0 12px;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: #6b7280;
      font-size: 13px;
      font-weight: 750;
      cursor: pointer;
      transition:
        background-color 0.15s ease,
        color 0.15s ease,
        box-shadow 0.15s ease;
    }

    .paper-btn.is-active {
      background: #2563eb;
      color: #ffffff;
      box-shadow: 0 6px 16px rgba(37, 99, 235, 0.22);
    }

    .paper-btn:not(.is-active):hover {
      color: #1e293b;
      background: rgba(255, 255, 255, 0.72);
    }

    .action-btn {
      min-height: 38px;
      padding: 0 14px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 800;
      line-height: 1;
      text-decoration: none;
      cursor: pointer;
      white-space: nowrap;
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease,
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }

    .action-btn__icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 14px;
      height: 14px;
      flex: 0 0 auto;
    }

    .action-btn__icon svg {
      width: 14px;
      height: 14px;
      display: block;
    }

    .action-btn-secondary {
      border: 1px solid #dbe3ef;
      background: #ffffff;
      color: #374151;
    }

    .action-btn-secondary:hover {
      border-color: #93c5fd;
      background: #eff6ff;
      color: #2563eb;
    }

    .action-btn-reset {
      border: 1px dashed #d7dce5;
      background: #ffffff;
      color: #6b7280;
    }

    .action-btn-reset:hover {
      border-color: #f59bb7;
      background: #fff8fb;
      color: #be185d;
    }

    .action-btn-primary {
      border: 1px solid #2563eb;
      background: #2563eb;
      color: #ffffff;
      box-shadow: 0 8px 18px rgba(37, 99, 235, 0.16);
    }

    .action-btn-primary:hover {
      background: #1d4ed8;
      border-color: #1d4ed8;
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(37, 99, 235, 0.18);
    }

    .document-stage {
      display: flex;
      justify-content: center;
      padding: 10px 0 0;
    }

    .document-stage-inner {
      width: 100%;
      overflow: auto;
      padding: 12px 0 4px;
    }

    .invoice-document {
      margin: 0 auto;
      background: #fff;
      border: 1px solid rgba(203, 213, 225, 0.7);
      box-shadow:
        0 34px 78px rgba(15, 23, 42, 0.12),
        0 10px 28px rgba(15, 23, 42, 0.08);
    }

    .invoice-document.paper-letter {
      width: min(100%, 884px);
      min-height: 1144px;
    }

    .invoice-document.paper-a4 {
      width: min(100%, 860px);
      min-height: 1216px;
    }

    .invoice-document-inner {
      padding: 54px 48px 48px;
      color: #111827;
      font-family: Arial, Helvetica, sans-serif;
    }

    .invoice-title-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 24px;
      margin-bottom: 24px;
    }

    .invoice-logo-text {
      width: 100%;
