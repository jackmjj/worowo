  <script>
    import JsBarcode from "jsbarcode";

    document.documentElement?.setAttribute("data-worowo-inline-script", "1");
    const documentRoot = document.getElementById("invoice-document");
    const itemsTableBody = document.getElementById("itemsTableBody");
    const mobileItemsList = document.getElementById("mobileItemsList");
    const printItemsTableBody = document.getElementById("printItemsTableBody");
    const barcodeBlock = document.getElementById("invoiceBarcodeBlock");
    const barcodeSvg = document.getElementById("invoiceBarcode");
    const barcodeToggleButtons = Array.from(document.querySelectorAll("#toggleBarcodeBtn, [data-mobile-barcode-toggle]"));
    const paperButtons = Array.from(document.querySelectorAll("[data-paper-size]"));
    const addItemTriggers = Array.from(document.querySelectorAll("[data-add-item-trigger]"));
    const resetTriggers = Array.from(document.querySelectorAll("[data-reset-form-trigger], #resetFormBtn"));
    const printTriggers = Array.from(document.querySelectorAll("[data-print-document]"));
    const syncFields = [
      "businessName",
      "invoiceNo",
      "invoiceDate",
      "dueDate",
      "fromName",
      "fromAddress",
      "fromContact",
      "billToName",
      "billToAddress",
      "billToContact",
      "paymentTerms",
      "paymentInstructions",
      "notes",
      "currencyCode",
      "discount",
    ];

    let nextItemId = 3;

    function updateNextItemId() {
      const numericIds = state.items
        .map((item) => Number.parseInt(String(item.id).replace("item-", ""), 10))
        .filter((value) => Number.isFinite(value));
      nextItemId = numericIds.length > 0 ? Math.max(...numericIds) + 1 : 1;
    }

    function defaultFields() {
      return {
        businessName: "",
        invoiceNo: "",
        invoiceDate: "",
        dueDate: "",
        fromName: "",
        fromAddress: "",
        fromContact: "",
        billToName: "",
        billToAddress: "",
        billToContact: "",
        paymentTerms: "",
        paymentInstructions: "",
        notes: "",
        currencyCode: "USD",
        discount: "0",
      };
    }

    function createItem() {
      return {
        id: `item-${nextItemId++}`,
        description: "",
        qty: "1",
        unitPrice: "0",
        taxRate: "0",
      };
    }

    const state = {
      paper: "a4",
      barcodeVisible: false,
      fields: defaultFields(),
      items: [createItem(), createItem()],
    };

    function toNumber(value) {
      const parsed = Number.parseFloat(value);
      return Number.isFinite(parsed) ? parsed : 0;
    }

    function currencyCode() {
      return state.fields.currencyCode.trim() || "USD";
    }

    function formatMoney(value) {
      return `${currencyCode()} ${value.toFixed(2)}`;
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
    }

    function renderInvoiceBarcode() {
      if (!barcodeBlock || !barcodeSvg) return;

      const value = state.fields.invoiceNo.trim();

      if (!state.barcodeVisible || !value) {
        barcodeBlock.hidden = true;
        barcodeSvg.innerHTML = "";
        barcodeToggleButtons.forEach((button) => {
          button.classList.toggle("is-active", false);
          const label = button.querySelector(".barcode-action-label");
          if (label) label.textContent = "Show Barcode";
        });
        return;
      }

      barcodeBlock.hidden = false;

      JsBarcode(barcodeSvg, value, {
        format: "CODE128",
        lineColor: "#111827",
        width: 1.1,
        height: 42,
        displayValue: false,
        margin: 0,
      });

      barcodeToggleButtons.forEach((button) => {
        button.classList.toggle("is-active", true);
        const label = button.querySelector(".barcode-action-label");
        if (label) label.textContent = "Hide Barcode";
      });
    }

    function toggleBarcode() {
      state.barcodeVisible = !state.barcodeVisible;
      renderInvoiceBarcode();
    }

    function calculateItemAmount(item) {
      return toNumber(item.qty) * toNumber(item.unitPrice);
    }

    function calculateTotals() {
      let subtotal = 0;
      let taxTotal = 0;

      state.items.forEach((item) => {
        const lineSubtotal = calculateItemAmount(item);
        subtotal += lineSubtotal;
        taxTotal += (lineSubtotal * toNumber(item.taxRate)) / 100;
      });

      const discount = toNumber(state.fields.discount);
      return {
        subtotal,
        taxTotal,
        discount,
        grandTotal: Math.max(0, subtotal + taxTotal - discount),
      };
    }

    function renderSharedFields() {
      syncFields.forEach((field) => {
        document.querySelectorAll(`[data-field="${field}"]`).forEach((input) => {
          if (input.value !== state.fields[field]) {
            input.value = state.fields[field];
          }
        });

        document.querySelectorAll(`[data-print-field="${field}"]`).forEach((node) => {
          node.textContent = state.fields[field];
        });
      });

      renderInvoiceBarcode();

      const printDiscountFieldValue = document.getElementById("printDiscountFieldValue");
      if (printDiscountFieldValue) {
        printDiscountFieldValue.textContent = formatMoney(toNumber(state.fields.discount));
      }
    }

    function desktopItemRow(item) {
      return `
        <tr class="item-row" data-item-id="${item.id}">
          <td><input class="doc-input table-input" type="text" data-item-id="${item.id}" data-item-field="description" value="${escapeHtml(item.description)}" /></td>
          <td><input class="doc-input table-input" type="number" min="0" step="1" data-item-id="${item.id}" data-item-field="qty" value="${escapeHtml(item.qty)}" /></td>
          <td><input class="doc-input table-input" type="number" min="0" step="0.01" data-item-id="${item.id}" data-item-field="unitPrice" value="${escapeHtml(item.unitPrice)}" data-clear-zero-on-focus="true" data-default-value="0" /></td>
          <td><input class="doc-input table-input" type="number" min="0" step="0.01" data-item-id="${item.id}" data-item-field="taxRate" value="${escapeHtml(item.taxRate)}" data-clear-zero-on-focus="true" data-default-value="0" /></td>
          <td class="amount-cell"><span class="line-amount" data-item-amount="${item.id}">${formatMoney(calculateItemAmount(item))}</span></td>
          <td class="edit-only action-cell">
            <button type="button" class="item-delete-btn" aria-label="Remove item" data-remove-item="${item.id}">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path
                  d="M9 3h6l1 2h4v2H4V5h4l1-2zm1 6h2v8h-2V9zm4 0h2v8h-2V9zM7 9h2v8H7V9zm-1 12h12a2 2 0 0 0 2-2V7H4v12a2 2 0 0 0 2 2z"
                  fill="currentColor"
                />
              </svg>
            </button>
          </td>
        </tr>
      `;
    }

    function mobileItemCard(item, index) {
      return `
        <article class="mobile-item-card" data-item-id="${item.id}">
          <div class="mobile-item-title">
            <strong>Item ${index + 1}</strong>
            <button type="button" class="mobile-delete-item-btn" aria-label="Remove item" data-remove-item="${item.id}">Delete</button>
          </div>

          <input class="mobile-input" type="text" placeholder="Description" data-item-id="${item.id}" data-item-field="description" value="${escapeHtml(item.description)}" />

          <div class="mobile-two-col">
            <input class="mobile-input" type="number" placeholder="Qty" min="0" step="1" data-item-id="${item.id}" data-item-field="qty" value="${escapeHtml(item.qty)}" />
            <input class="mobile-input" type="number" placeholder="Unit Price" min="0" step="0.01" data-item-id="${item.id}" data-item-field="unitPrice" value="${escapeHtml(item.unitPrice)}" data-clear-zero-on-focus="true" data-default-value="0" />
          </div>

          <div class="mobile-two-col">
            <input class="mobile-input" type="number" placeholder="Tax %" min="0" step="0.01" data-item-id="${item.id}" data-item-field="taxRate" value="${escapeHtml(item.taxRate)}" data-clear-zero-on-focus="true" data-default-value="0" />
            <div class="mobile-amount-box">
              <span>Amount</span>
              <strong data-item-amount="${item.id}">${formatMoney(calculateItemAmount(item))}</strong>
            </div>
          </div>
        </article>
      `;
    }

    function renderItems() {
      if (itemsTableBody) {
        itemsTableBody.innerHTML = state.items.map((item) => desktopItemRow(item)).join("");
      }

      if (mobileItemsList) {
        mobileItemsList.innerHTML = state.items.map((item, index) => mobileItemCard(item, index)).join("");
      }

      if (printItemsTableBody) {
        printItemsTableBody.innerHTML = state.items
          .map(
            (item) => `
              <tr>
                <td>${escapeHtml(item.description)}</td>
                <td>${escapeHtml(item.qty)}</td>
                <td>${formatMoney(toNumber(item.unitPrice))}</td>
                <td>${escapeHtml(item.taxRate)}</td>
                <td class="amount-cell"><span class="line-amount">${formatMoney(calculateItemAmount(item))}</span></td>
              </tr>
            `,
          )
          .join("");
      }
    }

    function renderTotals() {
      const totals = calculateTotals();

      document.querySelectorAll("[data-item-amount]").forEach((el) => {
        const item = state.items.find((entry) => entry.id === el.getAttribute("data-item-amount"));
        if (item) el.textContent = formatMoney(calculateItemAmount(item));
      });

      const totalTargets = {
        subtotalValue: totals.subtotal,
        taxValue: totals.taxTotal,
        discountPreviewValue: totals.discount,
        grandTotalValue: totals.grandTotal,
        mobileSubtotalValue: totals.subtotal,
        mobileTaxValue: totals.taxTotal,
        mobileDiscountPreviewValue: totals.discount,
        mobileGrandTotalValue: totals.grandTotal,
        printSubtotalValue: totals.subtotal,
        printTaxValue: totals.taxTotal,
        printDiscountPreviewValue: totals.discount,
        printGrandTotalValue: totals.grandTotal,
      };

      Object.entries(totalTargets).forEach(([id, value]) => {
        const element = document.getElementById(id);
        if (element) element.textContent = formatMoney(value);
      });
    }

    function applyPaper(paper) {
      state.paper = paper === "letter" ? "letter" : "a4";
      documentRoot.classList.remove("paper-letter", "paper-a4");
      documentRoot.classList.add(state.paper === "letter" ? "paper-letter" : "paper-a4");

      paperButtons.forEach((btn) => {
        btn.classList.toggle("is-active", btn.dataset.paperSize === state.paper);
      });

      const styleId = "invoice-print-page-rule";
      let styleTag = document.getElementById(styleId);

      if (!styleTag) {
        styleTag = document.createElement("style");
        styleTag.id = styleId;
        document.head.appendChild(styleTag);
      }

      styleTag.textContent =
        state.paper === "letter"
          ? "@page { size: Letter portrait; margin: 0.7in 0.65in 0.7in 0.65in; }"
          : "@page { size: A4 portrait; margin: 18mm 16mm 18mm 16mm; }";
    }

    function addItem() {
      state.items.push(createItem());
      renderItems();
      renderTotals();
    }

    function removeItem(itemId) {
      if (state.items.length <= 1) return;
      state.items = state.items.filter((item) => item.id !== itemId);
      renderItems();
      renderTotals();
    }

    function resetDocumentForm() {
      state.fields = defaultFields();
      state.barcodeVisible = false;
      state.items = [createItem(), createItem()];
      renderSharedFields();
      renderItems();
      applyPaper("a4");
      renderTotals();
    }

    function updateField(field, value, source) {
      state.fields[field] = value;

      document.querySelectorAll(`[data-field="${field}"]`).forEach((input) => {
        if (input !== source && input.value !== value) {
          input.value = value;
        }
      });

      if (field === "invoiceNo") {
        renderInvoiceBarcode();
      }

      renderTotals();
    }

    function updateItemField(itemId, field, value, source) {
      const item = state.items.find((entry) => entry.id === itemId);
      if (!item) return;
      item[field] = value;

      document.querySelectorAll(`[data-item-id="${itemId}"][data-item-field="${field}"]`).forEach((input) => {
        if (input !== source && input.value !== value) {
          input.value = value;
        }
      });

      renderTotals();
    }

    function handleDocumentPrint() {
      preparePrintState();
      document.body.classList.add("invoice-printing");

      window.setTimeout(() => {
        window.print();
      }, 60);
    }

    function onPrintTrigger(event) {
      event.preventDefault();
      event.stopPropagation();
      handleDocumentPrint();
    }

    function preparePrintState() {
      documentRoot.querySelectorAll("input, textarea").forEach((field) => {
        const value = field.value.trim();

        if (value !== "") {
          field.classList.remove("print-empty-field");
          return;
        }

        field.classList.add("print-empty-field");

        if (field.placeholder) {
          field.dataset.restorePlaceholder = field.placeholder;
          field.placeholder = "";
        }
      });
    }

    function restorePrintState() {
      document.body.classList.remove("invoice-printing");
      documentRoot.querySelectorAll(".print-empty-field").forEach((field) => {
        field.classList.remove("print-empty-field");

        if (field.dataset.restorePlaceholder) {
          field.placeholder = field.dataset.restorePlaceholder;
          delete field.dataset.restorePlaceholder;
        }
      });
    }

    window.addEventListener("beforeprint", preparePrintState);
    window.addEventListener("afterprint", restorePrintState);

    document.addEventListener("input", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement)) return;

      const field = target.dataset.field;
      if (field) {
        updateField(field, target.value, target);
        return;
      }

      const itemId = target.dataset.itemId;
      const itemField = target.dataset.itemField;

      if (itemId && itemField) {
        updateItemField(itemId, itemField, target.value, target);
      }
    });

    document.addEventListener("change", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLSelectElement)) return;
      const field = target.dataset.field;
      if (field) {
        updateField(field, target.value, target);
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const removeButton = target.closest("[data-remove-item]");
      if (removeButton) {
        removeItem(removeButton.getAttribute("data-remove-item"));
        return;
      }

      if (target.closest("[data-add-item-trigger]")) {
        addItem();
      }
    });

    resetTriggers.forEach((trigger) => {
      trigger.addEventListener("click", resetDocumentForm);
    });

    paperButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        applyPaper(btn.dataset.paperSize || "a4");
      });
    });

    barcodeToggleButtons.forEach((button) => {
      button.addEventListener("click", toggleBarcode);
    });

    printTriggers.forEach((trigger) => {
      trigger.addEventListener("click", onPrintTrigger);
    });

    window.handleDocumentPrint = handleDocumentPrint;
    renderSharedFields();
    renderItems();
    applyPaper(state.paper);
    renderInvoiceBarcode();
    renderTotals();
  </script>
</DocumentGeneratorLayout>
