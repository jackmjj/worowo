  <script>
    import JsBarcode from "jsbarcode";

    document.documentElement?.setAttribute("data-worowo-inline-script", "1");
    const documentRoot = document.getElementById("proforma-invoice-document");
    const itemsTableBody = document.getElementById("itemsTableBody");
    const mobileItemsList = document.getElementById("mobileItemsList");
    const barcodeBlock = document.getElementById("proformaBarcodeBlock");
    const barcodeSvg = document.getElementById("proformaInvoiceBarcode");
    const toggleBarcodeBtn = document.getElementById("toggleBarcodeBtn");
    const resetTriggers = Array.from(document.querySelectorAll("[data-reset-form-trigger], #resetFormBtn"));
    const printTriggers = Array.from(document.querySelectorAll("[data-print-document]"));
    const paperButtons = Array.from(document.querySelectorAll("[data-paper-size]"));

    const syncFields = [
      "logoText",
      "invoiceNumber",
      "invoiceDate",
      "validUntil",
      "currencyCode",
      "sellerName",
      "sellerAddress",
      "sellerContact",
      "buyerName",
      "buyerAddress",
      "buyerContact",
      "shipFrom",
      "portOfLoading",
      "leadTime",
      "deliveryTerms",
      "shipTo",
      "portOfDischarge",
      "incoterms",
      "shipmentMethod",
      "paymentTerms",
      "estimatedCharges",
      "depositRequired",
      "bankName",
      "accountName",
      "accountNumber",
      "swiftCode",
      "bankAddress",
      "preparedBy",
      "signature",
      "invoiceRemarks",
    ];

    let nextItemId = 3;

    function updateNextItemId() {
      const numericIds = state.items
        .map((item) => Number.parseInt(String(item.id).replace("item-", ""), 10))
        .filter((value) => Number.isFinite(value));
      nextItemId = numericIds.length > 0 ? Math.max(...numericIds) + 1 : 1;
    }

    function defaultFields() {
      return {
        logoText: "",
        invoiceNumber: "",
        invoiceDate: "",
        validUntil: "",
        currencyCode: "USD",
        sellerName: "",
        sellerAddress: "",
        sellerContact: "",
        buyerName: "",
        buyerAddress: "",
        buyerContact: "",
        shipFrom: "",
        portOfLoading: "",
        leadTime: "",
        deliveryTerms: "",
        shipTo: "",
        portOfDischarge: "",
        incoterms: "",
        shipmentMethod: "",
        paymentTerms: "",
        estimatedCharges: "0",
        depositRequired: "0",
        bankName: "",
        accountName: "",
        accountNumber: "",
        swiftCode: "",
        bankAddress: "",
        preparedBy: "",
        signature: "",
        invoiceRemarks: "",
      };
    }

    function createItem() {
      return {
        id: `item-${nextItemId++}`,
        description: "",
        itemCode: "",
        qty: "1",
        unit: "pcs",
        unitPrice: "0",
      };
    }

    const state = {
      paper: "a4",
      fields: defaultFields(),
      items: [createItem(), createItem()],
      barcodeVisible: false,
    };

    function toNumber(value) {
      const parsed = Number.parseFloat(value);
      return Number.isFinite(parsed) ? parsed : 0;
    }

    function currencyCode() {
      return state.fields.currencyCode.trim() || "USD";
    }

    function formatMoney(value) {
      return `${currencyCode()} ${value.toFixed(2)}`;
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
    }

    function lineAmounts(item) {
      const qty = toNumber(item.qty);
      const unitPrice = toNumber(item.unitPrice);
      const lineTotal = qty * unitPrice;
      return { lineTotal };
    }

    function calculateTotals() {
      let subtotal = 0;
      state.items.forEach((item) => {
        subtotal += lineAmounts(item).lineTotal;
      });
      const charges = toNumber(state.fields.estimatedCharges);
      const deposit = toNumber(state.fields.depositRequired);
      const grandTotal = subtotal + charges;
      const balanceDue = Math.max(grandTotal - deposit, 0);
      return { subtotal, charges, deposit, grandTotal, balanceDue };
    }

    function renderSharedFields() {
      syncFields.forEach((field) => {
        document.querySelectorAll(`[data-field="${field}"]`).forEach((input) => {
          const value = state.fields[field];
          if (input.value !== value) input.value = value;
        });
      });
    }

    function desktopItemRow(item) {
      const { lineTotal } = lineAmounts(item);
      return `
        <tr class="item-row" data-item-id="${item.id}">
          <td><input class="doc-input table-input item-description" type="text" data-item-id="${item.id}" data-item-field="description" value="${escapeHtml(item.description)}" /></td>
          <td><input class="doc-input table-input item-code" type="text" data-item-id="${item.id}" data-item-field="itemCode" value="${escapeHtml(item.itemCode)}" /></td>
          <td><input class="doc-input table-input item-qty" type="number" min="0" step="1" data-item-id="${item.id}" data-item-field="qty" value="${escapeHtml(item.qty)}" /></td>
          <td><input class="doc-input table-input item-unit" type="text" placeholder="pcs" data-item-id="${item.id}" data-item-field="unit" value="${escapeHtml(item.unit)}" /></td>
          <td><input class="doc-input table-input item-unit-price" type="number" min="0" step="0.01" data-item-id="${item.id}" data-item-field="unitPrice" value="${escapeHtml(item.unitPrice)}" data-clear-zero-on-focus="true" data-default-value="0" /></td>
          <td class="amount-cell"><span class="line-amount" data-item-line-total="${item.id}">${formatMoney(lineTotal)}</span></td>
          <td class="edit-only action-cell">
            <button type="button" class="item-delete-btn" aria-label="Remove item" data-remove-item="${item.id}">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path d="M9 3h6l1 2h4v2H4V5h4l1-2zm1 6h2v8h-2V9zm4 0h2v8h-2V9zM7 9h2v8H7V9zm-1 12h12a2 2 0 0 0 2-2V7H4v12a2 2 0 0 0 2 2z" fill="currentColor" />
              </svg>
            </button>
          </td>
        </tr>
      `;
    }

    function mobileItemCard(item, index) {
      const { lineTotal } = lineAmounts(item);
      return `
        <article class="mobile-item-card" data-item-id="${item.id}">
          <div class="mobile-item-title">
            <strong>Item ${index + 1}</strong>
            <button type="button" class="mobile-delete-item-btn" aria-label="Remove item" data-remove-item="${item.id}">Delete</button>
          </div>
          <input class="mobile-input" type="text" placeholder="Description" data-item-id="${item.id}" data-item-field="description" value="${escapeHtml(item.description)}" />
          <input class="mobile-input" type="text" placeholder="Item Code / SKU" data-item-id="${item.id}" data-item-field="itemCode" value="${escapeHtml(item.itemCode)}" />
          <div class="mobile-two-col">
            <input class="mobile-input" type="number" placeholder="Qty" min="0" step="1" data-item-id="${item.id}" data-item-field="qty" value="${escapeHtml(item.qty)}" />
            <input class="mobile-input" type="text" placeholder="Unit" data-item-id="${item.id}" data-item-field="unit" value="${escapeHtml(item.unit)}" />
          </div>
          <input class="mobile-input" type="number" placeholder="Unit Price" min="0" step="0.01" data-item-id="${item.id}" data-item-field="unitPrice" value="${escapeHtml(item.unitPrice)}" data-clear-zero-on-focus="true" data-default-value="0" />
          <div class="mobile-amount-box">
            <span>Amount</span>
            <strong data-item-line-total="${item.id}">${formatMoney(lineTotal)}</strong>
          </div>
        </article>
      `;
    }

    function renderItems() {
      updateNextItemId();
      if (itemsTableBody) {
        itemsTableBody.innerHTML = state.items.map((item) => desktopItemRow(item)).join("");
      }
      if (mobileItemsList) {
        mobileItemsList.innerHTML = state.items.map((item, index) => mobileItemCard(item, index)).join("");
      }
    }

    function renderTotals() {
      const { subtotal, charges, deposit, grandTotal, balanceDue } = calculateTotals();

      document.querySelectorAll("[data-item-line-total]").forEach((el) => {
        const id = el.getAttribute("data-item-line-total");
        const item = state.items.find((entry) => entry.id === id);
        if (item) el.textContent = formatMoney(lineAmounts(item).lineTotal);
      });

      const targets = {
        subtotalValue: subtotal,
        chargesValue: charges,
        grandTotalValue: grandTotal,
        depositValue: deposit,
        balanceDueValue: balanceDue,
        mobileSubtotalValue: subtotal,
        mobileChargesValue: charges,
        mobileGrandTotalValue: grandTotal,
        mobileDepositValue: deposit,
        mobileBalanceDueValue: balanceDue,
      };
      Object.entries(targets).forEach(([id, value]) => {
        const el = document.getElementById(id);
        if (el) el.textContent = formatMoney(value);
      });
    }

    function renderBarcode() {
      if (!(barcodeBlock instanceof HTMLElement) || !(barcodeSvg instanceof SVGElement)) return;

      const invoiceValue = state.fields.invoiceNumber.trim();
      const shouldShow = state.barcodeVisible;
      const canRenderBarcode = shouldShow && invoiceValue !== "";

      barcodeBlock.hidden = !shouldShow;
      barcodeBlock.toggleAttribute("data-barcode-visible", shouldShow);
      barcodeBlock.dataset.barcodeReady = canRenderBarcode ? "true" : "false";

      if (!shouldShow || !invoiceValue) {
        barcodeSvg.innerHTML = "";
        return;
      }

      try {
        JsBarcode(barcodeSvg, invoiceValue, {
          format: "CODE128",
          lineColor: "#111827",
          width: 1.1,
          height: 42,
          displayValue: false,
          margin: 0,
        });
      } catch (error) {
        console.error("Failed to render proforma invoice barcode", error);
        barcodeSvg.innerHTML = "";
        barcodeBlock.dataset.barcodeReady = "false";
      }
    }

    function applyPaper(paper) {
      state.paper = paper === "letter" ? "letter" : "a4";
      documentRoot.classList.remove("paper-letter", "paper-a4");
      documentRoot.classList.add(state.paper === "letter" ? "paper-letter" : "paper-a4");

      paperButtons.forEach((btn) => {
        btn.classList.toggle("is-active", btn.dataset.paperSize === state.paper);
      });

      const styleId = "proforma-invoice-print-page-rule";
      let styleTag = document.getElementById(styleId);

      if (!styleTag) {
        styleTag = document.createElement("style");
        styleTag.id = styleId;
        document.head.appendChild(styleTag);
      }

      styleTag.textContent =
        state.paper === "letter"
          ? "@page { size: Letter portrait; margin: 0.7in 0.65in 0.7in 0.65in; }"
          : "@page { size: A4 portrait; margin: 18mm 16mm 18mm 16mm; }";
    }

    function addItem() {
      state.items.push(createItem());
      renderItems();
      renderTotals();
    }

    function removeItem(itemId) {
      if (state.items.length <= 1) return;
      state.items = state.items.filter((item) => item.id !== itemId);
      renderItems();
      renderTotals();
    }

    function resetDocumentForm() {
      state.fields = defaultFields();
      state.items = [createItem(), createItem()];
      state.barcodeVisible = false;
      renderSharedFields();
      renderItems();
      applyPaper("a4");
      renderTotals();
      renderBarcode();
      if (toggleBarcodeBtn instanceof HTMLButtonElement) {
        toggleBarcodeBtn.classList.remove("is-active");
        const label = toggleBarcodeBtn.querySelector(".barcode-action-label");
        if (label) label.textContent = "Show Barcode";
      }
    }

    function updateField(field, value, source) {
      state.fields[field] = value;
      document.querySelectorAll(`[data-field="${field}"]`).forEach((input) => {
        if (input !== source && input.value !== value) {
          input.value = value;
        }
      });
      renderTotals();
      if (field === "invoiceNumber") renderBarcode();
    }

    function updateItemField(itemId, field, value, source) {
      const item = state.items.find((entry) => entry.id === itemId);
      if (!item) return;
      item[field] = value;
      document.querySelectorAll(`[data-item-id="${itemId}"][data-item-field="${field}"]`).forEach((input) => {
        if (input !== source && input.value !== value) {
          input.value = value;
        }
      });
      renderTotals();
    }

    function preparePrintState() {
      documentRoot.querySelectorAll("input, textarea").forEach((field) => {
        const value = field.value.trim();
        if (value !== "") {
          field.classList.remove("print-empty-field");
          return;
        }
        field.classList.add("print-empty-field");
        if (field.placeholder) {
          field.dataset.restorePlaceholder = field.placeholder;
          field.placeholder = "";
        }
      });
    }

    function restorePrintVisualState() {
      document.body.classList.remove("inline-doc-print-reveal");
      document.querySelectorAll(".print-hidden-section").forEach((section) => {
        section.classList.remove("print-hidden-section");
      });
      documentRoot.querySelectorAll(".print-empty-field").forEach((field) => {
        field.classList.remove("print-empty-field");
        if (field.dataset.restorePlaceholder) {
          field.placeholder = field.dataset.restorePlaceholder;
          delete field.dataset.restorePlaceholder;
        }
      });
    }

    function updateOptionalPrintSections() {
      document.querySelectorAll("[data-print-optional-section]").forEach((section) => {
        const fields = Array.from(section.querySelectorAll("input, textarea, select"));
        const hasValue = fields.some((field) => {
          const value = String(field.value || "").trim();
          return value !== "" && value !== "0" && value !== "0.00";
        });
        section.classList.toggle("print-hidden-section", !hasValue);
      });
    }

    function handleDocumentPrint() {
      preparePrintState();
      updateOptionalPrintSections();
      document.body.classList.add("inline-doc-print-reveal");
      window.setTimeout(() => window.print(), 60);
    }

    function onPrintTrigger(event) {
      event.preventDefault();
      event.stopPropagation();
      handleDocumentPrint();
    }

    window.addEventListener("afterprint", restorePrintVisualState);

    document.addEventListener("input", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement)) return;

      const field = target.dataset.field;
      if (field) {
        updateField(field, target.value, target);
        return;
      }

      const itemId = target.dataset.itemId;
      const itemField = target.dataset.itemField;
      if (itemId && itemField) {
        updateItemField(itemId, itemField, target.value, target);
      }
    });

    document.addEventListener("change", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLSelectElement)) return;
      const field = target.dataset.field;
      if (field) updateField(field, target.value, target);
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const removeButton = target.closest("[data-remove-item]");
      if (removeButton) {
        removeItem(removeButton.getAttribute("data-remove-item"));
        return;
      }

      if (target.closest("[data-add-item-trigger]")) {
        addItem();
      }
    });

    resetTriggers.forEach((trigger) => {
      trigger.addEventListener("click", resetDocumentForm);
    });

    if (toggleBarcodeBtn instanceof HTMLButtonElement) {
      toggleBarcodeBtn.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        state.barcodeVisible = !state.barcodeVisible;
        renderBarcode();
        toggleBarcodeBtn.classList.toggle("is-active", state.barcodeVisible);
        const label = toggleBarcodeBtn.querySelector(".barcode-action-label");
        if (label) {
          label.textContent = state.barcodeVisible ? "Hide Barcode" : "Show Barcode";
        }
      });
    }

    paperButtons.forEach((btn) => {
      btn.addEventListener("click", () => applyPaper(btn.dataset.paperSize || "a4"));
    });

    printTriggers.forEach((trigger) => {
      trigger.addEventListener("click", onPrintTrigger);
    });

    window.handleDocumentPrint = handleDocumentPrint;

    renderSharedFields();
    renderItems();
    applyPaper(state.paper);
    renderTotals();
    renderBarcode();
  </script>
</DocumentGeneratorLayout>
