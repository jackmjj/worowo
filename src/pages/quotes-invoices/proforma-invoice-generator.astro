---
import DocumentGeneratorLayout from "../../components/document-generator/DocumentGeneratorLayout.astro";
import { commonCurrencyOptions } from "../../data/currencyOptions";
import { getRelatedToolsForTool } from "../../data/toolRelations";

const pageTitle = "Proforma Invoice Generator";
const pageDescription =
  "Create a proforma invoice for payment reference, order confirmation, deposits, delivery terms, and trade documentation before final shipment. Print or save as PDF.";
const canonical = "https://www.worowo.com/quotes-invoices/proforma-invoice-generator/";

const faqItems = [
  {
    question: "What is a proforma invoice?",
    answer:
      "A proforma invoice is a preliminary sales document used to show estimated goods, prices, and shipment terms before final billing. It is commonly used for quotations, order confirmation, and trade preparation.",
  },
  {
    question: "Can I print the proforma invoice or save it as PDF?",
    answer:
      "Yes. You can fill in the proforma invoice directly in the document view, then print it or save it as PDF for customer review, banking support, or export preparation.",
  },
  {
    question: "How is this different from a commercial invoice?",
    answer:
      "A proforma invoice is usually issued before shipment or final billing and may include estimated values or payment terms. A commercial invoice is typically the final trade document used with the actual shipment.",
  },
];

const relatedTools = getRelatedToolsForTool("proforma_invoice_generator");
---

<DocumentGeneratorLayout
  config={{
    title: pageTitle,
    description: pageDescription,
    canonical,
    categoryName: "Quotes & Invoices",
    categoryHref: "/quotes-invoices/",
    breadcrumbCurrent: "Proforma Invoice Generator",
    backLabel: "Back to Quotes & Invoices",
    printHref: "#print",
  }}
  relatedTools={relatedTools}
  faqItems={faqItems}
>
  <div class="inline-document-mobile-shell" slot="document">
    <div class="desktop-document-editor">
      <div id="proforma-invoice-document" class="inline-document-root proforma-document paper-a4 proforma-sentinel">
        <div class="inline-document-inner proforma-document-inner">
          <div class="document-title-row">
            <input
              id="documentLogoText"
              class="document-logo-text"
              type="text"
              placeholder="Your Business Name"
              aria-label="Business name or logo text"
              data-field="logoText"
            />

            <div class="document-title">PROFORMA INVOICE</div>
          </div>

          <div class="doc-header">
            <div>
              <div class="doc-subtitle editor-hint no-print">Preliminary invoice for trade and payment reference</div>
            </div>

            <div class="doc-meta proforma-meta">
              <div class="proforma-meta-barcode-slot">
                <div class="proforma-barcode-block" id="proformaBarcodeBlock" hidden>
                  <svg id="proformaInvoiceBarcode" aria-label="Proforma invoice barcode"></svg>
                  <span class="proforma-barcode-empty">Enter Proforma No.</span>
                </div>
              </div>
              <div class="field-row proforma-meta-row proforma-meta-row-invoice">
                <button type="button" class="barcode-action-btn no-print" id="toggleBarcodeBtn">
                  <span class="barcode-action-icon" aria-hidden="true">▥</span>
                  <span class="barcode-action-label">Show Barcode</span>
                </button>
                <span class="field-label print-label">Proforma No.:</span>
                <input id="invoiceNumber" class="doc-input inline-input proforma-meta-input" type="text" maxlength="24" placeholder="Proforma No." data-field="invoiceNumber" />
              </div>
              <div class="field-row proforma-meta-row proforma-meta-row-date">
                <span class="proforma-meta-action-spacer no-print" aria-hidden="true"></span>
                <span class="field-label print-label">Date:</span>
                <input id="invoiceDate" class="doc-input inline-input proforma-meta-input" type="date" placeholder="Date" data-field="invoiceDate" />
              </div>
              <div class="field-row proforma-meta-row proforma-meta-row-valid">
                <span class="proforma-meta-action-spacer no-print" aria-hidden="true"></span>
                <span class="field-label print-label">Valid Until:</span>
                <input id="validUntil" class="doc-input inline-input proforma-meta-input" type="date" placeholder="Valid Until" data-field="validUntil" />
              </div>
            </div>
          </div>

          <section class="doc-section">
            <div class="two-col">
              <div class="box">
                <h2 class="section-title">Seller</h2>
                <div class="field-row field-row-block">
                  <input id="sellerName" class="doc-input" type="text" placeholder="Company Name" data-field="sellerName" />
                </div>
                <div class="field-row field-row-block">
                  <textarea id="sellerAddress" class="doc-textarea compact-area" rows="2" placeholder="Address" data-field="sellerAddress"></textarea>
                </div>
                <div class="field-row field-row-block">
                  <input id="sellerContact" class="doc-input" type="text" placeholder="Email / Phone" data-field="sellerContact" />
                </div>
              </div>

              <div class="box">
                <h2 class="section-title">Buyer</h2>
                <div class="field-row field-row-block">
                  <input id="buyerName" class="doc-input" type="text" placeholder="Company Name" data-field="buyerName" />
                </div>
                <div class="field-row field-row-block">
                  <textarea id="buyerAddress" class="doc-textarea compact-area" rows="2" placeholder="Address" data-field="buyerAddress"></textarea>
                </div>
                <div class="field-row field-row-block">
                  <input id="buyerContact" class="doc-input" type="text" placeholder="Email / Phone" data-field="buyerContact" />
                </div>
              </div>
            </div>
          </section>

          <section class="doc-section">
            <h2 class="section-title">Payment & Delivery Terms</h2>
            <div class="box">
              <div class="three-col">
                <div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Ship From:</span>
                    <input id="shipFrom" class="doc-input" type="text" placeholder="Ship From" data-field="shipFrom" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Port of Loading:</span>
                    <input id="portOfLoading" class="doc-input" type="text" placeholder="Port of Loading" data-field="portOfLoading" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Estimated Lead Time:</span>
                    <input id="leadTime" class="doc-input" type="text" placeholder="e.g. 15 days" data-field="leadTime" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Delivery Terms:</span>
                    <input id="deliveryTerms" class="doc-input" type="text" placeholder="e.g. After deposit / before shipment" data-field="deliveryTerms" />
                  </div>
                </div>

                <div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Ship To:</span>
                    <input id="shipTo" class="doc-input" type="text" placeholder="Ship To" data-field="shipTo" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Port of Discharge:</span>
                    <input id="portOfDischarge" class="doc-input" type="text" placeholder="Port of Discharge" data-field="portOfDischarge" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Incoterms:</span>
                    <input id="incoterms" class="doc-input" type="text" placeholder="e.g. FOB, CIF, EXW" data-field="incoterms" />
                  </div>
                </div>

                <div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Shipment Method:</span>
                    <input id="shipmentMethod" class="doc-input" type="text" placeholder="Sea, Air, Courier..." data-field="shipmentMethod" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Payment Terms:</span>
                    <input id="paymentTerms" class="doc-input" type="text" placeholder="e.g. 30% deposit, 70% before shipment" data-field="paymentTerms" />
                  </div>
                  <div class="field-row field-row-block no-print">
                    <span class="field-label">Estimated Charges:</span>
                    <input id="estimatedCharges" class="doc-input" type="number" min="0" step="0.01" value="0" placeholder="Estimated Charges" data-clear-zero-on-focus="true" data-default-value="0" data-field="estimatedCharges" />
                  </div>
                  <div class="field-row field-row-block no-print">
                    <span class="field-label">Deposit Required:</span>
                    <input id="depositRequired" class="doc-input" type="number" min="0" step="0.01" value="0" placeholder="Deposit Required" data-clear-zero-on-focus="true" data-default-value="0" data-field="depositRequired" />
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="doc-section">
            <div class="section-title-row">
              <h2 class="section-title">Items</h2>
              <div class="items-actions">
                <label class="currency-control no-print">
                  <span class="currency-icon" aria-hidden="true">$</span>
                  <span class="currency-label">Currency</span>
                  <select id="currencyCode" class="currency-select" data-field="currencyCode">
                    {commonCurrencyOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                  </select>
                </label>
                <button type="button" class="add-item-btn edit-only" id="addItemBtn" data-add-item-trigger>
                  <span class="add-item-icon" aria-hidden="true">+</span>
                  <span>Add Item</span>
                </button>
              </div>
            </div>

            <table class="doc-table proforma-table">
              <thead>
                <tr>
                  <th style="width: 29%;">Description</th>
                  <th style="width: 14%;">Item Code / SKU</th>
                  <th style="width: 9%;">Qty</th>
                  <th style="width: 11%;">Unit</th>
                  <th style="width: 14%;">Unit Price</th>
                  <th style="width: 15%;">Amount</th>
                  <th class="edit-only" style="width: 8%;"></th>
                </tr>
              </thead>
              <tbody id="itemsTableBody">
                {["item-1", "item-2"].map((itemId) => (
                  <tr class="item-row" data-item-id={itemId}>
                    <td><input class="doc-input table-input item-description" type="text" data-item-id={itemId} data-item-field="description" value="" /></td>
                    <td><input class="doc-input table-input item-code" type="text" data-item-id={itemId} data-item-field="itemCode" value="" /></td>
                    <td><input class="doc-input table-input item-qty" type="number" min="0" step="1" data-item-id={itemId} data-item-field="qty" value="1" /></td>
                    <td><input class="doc-input table-input item-unit" type="text" placeholder="pcs" data-item-id={itemId} data-item-field="unit" value="pcs" /></td>
                    <td><input class="doc-input table-input item-unit-price" type="number" min="0" step="0.01" data-item-id={itemId} data-item-field="unitPrice" value="0" data-clear-zero-on-focus="true" data-default-value="0" /></td>
                    <td class="amount-cell"><span class="line-amount" data-item-line-total={itemId}>USD 0.00</span></td>
                    <td class="edit-only action-cell">
                      <button type="button" class="item-delete-btn" aria-label="Remove item" data-remove-item={itemId}>
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                          <path d="M9 3h6l1 2h4v2H4V5h4l1-2zm1 6h2v8h-2V9zm4 0h2v8h-2V9zM7 9h2v8H7V9zm-1 12h12a2 2 0 0 0 2-2V7H4v12a2 2 0 0 0 2 2z" fill="currentColor" />
                        </svg>
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>

          <section class="doc-section">
            <div class="two-col notes-totals-row">
              <div class="box">
                <h2 class="section-title">Notes</h2>
                <textarea id="invoiceRemarks" class="doc-textarea compact-remarks" rows="2" placeholder="Notes or special instructions" data-field="invoiceRemarks"></textarea>
              </div>

              <div class="box totals-box">
                <div class="totals-panel">
                  <div class="total-row"><span>Estimated Goods Value</span><strong id="subtotalValue">USD 0.00</strong></div>
                  <div class="total-row"><span>Estimated Charges</span><strong id="chargesValue">USD 0.00</strong></div>
                  <div class="total-row total-row-grand"><span>Estimated Total</span><output id="grandTotalValue" class="total-output">USD 0.00</output></div>
                  <div class="total-row"><span>Deposit Required</span><strong id="depositValue">USD 0.00</strong></div>
                  <div class="total-row total-row-grand"><span>Balance Due</span><output id="balanceDueValue" class="total-output">USD 0.00</output></div>
                </div>
              </div>
            </div>
          </section>

          <section class="doc-section bank-details-section" data-print-optional-section>
            <h2 class="section-title">Bank Details</h2>
            <div class="box">
              <div class="two-col">
                <div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Bank Name:</span>
                    <input id="bankName" class="doc-input" type="text" placeholder="Bank Name" data-field="bankName" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Account Name:</span>
                    <input id="accountName" class="doc-input" type="text" placeholder="Account Name" data-field="accountName" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Account No. / IBAN:</span>
                    <input id="accountNumber" class="doc-input" type="text" placeholder="Account Number / IBAN" data-field="accountNumber" />
                  </div>
                </div>
                <div>
                  <div class="field-row field-row-block">
                    <span class="field-label">SWIFT / BIC:</span>
                    <input id="swiftCode" class="doc-input" type="text" placeholder="SWIFT / BIC" data-field="swiftCode" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Bank Address:</span>
                    <textarea id="bankAddress" class="doc-textarea compact-area" rows="2" placeholder="Bank Address" data-field="bankAddress"></textarea>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="doc-section signature-grid">
            <div class="two-col">
              <div class="box signature-box">
                <h2 class="section-title">Prepared By</h2>
                <input id="preparedBy" class="doc-input" type="text" placeholder="Name / Title" data-field="preparedBy" />
              </div>
              <div class="box signature-box">
                <h2 class="section-title">Authorized Signature</h2>
                <input id="signature" class="doc-input" type="text" placeholder="Signature / Name" data-field="signature" />
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>

    <div class="mobile-document-editor no-print">
      <div class="mobile-action-card">
        <a href="/quotes-invoices/" class="mobile-back-btn">Back to Quotes & Invoices</a>
        <div class="mobile-paper-size">
          <span class="mobile-paper-size-label">Paper Size</span>
          <div class="mobile-paper-toggle" aria-label="Paper size">
            <button type="button" class="paper-btn" data-paper-size="letter">US Letter</button>
            <button type="button" class="paper-btn is-active" data-paper-size="a4">A4</button>
          </div>
        </div>
      </div>

      <section class="mobile-form-card">
        <h2>Proforma Header</h2>
        <input class="mobile-input mobile-logo-input" type="text" placeholder="Your Business Name" data-field="logoText" />
        <input class="mobile-input" type="text" placeholder="Proforma No." data-field="invoiceNumber" />
        <input class="mobile-input" type="date" data-field="invoiceDate" />
        <input class="mobile-input" type="date" data-field="validUntil" />
      </section>

      <section class="mobile-form-card">
        <h2>Seller</h2>
        <input class="mobile-input" type="text" placeholder="Company Name" data-field="sellerName" />
        <textarea class="mobile-textarea" placeholder="Address" data-field="sellerAddress"></textarea>
        <input class="mobile-input" type="text" placeholder="Email / Phone" data-field="sellerContact" />
      </section>

      <section class="mobile-form-card">
        <h2>Buyer</h2>
        <input class="mobile-input" type="text" placeholder="Company Name" data-field="buyerName" />
        <textarea class="mobile-textarea" placeholder="Address" data-field="buyerAddress"></textarea>
        <input class="mobile-input" type="text" placeholder="Email / Phone" data-field="buyerContact" />
      </section>

      <section class="mobile-form-card">
        <h2>Shipment & Terms</h2>
        <input class="mobile-input" type="text" placeholder="Ship From" data-field="shipFrom" />
        <input class="mobile-input" type="text" placeholder="Port of Loading" data-field="portOfLoading" />
        <input class="mobile-input" type="text" placeholder="Estimated Lead Time" data-field="leadTime" />
        <input class="mobile-input" type="text" placeholder="Delivery Terms" data-field="deliveryTerms" />
        <input class="mobile-input" type="text" placeholder="Ship To" data-field="shipTo" />
        <input class="mobile-input" type="text" placeholder="Port of Discharge" data-field="portOfDischarge" />
        <input class="mobile-input" type="text" placeholder="Incoterms" data-field="incoterms" />
        <input class="mobile-input" type="text" placeholder="Shipment Method" data-field="shipmentMethod" />
        <input class="mobile-input" type="text" placeholder="Payment Terms" data-field="paymentTerms" />
        <input class="mobile-input" type="number" min="0" step="0.01" placeholder="Estimated Charges" data-field="estimatedCharges" data-clear-zero-on-focus="true" data-default-value="0" />
        <input class="mobile-input" type="number" min="0" step="0.01" placeholder="Deposit Required" data-field="depositRequired" data-clear-zero-on-focus="true" data-default-value="0" />
      </section>

      <section class="mobile-form-card">
        <div class="mobile-section-header">
          <h2>Items</h2>
          <div class="items-actions items-actions--mobile">
            <label class="currency-control">
              <span class="currency-icon" aria-hidden="true">$</span>
              <span class="currency-label">Currency</span>
              <select class="mobile-select currency-select" data-field="currencyCode">
                {commonCurrencyOptions.map((option) => <option value={option.value}>{option.label}</option>)}
              </select>
            </label>
            <button type="button" class="mobile-add-item-btn" data-add-item-trigger>+ Add Item</button>
          </div>
        </div>
        <div id="mobileItemsList" class="mobile-items-list">
          {[1, 2].map((itemNumber) => {
            const itemId = `item-${itemNumber}`;
            return (
              <article class="mobile-item-card" data-item-id={itemId}>
                <div class="mobile-item-title">
                  <strong>{`Item ${itemNumber}`}</strong>
                  <button type="button" class="mobile-delete-item-btn" aria-label="Remove item" data-remove-item={itemId}>Delete</button>
                </div>
                <input class="mobile-input" type="text" placeholder="Description" data-item-id={itemId} data-item-field="description" value="" />
                <input class="mobile-input" type="text" placeholder="Item Code / SKU" data-item-id={itemId} data-item-field="itemCode" value="" />
                <div class="mobile-two-col">
                  <input class="mobile-input" type="number" placeholder="Qty" min="0" step="1" data-item-id={itemId} data-item-field="qty" value="1" />
                  <input class="mobile-input" type="text" placeholder="Unit" data-item-id={itemId} data-item-field="unit" value="pcs" />
                </div>
                <input class="mobile-input" type="number" placeholder="Unit Price" min="0" step="0.01" data-item-id={itemId} data-item-field="unitPrice" value="0" data-clear-zero-on-focus="true" data-default-value="0" />
                <div class="mobile-amount-box">
                  <span>Amount</span>
                  <strong data-item-line-total={itemId}>USD 0.00</strong>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <section class="mobile-form-card">
        <h2>Notes & Totals</h2>
        <textarea class="mobile-textarea" placeholder="Notes" data-field="invoiceRemarks"></textarea>
        <div class="mobile-total-card">
          <div><span>Estimated Goods Value</span><strong id="mobileSubtotalValue">USD 0.00</strong></div>
          <div><span>Estimated Charges</span><strong id="mobileChargesValue">USD 0.00</strong></div>
          <div class="grand-total"><span>Estimated Total</span><output id="mobileGrandTotalValue" class="total-output">USD 0.00</output></div>
          <div><span>Deposit Required</span><strong id="mobileDepositValue">USD 0.00</strong></div>
          <div class="grand-total"><span>Balance Due</span><output id="mobileBalanceDueValue" class="total-output">USD 0.00</output></div>
        </div>
      </section>

      <section class="mobile-form-card">
        <h2>Bank Details & Signature</h2>
        <input class="mobile-input" type="text" placeholder="Bank Name" data-field="bankName" />
        <input class="mobile-input" type="text" placeholder="Account Name" data-field="accountName" />
        <input class="mobile-input" type="text" placeholder="Account Number / IBAN" data-field="accountNumber" />
        <input class="mobile-input" type="text" placeholder="SWIFT / BIC" data-field="swiftCode" />
        <textarea class="mobile-textarea" placeholder="Bank Address" data-field="bankAddress"></textarea>
        <input class="mobile-input" type="text" placeholder="Prepared By" data-field="preparedBy" />
        <input class="mobile-input" type="text" placeholder="Authorized Signature" data-field="signature" />
      </section>
    </div>

    <div class="mobile-bottom-action-bar no-print">
      <button type="button" class="mobile-reset-btn" data-reset-form-trigger>
        <span class="reset-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path d="M12 5a7 7 0 1 1-6.67 9.12 1 1 0 1 1 1.91-.59A5 5 0 1 0 8.1 8.3H11a1 1 0 1 1 0 2H5a1 1 0 0 1-1-1V3a1 1 0 1 1 2 0v3.32A8.97 8.97 0 0 1 12 5z" fill="currentColor"></path>
          </svg>
        </span>
        <span>Reset</span>
      </button>

      <a
        href="#print"
        class="mobile-print-btn"
        data-print-document
        title="Generate and download professional PDF proforma invoice"
        aria-label="Generate and download professional PDF proforma invoice"
      >
        <svg class="mobile-print-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M7 2h8l5 5v3h-2V8h-4V4H7v6H5V4a2 2 0 0 1 2-2z" fill="currentColor"></path>
          <path d="M6 12h12a3 3 0 0 1 3 3v4h-4v3H7v-3H3v-4a3 3 0 0 1 3-3zm3 8h6v-4H9v4z" fill="currentColor"></path>
          <path d="M16 9h3v3h-3z" fill="currentColor"></path>
        </svg>
        <span>Print / Save as PDF</span>
      </a>
      <p class="mobile-privacy-note">Your data is processed locally in your browser and is not stored on our servers.</p>
    </div>
  </div>

  <article class="content-card" slot="guide">
    <h2>How This Proforma Invoice Generator Works</h2>
    <p>
      Fill in seller, buyer, payment terms, delivery details, deposit information, bank details, and estimated item values directly on the document. The proforma invoice stays print-ready while estimated totals, deposits, and balance due update automatically.
    </p>
  </article>

  <article class="content-card" slot="guide">
    <h2>When to Use It</h2>
    <p>
      Use this proforma invoice generator for quotations, order confirmation, advance payment requests, and
      international trade preparation before issuing a final commercial invoice.
    </p>
  </article>

  <article class="content-card" slot="guide">
    <h2>Why It Helps</h2>
    <p>
      A structured proforma invoice makes preliminary pricing clearer, helps buyers review terms faster, and
      gives you a professional document for pre-shipment communication.
    </p>
  </article>

  <style is:global>
    .proforma-invoice-page {
      background: #f8fafc;
    }

    .proforma-invoice-inner {
      width: min(1280px, calc(100% - 32px));
      margin: 0 auto;
      padding: 40px 0 72px;
    }

    .generator-hero {
      margin-bottom: 24px;
    }

    .generator-breadcrumb {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
      color: #64748b;
      font-size: 14px;
      line-height: 1.4;
      font-weight: 600;
    }

    .generator-breadcrumb a {
      color: #64748b;
      text-decoration: none;
    }

    .generator-breadcrumb a:hover {
      color: #2563eb;
    }

    .generator-eyebrow {
      display: inline-block;
