---
import DocumentGeneratorLayout from "../../components/document-generator/DocumentGeneratorLayout.astro";

const pageTitle = "Proforma Invoice Generator";
const pageDescription =
  "Create a professional proforma invoice online for quotations, pre-sale confirmation, and international trade preparation. Print or save the document as PDF.";
const canonical = "https://www.worowo.com/quotes-invoices/proforma-invoice-generator/";

const faqItems = [
  {
    question: "What is a proforma invoice?",
    answer:
      "A proforma invoice is a preliminary sales document used to show estimated goods, prices, and shipment terms before final billing. It is commonly used for quotations, order confirmation, and trade preparation.",
  },
  {
    question: "Can I print the proforma invoice or save it as PDF?",
    answer:
      "Yes. You can fill in the proforma invoice directly in the document view, then print it or save it as PDF for customer review, banking support, or export preparation.",
  },
  {
    question: "How is this different from a commercial invoice?",
    answer:
      "A proforma invoice is usually issued before shipment or final billing and may include estimated values or payment terms. A commercial invoice is typically the final trade document used with the actual shipment.",
  },
];

const relatedTools = [
  {
    name: "Quote / Estimate Generator",
    href: "/quotes-invoices/quote-estimate-generator/",
    desc: "Create an initial customer-facing price offer before preparing a proforma invoice.",
  },
  {
    name: "Invoice Generator",
    href: "/quotes-invoices/invoice-generator/",
    desc: "Create a standard invoice for billing customers, project work, and day-to-day business use.",
  },
  {
    name: "Commercial Invoice Generator",
    href: "/quotes-invoices/commercial-invoice-generator/",
    desc: "Create a final trade invoice for international shipments, customs support, and shipment valuation.",
  },
  {
    name: "Purchase Order Generator",
    href: "/quotes-invoices/purchase-order-generator/",
    desc: "Prepare a buyer purchase order before supplier confirmation and invoicing.",
  },
];
---

<DocumentGeneratorLayout
  config={{
    title: pageTitle,
    description: pageDescription,
    canonical,
    categoryName: "Quotes & Invoices",
    categoryHref: "/quotes-invoices/",
    breadcrumbCurrent: "Proforma Invoice Generator",
    backLabel: "Back to Quotes & Invoices",
    printHref: "#print",
  }}
  relatedTools={relatedTools}
  faqItems={faqItems}
>
  <div class="inline-document-mobile-shell" slot="document">
    <div class="desktop-document-editor">
      <div id="proforma-invoice-document" class="inline-document-root proforma-document paper-a4">
    <div class="inline-document-inner proforma-document-inner">
      <div class="document-title-row">
        <input
          id="documentLogoText"
          class="document-logo-text"
          type="text"
          placeholder="Your Business Name"
          aria-label="Business name or logo text"
          data-field="logoText"
        />

        <div class="document-title">PROFORMA INVOICE</div>
      </div>

              <div class="doc-header">
                <div>
                  <div class="doc-subtitle editor-hint no-print">Preliminary invoice for trade and payment reference</div>
                </div>

                <div class="doc-meta">
                  <div class="field-row">
                    <span class="field-label print-label">Proforma No.:</span>
                    <input id="invoiceNumber" class="doc-input inline-input" type="text" placeholder="Proforma No." data-field="invoiceNumber" />
                  </div>
                  <div class="field-row">
                    <span class="field-label print-label">Date:</span>
                    <input id="invoiceDate" class="doc-input inline-input" type="date" placeholder="Date" data-field="invoiceDate" />
                  </div>
                  <div class="field-row">
                    <span class="field-label print-label">Currency:</span>
                    <input id="currencyCode" class="doc-input inline-input short-inline-input" type="text" value="USD" maxlength="8" placeholder="USD" data-field="currencyCode" />
                  </div>
                </div>
              </div>

              <section class="doc-section">
                <div class="two-col">
                  <div class="box">
                    <h2 class="section-title">Seller</h2>
                    <div class="field-row field-row-block">
                      <input id="sellerName" class="doc-input" type="text" placeholder="Company Name" data-field="sellerName" />
                    </div>
                    <div class="field-row field-row-block">
                      <textarea id="sellerAddress" class="doc-textarea compact-area" rows="2" placeholder="Address" data-field="sellerAddress"></textarea>
                    </div>
                    <div class="field-row field-row-block">
                      <input id="sellerContact" class="doc-input" type="text" placeholder="Email / Phone" data-field="sellerContact" />
                    </div>
                  </div>

                  <div class="box">
                    <h2 class="section-title">Buyer</h2>
                    <div class="field-row field-row-block">
                      <input id="buyerName" class="doc-input" type="text" placeholder="Company Name" data-field="buyerName" />
                    </div>
                    <div class="field-row field-row-block">
                      <textarea id="buyerAddress" class="doc-textarea compact-area" rows="2" placeholder="Address" data-field="buyerAddress"></textarea>
                    </div>
                    <div class="field-row field-row-block">
                      <input id="buyerContact" class="doc-input" type="text" placeholder="Email / Phone" data-field="buyerContact" />
                    </div>
                  </div>
                </div>
              </section>

              <section class="doc-section">
                <h2 class="section-title">Shipment & Terms</h2>
                <div class="box">
                  <div class="three-col">
                    <div>
                      <div class="field-row field-row-block">
                        <span class="field-label">Ship From:</span>
                        <input id="shipFrom" class="doc-input" type="text" placeholder="Ship From" data-field="shipFrom" />
                      </div>
                      <div class="field-row field-row-block">
                        <span class="field-label">Port of Loading:</span>
                        <input id="portOfLoading" class="doc-input" type="text" placeholder="Port of Loading" data-field="portOfLoading" />
                      </div>
                      <div class="field-row field-row-block">
                        <span class="field-label">Estimated Lead Time:</span>
                        <input id="leadTime" class="doc-input" type="text" placeholder="e.g. 15 days" data-field="leadTime" />
                      </div>
                    </div>

                    <div>
                      <div class="field-row field-row-block">
                        <span class="field-label">Ship To:</span>
                        <input id="shipTo" class="doc-input" type="text" placeholder="Ship To" data-field="shipTo" />
                      </div>
                      <div class="field-row field-row-block">
                        <span class="field-label">Port of Discharge:</span>
                        <input id="portOfDischarge" class="doc-input" type="text" placeholder="Port of Discharge" data-field="portOfDischarge" />
                      </div>
                      <div class="field-row field-row-block">
                        <span class="field-label">Incoterms:</span>
                        <input id="incoterms" class="doc-input" type="text" placeholder="e.g. FOB, CIF, EXW" data-field="incoterms" />
                      </div>
                    </div>

                    <div>
                      <div class="field-row field-row-block">
                        <span class="field-label">Shipment Method:</span>
                        <input id="shipmentMethod" class="doc-input" type="text" placeholder="Sea, Air, Courier..." data-field="shipmentMethod" />
                      </div>
                      <div class="field-row field-row-block">
                        <span class="field-label">Payment Terms:</span>
                        <input id="paymentTerms" class="doc-input" type="text" placeholder="e.g. 50% deposit, 50% before shipment" data-field="paymentTerms" />
                      </div>
                      <div class="field-row field-row-block">
                        <span class="field-label">Estimated Charges:</span>
                        <input id="estimatedCharges" class="doc-input" type="number" min="0" step="0.01" value="0" placeholder="Estimated Charges" data-clear-zero-on-focus="true" data-default-value="0" data-field="estimatedCharges" />
                      </div>
                    </div>
                  </div>
                </div>
              </section>

              <section class="doc-section">
                <div class="section-title-row">
                  <h2 class="section-title">Items</h2>
                  <button type="button" class="add-item-btn edit-only" id="addItemBtn" data-add-item-trigger>
                    <span class="add-item-icon" aria-hidden="true">+</span>
                    <span>Add Item</span>
                  </button>
                </div>

                <table class="doc-table proforma-table">
                  <thead>
                    <tr>
                      <th style="width: 29%;">Description</th>
                      <th style="width: 14%;">HS Code</th>
                      <th style="width: 9%;">Qty</th>
                      <th style="width: 11%;">Unit</th>
                      <th style="width: 14%;">Unit Price</th>
                      <th style="width: 15%;">Amount</th>
                      <th class="edit-only" style="width: 8%;"></th>
                    </tr>
                  </thead>
                  <tbody id="itemsTableBody"></tbody>
                </table>
              </section>

              <section class="doc-section">
                <div class="two-col notes-totals-row">
                  <div class="box">
                    <h2 class="section-title">Notes</h2>
                    <textarea id="invoiceRemarks" class="doc-textarea compact-remarks" rows="2" data-field="invoiceRemarks"></textarea>
                  </div>

                  <div class="box totals-box">
                    <div class="totals-panel">
                      <div class="total-row"><span>Estimated Goods Value</span><strong id="subtotalValue">USD 0.00</strong></div>
                      <div class="total-row"><span>Estimated Charges</span><strong id="chargesValue">USD 0.00</strong></div>
                      <div class="total-row total-row-grand"><span>Estimated Total</span><strong id="grandTotalValue">USD 0.00</strong></div>
                    </div>
                  </div>
                </div>
              </section>
    </div>
      </div>
    </div>

    <div class="mobile-document-editor no-print">
      <div class="mobile-action-card">
        <a href="/quotes-invoices/" class="mobile-back-btn">Back to Quotes & Invoices</a>
        <div class="mobile-paper-size">
          <span class="mobile-paper-size-label">Paper Size</span>
          <div class="mobile-paper-toggle" aria-label="Paper size">
            <button type="button" class="paper-btn" data-paper-size="letter">US Letter</button>
            <button type="button" class="paper-btn is-active" data-paper-size="a4">A4</button>
          </div>
        </div>
      </div>

      <section class="mobile-form-card">
        <h2>Proforma Header</h2>
        <input class="mobile-input mobile-logo-input" type="text" placeholder="Your Business Name" data-field="logoText" />
        <input class="mobile-input" type="text" placeholder="Proforma No." data-field="invoiceNumber" />
        <input class="mobile-input" type="date" data-field="invoiceDate" />
        <input class="mobile-input" type="text" placeholder="Currency (e.g. USD)" data-field="currencyCode" maxlength="8" />
      </section>

      <section class="mobile-form-card">
        <h2>Seller</h2>
        <input class="mobile-input" type="text" placeholder="Company Name" data-field="sellerName" />
        <textarea class="mobile-textarea" placeholder="Address" data-field="sellerAddress"></textarea>
        <input class="mobile-input" type="text" placeholder="Email / Phone" data-field="sellerContact" />
      </section>

      <section class="mobile-form-card">
        <h2>Buyer</h2>
        <input class="mobile-input" type="text" placeholder="Company Name" data-field="buyerName" />
        <textarea class="mobile-textarea" placeholder="Address" data-field="buyerAddress"></textarea>
        <input class="mobile-input" type="text" placeholder="Email / Phone" data-field="buyerContact" />
      </section>

      <section class="mobile-form-card">
        <h2>Shipment & Terms</h2>
        <input class="mobile-input" type="text" placeholder="Ship From" data-field="shipFrom" />
        <input class="mobile-input" type="text" placeholder="Port of Loading" data-field="portOfLoading" />
        <input class="mobile-input" type="text" placeholder="Estimated Lead Time" data-field="leadTime" />
        <input class="mobile-input" type="text" placeholder="Ship To" data-field="shipTo" />
        <input class="mobile-input" type="text" placeholder="Port of Discharge" data-field="portOfDischarge" />
        <input class="mobile-input" type="text" placeholder="Incoterms" data-field="incoterms" />
        <input class="mobile-input" type="text" placeholder="Shipment Method" data-field="shipmentMethod" />
        <input class="mobile-input" type="text" placeholder="Payment Terms" data-field="paymentTerms" />
        <input class="mobile-input" type="number" min="0" step="0.01" placeholder="Estimated Charges" data-field="estimatedCharges" data-clear-zero-on-focus="true" data-default-value="0" />
      </section>

      <section class="mobile-form-card">
        <div class="mobile-section-header">
          <h2>Items</h2>
          <button type="button" class="mobile-add-item-btn" data-add-item-trigger>+ Add Item</button>
        </div>
        <div id="mobileItemsList" class="mobile-items-list"></div>
      </section>

      <section class="mobile-form-card">
        <h2>Notes & Totals</h2>
        <textarea class="mobile-textarea" placeholder="Notes" data-field="invoiceRemarks"></textarea>
        <div class="mobile-total-card">
          <div><span>Estimated Goods Value</span><strong id="mobileSubtotalValue">USD 0.00</strong></div>
          <div><span>Estimated Charges</span><strong id="mobileChargesValue">USD 0.00</strong></div>
          <div class="grand-total"><span>Estimated Total</span><strong id="mobileGrandTotalValue">USD 0.00</strong></div>
        </div>
      </section>
    </div>

    <div class="mobile-bottom-action-bar no-print">
      <a
        href="#print"
        class="mobile-print-btn"
        data-print-document
        title="Generate and download professional PDF proforma invoice"
        aria-label="Generate and download professional PDF proforma invoice"
      >
        <svg class="mobile-print-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 2h8l5 5v3h-2V8h-4V4H7v6H5V4a2 2 0 0 1 2-2z" fill="currentColor"></path>
          <path d="M6 12h12a3 3 0 0 1 3 3v4h-4v3H7v-3H3v-4a3 3 0 0 1 3-3zm3 8h6v-4H9v4z" fill="currentColor"></path>
          <path d="M16 9h3v3h-3z" fill="currentColor"></path>
        </svg>
        <span>Print / Save as PDF</span>
      </a>
      <button type="button" class="mobile-reset-btn" data-reset-form-trigger>Reset</button>
      <p class="mobile-privacy-note">Your data is processed locally in your browser and is not stored on our servers.</p>
    </div>
  </div>

  <article class="content-card" slot="guide">
            <h2>How This Proforma Invoice Generator Works</h2>
            <p>
              Fill in seller, buyer, shipment terms, and estimated item values directly on the document. The proforma
              invoice stays print-ready while estimated totals update automatically.
            </p>
          </article>

  <article class="content-card" slot="guide">
            <h2>When to Use It</h2>
            <p>
              Use this proforma invoice generator for quotations, order confirmation, advance payment requests, and
              international trade preparation before issuing a final commercial invoice.
            </p>
          </article>

  <article class="content-card" slot="guide">
            <h2>Why It Helps</h2>
            <p>
              A structured proforma invoice makes preliminary pricing clearer, helps buyers review terms faster, and
              gives you a professional document for pre-shipment communication.
            </p>
          </article>

  <style is:global>
    .proforma-invoice-page {
      background: #f8fafc;
    }

    .proforma-invoice-inner {
      width: min(1280px, calc(100% - 32px));
      margin: 0 auto;
      padding: 40px 0 72px;
    }

    .generator-hero {
      margin-bottom: 24px;
    }

    .generator-breadcrumb {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
      color: #64748b;
      font-size: 14px;
      line-height: 1.4;
      font-weight: 600;
    }

    .generator-breadcrumb a {
      color: #64748b;
      text-decoration: none;
    }

    .generator-breadcrumb a:hover {
      color: #2563eb;
    }

    .generator-eyebrow {
      display: inline-block;
      margin-bottom: 10px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #2563eb;
    }

    .generator-title {
      margin: 0 0 14px;
      font-size: clamp(34px, 4vw, 52px);
      line-height: 1.08;
      letter-spacing: -0.03em;
      color: #0f172a;
    }

    .generator-description {
      max-width: 900px;
      margin: 0;
      font-size: 18px;
      line-height: 1.75;
      color: #475569;
    }

    .document-toolbar {
      position: sticky;
      top: 79px;
      z-index: 30;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 18px;
      padding: 14px 16px;
      margin-bottom: 22px;
      border: 1px solid #dbe3ee;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(8px);
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    }

    .document-toolbar-left {
      display: flex;
      align-items: center;
    }

    .document-toolbar-center {
      display: flex;
      justify-content: center;
    }

    .document-toolbar-right {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 10px;
    }

    .brand-link {
      color: #0f172a;
      text-decoration: none;
      font-size: 20px;
      font-weight: 800;
      letter-spacing: -0.05em;
      line-height: 1;
      white-space: nowrap;
    }

    .brand-link:hover {
      color: #2563eb;
    }

    .toolbar-link-btn,
    .toolbar-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      padding: 0 14px;
      border-radius: 10px;
      border: 1px solid #dbe3ee;
      background: #fff;
      color: #0f172a;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: 0.18s ease;
    }

    .toolbar-link-btn:hover,
    .toolbar-btn:hover {
      border-color: #94a3b8;
      background: #f8fafc;
    }

    .toolbar-btn-primary {
      background: #2563eb;
      border-color: #2563eb;
      color: #fff;
    }

    .toolbar-btn-primary:hover {
      background: #1d4ed8;
      border-color: #1d4ed8;
    }

    .toolbar-label {
      font-size: 14px;
      font-weight: 700;
      color: #475569;
      white-space: nowrap;
    }

    .paper-toggle-group {
      display: inline-flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .paper-toggle.is-active {
      background: #dbeafe;
      color: #1d4ed8;
      border-color: #93c5fd;
    }

    .document-stage {
      display: flex;
      justify-content: center;
      padding: 10px 0 0;
    }

    .document-stage-inner {
      width: 100%;
      overflow: auto;
      padding: 12px 0 4px;
    }

    .proforma-document {
      margin: 0 auto;
      background: #fff;
      border: 1px solid rgba(203, 213, 225, 0.7);
      box-shadow:
        0 26px 70px rgba(15, 23, 42, 0.14),
        0 4px 18px rgba(15, 23, 42, 0.06);
    }

    .proforma-document.paper-letter {
      width: min(100%, 884px);
      min-height: 1144px;
    }

    .proforma-document.paper-a4 {
      width: min(100%, 860px);
      min-height: 1216px;
    }

    .proforma-document-inner {
      padding: 54px 48px 48px;
      color: #111827;
      font-family: Arial, Helvetica, sans-serif;
    }

    .doc-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 24px;
      padding-bottom: 14px;
      border-bottom: 2px solid #cbd5e1;
    }

    .doc-title {
      font-size: 24px;
      font-weight: 700;
      letter-spacing: 0.06em;
    }

    .doc-subtitle {
      margin-top: 8px;
      color: #64748b;
      font-size: 12px;
      line-height: 1.5;
    }

    .doc-meta {
      min-width: 250px;
    }

    .doc-section {
      margin-top: 16px;
    }

    .section-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
    }

    .section-title {
      margin: 0;
      font-size: 11pt;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .three-col {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .box {
      border: 1px solid #cbd5e1;
      padding: 12px;
    }

    .field-row {
      display: flex;
      align-items: baseline;
      gap: 8px;
      min-height: 26px;
      font-size: 10pt;
      line-height: 1.45;
    }

    .field-row-block {
      display: grid;
      grid-template-columns: 1fr;
      gap: 6px;
      align-items: start;
      min-height: auto;
      margin-bottom: 10px;
    }

    .field-row-block:last-child {
      margin-bottom: 0;
    }

    .field-label {
      font-weight: 700;
      white-space: nowrap;
    }

    .doc-input,
    .doc-textarea {
      width: 100%;
      border: 1.5px dashed #e5e7eb;
      border-radius: 10px;
      background: #ffffff;
      color: #111827;
      font: inherit;
      padding: 9px 10px;
      outline: none;
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        box-shadow 0.15s ease;
    }

    .doc-input::placeholder,
    .doc-textarea::placeholder {
      color: #6b7280;
    }

    .inline-input {
      padding: 4px 8px;
    }

    .short-inline-input {
      max-width: 96px;
    }

    .doc-input:hover,
    .doc-textarea:hover,
    .doc-input:focus,
    .doc-textarea:focus {
      background-color: #fffbea !important;
      border-color: #2563eb !important;
      box-shadow:
        0 0 0 4px rgba(37, 99, 235, 0.22),
        0 6px 18px rgba(37, 99, 235, 0.1) !important;
      outline: none;
    }

    .doc-textarea {
      resize: vertical;
    }

    .compact-area,
    .compact-remarks {
      min-height: 64px;
    }

    .doc-table {
      width: 100%;
      border-collapse: collapse;
    }

    .doc-table th,
    .doc-table td {
      border: 1px solid #cbd5e1;
      padding: 7px 8px;
      font-size: 9.5pt;
      text-align: left;
      vertical-align: top;
    }

    .proforma-table td {
      height: 36px;
    }

    .table-input {
      border: 1px solid transparent;
      border-radius: 8px;
      background: transparent;
      padding: 8px;
      min-height: 28px;
    }

    .table-input:hover,
    .table-input:focus {
      background-color: #fffbea !important;
      border-color: #2563eb !important;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.18) !important;
      outline: none;
    }

    .amount-cell {
      vertical-align: middle;
    }

    .line-amount {
      display: inline-block;
      font-weight: 700;
      color: #0f172a;
    }

    .action-cell {
      text-align: center;
      vertical-align: middle;
    }

    .remove-row-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border-radius: 999px;
      border: 1px solid #dbe3ee;
      background: #fff;
      color: #64748b;
      font-size: 16px;
      line-height: 1;
      cursor: pointer;
      transition: 0.18s ease;
    }

    .remove-row-btn:hover {
      border-color: #94a3b8;
      background: #f8fafc;
    }

    .add-item-inline-btn {
      min-height: 34px;
      padding: 0 12px;
      font-size: 13px;
    }

    .notes-totals-row {
      align-items: start;
    }

    .totals-box {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .totals-panel {
      border: 1px solid #dbe3ee;
      padding: 12px;
    }

    .total-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 12px;
      padding: 4px 0;
      font-size: 9.5pt;
      color: #475569;
    }

    .total-row-grand {
      margin-top: 4px;
      padding-top: 8px;
      border-top: 1px solid #dbe3ee;
      color: #0f172a;
      font-weight: 700;
    }

    .generator-related-block {
      margin: 44px calc(50% - 50vw) 0;
      padding: 38px max(16px, calc((100vw - 1280px) / 2 + 16px)) 10px;
      border-top: 1px solid #e5e7eb;
      border-bottom: 1px solid #e5e7eb;
      background: #f9fafb;
    }

    .generator-seo-block {
      margin: 0 calc(50% - 50vw);
      padding: 38px max(16px, calc((100vw - 1280px) / 2 + 16px)) 10px;
      background: #ffffff;
    }

    .generator-faq-block {
      margin: 0 calc(50% - 50vw);
      padding: 10px max(16px, calc((100vw - 1280px) / 2 + 16px)) 8px;
      background: #ffffff;
    }

    @media (max-width: 980px) {
      .document-toolbar {
        grid-template-columns: 1fr;
        gap: 12px;
      }

      .document-toolbar-left,
      .document-toolbar-center,
      .document-toolbar-right {
        justify-content: flex-start;
      }

    }

    @media (max-width: 760px) {
      .proforma-invoice-inner {
        width: min(1280px, calc(100% - 24px));
        padding: 28px 0 56px;
      }

      .generator-breadcrumb {
        flex-wrap: wrap;
        gap: 8px;
      }

      .generator-description {
        font-size: 16px;
      }

      .two-col,
      .three-col {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <style is:global>
    @media print {
      .site-header,
      .site-footer,
      .generator-breadcrumb,
      .generator-hero,
      .generator-related-block,
      .generator-seo-block,
      .generator-faq-block,
      .document-toolbar,
      .document-action-bar,
      .editor-hint,
      .doc-subtitle,
      .field-label:not(.print-label),
      .remove-row-btn,
      .item-delete-btn,
      .edit-only {
        display: none !important;
      }

      #proforma-invoice-document {
        position: static !important;
        display: block !important;
        width: auto !important;
        max-width: none !important;
        height: auto !important;
        min-height: auto !important;
        margin: 0 !important;
        border: 0 !important;
        box-shadow: none !important;
        background: #fff !important;
        overflow: visible !important;
        break-after: auto;
        break-inside: avoid;
        page-break-after: auto;
        page-break-inside: avoid;
      }

      .proforma-document.paper-letter,
      .proforma-document.paper-a4 {
        width: auto !important;
        min-height: auto !important;
      }

      .doc-input,
      .doc-textarea {
        border: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
        padding: 0 !important;
        border-radius: 0 !important;
        resize: none !important;
      }

      .field-label.print-label {
        display: inline !important;
        font-weight: 700 !important;
        white-space: nowrap !important;
      }
    }
  </style>

  <script>
    const documentRoot = document.getElementById("proforma-invoice-document");
    const itemsTableBody = document.getElementById("itemsTableBody");
    const mobileItemsList = document.getElementById("mobileItemsList");
    const resetTriggers = Array.from(document.querySelectorAll("[data-reset-form-trigger], #resetFormBtn"));
    const printTriggers = Array.from(document.querySelectorAll("[data-print-document]"));
    const paperButtons = Array.from(document.querySelectorAll("[data-paper-size]"));

    const syncFields = [
      "logoText",
      "invoiceNumber",
      "invoiceDate",
      "currencyCode",
      "sellerName",
      "sellerAddress",
      "sellerContact",
      "buyerName",
      "buyerAddress",
      "buyerContact",
      "shipFrom",
      "portOfLoading",
      "leadTime",
      "shipTo",
      "portOfDischarge",
      "incoterms",
      "shipmentMethod",
      "paymentTerms",
      "estimatedCharges",
      "invoiceRemarks",
    ];

    let nextItemId = 3;

    function updateNextItemId() {
      const numericIds = state.items
        .map((item) => Number.parseInt(String(item.id).replace("item-", ""), 10))
        .filter((value) => Number.isFinite(value));
      nextItemId = numericIds.length > 0 ? Math.max(...numericIds) + 1 : 1;
    }

    function defaultFields() {
      return {
        logoText: "",
        invoiceNumber: "",
        invoiceDate: "",
        currencyCode: "USD",
        sellerName: "",
        sellerAddress: "",
        sellerContact: "",
        buyerName: "",
        buyerAddress: "",
        buyerContact: "",
        shipFrom: "",
        portOfLoading: "",
        leadTime: "",
        shipTo: "",
        portOfDischarge: "",
        incoterms: "",
        shipmentMethod: "",
        paymentTerms: "",
        estimatedCharges: "0",
        invoiceRemarks: "",
      };
    }

    function createItem() {
      return {
        id: `item-${nextItemId++}`,
        description: "",
        hsCode: "",
        qty: "1",
        unit: "",
        unitPrice: "0",
      };
    }

    const state = {
      paper: "a4",
      fields: defaultFields(),
      items: [createItem(), createItem()],
    };

    function toNumber(value) {
      const parsed = Number.parseFloat(value);
      return Number.isFinite(parsed) ? parsed : 0;
    }

    function currencyCode() {
      return state.fields.currencyCode.trim() || "USD";
    }

    function formatMoney(value) {
      return `${currencyCode()} ${value.toFixed(2)}`;
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
    }

    function lineAmounts(item) {
      const qty = toNumber(item.qty);
      const unitPrice = toNumber(item.unitPrice);
      const lineTotal = qty * unitPrice;
      return { lineTotal };
    }

    function calculateTotals() {
      let subtotal = 0;
      state.items.forEach((item) => {
        subtotal += lineAmounts(item).lineTotal;
      });
      const charges = toNumber(state.fields.estimatedCharges);
      const grandTotal = subtotal + charges;
      return { subtotal, charges, grandTotal };
    }

    function renderSharedFields() {
      syncFields.forEach((field) => {
        document.querySelectorAll(`[data-field="${field}"]`).forEach((input) => {
          const value = state.fields[field];
          if (input.value !== value) input.value = value;
        });
      });
    }

    function desktopItemRow(item) {
      const { lineTotal } = lineAmounts(item);
      return `
        <tr class="item-row" data-item-id="${item.id}">
          <td><input class="doc-input table-input item-description" type="text" data-item-id="${item.id}" data-item-field="description" value="${escapeHtml(item.description)}" /></td>
          <td><input class="doc-input table-input item-hs-code" type="text" data-item-id="${item.id}" data-item-field="hsCode" value="${escapeHtml(item.hsCode)}" /></td>
          <td><input class="doc-input table-input item-qty" type="number" min="0" step="1" data-item-id="${item.id}" data-item-field="qty" value="${escapeHtml(item.qty)}" /></td>
          <td><input class="doc-input table-input item-unit" type="text" placeholder="pcs" data-item-id="${item.id}" data-item-field="unit" value="${escapeHtml(item.unit)}" /></td>
          <td><input class="doc-input table-input item-unit-price" type="number" min="0" step="0.01" data-item-id="${item.id}" data-item-field="unitPrice" value="${escapeHtml(item.unitPrice)}" data-clear-zero-on-focus="true" data-default-value="0" /></td>
          <td class="amount-cell"><span class="line-amount" data-item-line-total="${item.id}">${formatMoney(lineTotal)}</span></td>
          <td class="edit-only action-cell">
            <button type="button" class="item-delete-btn" aria-label="Remove item" data-remove-item="${item.id}">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 3h6l1 2h4v2H4V5h4l1-2zm1 6h2v8h-2V9zm4 0h2v8h-2V9zM7 9h2v8H7V9zm-1 12h12a2 2 0 0 0 2-2V7H4v12a2 2 0 0 0 2 2z" fill="currentColor" />
              </svg>
            </button>
          </td>
        </tr>
      `;
    }

    function mobileItemCard(item, index) {
      const { lineTotal } = lineAmounts(item);
      return `
        <article class="mobile-item-card" data-item-id="${item.id}">
          <div class="mobile-item-title">
            <strong>Item ${index + 1}</strong>
            <button type="button" class="mobile-delete-item-btn" aria-label="Remove item" data-remove-item="${item.id}">Delete</button>
          </div>
          <input class="mobile-input" type="text" placeholder="Description" data-item-id="${item.id}" data-item-field="description" value="${escapeHtml(item.description)}" />
          <input class="mobile-input" type="text" placeholder="HS Code" data-item-id="${item.id}" data-item-field="hsCode" value="${escapeHtml(item.hsCode)}" />
          <div class="mobile-two-col">
            <input class="mobile-input" type="number" placeholder="Qty" min="0" step="1" data-item-id="${item.id}" data-item-field="qty" value="${escapeHtml(item.qty)}" />
            <input class="mobile-input" type="text" placeholder="Unit" data-item-id="${item.id}" data-item-field="unit" value="${escapeHtml(item.unit)}" />
          </div>
          <input class="mobile-input" type="number" placeholder="Unit Price" min="0" step="0.01" data-item-id="${item.id}" data-item-field="unitPrice" value="${escapeHtml(item.unitPrice)}" data-clear-zero-on-focus="true" data-default-value="0" />
          <div class="mobile-amount-box">
            <span>Amount</span>
            <strong data-item-line-total="${item.id}">${formatMoney(lineTotal)}</strong>
          </div>
        </article>
      `;
    }

    function renderItems() {
      updateNextItemId();
      if (itemsTableBody) {
        itemsTableBody.innerHTML = state.items.map((item) => desktopItemRow(item)).join("");
      }
      if (mobileItemsList) {
        mobileItemsList.innerHTML = state.items.map((item, index) => mobileItemCard(item, index)).join("");
      }
    }

    function renderTotals() {
      const { subtotal, charges, grandTotal } = calculateTotals();

      document.querySelectorAll("[data-item-line-total]").forEach((el) => {
        const id = el.getAttribute("data-item-line-total");
        const item = state.items.find((entry) => entry.id === id);
        if (item) el.textContent = formatMoney(lineAmounts(item).lineTotal);
      });

      const targets = {
        subtotalValue: subtotal,
        chargesValue: charges,
        grandTotalValue: grandTotal,
        mobileSubtotalValue: subtotal,
        mobileChargesValue: charges,
        mobileGrandTotalValue: grandTotal,
      };
      Object.entries(targets).forEach(([id, value]) => {
        const el = document.getElementById(id);
        if (el) el.textContent = formatMoney(value);
      });
    }

    function applyPaper(paper) {
      state.paper = paper === "letter" ? "letter" : "a4";
      documentRoot.classList.remove("paper-letter", "paper-a4");
      documentRoot.classList.add(state.paper === "letter" ? "paper-letter" : "paper-a4");

      paperButtons.forEach((btn) => {
        btn.classList.toggle("is-active", btn.dataset.paperSize === state.paper);
      });

      const styleId = "proforma-invoice-print-page-rule";
      let styleTag = document.getElementById(styleId);

      if (!styleTag) {
        styleTag = document.createElement("style");
        styleTag.id = styleId;
        document.head.appendChild(styleTag);
      }

      styleTag.textContent =
        state.paper === "letter"
          ? "@page { size: Letter portrait; margin: 0.7in 0.65in 0.7in 0.65in; }"
          : "@page { size: A4 portrait; margin: 18mm 16mm 18mm 16mm; }";
    }

    function addItem() {
      state.items.push(createItem());
      renderItems();
      renderTotals();
    }

    function removeItem(itemId) {
      if (state.items.length <= 1) return;
      state.items = state.items.filter((item) => item.id !== itemId);
      renderItems();
      renderTotals();
    }

    function resetDocumentForm() {
      state.fields = defaultFields();
      state.items = [createItem(), createItem()];
      renderSharedFields();
      renderItems();
      applyPaper("a4");
      renderTotals();
    }

    function updateField(field, value, source) {
      state.fields[field] = value;
      document.querySelectorAll(`[data-field="${field}"]`).forEach((input) => {
        if (input !== source && input.value !== value) {
          input.value = value;
        }
      });
      renderTotals();
    }

    function updateItemField(itemId, field, value, source) {
      const item = state.items.find((entry) => entry.id === itemId);
      if (!item) return;
      item[field] = value;
      document.querySelectorAll(`[data-item-id="${itemId}"][data-item-field="${field}"]`).forEach((input) => {
        if (input !== source && input.value !== value) {
          input.value = value;
        }
      });
      renderTotals();
    }

    function preparePrintState() {
      documentRoot.querySelectorAll("input, textarea").forEach((field) => {
        const value = field.value.trim();
        if (value !== "") {
          field.classList.remove("print-empty-field");
          return;
        }
        field.classList.add("print-empty-field");
        if (field.placeholder) {
          field.dataset.restorePlaceholder = field.placeholder;
          field.placeholder = "";
        }
      });
    }

    function restorePrintVisualState() {
      document.body.classList.remove("inline-doc-print-reveal");
      documentRoot.querySelectorAll(".print-empty-field").forEach((field) => {
        field.classList.remove("print-empty-field");
        if (field.dataset.restorePlaceholder) {
          field.placeholder = field.dataset.restorePlaceholder;
          delete field.dataset.restorePlaceholder;
        }
      });
    }

    function handleDocumentPrint() {
      preparePrintState();
      document.body.classList.add("inline-doc-print-reveal");
      window.setTimeout(() => window.print(), 60);
    }

    function onPrintTrigger(event) {
      event.preventDefault();
      event.stopPropagation();
      handleDocumentPrint();
    }

    window.addEventListener("afterprint", restorePrintVisualState);

    document.addEventListener("input", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement)) return;

      const field = target.dataset.field;
      if (field) {
        updateField(field, target.value, target);
        return;
      }

      const itemId = target.dataset.itemId;
      const itemField = target.dataset.itemField;
      if (itemId && itemField) {
        updateItemField(itemId, itemField, target.value, target);
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const removeButton = target.closest("[data-remove-item]");
      if (removeButton) {
        removeItem(removeButton.getAttribute("data-remove-item"));
        return;
      }

      if (target.closest("[data-add-item-trigger]")) {
        addItem();
      }
    });

    resetTriggers.forEach((trigger) => {
      trigger.addEventListener("click", resetDocumentForm);
    });

    paperButtons.forEach((btn) => {
      btn.addEventListener("click", () => applyPaper(btn.dataset.paperSize || "a4"));
    });

    printTriggers.forEach((trigger) => {
      trigger.addEventListener("click", onPrintTrigger);
    });

    window.handleDocumentPrint = handleDocumentPrint;

    renderSharedFields();
    renderItems();
    applyPaper(state.paper);
    renderTotals();
  </script>
</DocumentGeneratorLayout>
