---
import DocumentGeneratorLayout from "../../components/document-generator/DocumentGeneratorLayout.astro";
import { commonCurrencyOptions } from "../../data/currencyOptions";
import { getRelatedToolsForTool } from "../../data/toolRelations";

const title = "Free Purchase Order Generator";
const description =
  "Create a professional purchase order online for free. Add buyer, supplier, delivery terms, item lines, authorization details, barcode, totals, and print or save as PDF. No sign-up required.";
const canonical = "https://www.worowo.com/quotes-invoices/purchase-order-generator/";

const faqItems = [
  {
    question: "Is this purchase order generator free?",
    answer:
      "Yes. You can create, edit, print, or save your purchase order as PDF for free. No sign-up required.",
  },
  {
    question: "Can I customize the purchase order?",
    answer:
      "Yes. You can fill in buyer, vendor, shipping details, item rows, taxes, notes, and authorization details directly on the document.",
  },
  {
    question: "Can I download the purchase order as a PDF?",
    answer:
      "Yes. Use the Print / Save as PDF button and choose your browser PDF option.",
  },
  {
    question: "Who can use this tool?",
    answer:
      "Small businesses, procurement teams, wholesalers, importers, and trading companies can use it for supplier purchase records.",
  },
];

const relatedTools = getRelatedToolsForTool("purchase_order_generator");
---

<DocumentGeneratorLayout
  config={{
    title,
    description,
    canonical,
    categoryName: "Quotes & Invoices",
    categoryHref: "/quotes-invoices/",
    breadcrumbCurrent: "Free Purchase Order Generator",
    backLabel: "Back to Quotes & Invoices",
    printHref: "#print",
  }}
  relatedTools={relatedTools}
  faqItems={faqItems}
>
  <div class="inline-document-mobile-shell" slot="document">
    <div class="desktop-document-editor">
      <div id="purchase-order-document" class="inline-document-root paper-a4 purchase-order-sentinel">
        <div class="inline-document-inner">
          <div class="document-title-row">
            <input
              id="documentLogoText"
              class="document-logo-text"
              type="text"
              placeholder="Your Business Name"
              aria-label="Business name or logo text"
              data-field="businessName"
            />

            <div class="document-title">PURCHASE ORDER</div>
          </div>

          <div class="doc-header">
            <div>
              <div class="doc-subtitle editor-hint no-print">Buyer document for ordering goods or services</div>
            </div>

            <div class="doc-meta po-doc-meta">
              <div class="po-barcode-slot">
                <div class="po-barcode-block" id="poBarcodeBlock" hidden>
                  <svg id="poBarcode" aria-label="Purchase order barcode"></svg>
                  <span class="po-barcode-empty">Enter PO No.</span>
                </div>
              </div>
              <div class="field-row po-meta-row po-meta-row-number">
                <button type="button" class="barcode-action-btn no-print" id="toggleBarcodeBtn">
                  <span class="barcode-action-icon" aria-hidden="true">▥</span>
                  <span class="barcode-action-label">Show Barcode</span>
                </button>
                <span class="field-label print-label">PO No.:</span>
                <input id="poNumber" class="doc-input inline-input po-meta-input" type="text" maxlength="24" placeholder="PO No." data-field="poNumber" />
              </div>
              <div class="field-row po-meta-row">
                <span class="po-meta-action-spacer no-print" aria-hidden="true"></span>
                <span class="field-label print-label">PO Date:</span>
                <input id="poDate" class="doc-input inline-input po-meta-input" type="date" placeholder="PO Date" data-field="poDate" />
              </div>
              <div class="field-row po-meta-row">
                <span class="po-meta-action-spacer no-print" aria-hidden="true"></span>
                <span class="field-label print-label">Expected Delivery:</span>
                <input id="deliveryDate" class="doc-input inline-input po-meta-input" type="date" placeholder="Expected Delivery" data-field="deliveryDate" />
              </div>
            </div>
          </div>

          <section class="doc-section">
            <div class="two-col">
              <div class="box">
                <h2 class="section-title">Buyer</h2>
                <div class="field-row field-row-block">
                  <input id="buyerName" class="doc-input" type="text" placeholder="Company Name" data-field="buyerName" />
                </div>
                <div class="field-row field-row-block">
                  <textarea id="buyerAddress" class="doc-textarea compact-area" rows="2" placeholder="Address" data-field="buyerAddress"></textarea>
                </div>
                <div class="field-row field-row-block">
                  <input id="buyerContact" class="doc-input" type="text" placeholder="Email / Phone" data-field="buyerContact" />
                </div>
              </div>

              <div class="box">
                <h2 class="section-title">Vendor / Supplier</h2>
                <div class="field-row field-row-block">
                  <input id="vendorName" class="doc-input" type="text" placeholder="Company Name" data-field="vendorName" />
                </div>
                <div class="field-row field-row-block">
                  <textarea id="vendorAddress" class="doc-textarea compact-area" rows="2" placeholder="Address" data-field="vendorAddress"></textarea>
                </div>
                <div class="field-row field-row-block">
                  <input id="vendorContact" class="doc-input" type="text" placeholder="Email / Phone" data-field="vendorContact" />
                </div>
              </div>
            </div>
          </section>

          <section class="doc-section">
            <h2 class="section-title">Delivery & Order Terms</h2>
            <div class="box">
              <div class="three-col">
                <div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Ship To:</span>
                    <input id="deliveryAddress" class="doc-input" type="text" placeholder="Delivery Address" data-field="deliveryAddress" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Shipping Method:</span>
                    <input id="shippingMethod" class="doc-input" type="text" placeholder="Air / Sea / Courier" data-field="shippingMethod" />
                  </div>
                </div>
                <div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Delivery Terms:</span>
                    <input id="deliveryTerms" class="doc-input" type="text" placeholder="Delivery terms or instructions" data-field="deliveryTerms" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Payment Terms:</span>
                    <input id="paymentTerms" class="doc-input" type="text" placeholder="Net 30 / Prepaid" data-field="paymentTerms" />
                  </div>
                </div>
                <div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Incoterms:</span>
                    <input id="incoterms" class="doc-input" type="text" placeholder="EXW / FOB / CIF" data-field="incoterms" />
                  </div>
                  <div class="field-row field-row-block">
                    <span class="field-label">Reference No.:</span>
                    <input id="referenceNumber" class="doc-input" type="text" placeholder="Reference No." data-field="referenceNumber" />
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="doc-section">
            <div class="section-title-row">
              <h2 class="section-title">Items</h2>
              <div class="items-actions">
                <label class="currency-control no-print">
                  <span class="currency-icon" aria-hidden="true">$</span>
                  <span class="currency-label">Currency</span>
                  <select id="currencyCode" class="currency-select" data-field="currencyCode">
                    {commonCurrencyOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                  </select>
                </label>
                <button type="button" class="add-item-btn edit-only" id="addItemBtn" data-add-item-trigger>
                  <span class="add-item-icon" aria-hidden="true">+</span>
                  <span>Add Item</span>
                </button>
              </div>
            </div>

            <table class="doc-table">
              <thead>
                <tr>
                  <th style="width: 33%;">Description</th>
                  <th style="width: 11%;">SKU</th>
                  <th style="width: 8%;">Qty</th>
                  <th style="width: 10%;">Unit</th>
                  <th style="width: 13%;">Unit Price</th>
                  <th style="width: 9%;">Tax %</th>
                  <th style="width: 13%;">Amount</th>
                  <th class="edit-only" style="width: 3%;"></th>
                </tr>
              </thead>
              <tbody id="itemsTableBody"></tbody>
            </table>
          </section>

          <section class="doc-section">
            <div class="two-col notes-totals-row">
              <div class="box">
                <h2 class="section-title">Notes</h2>
                <textarea id="poNotes" class="doc-textarea compact-remarks" rows="2" data-field="notes"></textarea>
              </div>

              <div class="box totals-box">
                <div class="totals-panel">
                  <div class="total-row"><span>Subtotal</span><strong id="subtotalValue">USD 0.00</strong></div>
                  <div class="total-row"><span>Tax</span><strong id="taxValue">USD 0.00</strong></div>
                  <div class="total-row total-adjustment-row"><span>Shipping / Handling</span><input id="shippingHandling" class="doc-input inline-input short-inline-input total-adjustment-input" type="number" min="0" step="0.01" value="0" data-clear-zero-on-focus="true" data-default-value="0" data-field="shippingHandling" /></div>
                  <div class="total-row total-row-grand"><span>Total</span><output id="grandTotalValue" class="total-output">USD 0.00</output></div>
                </div>
              </div>
            </div>
          </section>

          <section class="doc-section signature-grid">
            <div class="two-col">
              <div class="box">
                <h2 class="section-title">Authorized By</h2>
                <input id="preparedBy" class="doc-input" type="text" data-field="preparedBy" />
              </div>
              <div class="box">
                <h2 class="section-title">Supplier Acknowledgement</h2>
                <input id="poSignature" class="doc-input" type="text" data-field="signature" />
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>

    <div class="mobile-document-editor no-print">
      <div class="mobile-action-card">
        <a href="/quotes-invoices/" class="mobile-back-btn">Back to Quotes & Invoices</a>
        <div class="mobile-paper-size">
          <span class="mobile-paper-size-label">Paper Size</span>
          <div class="mobile-paper-toggle" aria-label="Paper size">
            <button type="button" class="paper-btn" data-paper-size="letter">US Letter</button>
            <button type="button" class="paper-btn is-active" data-paper-size="a4">A4</button>
          </div>
        </div>
      </div>

      <section class="mobile-form-card">
        <h2>Business & PO Info</h2>
        <input class="mobile-input mobile-logo-input" type="text" placeholder="Your Business Name" data-field="businessName" />
        <input class="mobile-input" type="text" placeholder="PO No." data-field="poNumber" />
        <button type="button" class="barcode-action-btn barcode-action-btn--mobile no-print" id="mobileToggleBarcodeBtn">
          <span class="barcode-action-icon" aria-hidden="true">▥</span>
          <span class="barcode-action-label">Show Barcode</span>
        </button>
        <input class="mobile-input" type="date" data-field="poDate" />
        <input class="mobile-input" type="date" data-field="deliveryDate" />
      </section>

      <section class="mobile-form-card">
        <h2>Buyer</h2>
        <input class="mobile-input" type="text" placeholder="Company Name" data-field="buyerName" />
        <textarea class="mobile-textarea" placeholder="Address" data-field="buyerAddress"></textarea>
        <input class="mobile-input" type="text" placeholder="Email / Phone" data-field="buyerContact" />
      </section>

      <section class="mobile-form-card">
        <h2>Vendor / Supplier</h2>
        <input class="mobile-input" type="text" placeholder="Company Name" data-field="vendorName" />
        <textarea class="mobile-textarea" placeholder="Address" data-field="vendorAddress"></textarea>
        <input class="mobile-input" type="text" placeholder="Email / Phone" data-field="vendorContact" />
      </section>

      <section class="mobile-form-card">
        <h2>Delivery & Order Terms</h2>
        <input class="mobile-input" type="text" placeholder="Delivery Address / Ship To" data-field="deliveryAddress" />
        <input class="mobile-input" type="text" placeholder="Shipping Method" data-field="shippingMethod" />
        <input class="mobile-input" type="text" placeholder="Delivery Terms" data-field="deliveryTerms" />
        <input class="mobile-input" type="text" placeholder="Payment Terms" data-field="paymentTerms" />
        <input class="mobile-input" type="text" placeholder="Incoterms" data-field="incoterms" />
        <input class="mobile-input" type="text" placeholder="Reference No." data-field="referenceNumber" />
      </section>

      <section class="mobile-form-card">
        <div class="mobile-section-header">
          <h2>Items</h2>
          <div class="items-actions items-actions--mobile">
            <label class="currency-control">
              <span class="currency-icon" aria-hidden="true">$</span>
              <span class="currency-label">Currency</span>
              <select class="mobile-select currency-select" data-field="currencyCode">
                {commonCurrencyOptions.map((option) => <option value={option.value}>{option.label}</option>)}
              </select>
            </label>
            <button type="button" class="mobile-add-item-btn" data-add-item-trigger>+ Add Item</button>
          </div>
        </div>
        <div id="mobileItemsList" class="mobile-items-list"></div>
      </section>

      <section class="mobile-form-card">
        <h2>Notes & Authorization</h2>
        <textarea class="mobile-textarea" placeholder="Notes" data-field="notes"></textarea>
        <input class="mobile-input" type="text" placeholder="Authorized By" data-field="preparedBy" />
        <input class="mobile-input" type="text" placeholder="Supplier Acknowledgement" data-field="signature" />
        <div class="mobile-total-card">
          <div><span>Subtotal</span><strong id="mobileSubtotalValue">USD 0.00</strong></div>
          <div><span>Tax</span><strong id="mobileTaxValue">USD 0.00</strong></div>
          <label class="mobile-total-input-row"><span>Shipping / Handling</span><input class="mobile-input" type="number" min="0" step="0.01" data-field="shippingHandling" data-clear-zero-on-focus="true" data-default-value="0" /></label>
          <div class="grand-total"><span>Total</span><output id="mobileGrandTotalValue" class="total-output">USD 0.00</output></div>
        </div>
      </section>
    </div>

    <div class="mobile-bottom-action-bar no-print">
      <button type="button" class="mobile-reset-btn" data-reset-form-trigger>
        <span class="reset-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path d="M12 5a7 7 0 1 1-6.67 9.12 1 1 0 1 1 1.91-.59A5 5 0 1 0 8.1 8.3H11a1 1 0 1 1 0 2H5a1 1 0 0 1-1-1V3a1 1 0 1 1 2 0v3.32A8.97 8.97 0 0 1 12 5z" fill="currentColor"></path>
          </svg>
        </span>
        <span>Reset</span>
      </button>

      <a
        href="#print"
        class="mobile-print-btn"
        data-print-document
        title="Generate and download professional PDF purchase order"
        aria-label="Generate and download professional PDF purchase order"
      >
        <svg class="mobile-print-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M7 2h8l5 5v3h-2V8h-4V4H7v6H5V4a2 2 0 0 1 2-2z" fill="currentColor"></path>
          <path d="M6 12h12a3 3 0 0 1 3 3v4h-4v3H7v-3H3v-4a3 3 0 0 1 3-3zm3 8h6v-4H9v4z" fill="currentColor"></path>
          <path d="M16 9h3v3h-3z" fill="currentColor"></path>
        </svg>
        <span>Print / Save as PDF</span>
      </a>
      <p class="mobile-privacy-note">Your data is processed locally in your browser and is not stored on our servers.</p>
    </div>
  </div>

  <article class="content-card" slot="guide">
    <h2>How This Purchase Order Generator Works</h2>
    <p>
      Fill in buyer, supplier, shipping terms, and item lines directly on the purchase order. The document stays
      print-ready while item totals and tax amounts update automatically.
    </p>
  </article>

  <article class="content-card" slot="guide">
    <h2>When to Use It</h2>
    <p>
      Use this purchase order generator when ordering products, confirming supplier pricing, preparing procurement
      records, or sending clear buying instructions to vendors.
    </p>
  </article>

  <article class="content-card" slot="guide">
    <h2>Why It Helps</h2>
    <p>
      A structured purchase order keeps supplier communication clearer, reduces manual formatting work, and gives both
      buyer and vendor a clean record of quantities, prices, and terms.
    </p>
  </article>

  <style>
    .purchase-order-sentinel {
      --purchase-order-sentinel: 1;
    }

    .po-doc-meta {
      min-width: 292px;
      display: grid;
      gap: 8px;
      justify-items: stretch;
      align-content: start;
    }

    .po-barcode-slot {
      display: flex;
      justify-content: flex-end;
      min-height: 0;
    }

    .po-barcode-block {
      width: 3.5cm;
      height: 1.8cm;
      margin-top: 4px;
      padding: 2mm 4mm;
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #ffffff;
      border: 1px dashed #cbd5e1;
      border-radius: 6px;
      overflow: hidden;
      position: relative;
    }

    .po-barcode-block svg {
      display: block;
      width: 100%;
      height: 100%;
    }

    .po-barcode-empty {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #94a3b8;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-align: center;
      padding: 0 2mm;
    }

    .po-barcode-block[data-barcode-ready="true"] .po-barcode-empty {
      display: none;
    }

    .po-barcode-block[hidden] {
      display: none !important;
    }

    .po-meta-row {
      display: grid;
      grid-template-columns: auto 118px 15ch;
      align-items: center;
      gap: 8px;
      width: max-content;
      margin-left: auto;
    }

    .po-meta-input {
      width: 15ch;
      min-width: 0;
      max-width: 15ch;
    }

    .po-meta-action-spacer {
      width: 130px;
      min-width: 130px;
      height: 1px;
      display: block;
    }

    .barcode-action-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 36px;
      padding: 0 14px;
      border: 1px solid #93c5fd;
      border-radius: 999px;
      background: #eff6ff;
      color: #2563eb;
      font-size: 13px;
      font-weight: 800;
      line-height: 1;
      cursor: pointer;
      white-space: nowrap;
      transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    }

    .barcode-action-btn:hover {
      background: #dbeafe;
      border-color: #60a5fa;
      color: #1d4ed8;
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(37, 99, 235, 0.12);
    }

    .barcode-action-btn.is-active {
      background: #dbeafe;
      border-color: #60a5fa;
      color: #1d4ed8;
      box-shadow: 0 8px 20px rgba(37, 99, 235, 0.12);
    }

    .barcode-action-icon {
      width: 18px;
      height: 18px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #2563eb;
      color: #ffffff;
      font-size: 12px;
      line-height: 1;
      font-weight: 900;
      flex: 0 0 auto;
    }

    .barcode-action-btn--mobile {
      width: 100%;
      justify-content: center;
      margin-bottom: 12px;
    }

    .total-adjustment-row {
      align-items: center;
    }

    .total-adjustment-input {
      width: 110px;
      max-width: 110px;
      text-align: right;
      justify-self: end;
    }

    .mobile-total-input-row {
      display: grid;
      grid-template-columns: 1fr minmax(130px, 42%);
      align-items: center;
      gap: 10px;
      margin: 10px 0;
      color: #64748b;
      font-size: 13px;
      font-weight: 800;
    }

    .mobile-total-input-row .mobile-input {
      margin: 0;
      min-height: 40px;
      text-align: right;
    }

    #poNotes {
      font-size: 9.5pt;
      line-height: 1.45;
    }

    @media print {
      #purchase-order-document .inline-document-inner {
        padding: 44px 40px 38px !important;
      }

      #purchase-order-document .document-title-row {
        margin-bottom: 18px !important;
      }

      #purchase-order-document .doc-header {
        gap: 18px !important;
        padding-bottom: 10px !important;
      }

      #purchase-order-document .doc-section {
        margin-top: 12px !important;
      }

      #purchase-order-document .two-col,
      #purchase-order-document .three-col {
        gap: 14px !important;
      }

      #purchase-order-document .box {
        padding: 10px !important;
      }

      #purchase-order-document .section-title-row {
        margin-bottom: 8px !important;
      }

      #purchase-order-document .field-row-block {
        gap: 4px !important;
        margin-bottom: 8px !important;
      }

      #purchase-order-document .compact-area,
      #purchase-order-document .compact-remarks {
        min-height: 52px !important;
      }

      #poNotes {
        font-size: 9.5pt !important;
        line-height: 1.45 !important;
      }

      .barcode-action-btn,
      .po-barcode-empty {
        display: none !important;
      }

      .po-barcode-block {
        border: 0 !important;
        border-radius: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
        margin-top: 2px !important;
      }

      #purchase-order-document .doc-table th,
      #purchase-order-document .doc-table td {
        padding-top: 5px !important;
        padding-bottom: 5px !important;
      }
    }
  </style>

  <script>
    import JsBarcode from "jsbarcode";

    document.documentElement?.setAttribute("data-worowo-inline-script", "1");
    const documentRoot = document.getElementById("purchase-order-document");
    const itemsTableBody = document.getElementById("itemsTableBody");
    const mobileItemsList = document.getElementById("mobileItemsList");
    const barcodeBlock = document.getElementById("poBarcodeBlock");
    const barcodeSvg = document.getElementById("poBarcode");
    const toggleBarcodeButtons = Array.from(document.querySelectorAll("#toggleBarcodeBtn, #mobileToggleBarcodeBtn"));
    const resetTriggers = Array.from(document.querySelectorAll("[data-reset-form-trigger], #resetFormBtn"));
    const printTriggers = Array.from(document.querySelectorAll("[data-print-document]"));
    const paperButtons = Array.from(document.querySelectorAll("[data-paper-size]"));

    const syncFields = [
      "businessName",
      "poNumber",
      "poDate",
      "deliveryDate",
      "currencyCode",
      "buyerName",
      "buyerAddress",
      "buyerContact",
      "vendorName",
      "vendorAddress",
      "vendorContact",
      "paymentTerms",
      "shippingMethod",
      "deliveryAddress",
      "deliveryTerms",
      "incoterms",
      "referenceNumber",
      "shippingHandling",
      "notes",
      "preparedBy",
      "signature",
    ];

    let nextItemId = 3;

    function updateNextItemId() {
      const numericIds = state.items
        .map((item) => Number.parseInt(String(item.id).replace("item-", ""), 10))
        .filter((value) => Number.isFinite(value));
      nextItemId = numericIds.length > 0 ? Math.max(...numericIds) + 1 : 1;
    }

    function defaultFields() {
      return {
        businessName: "",
        poNumber: "",
        poDate: "",
        deliveryDate: "",
        currencyCode: "USD",
        buyerName: "",
        buyerAddress: "",
        buyerContact: "",
        vendorName: "",
        vendorAddress: "",
        vendorContact: "",
        paymentTerms: "",
        shippingMethod: "",
        deliveryAddress: "",
        deliveryTerms: "",
        incoterms: "",
        referenceNumber: "",
        shippingHandling: "0",
        notes: "",
        preparedBy: "",
        signature: "",
      };
    }

    function createItem() {
      return {
        id: `item-${nextItemId++}`,
        description: "",
        sku: "",
        qty: "1",
        unit: "pcs",
        unitPrice: "0",
        tax: "0",
      };
    }

    const state = {
      paper: "a4",
      fields: defaultFields(),
      items: [createItem(), createItem()],
      barcodeVisible: false,
    };

    function toNumber(value) {
      const parsed = Number.parseFloat(value);
      return Number.isFinite(parsed) ? parsed : 0;
    }

    function currencyCode() {
      return state.fields.currencyCode.trim() || "USD";
    }

    function formatMoney(value) {
      return `${currencyCode()} ${value.toFixed(2)}`;
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
    }

    function lineAmounts(item) {
      const qty = toNumber(item.qty);
      const unitPrice = toNumber(item.unitPrice);
      const taxRate = toNumber(item.tax);
      const lineBase = qty * unitPrice;
      const lineTax = (lineBase * taxRate) / 100;
      return { lineBase, lineTax, lineTotal: lineBase + lineTax };
    }

    function calculateTotals() {
      let subtotal = 0;
      let taxTotal = 0;
      state.items.forEach((item) => {
        const { lineBase, lineTax } = lineAmounts(item);
        subtotal += lineBase;
        taxTotal += lineTax;
      });
      const shippingHandling = toNumber(state.fields.shippingHandling);
      return { subtotal, taxTotal, shippingHandling, grandTotal: subtotal + taxTotal + shippingHandling };
    }

    function renderSharedFields() {
      syncFields.forEach((field) => {
        document.querySelectorAll(`[data-field="${field}"]`).forEach((input) => {
          if (input.value !== state.fields[field]) {
            input.value = state.fields[field];
          }
        });
      });
    }

    function desktopItemRow(item) {
      const { lineTotal } = lineAmounts(item);
      return `
        <tr class="item-row" data-item-id="${item.id}">
          <td><input class="doc-input table-input item-description" type="text" data-item-id="${item.id}" data-item-field="description" value="${escapeHtml(item.description)}" /></td>
          <td><input class="doc-input table-input item-sku" type="text" data-item-id="${item.id}" data-item-field="sku" value="${escapeHtml(item.sku)}" /></td>
          <td><input class="doc-input table-input item-qty" type="number" min="0" step="1" data-item-id="${item.id}" data-item-field="qty" value="${escapeHtml(item.qty)}" /></td>
          <td><input class="doc-input table-input item-unit" type="text" placeholder="pcs" data-item-id="${item.id}" data-item-field="unit" value="${escapeHtml(item.unit)}" /></td>
          <td><input class="doc-input table-input item-unit-price" type="number" min="0" step="0.01" data-item-id="${item.id}" data-item-field="unitPrice" value="${escapeHtml(item.unitPrice)}" data-clear-zero-on-focus="true" data-default-value="0" /></td>
          <td><input class="doc-input table-input item-tax" type="number" min="0" step="0.01" data-item-id="${item.id}" data-item-field="tax" value="${escapeHtml(item.tax)}" data-clear-zero-on-focus="true" data-default-value="0" /></td>
          <td class="amount-cell"><span class="line-amount" data-item-line-total="${item.id}">${formatMoney(lineTotal)}</span></td>
          <td class="edit-only action-cell">
            <button type="button" class="item-delete-btn" aria-label="Remove item" data-remove-item="${item.id}">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path d="M9 3h6l1 2h4v2H4V5h4l1-2zm1 6h2v8h-2V9zm4 0h2v8h-2V9zM7 9h2v8H7V9zm-1 12h12a2 2 0 0 0 2-2V7H4v12a2 2 0 0 0 2 2z" fill="currentColor" />
              </svg>
            </button>
          </td>
        </tr>
      `;
    }

    function mobileItemCard(item, index) {
      const { lineTotal } = lineAmounts(item);
      return `
        <article class="mobile-item-card" data-item-id="${item.id}">
          <div class="mobile-item-title">
            <strong>Item ${index + 1}</strong>
            <button type="button" class="mobile-delete-item-btn" aria-label="Remove item" data-remove-item="${item.id}">Delete</button>
          </div>
          <input class="mobile-input" type="text" placeholder="Description" data-item-id="${item.id}" data-item-field="description" value="${escapeHtml(item.description)}" />
          <input class="mobile-input" type="text" placeholder="SKU" data-item-id="${item.id}" data-item-field="sku" value="${escapeHtml(item.sku)}" />
          <div class="mobile-two-col">
            <input class="mobile-input" type="number" placeholder="Qty" min="0" step="1" data-item-id="${item.id}" data-item-field="qty" value="${escapeHtml(item.qty)}" />
            <input class="mobile-input" type="text" placeholder="Unit" data-item-id="${item.id}" data-item-field="unit" value="${escapeHtml(item.unit)}" />
          </div>
          <div class="mobile-two-col">
            <input class="mobile-input" type="number" placeholder="Unit Price" min="0" step="0.01" data-item-id="${item.id}" data-item-field="unitPrice" value="${escapeHtml(item.unitPrice)}" data-clear-zero-on-focus="true" data-default-value="0" />
            <input class="mobile-input" type="number" placeholder="Tax %" min="0" step="0.01" data-item-id="${item.id}" data-item-field="tax" value="${escapeHtml(item.tax)}" data-clear-zero-on-focus="true" data-default-value="0" />
          </div>
          <div class="mobile-amount-box">
            <span>Line total</span>
            <strong data-item-line-total="${item.id}">${formatMoney(lineTotal)}</strong>
          </div>
        </article>
      `;
    }

    function renderItems() {
      updateNextItemId();
      if (itemsTableBody) {
        itemsTableBody.innerHTML = state.items.map((item) => desktopItemRow(item)).join("");
      }
      if (mobileItemsList) {
        mobileItemsList.innerHTML = state.items.map((item, index) => mobileItemCard(item, index)).join("");
      }
    }

    function renderTotals() {
      const { subtotal, taxTotal, grandTotal } = calculateTotals();

      document.querySelectorAll("[data-item-line-total]").forEach((el) => {
        const id = el.getAttribute("data-item-line-total");
        const item = state.items.find((entry) => entry.id === id);
        if (item) el.textContent = formatMoney(lineAmounts(item).lineTotal);
      });

      const targets = {
        subtotalValue: subtotal,
        taxValue: taxTotal,
        grandTotalValue: grandTotal,
        mobileSubtotalValue: subtotal,
        mobileTaxValue: taxTotal,
        mobileGrandTotalValue: grandTotal,
      };
      Object.entries(targets).forEach(([id, value]) => {
        const el = document.getElementById(id);
        if (el) el.textContent = formatMoney(value);
      });
    }

    function renderBarcode() {
      if (!(barcodeBlock instanceof HTMLElement) || !(barcodeSvg instanceof SVGElement)) return;

      const poValue = state.fields.poNumber.trim();
      const shouldShow = state.barcodeVisible;
      const canRenderBarcode = shouldShow && poValue !== "";

      barcodeBlock.hidden = !shouldShow;
      barcodeBlock.dataset.barcodeReady = canRenderBarcode ? "true" : "false";

      if (!shouldShow || !poValue) {
        barcodeSvg.innerHTML = "";
        return;
      }

      try {
        JsBarcode(barcodeSvg, poValue, {
          format: "CODE128",
          lineColor: "#111827",
          width: 1.1,
          height: 42,
          displayValue: false,
          margin: 0,
        });
      } catch (error) {
        console.error("Failed to render purchase order barcode", error);
        barcodeSvg.innerHTML = "";
        barcodeBlock.dataset.barcodeReady = "false";
      }
    }

    function updateBarcodeButtons() {
      toggleBarcodeButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.classList.toggle("is-active", state.barcodeVisible);
        const label = button.querySelector(".barcode-action-label");
        if (label) label.textContent = state.barcodeVisible ? "Hide Barcode" : "Show Barcode";
      });
    }

    function applyPaper(paper) {
      state.paper = paper === "letter" ? "letter" : "a4";
      documentRoot.classList.remove("paper-letter", "paper-a4");
      documentRoot.classList.add(state.paper === "letter" ? "paper-letter" : "paper-a4");
      paperButtons.forEach((btn) => {
        btn.classList.toggle("is-active", btn.dataset.paperSize === state.paper);
      });

      const styleId = "purchase-order-print-page-rule";
      let styleTag = document.getElementById(styleId);
      if (!styleTag) {
        styleTag = document.createElement("style");
        styleTag.id = styleId;
        document.head.appendChild(styleTag);
      }
      styleTag.textContent =
        state.paper === "letter"
          ? "@page { size: Letter portrait; margin: 0.55in 0.55in; }"
          : "@page { size: A4 portrait; margin: 14mm 14mm; }";
    }

    function addItem() {
      state.items.push(createItem());
      renderItems();
      renderTotals();
    }

    function removeItem(itemId) {
      if (state.items.length <= 1) return;
      state.items = state.items.filter((item) => item.id !== itemId);
      renderItems();
      renderTotals();
    }

    function resetDocumentForm() {
      state.fields = defaultFields();
      state.items = [createItem(), createItem()];
      state.barcodeVisible = false;
      renderSharedFields();
      renderItems();
      applyPaper("a4");
      renderTotals();
      renderBarcode();
      updateBarcodeButtons();
    }

    function updateField(field, value, source) {
      state.fields[field] = value;
      document.querySelectorAll(`[data-field="${field}"]`).forEach((input) => {
        if (input !== source && input.value !== value) {
          input.value = value;
        }
      });
      if (field === "poNumber") renderBarcode();
      renderTotals();
    }

    function updateItemField(itemId, field, value, source) {
      const item = state.items.find((entry) => entry.id === itemId);
      if (!item) return;
      item[field] = value;
      document.querySelectorAll(`[data-item-id="${itemId}"][data-item-field="${field}"]`).forEach((input) => {
        if (input !== source && input.value !== value) {
          input.value = value;
        }
      });
      renderTotals();
    }

    function preparePrintState() {
      documentRoot.querySelectorAll("input, textarea").forEach((field) => {
        const value = field.value.trim();
        if (value !== "") {
          field.classList.remove("print-empty-field");
          return;
        }
        field.classList.add("print-empty-field");
        if (field.placeholder) {
          field.dataset.restorePlaceholder = field.placeholder;
          field.placeholder = "";
        }
      });
    }

    function restorePrintVisualState() {
      document.body.classList.remove("inline-doc-print-reveal");
      documentRoot.querySelectorAll(".print-empty-field").forEach((field) => {
        field.classList.remove("print-empty-field");
        if (field.dataset.restorePlaceholder) {
          field.placeholder = field.dataset.restorePlaceholder;
          delete field.dataset.restorePlaceholder;
        }
      });
    }

    function handleDocumentPrint() {
      preparePrintState();
      document.body.classList.add("inline-doc-print-reveal");
      window.setTimeout(() => window.print(), 60);
    }

    function onPrintTrigger(event) {
      event.preventDefault();
      event.stopPropagation();
      handleDocumentPrint();
    }

    window.addEventListener("afterprint", restorePrintVisualState);

    document.addEventListener("input", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement)) return;

      const field = target.dataset.field;
      if (field) {
        updateField(field, target.value, target);
        return;
      }

      const itemId = target.dataset.itemId;
      const itemField = target.dataset.itemField;
      if (itemId && itemField) {
        updateItemField(itemId, itemField, target.value, target);
      }
    });

    document.addEventListener("change", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLSelectElement)) return;
      const field = target.dataset.field;
      if (field) updateField(field, target.value, target);
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (target.closest("#toggleBarcodeBtn, #mobileToggleBarcodeBtn")) {
        state.barcodeVisible = !state.barcodeVisible;
        renderBarcode();
        updateBarcodeButtons();
        return;
      }

      const removeButton = target.closest("[data-remove-item]");
      if (removeButton) {
        removeItem(removeButton.getAttribute("data-remove-item"));
        return;
      }

      if (target.closest("[data-add-item-trigger]")) {
        addItem();
      }
    });

    resetTriggers.forEach((trigger) => {
      trigger.addEventListener("click", resetDocumentForm);
    });

    paperButtons.forEach((btn) => {
      btn.addEventListener("click", () => applyPaper(btn.dataset.paperSize || "a4"));
    });

    printTriggers.forEach((trigger) => {
      trigger.addEventListener("click", onPrintTrigger);
    });

    window.handleDocumentPrint = handleDocumentPrint;

    renderSharedFields();
    renderItems();
    applyPaper(state.paper);
    renderTotals();
    renderBarcode();
    updateBarcodeButtons();
  </script>
</DocumentGeneratorLayout>
