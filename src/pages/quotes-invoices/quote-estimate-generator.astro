---
import DocumentGeneratorLayout from "../../components/document-generator/DocumentGeneratorLayout.astro";
import { commonCurrencyOptions } from "../../data/currencyOptions";
import { getRelatedToolsForTool } from "../../data/toolRelations";

const title = "Free Quote / Estimate Generator";
const description =
  "Create a professional quote or estimate online for free. Add client details, item lines, discounts, taxes, terms, and print or save as PDF. No sign-up required.";
const canonical = "https://www.worowo.com/quotes-invoices/quote-estimate-generator/";

const faqItems = [
  {
    question: "Is this quote generator free?",
    answer:
      "Yes. You can create, edit, print, or save your quote as PDF for free. No sign-up required.",
  },
  {
    question: "What is the difference between a quote and an estimate?",
    answer:
      "A quote is usually a fixed offer, while an estimate is an approximate price that may change after the final work scope is confirmed.",
  },
  {
    question: "Can I save the quote as a PDF?",
    answer:
      "Yes. Use the Print / Save as PDF button and choose your browser PDF option.",
  },
  {
    question: "Can I use this for service quotes and product quotes?",
    answer:
      "Yes. You can use it for services, products, freelance work, contractors, small business sales, and B2B quotes.",
  },
];

const relatedTools = getRelatedToolsForTool("quotation_estimate_generator");
---

<DocumentGeneratorLayout
  config={{
    title,
    description,
    canonical,
    categoryName: "Quotes & Invoices",
    categoryHref: "/quotes-invoices/",
    breadcrumbCurrent: "Free Quote / Estimate Generator",
    backLabel: "Back to Quotes & Invoices",
    printHref: "#print",
  }}
  relatedTools={relatedTools}
  faqItems={faqItems}
>
  <div slot="actionBarCenter" class="qe-toolbar-type-control no-print" data-qe-type-toolbar-control>
    <span class="qe-type-switch-label">Type</span>
    <div class="qe-type-switch-options" role="group" aria-label="Document type">
      <button type="button" class="qe-type-switch-btn is-active" data-document-type-option="Quote">Quote</button>
      <button type="button" class="qe-type-switch-btn" data-document-type-option="Estimate">Estimate</button>
    </div>
  </div>

  <div class="inline-document-mobile-shell" slot="document">
    <div class="desktop-document-editor">
      <div id="quote-estimate-document" class="inline-document-root paper-a4 quote-estimate-sentinel">
        <div class="inline-document-inner">
          <div class="document-title-row">
            <input
              id="documentLogoText"
              class="document-logo-text"
              type="text"
              placeholder="Your Business Name"
              aria-label="Business name or logo text"
              data-field="logoText"
            />

            <div class="document-title" id="documentTitlePreview">QUOTATION</div>
          </div>

          <div class="doc-header">
            <div>
              <div class="doc-subtitle editor-hint no-print">Price offer before an order is confirmed</div>
            </div>

            <div class="doc-meta">
              <div class="field-row">
                <span class="field-label print-label" id="documentNumberLabel">Quote No.:</span>
                <input id="documentNo" class="doc-input inline-input" type="text" placeholder="Quote No." data-field="documentNo" />
              </div>
              <div class="field-row">
                <span class="field-label print-label">Issue Date:</span>
                <input id="issueDate" class="doc-input inline-input" type="date" placeholder="Issue Date" data-field="issueDate" />
              </div>
              <div class="field-row">
                <span class="field-label print-label">Valid Until:</span>
                <input id="validUntil" class="doc-input inline-input" type="date" placeholder="Valid Until" data-field="validUntil" />
              </div>
            </div>
          </div>

          <section class="doc-section">
            <div class="two-col">
              <div class="box">
                <h2 class="section-title">From</h2>
                <div class="field-row field-row-block">
                  <input id="businessName" class="doc-input" type="text" placeholder="Business Name" data-field="businessName" />
                </div>
                <div class="field-row field-row-block">
                  <textarea id="businessAddress" class="doc-textarea compact-area" rows="2" placeholder="Address" data-field="businessAddress"></textarea>
                </div>
                <div class="field-row field-row-block">
                  <input id="businessContact" class="doc-input" type="text" placeholder="Email / Phone" data-field="businessContact" />
                </div>
              </div>

              <div class="box">
                <h2 class="section-title">To</h2>
                <div class="field-row field-row-block">
                  <input id="clientName" class="doc-input" type="text" placeholder="Client Name" data-field="clientName" />
                </div>
                <div class="field-row field-row-block">
                  <textarea id="clientAddress" class="doc-textarea compact-area" rows="2" placeholder="Address" data-field="clientAddress"></textarea>
                </div>
                <div class="field-row field-row-block">
                  <input id="clientContact" class="doc-input" type="text" placeholder="Email / Phone" data-field="clientContact" />
                </div>
              </div>
            </div>
          </section>

          <section class="doc-section">
            <div class="section-title-row">
              <h2 class="section-title">Items / Services</h2>
              <div class="items-actions">
                <label class="currency-control no-print">
                  <span class="currency-icon" aria-hidden="true">$</span>
                  <span class="currency-label">Currency</span>
                  <select id="currencyCode" class="currency-select" data-field="currencyCode">
                    {commonCurrencyOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                  </select>
                </label>
                <button type="button" class="add-item-btn edit-only" id="addItemBtn" data-add-item-trigger>
                  <span class="add-item-icon" aria-hidden="true">+</span>
                  <span>Add Item</span>
                </button>
              </div>
            </div>

            <table class="doc-table">
              <thead>
                <tr>
                  <th style="width: 36%;">Description</th>
                  <th style="width: 8%;">Qty</th>
                  <th style="width: 13%;">Unit Price</th>
                  <th style="width: 10%;">Discount %</th>
                  <th style="width: 9%;">Tax %</th>
                  <th style="width: 16%;">Amount</th>
                  <th class="edit-only" style="width: 8%;"></th>
                </tr>
              </thead>
              <tbody id="itemsTableBody"></tbody>
            </table>
          </section>

          <section class="doc-section">
            <div class="two-col notes-totals-row">
              <div class="box">
                <h2 class="section-title">Terms & Notes</h2>
                <div class="field-row field-row-block">
                  <span class="field-label">Terms:</span>
                  <textarea id="terms" class="doc-textarea compact-remarks" rows="2" placeholder="Terms" data-field="terms"></textarea>
                </div>
                <div class="field-row field-row-block">
                  <span class="field-label">Notes:</span>
                  <textarea id="notes" class="doc-textarea compact-remarks" rows="2" placeholder="Notes" data-field="notes"></textarea>
                </div>
              </div>

              <div class="box totals-box">
                <div class="totals-panel">
                  <div class="total-row"><span>Subtotal</span><strong id="subtotalValue">USD 0.00</strong></div>
                  <div class="total-row"><span>Discount</span><strong id="discountValue">USD 0.00</strong></div>
                  <div class="total-row"><span>Tax</span><strong id="taxValue">USD 0.00</strong></div>
                  <div class="total-row total-row-grand"><span>Total</span><output id="grandTotalValue" class="total-output">USD 0.00</output></div>
                </div>
              </div>
            </div>
          </section>

          <section class="doc-section signature-grid">
            <div class="two-col">
              <div class="box">
                <h2 class="section-title">Prepared By</h2>
                <input id="preparedBy" class="doc-input" type="text" data-field="preparedBy" />
              </div>
              <div class="box">
                <h2 class="section-title">Authorized Signature</h2>
                <input id="signature" class="doc-input" type="text" data-field="signature" />
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>

    <div class="mobile-document-editor no-print">
      <div class="mobile-action-card">
        <a href="/quotes-invoices/" class="mobile-back-btn">Back to Quotes & Invoices</a>
        <div class="qe-type-switch qe-type-switch--mobile" data-qe-type-mobile-control>
          <span class="qe-type-switch-label">Type</span>
          <div class="qe-type-switch-options" role="group" aria-label="Document type">
            <button type="button" class="qe-type-switch-btn is-active" data-document-type-option="Quote">Quote</button>
            <button type="button" class="qe-type-switch-btn" data-document-type-option="Estimate">Estimate</button>
          </div>
        </div>
        <div class="mobile-paper-size">
          <span class="mobile-paper-size-label">Paper Size</span>
          <div class="mobile-paper-toggle" aria-label="Paper size">
            <button type="button" class="paper-btn" data-paper-size="letter">US Letter</button>
            <button type="button" class="paper-btn is-active" data-paper-size="a4">A4</button>
          </div>
        </div>
      </div>

      <section class="mobile-form-card">
        <h2>Document Type & Numbers</h2>
        <input class="mobile-input mobile-logo-input" type="text" placeholder="Your Business Name (logo)" data-field="logoText" />
        <input class="mobile-input" type="text" placeholder="Quote No." data-field="documentNo" />
        <input class="mobile-input" type="date" data-field="issueDate" />
        <input class="mobile-input" type="date" data-field="validUntil" />
      </section>

      <section class="mobile-form-card">
        <h2>From</h2>
        <input class="mobile-input" type="text" placeholder="Business Name" data-field="businessName" />
        <textarea class="mobile-textarea" placeholder="Address" data-field="businessAddress"></textarea>
        <input class="mobile-input" type="text" placeholder="Email / Phone" data-field="businessContact" />
      </section>

      <section class="mobile-form-card">
        <h2>To</h2>
        <input class="mobile-input" type="text" placeholder="Client Name" data-field="clientName" />
        <textarea class="mobile-textarea" placeholder="Address" data-field="clientAddress"></textarea>
        <input class="mobile-input" type="text" placeholder="Email / Phone" data-field="clientContact" />
      </section>

      <section class="mobile-form-card">
        <div class="mobile-section-header">
          <h2>Items / Services</h2>
          <div class="items-actions items-actions--mobile">
            <label class="currency-control">
              <span class="currency-icon" aria-hidden="true">$</span>
              <span class="currency-label">Currency</span>
              <select class="mobile-select currency-select" data-field="currencyCode">
                {commonCurrencyOptions.map((option) => <option value={option.value}>{option.label}</option>)}
              </select>
            </label>
            <button type="button" class="mobile-add-item-btn" data-add-item-trigger>+ Add Item</button>
          </div>
        </div>
        <div id="mobileItemsList" class="mobile-items-list"></div>
      </section>

      <section class="mobile-form-card">
        <h2>Terms & Notes</h2>
        <textarea class="mobile-textarea" placeholder="Terms" data-field="terms"></textarea>
        <textarea class="mobile-textarea" placeholder="Notes" data-field="notes"></textarea>
        <input class="mobile-input" type="text" placeholder="Prepared By" data-field="preparedBy" />
        <input class="mobile-input" type="text" placeholder="Authorized Signature" data-field="signature" />
        <div class="mobile-total-card">
          <div><span>Subtotal</span><strong id="mobileSubtotalValue">USD 0.00</strong></div>
          <div><span>Discount</span><strong id="mobileDiscountValue">USD 0.00</strong></div>
          <div><span>Tax</span><strong id="mobileTaxValue">USD 0.00</strong></div>
          <div class="grand-total"><span>Total</span><output id="mobileGrandTotalValue" class="total-output">USD 0.00</output></div>
        </div>
      </section>
    </div>

    <div class="mobile-bottom-action-bar no-print">
      <button type="button" class="mobile-reset-btn" data-reset-form-trigger>
        <span class="reset-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path d="M12 5a7 7 0 1 1-6.67 9.12 1 1 0 1 1 1.91-.59A5 5 0 1 0 8.1 8.3H11a1 1 0 1 1 0 2H5a1 1 0 0 1-1-1V3a1 1 0 1 1 2 0v3.32A8.97 8.97 0 0 1 12 5z" fill="currentColor"></path>
          </svg>
        </span>
        <span>Reset</span>
      </button>

      <a
        href="#print"
        class="mobile-print-btn"
        data-print-document
        title="Generate and download professional PDF quote or estimate"
        aria-label="Generate and download professional PDF quote or estimate"
      >
        <svg class="mobile-print-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M7 2h8l5 5v3h-2V8h-4V4H7v6H5V4a2 2 0 0 1 2-2z" fill="currentColor"></path>
          <path d="M6 12h12a3 3 0 0 1 3 3v4h-4v3H7v-3H3v-4a3 3 0 0 1 3-3zm3 8h6v-4H9v4z" fill="currentColor"></path>
          <path d="M16 9h3v3h-3z" fill="currentColor"></path>
        </svg>
        <span>Print / Save as PDF</span>
      </a>
      <p class="mobile-privacy-note">Your data is processed locally in your browser and is not stored on our servers.</p>
    </div>
  </div>

  <article class="content-card" slot="guide">
    <h2>How This Quote / Estimate Generator Works</h2>
    <p>
      Choose Quote or Estimate, add client details, and enter item lines directly on the document. Subtotals,
      discounts, tax, and final totals update automatically while the page stays print-ready.
    </p>
  </article>

  <article class="content-card" slot="guide">
    <h2>When to Use It</h2>
    <p>
      Use this tool for service proposals, product quotes, contractor estimates, freelance work, B2B pricing, and
      customer approvals before final invoicing.
    </p>
  </article>

  <article class="content-card" slot="guide">
    <h2>Why It Helps</h2>
    <p>
      A clean quote or estimate helps customers review scope and pricing faster, while the editable document format
      reduces the back-and-forth of formatting separate previews.
    </p>
  </article>

  <style>
    .quote-estimate-sentinel {
      --quote-estimate-sentinel: 1;
    }

    .qe-toolbar-type-control {
      display: inline-flex;
    }

    .document-toolbar .qe-toolbar-type-control,
    .document-action-bar .qe-toolbar-type-control {
      margin-right: 2px;
    }

    .qe-type-switch,
    .qe-toolbar-type-control {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      min-height: 36px;
      padding: 0;
      font-size: 13px;
      font-weight: 750;
      line-height: 1;
      white-space: nowrap;
    }

    .qe-type-switch-label {
      font-size: 13px;
      font-weight: 750;
      color: #6b7280;
      white-space: nowrap;
    }

    .qe-type-switch-options {
      display: inline-flex;
      align-items: center;
      padding: 4px;
      border: 1px solid #d9e2ee;
      border-radius: 999px;
      background: #eef3f8;
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.8);
    }

    .qe-type-switch-btn {
      min-width: 84px;
      height: 36px;
      padding: 0 12px;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: #6b7280;
      font-size: 13px;
      font-weight: 750;
      cursor: pointer;
      transition:
        background-color 0.15s ease,
        color 0.15s ease,
        box-shadow 0.15s ease;
    }

    .qe-type-switch-btn.is-active {
      background: #2563eb;
      color: #ffffff;
      box-shadow: 0 6px 16px rgba(37, 99, 235, 0.22);
    }

    .qe-type-switch-btn:not(.is-active):hover {
      color: #1e293b;
      background: rgba(255, 255, 255, 0.72);
    }

    .qe-type-switch-btn:focus-visible {
      outline: none;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.2);
    }

    .qe-type-switch--mobile {
      width: 100%;
      box-sizing: border-box;
      justify-content: space-between;
    }

    @media screen and (max-width: 760px) {
      .document-toolbar .qe-toolbar-type-control,
      .document-action-bar .qe-toolbar-type-control,
      .invoice-action-bar .qe-toolbar-type-control {
        display: none !important;
      }
    }

    @media print {
      #quote-estimate-document .inline-document-inner {
        padding: 44px 40px 38px !important;
      }

      #quote-estimate-document .document-title-row {
        margin-bottom: 18px !important;
      }

      #quote-estimate-document .doc-header {
        gap: 18px !important;
        padding-bottom: 10px !important;
      }

      #quote-estimate-document .doc-section {
        margin-top: 12px !important;
      }

      #quote-estimate-document .two-col,
      #quote-estimate-document .three-col {
        gap: 14px !important;
      }

      #quote-estimate-document .box {
        padding: 10px !important;
      }

      #quote-estimate-document .section-title-row {
        margin-bottom: 8px !important;
      }

      #quote-estimate-document .field-row-block {
        gap: 4px !important;
        margin-bottom: 8px !important;
      }

      #quote-estimate-document .compact-area,
      #quote-estimate-document .compact-remarks {
        min-height: 52px !important;
      }

      #quote-estimate-document .doc-table th,
      #quote-estimate-document .doc-table td {
        padding-top: 5px !important;
        padding-bottom: 5px !important;
      }
    }
  </style>

  <script>
    document.documentElement?.setAttribute("data-worowo-inline-script", "1");
    const documentRoot = document.getElementById("quote-estimate-document");
    const itemsTableBody = document.getElementById("itemsTableBody");
    const mobileItemsList = document.getElementById("mobileItemsList");
    const resetTriggers = Array.from(document.querySelectorAll("[data-reset-form-trigger], #resetFormBtn"));
    const printTriggers = Array.from(document.querySelectorAll("[data-print-document]"));
    const paperButtons = Array.from(document.querySelectorAll("[data-paper-size]"));

    const syncFields = [
      "logoText",
      "documentType",
      "documentNo",
      "issueDate",
      "validUntil",
      "currencyCode",
      "businessName",
      "businessAddress",
      "businessContact",
      "clientName",
      "clientAddress",
      "clientContact",
      "terms",
      "notes",
      "preparedBy",
      "signature",
    ];

    let nextItemId = 3;

    function updateNextItemId() {
      const numericIds = state.items
        .map((item) => Number.parseInt(String(item.id).replace("item-", ""), 10))
        .filter((value) => Number.isFinite(value));
      nextItemId = numericIds.length > 0 ? Math.max(...numericIds) + 1 : 1;
    }

    function defaultFields() {
      return {
        logoText: "",
        documentType: "Quote",
        documentNo: "",
        issueDate: "",
        validUntil: "",
        currencyCode: "USD",
        businessName: "",
        businessAddress: "",
        businessContact: "",
        clientName: "",
        clientAddress: "",
        clientContact: "",
        terms: "",
        notes: "",
        preparedBy: "",
        signature: "",
      };
    }

    function createItem() {
      return {
        id: `item-${nextItemId++}`,
        description: "",
        qty: "1",
        unitPrice: "0",
        discount: "0",
        tax: "0",
      };
    }

    const state = {
      paper: "a4",
      fields: defaultFields(),
      items: [createItem(), createItem()],
    };

    function toNumber(value) {
      const parsed = Number.parseFloat(value);
      return Number.isFinite(parsed) ? parsed : 0;
    }

    function currencyCode() {
      return state.fields.currencyCode.trim() || "USD";
    }

    function formatMoney(value) {
      return `${currencyCode()} ${value.toFixed(2)}`;
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
    }

    function lineAmounts(item) {
      const qty = toNumber(item.qty);
      const unitPrice = toNumber(item.unitPrice);
      const discountRate = toNumber(item.discount);
      const taxRate = toNumber(item.tax);
      const lineBase = qty * unitPrice;
      const lineDiscount = (lineBase * discountRate) / 100;
      const taxable = Math.max(lineBase - lineDiscount, 0);
      const lineTax = (taxable * taxRate) / 100;
      const lineTotal = taxable + lineTax;
      return { lineBase, lineDiscount, lineTax, lineTotal };
    }

    function calculateTotals() {
      let subtotal = 0;
      let discountTotal = 0;
      let taxTotal = 0;
      state.items.forEach((item) => {
        const { lineBase, lineDiscount, lineTax } = lineAmounts(item);
        subtotal += lineBase;
        discountTotal += lineDiscount;
        taxTotal += lineTax;
      });
      const grandTotal = subtotal - discountTotal + taxTotal;
      return { subtotal, discountTotal, taxTotal, grandTotal };
    }

    function renderDocumentType() {
      const type = state.fields.documentType === "Estimate" ? "Estimate" : "Quote";
      const titlePreview = document.getElementById("documentTitlePreview");
      const numberLabel = document.getElementById("documentNumberLabel");
      if (titlePreview) titlePreview.textContent = type === "Estimate" ? "ESTIMATE" : "QUOTATION";
      if (numberLabel) numberLabel.textContent = `${type} No.:`;
      const numberPlaceholder = type === "Estimate" ? "Estimate No." : "Quote No.";
      document.querySelectorAll('[data-field="documentNo"]').forEach((el) => {
        if (el instanceof HTMLInputElement) el.placeholder = numberPlaceholder;
      });
      document.querySelectorAll("[data-document-type-option]").forEach((button) => {
        button.classList.toggle("is-active", button.getAttribute("data-document-type-option") === type);
        if (button instanceof HTMLButtonElement) {
          button.setAttribute("aria-pressed", button.getAttribute("data-document-type-option") === type ? "true" : "false");
        }
      });
    }

    function renderSharedFields() {
      syncFields.forEach((field) => {
        document.querySelectorAll(`[data-field="${field}"]`).forEach((input) => {
          const value = state.fields[field];
          if (input instanceof HTMLSelectElement) {
            if (input.value !== value) input.value = value;
          } else if (input.value !== value) {
            input.value = value;
          }
        });
      });
      renderDocumentType();
    }

    function desktopItemRow(item) {
      const { lineTotal } = lineAmounts(item);
      return `
        <tr class="item-row" data-item-id="${item.id}">
          <td><input class="doc-input table-input item-description" type="text" data-item-id="${item.id}" data-item-field="description" value="${escapeHtml(item.description)}" /></td>
          <td><input class="doc-input table-input item-qty" type="number" min="0" step="1" data-item-id="${item.id}" data-item-field="qty" value="${escapeHtml(item.qty)}" /></td>
          <td><input class="doc-input table-input item-unit-price" type="number" min="0" step="0.01" data-item-id="${item.id}" data-item-field="unitPrice" value="${escapeHtml(item.unitPrice)}" data-clear-zero-on-focus="true" data-default-value="0" /></td>
          <td><input class="doc-input table-input item-discount" type="number" min="0" step="0.01" data-item-id="${item.id}" data-item-field="discount" value="${escapeHtml(item.discount)}" data-clear-zero-on-focus="true" data-default-value="0" /></td>
          <td><input class="doc-input table-input item-tax" type="number" min="0" step="0.01" data-item-id="${item.id}" data-item-field="tax" value="${escapeHtml(item.tax)}" data-clear-zero-on-focus="true" data-default-value="0" /></td>
          <td class="amount-cell"><span class="line-amount" data-item-line-total="${item.id}">${formatMoney(lineTotal)}</span></td>
          <td class="edit-only action-cell">
            <button type="button" class="item-delete-btn" aria-label="Remove item" data-remove-item="${item.id}">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path d="M9 3h6l1 2h4v2H4V5h4l1-2zm1 6h2v8h-2V9zm4 0h2v8h-2V9zM7 9h2v8H7V9zm-1 12h12a2 2 0 0 0 2-2V7H4v12a2 2 0 0 0 2 2z" fill="currentColor" />
              </svg>
            </button>
          </td>
        </tr>
      `;
    }

    function mobileItemCard(item, index) {
      const { lineTotal } = lineAmounts(item);
      return `
        <article class="mobile-item-card" data-item-id="${item.id}">
          <div class="mobile-item-title">
            <strong>Item ${index + 1}</strong>
            <button type="button" class="mobile-delete-item-btn" aria-label="Remove item" data-remove-item="${item.id}">Delete</button>
          </div>
          <input class="mobile-input" type="text" placeholder="Description" data-item-id="${item.id}" data-item-field="description" value="${escapeHtml(item.description)}" />
          <div class="mobile-two-col">
            <input class="mobile-input" type="number" placeholder="Qty" min="0" step="1" data-item-id="${item.id}" data-item-field="qty" value="${escapeHtml(item.qty)}" />
            <input class="mobile-input" type="number" placeholder="Unit Price" min="0" step="0.01" data-item-id="${item.id}" data-item-field="unitPrice" value="${escapeHtml(item.unitPrice)}" data-clear-zero-on-focus="true" data-default-value="0" />
          </div>
          <div class="mobile-two-col">
            <input class="mobile-input" type="number" placeholder="Discount %" min="0" step="0.01" data-item-id="${item.id}" data-item-field="discount" value="${escapeHtml(item.discount)}" data-clear-zero-on-focus="true" data-default-value="0" />
            <input class="mobile-input" type="number" placeholder="Tax %" min="0" step="0.01" data-item-id="${item.id}" data-item-field="tax" value="${escapeHtml(item.tax)}" data-clear-zero-on-focus="true" data-default-value="0" />
          </div>
          <div class="mobile-amount-box">
            <span>Line total</span>
            <strong data-item-line-total="${item.id}">${formatMoney(lineTotal)}</strong>
          </div>
        </article>
      `;
    }

    function renderItems() {
      updateNextItemId();
      if (itemsTableBody) {
        itemsTableBody.innerHTML = state.items.map((item) => desktopItemRow(item)).join("");
      }
      if (mobileItemsList) {
        mobileItemsList.innerHTML = state.items.map((item, index) => mobileItemCard(item, index)).join("");
      }
    }

    function renderTotals() {
      const { subtotal, discountTotal, taxTotal, grandTotal } = calculateTotals();

      document.querySelectorAll("[data-item-line-total]").forEach((el) => {
        const id = el.getAttribute("data-item-line-total");
        const item = state.items.find((entry) => entry.id === id);
        if (item) el.textContent = formatMoney(lineAmounts(item).lineTotal);
      });

      const targets = {
        subtotalValue: subtotal,
        discountValue: discountTotal,
        taxValue: taxTotal,
        grandTotalValue: grandTotal,
        mobileSubtotalValue: subtotal,
        mobileDiscountValue: discountTotal,
        mobileTaxValue: taxTotal,
        mobileGrandTotalValue: grandTotal,
      };
      Object.entries(targets).forEach(([id, value]) => {
        const el = document.getElementById(id);
        if (el) el.textContent = formatMoney(value);
      });
    }

    function applyPaper(paper) {
      state.paper = paper === "letter" ? "letter" : "a4";
      documentRoot.classList.remove("paper-letter", "paper-a4");
      documentRoot.classList.add(state.paper === "letter" ? "paper-letter" : "paper-a4");
      paperButtons.forEach((btn) => {
        btn.classList.toggle("is-active", btn.dataset.paperSize === state.paper);
      });

      const styleId = "quote-estimate-print-page-rule";
      let styleTag = document.getElementById(styleId);
      if (!styleTag) {
        styleTag = document.createElement("style");
        styleTag.id = styleId;
        document.head.appendChild(styleTag);
      }
      styleTag.textContent =
        state.paper === "letter"
          ? "@page { size: Letter portrait; margin: 0.55in 0.55in; }"
          : "@page { size: A4 portrait; margin: 14mm 14mm; }";
    }

    function addItem() {
      state.items.push(createItem());
      renderItems();
      renderTotals();
    }

    function removeItem(itemId) {
      if (state.items.length <= 1) return;
      state.items = state.items.filter((item) => item.id !== itemId);
      renderItems();
      renderTotals();
    }

    function resetDocumentForm() {
      state.fields = defaultFields();
      state.items = [createItem(), createItem()];
      renderSharedFields();
      renderItems();
      applyPaper("a4");
      renderTotals();
    }

    function updateField(field, value, source) {
      state.fields[field] = value;
      document.querySelectorAll(`[data-field="${field}"]`).forEach((input) => {
        if (input === source) return;
        if (input instanceof HTMLSelectElement) {
          if (input.value !== value) input.value = value;
        } else if (input.value !== value) {
          input.value = value;
        }
      });
      if (field === "documentType") renderDocumentType();
      renderTotals();
    }

    function updateItemField(itemId, field, value, source) {
      const item = state.items.find((entry) => entry.id === itemId);
      if (!item) return;
      item[field] = value;
      document.querySelectorAll(`[data-item-id="${itemId}"][data-item-field="${field}"]`).forEach((input) => {
        if (input !== source && input.value !== value) {
          input.value = value;
        }
      });
      renderTotals();
    }

    function preparePrintState() {
      documentRoot.querySelectorAll("input, textarea").forEach((field) => {
        const value = field.value.trim();
        if (value !== "") {
          field.classList.remove("print-empty-field");
          return;
        }
        field.classList.add("print-empty-field");
        if (field.placeholder) {
          field.dataset.restorePlaceholder = field.placeholder;
          field.placeholder = "";
        }
      });
    }

    function restorePrintVisualState() {
      document.body.classList.remove("inline-doc-print-reveal");
      documentRoot.querySelectorAll(".print-empty-field").forEach((field) => {
        field.classList.remove("print-empty-field");
        if (field.dataset.restorePlaceholder) {
          field.placeholder = field.dataset.restorePlaceholder;
          delete field.dataset.restorePlaceholder;
        }
      });
    }

    function handleDocumentPrint() {
      preparePrintState();
      document.body.classList.add("inline-doc-print-reveal");
      window.setTimeout(() => window.print(), 60);
    }

    function onPrintTrigger(event) {
      event.preventDefault();
      event.stopPropagation();
      handleDocumentPrint();
    }

    window.addEventListener("afterprint", restorePrintVisualState);

    document.addEventListener("input", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement)) return;

      const field = target.dataset.field;
      if (field) {
        updateField(field, target.value, target);
        return;
      }

      const itemId = target.dataset.itemId;
      const itemField = target.dataset.itemField;
      if (itemId && itemField) {
        updateItemField(itemId, itemField, target.value, target);
      }
    });

    document.addEventListener("change", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLSelectElement)) return;
      const field = target.dataset.field;
      if (field) updateField(field, target.value, target);
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const typeButton = target.closest("[data-document-type-option]");
      if (typeButton) {
        const type = typeButton.getAttribute("data-document-type-option") === "Estimate" ? "Estimate" : "Quote";
        updateField("documentType", type, typeButton);
        return;
      }

      const removeButton = target.closest("[data-remove-item]");
      if (removeButton) {
        removeItem(removeButton.getAttribute("data-remove-item"));
        return;
      }

      if (target.closest("[data-add-item-trigger]")) {
        addItem();
      }
    });

    resetTriggers.forEach((trigger) => {
      trigger.addEventListener("click", resetDocumentForm);
    });

    paperButtons.forEach((btn) => {
      btn.addEventListener("click", () => applyPaper(btn.dataset.paperSize || "a4"));
    });

    printTriggers.forEach((trigger) => {
      trigger.addEventListener("click", onPrintTrigger);
    });

    window.handleDocumentPrint = handleDocumentPrint;

    renderSharedFields();
    renderItems();
    applyPaper(state.paper);
    renderTotals();
  </script>
</DocumentGeneratorLayout>
