---
interface RelatedTool {
  name: string;
  href: string;
  desc: string;
}

interface Props {
  tools?: RelatedTool[];
  title?: string;
}

const { tools = [], title = "Related Tools" } = Astro.props;
---

{tools.length > 0 && (
  <section class="tool-related-block">
    <h2 class="tool-block-title">{title}</h2>

    <div class="tool-related-grid">
      {tools.map((tool) => (
        <a href={tool.href} class="tool-related-tile">
          <span class="tool-related-name">{tool.name}</span>

          <span class="tool-related-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .tool-related-block {
    padding: 0 0 28px;
  }

  .tool-block-title {
    margin: 0 0 14px;
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .tool-related-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .tool-related-tile {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-width: 0;
    min-height: 82px;
    padding: 20px 18px;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    background: #ffffff;
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.04);
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease,
      box-shadow 0.18s ease;
  }

  .tool-related-tile::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: #2563eb;
    opacity: 0;
    transform: scaleX(0.6);
    transform-origin: left center;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  .tool-related-tile:hover {
    transform: translateY(-3px);
    border-color: #2563eb;
    background: #f8fbff;
    color: #2563eb;
    box-shadow: 0 18px 40px rgba(37, 99, 235, 0.14);
  }

  .tool-related-tile:hover::before {
    opacity: 1;
    transform: scaleX(1);
  }

  .tool-related-name {
    display: block;
    color: var(--text);
    font-size: 15px;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .tool-related-arrow {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #eff6ff;
    color: #2563eb;
    font-size: 1.15rem;
    font-weight: 800;
    flex-shrink: 0;
    transition:
      background-color 0.18s ease,
      color 0.18s ease,
      transform 0.18s ease;
  }

  .tool-related-tile:hover .tool-related-name {
    color: #2563eb;
  }

  .tool-related-tile:hover .tool-related-arrow {
    background: #2563eb;
    color: #ffffff;
    transform: translateX(2px);
  }

  @media (max-width: 980px) {
    .tool-related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .tool-related-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .tool-related-tile {
      min-height: 72px;
      padding: 17px 15px;
    }
  }
</style>
