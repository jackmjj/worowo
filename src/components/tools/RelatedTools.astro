---
interface RelatedTool {
  name: string;
  href: string;
  desc: string;
}

interface Props {
  tools?: RelatedTool[];
  title?: string;
}

const { tools = [], title = "Related Tools" } = Astro.props;
---

{tools.length > 0 && (
  <section class="tool-related-block">
    <h2 class="tool-block-title">{title}</h2>

    <div class="tool-related-grid">
      {tools.map((tool) => (
        <a href={tool.href} class="tool-related-tile">
          <span class="tool-related-name">{tool.name}</span>

          <span class="tool-related-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .tool-related-block {
    padding: 0 0 28px;
  }

  .tool-block-title {
    margin: 0 0 14px;
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .tool-related-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .tool-related-tile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
    min-height: 58px;
    padding: 15px 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #ffffff;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease,
      box-shadow 0.18s ease;
  }

  .tool-related-tile:hover {
    transform: translateY(-2px);
    border-color: #2563eb;
    background: #eff6ff;
    color: #2563eb;
    box-shadow: 0 14px 30px rgba(37, 99, 235, 0.12);
  }

  .tool-related-name {
    display: block;
    color: var(--text);
    font-size: 15px;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .tool-related-arrow {
    color: var(--primary);
    font-size: 1rem;
    font-weight: 800;
    flex-shrink: 0;
  }

  .tool-related-tile:hover .tool-related-name,
  .tool-related-tile:hover .tool-related-arrow {
    color: #2563eb;
  }

  @media (max-width: 980px) {
    .tool-related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .tool-related-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .tool-related-tile {
      min-height: 54px;
      padding: 14px 15px;
    }
  }
</style>
