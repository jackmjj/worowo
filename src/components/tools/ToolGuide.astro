---
interface Props {
  title?: string;
}

const { title = "Guide" } = Astro.props;
---

<section class="tool-guide-block">
  <h2 class="tool-guide-title">{title}</h2>
  <div class="tool-guide-grid">
    <slot />
  </div>
</section>

<style>
  .tool-guide-block {
    padding: 4px 0 28px;
  }

  .tool-guide-title {
    margin: 0 0 14px;
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .tool-guide-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .tool-guide-grid :global(.content-card) {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 16px 40px -28px rgba(15, 23, 42, 0.25);
    padding: 24px;
  }

  .tool-guide-grid :global(.content-card h2) {
    margin: 0 0 10px;
    font-size: 1.32rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .tool-guide-grid :global(.content-card p),
  .tool-guide-grid :global(.content-card li) {
    color: var(--text-soft);
    line-height: 1.9;
  }

  .tool-guide-grid :global(.content-card ul) {
    margin: 14px 0 0;
    padding-left: 18px;
  }

  .tool-guide-grid :global(.content-card:nth-child(3)) {
    grid-column: 1 / -1;
  }

  @media (max-width: 980px) {
    .tool-guide-grid {
      grid-template-columns: 1fr;
    }

    .tool-guide-grid :global(.content-card:nth-child(3)) {
      grid-column: auto;
    }
  }

  @media (max-width: 600px) {
    .tool-guide-grid :global(.content-card) {
      padding: 20px;
    }
  }
</style>
