---
import ToolActionBar from "../shared/ToolActionBar.astro";
import type { PaperType } from "../../lib/printable/types";

interface Props {
  currentPaper: PaperType;
  supportedPapers: PaperType[];
  backHref: string;
}

const { currentPaper, supportedPapers, backHref } = Astro.props;
---

<ToolActionBar
  backHref={backHref}
  backLabel="Back to Template Page"
  activePaper={currentPaper}
  supportedPapers={supportedPapers}
  showResetButton={false}
  className="topbar"
/>
