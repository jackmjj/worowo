---
import PaperSizeToggle from "../shared/PaperSizeToggle.astro";
import type { GeneratorPaperType } from "../../lib/generators/types";

interface Props {
  title: string;
  subtitle?: string;
  defaultPaper?: GeneratorPaperType;
  supportedPapers?: GeneratorPaperType[];
}

const {
  title,
  subtitle = "",
  defaultPaper = "a4",
  supportedPapers = ["letter", "a4"],
} = Astro.props as Props;
---

<div class="generator-preview-toolbar">
  <div class="generator-preview-toolbar__content">
    <h2 class="generator-preview-toolbar__title">{title}</h2>
    {subtitle && <p class="generator-preview-toolbar__subtitle">{subtitle}</p>}
  </div>

  <div class="generator-preview-toolbar__controls">
    <PaperSizeToggle
      activePaper={defaultPaper}
      papers={supportedPapers}
      dataAttributeName="data-paper-size"
    />
    <slot />
  </div>
</div>

<style>
  .generator-preview-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 16px;
    padding: 14px 16px;
    border: 1px solid #dbe4ef;
    border-radius: 16px;
    background: #ffffff;
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.06);
  }

  .generator-preview-toolbar__content {
    min-width: 0;
  }

  .generator-preview-toolbar__title {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.2;
    color: #0f172a;
  }

  .generator-preview-toolbar__subtitle {
    margin: 6px 0 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #64748b;
  }

  .generator-preview-toolbar__controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .generator-preview-toolbar {
      flex-direction: column;
      align-items: stretch;
    }

    .generator-preview-toolbar__controls {
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .generator-preview-toolbar__controls {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
