---
import ToolActionBar from "../../shared/ToolActionBar.astro";
import PrintActionFooter from "../../shared/PrintActionFooter.astro";
---

<div class="generator-actions">
  <ToolActionBar showBackButton={false} className="generator-actions__bar" />
  <PrintActionFooter showPrivacyNote={true} />
</div>

<style>
  .generator-actions {
    margin-top: 16px;
    display: grid;
    gap: 12px;
    justify-items: center;
    padding-top: 0;
    width: 100%;
  }

  .generator-actions__bar {
    width: 100%;
    margin: 0;
  }

  @media (max-width: 640px) {
    .generator-actions {
      gap: 10px;
    }
  }
</style>
