---
import DocumentPaper from "../shared/DocumentPaper.astro";
---

<section class="inv-preview-card">
  <div class="inv-preview-head">
    <h2 class="inv-preview-title">Invoice Preview</h2>
  </div>

  <DocumentPaper paperId="invoicePaper" defaultSize="a4">
    <div class="inv-doc-top">
      <div>
        <div class="inv-doc-title">INVOICE</div>
        <div class="inv-doc-subtitle">Professional invoice for products or services</div>
      </div>

      <div class="inv-doc-meta">
        <div><strong>Invoice No.</strong><span id="previewInvoiceNumber">INV-0001</span></div>
        <div><strong>Date</strong><span id="previewInvoiceDate">YYYY-MM-DD</span></div>
        <div><strong>Due Date</strong><span id="previewDueDate">YYYY-MM-DD</span></div>
      </div>
    </div>

    <div class="inv-doc-rule"></div>

    <div class="inv-doc-grid-2">
      <div class="inv-doc-box">
        <div class="inv-doc-box-title">From</div>
        <div id="previewSeller" class="inv-doc-content">Enter your business details</div>
      </div>

      <div class="inv-doc-box">
        <div class="inv-doc-box-title">Bill To</div>
        <div id="previewBuyer" class="inv-doc-content">Enter customer details</div>
      </div>
    </div>

    <div class="inv-doc-note-wrap">
      <div class="inv-doc-box-title">Notes</div>
      <div id="previewNotes" class="inv-doc-content inv-doc-note">Payment terms, project notes, or invoice remarks</div>
    </div>

    <table class="inv-doc-table">
      <thead>
        <tr>
          <th style="width: 40%;">Description</th>
          <th style="width: 12%;">Qty</th>
          <th style="width: 16%;">Unit Price</th>
          <th style="width: 12%;">Tax %</th>
          <th style="width: 20%;">Amount</th>
        </tr>
      </thead>
      <tbody id="previewInvoiceItemsBody"></tbody>
    </table>

    <div class="inv-doc-totals">
      <div class="inv-doc-totals-title">Totals</div>
      <div class="inv-doc-total-row"><span>Subtotal</span><strong id="previewSubtotal">$0.00</strong></div>
      <div class="inv-doc-total-row"><span>Tax</span><strong id="previewTax">$0.00</strong></div>
      <div class="inv-doc-total-row"><span>Discount</span><strong id="previewDiscount">$0.00</strong></div>
      <div class="inv-doc-total-row inv-doc-total-row-grand"><span>Grand Total</span><strong id="previewGrandTotal">$0.00</strong></div>
    </div>
  </DocumentPaper>
</section>

<style>
  .inv-preview-card {
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .inv-preview-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .inv-preview-title {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.3;
    letter-spacing: 0.08em;
    font-weight: 800;
    color: #475569;
    text-transform: uppercase;
  }

  .inv-doc-top {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: start;
  }

  .inv-doc-title {
    font-size: 30px;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #0f172a;
  }

  .inv-doc-subtitle {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.6;
    color: #64748b;
  }

  .inv-doc-meta {
    min-width: 280px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 13px;
    line-height: 1.45;
    color: #0f172a;
  }

  .inv-doc-meta div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 12px;
  }

  .inv-doc-meta strong {
    font-weight: 800;
  }

  .inv-doc-rule {
    height: 2px;
    background: #dbe4f0;
    margin: 18px 0 16px;
  }

  .inv-doc-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 14px;
  }

  .inv-doc-box,
  .inv-doc-note-wrap {
    border: 1px solid #dbe4f0;
    padding: 12px 12px 14px;
    background: #ffffff;
  }

  .inv-doc-box {
    min-height: 138px;
  }

  .inv-doc-box-title,
  .inv-doc-totals-title {
    margin: 0 0 8px;
    font-size: 11px;
    line-height: 1.25;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0f172a;
  }

  .inv-doc-content {
    font-size: 12px;
    line-height: 1.72;
    color: #0f172a;
    white-space: pre-line;
  }

  .inv-doc-note {
    min-height: 42px;
  }

  .inv-doc-placeholder {
    color: #94a3b8;
  }

  .inv-doc-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    margin-top: 14px;
  }

  .inv-doc-table th,
  .inv-doc-table td {
    border: 1px solid #dbe4f0;
    padding: 8px;
    font-size: 10.5px;
    line-height: 1.42;
    text-align: left;
    vertical-align: top;
  }

  .inv-doc-table th {
    background: #ffffff;
    color: #0f172a;
    font-weight: 800;
  }

  .inv-doc-totals {
    width: 320px;
    margin-left: auto;
    margin-top: 18px;
    border: 1px solid #dbe4f0;
    padding: 12px 12px 10px;
    background: #ffffff;
  }

  .inv-doc-total-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    font-size: 11.5px;
    color: #475569;
    padding: 4px 0;
  }

  .inv-doc-total-row-grand {
    margin-top: 4px;
    padding-top: 8px;
    border-top: 1px solid #dbe4f0;
    color: #0f172a;
    font-weight: 800;
  }

  @media (max-width: 760px) {
    .inv-doc-grid-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
