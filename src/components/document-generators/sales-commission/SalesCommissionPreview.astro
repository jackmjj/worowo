---
import DocumentPaper from "../shared/DocumentPaper.astro";
---

<DocumentPaper paperId="salesCommissionPaper" title="Monthly Commission Statement" className="sc-paper">
  <div class="sc-paper-head">
    <div>
      <h3 id="previewStatementTitle">Sales Commission Statement</h3>
      <p class="sc-paper-subtitle">Commission payout statement for payroll review, signatures, and records</p>
    </div>

    <div class="sc-paper-meta">
      <p><strong>Salesperson</strong> <span data-preview="salespersonName">—</span></p>
      <p><strong>Period</strong> <span id="previewStatementPeriod">—</span></p>
      <p><strong>Payout Date</strong> <span data-preview="payoutDate">—</span></p>
    </div>
  </div>

  <div class="sc-payout-hero">
    <span>Net Payout</span>
    <strong id="previewNetPayoutHero">0.00</strong>
    <small>Final payout after base salary, commission, bonus, and deductions.</small>
  </div>

  <div class="sc-summary-grid">
    <div class="sc-summary-card">
      <span>Total Sales</span>
      <strong id="previewSalesAmount">0.00</strong>
    </div>
    <div class="sc-summary-card">
      <span>Base Salary</span>
      <strong id="previewBaseSalary">0.00</strong>
    </div>
    <div class="sc-summary-card">
      <span>Total Commission</span>
      <strong id="previewTierCommission">0.00</strong>
    </div>
    <div class="sc-summary-card">
      <span>Gross Earnings</span>
      <strong id="previewGrossCommissionHero">0.00</strong>
    </div>
  </div>

  <div class="sc-paper-box">
    <h4>Commission Breakdown</h4>

    <table class="sc-tier-table">
      <thead>
        <tr>
          <th>Tier</th>
          <th>Sales Range</th>
          <th>Rate</th>
          <th>Commission</th>
        </tr>
      </thead>
      <tbody id="previewTierTableBody">
        <tr>
          <td colspan="4">Add tier settings to see the commission breakdown.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <table class="sc-paper-table">
    <tbody>
      <tr>
        <th>Base Salary</th>
        <td id="previewBaseSalaryTable">0.00</td>
      </tr>
      <tr>
        <th>Tiered Commission</th>
        <td id="previewTierCommissionTable">0.00</td>
      </tr>
      <tr>
        <th>Bonus Threshold</th>
        <td id="previewBonusThreshold">0.00</td>
      </tr>
      <tr>
        <th>Bonus Earned</th>
        <td id="previewBonusAmount">0.00</td>
      </tr>
      <tr>
        <th>Gross Earnings</th>
        <td id="previewGrossCommission">0.00</td>
      </tr>
      <tr>
        <th>Other Deductions</th>
        <td id="previewDeductions">0.00</td>
      </tr>
      <tr>
        <th>Net Payout</th>
        <td id="previewNetPayout">0.00</td>
      </tr>
    </tbody>
  </table>

  <div class="sc-paper-box">
    <h4>Notes</h4>
    <p data-preview="commissionNotes">—</p>
  </div>

  <div class="sc-paper-signature-grid">
    <div class="sc-paper-signature">
      <div>
        <span>Employee Signature</span>
        <strong>____________________________</strong>
      </div>
    </div>

    <div class="sc-paper-signature">
      <div>
        <span>Manager Signature</span>
        <strong>____________________________</strong>
      </div>
    </div>
  </div>
</DocumentPaper>

<style>
  .sc-paper {
    font-size: 14px;
  }

  .sc-paper-head {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    border-bottom: 1px solid #dbe4f0;
    padding-bottom: 22px;
    margin-bottom: 24px;
  }

  .sc-paper-head h3 {
    margin: 0;
    color: #0f172a;
    font-size: 28px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .sc-paper-subtitle {
    margin: 8px 0 0;
    color: #64748b;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .sc-paper-meta {
    min-width: 240px;
  }

  .sc-paper-meta p {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin: 0 0 7px;
    font-size: 0.9rem;
  }

  .sc-summary-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 18px;
  }

  .sc-payout-hero {
    margin-bottom: 16px;
    padding: 18px 20px;
    border: 1px solid #dbe4f0;
    border-radius: 20px;
    background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
  }

  .sc-payout-hero span {
    display: block;
    margin-bottom: 8px;
    color: #64748b;
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .sc-payout-hero strong {
    display: block;
    color: #0f172a;
    font-size: 34px;
    font-weight: 950;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .sc-payout-hero small {
    display: block;
    margin-top: 10px;
    color: #475569;
    font-size: 12px;
    line-height: 1.45;
  }

  .sc-summary-card {
    border: 1px solid #dbe4f0;
    border-radius: 18px;
    padding: 16px;
    background: #ffffff;
  }

  .sc-summary-card span {
    display: block;
    margin-bottom: 8px;
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .sc-summary-card strong {
    color: #0f172a;
    font-size: 22px;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .sc-paper-table,
  .sc-tier-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    margin-top: 18px;
    font-size: 0.85rem;
  }

  .sc-paper-table th,
  .sc-paper-table td,
  .sc-tier-table th,
  .sc-tier-table td {
    border: 1px solid #dbe3ef;
    padding: 10px;
    text-align: left;
    vertical-align: top;
  }

  .sc-paper-table th,
  .sc-tier-table th {
    background: #f8fafc;
    color: #0f172a;
    font-weight: 900;
  }

  .sc-paper-table th {
    width: 46%;
  }

  .sc-paper-box {
    border: 1px solid #dbe4f0;
    border-radius: 18px;
    padding: 16px;
    margin-top: 18px;
    background: #ffffff;
    color: #334155;
    overflow: visible;
  }

  .sc-paper-box h4 {
    margin: 0 0 10px;
    color: #0f172a;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .sc-paper-box p {
    margin: 0;
    white-space: pre-line;
  }

  .sc-paper-signature-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px;
    margin-top: 56px;
  }

  .sc-paper-signature div {
    border-top: 1px solid #94a3b8;
    padding-top: 10px;
  }

  .sc-paper-signature span {
    display: block;
    color: #64748b;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .sc-paper-signature strong {
    display: block;
    margin-top: 8px;
    color: #0f172a;
    font-size: 0.88rem;
  }

  @media (max-width: 900px) {
    .sc-summary-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sc-paper-signature-grid {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .sc-payout-hero {
      margin-bottom: 12px !important;
      padding: 12px 14px !important;
    }

    .sc-payout-hero strong {
      font-size: 26px !important;
    }

    .sc-paper-head {
      margin-bottom: 14px !important;
      padding-bottom: 14px !important;
    }

    .sc-paper-head h3 {
      font-size: 22px !important;
    }

    .sc-summary-card,
    .sc-paper-box {
      padding: 10px !important;
    }

    .sc-summary-grid {
      gap: 10px !important;
      margin-bottom: 12px !important;
    }

    .sc-paper-table,
    .sc-tier-table {
      margin-top: 12px !important;
      font-size: 9.5px !important;
    }

    .sc-paper-table th,
    .sc-paper-table td,
    .sc-tier-table th,
    .sc-tier-table td {
      padding: 5px !important;
    }

    .sc-paper-box {
      margin-top: 12px !important;
    }

    .sc-paper-signature-grid {
      gap: 22px !important;
      margin-top: 28px !important;
    }
  }
</style>
