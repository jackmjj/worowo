---
import CalculatorFormActions from "../../business-calculators/CalculatorFormActions.astro";

const YEAR_START = 2026;
const years = Array.from({ length: 8 }, (_, index) => YEAR_START + index);
const months = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];
const currencies = [
  { code: "USD", label: "USD $" },
  { code: "EUR", label: "EUR €" },
  { code: "GBP", label: "GBP £" },
  { code: "CNY", label: "CNY ¥" },
  { code: "JPY", label: "JPY ¥" },
  { code: "CAD", label: "CAD $" },
  { code: "AUD", label: "AUD $" },
];
---

<form id="salesCommissionForm" class="sc-form">
  <p class="sc-notice">
    Fill in the commission details below. The printable payout statement updates automatically as you type.
  </p>

  <section class="sc-section">
    <h2>Statement Details</h2>

    <div class="sc-grid sc-grid-2 sc-statement-details-grid">
      <label>
        Salesperson Name
        <input id="salespersonName" type="text" placeholder="Enter salesperson name" data-preview-field="salespersonName" />
      </label>

      <label class="sc-currency-field no-print">
        Currency
        <span class="sc-currency-control">
          <span class="sc-currency-icon" aria-hidden="true">$</span>
          <select id="commissionCurrency" class="sc-currency-select" aria-label="Currency">
            {currencies.map((currency) => <option value={currency.code}>{currency.label}</option>)}
          </select>
        </span>
      </label>

      <label>
        Period
        <div class="sc-period-fields">
          <select id="commissionMonth" data-period-field="month" aria-label="Commission month">
            <option value="">Month</option>
            {months.map((month) => <option value={month}>{month}</option>)}
          </select>

          <select id="commissionYear" data-period-field="year" aria-label="Commission year">
            <option value="">Year</option>
            {years.map((year) => <option value={String(year)}>{year}</option>)}
          </select>
        </div>
      </label>

      <label>
        Payout Date
        <input id="payoutDate" type="date" data-preview-field="payoutDate" />
      </label>
    </div>
  </section>

  <section class="sc-section">
    <h2>Commission Inputs</h2>

    <div class="sc-grid sc-grid-2">
      <div class="sc-mini-card">
        <h3>Sales & Salary</h3>

        <label>
          Total Sales Amount
          <input id="salesAmount" type="number" min="0" step="0.01" value="0" data-clear-zero-on-focus="true" data-default-value="0" />
        </label>

        <label>
          Base Salary
          <input id="baseSalary" type="number" min="0" step="0.01" value="0" data-clear-zero-on-focus="true" data-default-value="0" />
        </label>
      </div>

      <div class="sc-mini-card">
        <h3>Bonus & Deductions</h3>

        <label>
          Bonus Threshold
          <input id="bonusThreshold" type="number" min="0" step="0.01" value="0" data-clear-zero-on-focus="true" data-default-value="0" />
        </label>

        <label>
          Bonus Amount
          <input id="bonusAmount" type="number" min="0" step="0.01" value="0" data-clear-zero-on-focus="true" data-default-value="0" />
        </label>

        <label>
          Other Deductions
          <input id="deductions" type="number" min="0" step="0.01" value="0" data-clear-zero-on-focus="true" data-default-value="0" />
        </label>
      </div>
    </div>
  </section>

  <section class="sc-section">
    <div class="sc-section-head">
      <div>
        <h2>Tiered Commission</h2>
        <p class="sc-section-copy">
          Add one or more sales tiers. Leave the last "Up To" field blank to pay that rate on all remaining sales.
        </p>
      </div>

      <button type="button" id="addTierButton" class="sc-tier-action-btn">
        <span class="sc-tier-action-icon" aria-hidden="true">+</span>
        <span>Add Tier</span>
      </button>
    </div>

    <div id="commissionTierList" class="sc-tier-list" aria-live="polite"></div>
  </section>

  <section class="sc-section">
    <h2>Notes</h2>

    <textarea
      id="commissionNotes"
      rows="4"
      placeholder="Optional notes about targets, adjustments, or payment details"
      data-preview-field="commissionNotes"
      aria-label="Notes"
    ></textarea>
  </section>

  <CalculatorFormActions
    className="scc-form-actions"
    primaryLabel="Calculate Commission"
    primaryDataAttribute="data-calculate-commission"
  />

  <script type="module" src="/scripts/sales-commission.js?v=20260511b"></script>
</form>

<template id="commissionTierTemplate">
  <div class="sc-tier-row" data-tier-row>
    <div class="sc-tier-row-head">
      <strong data-tier-title>Tier 1</strong>
      <button type="button" class="sc-tier-remove-btn" data-remove-tier>
        Remove
      </button>
    </div>

    <div class="sc-grid sc-grid-2 sc-tier-fields">
      <label>
        Up To Sales Amount
        <input type="number" min="0" step="0.01" data-tier-field="cap" placeholder="Leave blank for no upper limit" />
      </label>

      <label>
        Commission Rate (%)
        <input type="number" min="0" step="0.01" data-tier-field="rate" value="0" data-clear-zero-on-focus="true" data-default-value="0" />
      </label>
    </div>
  </div>
</template>

<style>
  .sc-form {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    width: 100%;
    border: 1px solid #dbe4f0;
    border-radius: 24px;
    background: #ffffff;
    padding: 24px;
    box-shadow: 0 18px 44px -34px rgba(15, 23, 42, 0.18);
    box-sizing: border-box;
  }

  .sc-notice {
    margin: 0 0 22px;
    padding: 14px 16px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #f8fafc;
    color: #64748b;
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .sc-section + .sc-section {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid #e2e8f0;
  }

  .sc-section h2 {
    margin: 0 0 16px;
    color: #334155;
    font-size: 0.82rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .sc-grid {
    display: grid;
    gap: 16px;
  }

  .sc-grid-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .sc-grid-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .sc-statement-details-grid {
    align-items: end;
  }

  .sc-period-fields {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 10px;
  }

  .sc-currency-field {
    gap: 7px;
  }

  .sc-currency-control {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 52px;
    padding: 0 14px;
    border: 1px solid #93c5fd;
    border-radius: 999px;
    background: #eff6ff;
    color: #2563eb;
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1;
    cursor: pointer;
    white-space: nowrap;
    width: 100%;
    box-sizing: border-box;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .sc-currency-control:hover {
    background: #dbeafe;
    border-color: #60a5fa;
    color: #1d4ed8;
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(37, 99, 235, 0.12);
  }

  .sc-currency-control:focus-within {
    outline: none;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.2);
  }

  .sc-currency-icon {
    width: 18px;
    height: 18px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #2563eb;
    color: #ffffff;
    font-size: 13px;
    line-height: 1;
    font-weight: 900;
    flex: 0 0 auto;
  }

  .sc-currency-select {
    border: 0;
    background: transparent;
    color: #111827;
    font-size: 0.95rem;
    font-weight: 850;
    outline: none;
    cursor: pointer;
    padding: 0;
    flex: 1 1 auto;
    min-width: 0;
  }

  .sc-currency-select:hover,
  .sc-currency-select:focus {
    border-color: transparent !important;
    background: transparent !important;
    box-shadow: none !important;
  }

  .sc-section-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  .sc-section-copy {
    margin: -8px 0 0;
    color: #64748b;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .sc-mini-card {
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 18px;
    background: #ffffff;
  }

  .sc-mini-card h3 {
    margin: 0 0 14px;
    color: #475569;
    font-size: 0.82rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 7px;
    color: #334155;
    font-size: 0.95rem;
    font-weight: 800;
  }

  label + label {
    margin-top: 14px;
  }

  .sc-tier-list {
    display: grid;
    gap: 14px;
  }

  .sc-tier-row {
    border: 1px solid #dbe4f0;
    border-radius: 18px;
    padding: 16px;
    background: linear-gradient(180deg, #f8fbff 0%, #fdfefe 100%);
  }

  .sc-tier-row-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .sc-tier-row-head strong {
    color: #334155;
    font-size: 0.82rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .sc-tier-fields label + label {
    margin-top: 0;
  }

  .sc-tier-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 14px;
    border: 1px solid #93c5fd;
    border-radius: 999px;
    background: #eff6ff;
    color: #2563eb;
    font-size: 0.9rem;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .sc-tier-action-btn:hover {
    background: #dbeafe;
    border-color: #60a5fa;
    color: #1d4ed8;
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(37, 99, 235, 0.12);
  }

  .sc-tier-action-icon {
    width: 18px;
    height: 18px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #2563eb;
    color: #ffffff;
    font-size: 13px;
    line-height: 1;
    font-weight: 900;
  }

  .sc-tier-remove-btn {
    min-height: 32px;
    padding: 0 12px;
    border: 1px dashed #d7dce5;
    border-radius: 999px;
    background: #ffffff;
    color: #6b7280;
    font-size: 0.82rem;
    font-weight: 800;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .sc-tier-remove-btn:hover {
    border-color: #f59bb7;
    background: #fff8fb;
    color: #be185d;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    background: #ffffff;
    color: #0f172a;
    padding: 12px 13px;
    font-size: 1rem;
    outline: none;
    transition:
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      background 0.18s ease;
  }

  textarea {
    resize: vertical;
  }

  input::placeholder,
  textarea::placeholder {
    color: #94a3b8;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
  }

  @media (max-width: 900px) {
    .sc-form {
      padding: 18px;
      border-radius: 20px;
      box-shadow: 0 14px 36px -30px rgba(15, 23, 42, 0.16);
    }

    .sc-notice {
      margin-bottom: 18px;
      padding: 12px 14px;
      font-size: 13px;
    }

    .sc-section {
      padding: 16px;
      border: 1px solid #dbe4f0;
      border-radius: 18px;
      background: #ffffff;
    }

    .sc-grid-2,
    .sc-grid-3 {
      grid-template-columns: 1fr;
    }

    .sc-section + .sc-section {
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid #e2e8f0;
    }

    .sc-section-head {
      flex-direction: column;
      align-items: stretch;
    }

    .sc-mini-card {
      padding: 16px;
      border-radius: 16px;
      background: #f8fbff;
    }

    .sc-tier-row {
      padding: 14px;
      border-radius: 16px;
    }
  }

  @media (max-width: 640px) {
    .sc-form {
      padding: 16px;
    }

    .sc-period-fields {
      grid-template-columns: 1fr;
    }

    .sc-currency-control {
      justify-content: flex-start;
    }

    .sc-tier-action-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<style is:global>
  /* Match Profit Margin Calculator (.pm-actions / .pm-btn) for sales commission tool */
  .scc-form-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 28px;
    padding-top: 0;
    border-top: 0;
  }

  .scc-btn {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    height: 52px;
    padding: 0 24px;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.2;
    cursor: pointer;
    text-decoration: none;
    transition: 0.18s ease;
  }

  .scc-btn-secondary {
    border: 1px dashed #d7dce5;
    background: #ffffff;
    color: #6b7280;
  }

  .scc-btn-secondary:hover {
    border-color: #f59bb7;
    background: #fff8fb;
    color: #be185d;
    transform: translateY(-1px);
  }

  .scc-btn-primary {
    min-width: 180px;
    border: 1px solid #2563eb;
    background: #2563eb;
    color: #ffffff;
    box-shadow: 0 14px 30px -18px rgba(37, 99, 235, 0.7);
  }

  .scc-btn-primary:hover {
    background: #1d4ed8;
    border-color: #1d4ed8;
    transform: translateY(-1px);
  }

  @media (max-width: 700px) {
    .scc-form-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .scc-btn {
      width: 100%;
    }
  }
</style>
