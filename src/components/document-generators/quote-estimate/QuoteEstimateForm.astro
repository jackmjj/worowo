---
import GeneratorActions from "../shared/GeneratorActions.astro";
---

<form id="quoteEstimateForm" class="quote-form">
  <p class="notice">
    Fill in the details below. Your quote or estimate preview updates automatically as you type.
  </p>

  <section class="form-section">
    <h2>Document Details</h2>

    <div class="grid four">
      <label>
        Document Type
        <select id="documentType" data-preview-field="documentType">
          <option value="Quote">Quote</option>
          <option value="Estimate">Estimate</option>
        </select>
      </label>

      <label>
        Quote / Estimate No.
        <input id="documentNo" type="text" placeholder="QT-2026-001" data-preview-field="documentNo" />
      </label>

      <label>
        Issue Date
        <input id="issueDate" type="date" data-preview-field="issueDate" />
      </label>

      <label>
        Valid Until
        <input id="validUntil" type="date" data-preview-field="validUntil" />
      </label>
    </div>
  </section>

  <section class="form-section">
    <h2>Business & Client Details</h2>

    <div class="grid two">
      <div class="mini-card">
        <h3>Your Business</h3>

        <label>
          Business Name
          <input id="businessName" type="text" placeholder="Your company name" data-preview-field="businessName" />
        </label>

        <label>
          Address
          <textarea id="businessAddress" rows="4" placeholder="Business address" data-preview-field="businessAddress"></textarea>
        </label>

        <label>
          Contact
          <input id="businessContact" type="text" placeholder="Email, phone, or website" data-preview-field="businessContact" />
        </label>
      </div>

      <div class="mini-card">
        <h3>Client</h3>

        <label>
          Client Name
          <input id="clientName" type="text" placeholder="Client or company name" data-preview-field="clientName" />
        </label>

        <label>
          Address
          <textarea id="clientAddress" rows="4" placeholder="Client address" data-preview-field="clientAddress"></textarea>
        </label>

        <label>
          Contact
          <input id="clientContact" type="text" placeholder="Client email or phone" data-preview-field="clientContact" />
        </label>
      </div>
    </div>
  </section>

  <section class="items-section">
    <div class="items-header">
      <div>
        <h2>Items / Services</h2>
        <p>Add products or services. Amounts are calculated automatically.</p>
      </div>

      <button id="addQuoteItemBtn" class="add-item-btn" type="button">
        <span>+</span>
        Add Item
      </button>
    </div>

    <div class="items-table-shell">
      <table class="items-table">
        <thead>
          <tr>
            <th class="col-description">Description</th>
            <th class="col-small">Qty</th>
            <th class="col-medium">Unit Price</th>
            <th class="col-small">Discount %</th>
            <th class="col-small">Tax %</th>
            <th class="col-medium">Amount</th>
            <th class="col-action"></th>
          </tr>
        </thead>

        <tbody id="quoteItemsBody">
          <tr>
            <td>
              <input class="item-desc" type="text" placeholder="Product or service description" />
            </td>
            <td>
              <input class="item-qty calc-field" type="number" value="1" min="0" step="1" />
            </td>
            <td>
              <input class="item-price calc-field" type="number" value="0" min="0" step="0.01" />
            </td>
            <td>
              <input class="item-discount calc-field" type="number" value="0" min="0" step="0.01" />
            </td>
            <td>
              <input class="item-tax calc-field" type="number" value="0" min="0" step="0.01" />
            </td>
            <td>
              <input class="item-amount" type="text" value="0.00" readonly />
            </td>
            <td>
              <button class="remove-item-btn" type="button" aria-label="Remove item">×</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="totals-card">
      <div>
        <span>Subtotal</span>
        <strong><span id="subtotalValue">0.00</span></strong>
      </div>

      <div>
        <span>Discount</span>
        <strong><span id="discountValue">0.00</span></strong>
      </div>

      <div>
        <span>Tax</span>
        <strong><span id="taxValue">0.00</span></strong>
      </div>

      <div>
        <span>Total</span>
        <strong><span id="totalValue">0.00</span></strong>
      </div>
    </div>
  </section>

  <section class="form-section">
    <h2>Terms & Notes</h2>

    <div class="grid two">
      <label>
        Terms
        <textarea
          id="terms"
          rows="4"
          placeholder="Example: This quote is valid until the date shown above."
          data-preview-field="terms"
        ></textarea>
      </label>

      <label>
        Notes
        <textarea
          id="notes"
          rows="4"
          placeholder="Additional notes for the client"
          data-preview-field="notes"
        ></textarea>
      </label>
    </div>
  </section>

  <section class="form-section">
    <h2>Footer</h2>

    <div class="grid two">
      <label>
        Prepared By
        <input id="preparedBy" type="text" placeholder="Your name" data-preview-field="preparedBy" />
      </label>

      <label>
        Authorized Signature
        <input id="signature" type="text" placeholder="Signature name" data-preview-field="signature" />
      </label>
    </div>
  </section>

  <GeneratorActions />

  <script is:inline>
    const form = document.getElementById('quoteEstimateForm');
    const itemsBody = document.getElementById('quoteItemsBody');
    const addItemBtn = document.getElementById('addQuoteItemBtn');
    const paper = document.getElementById('quoteEstimatePaper');

    const subtotalValue = document.getElementById('subtotalValue');
    const discountValue = document.getElementById('discountValue');
    const taxValue = document.getElementById('taxValue');
    const totalValue = document.getElementById('totalValue');

    const previewItemsBody = document.getElementById('quotePreviewItemsBody');
    const previewSubtotal = document.getElementById('quotePreviewSubtotal');
    const previewDiscount = document.getElementById('quotePreviewDiscount');
    const previewTax = document.getElementById('quotePreviewTax');
    const previewTotal = document.getElementById('quotePreviewTotal');

    function numberValue(value) {
      const number = parseFloat(value);
      return Number.isFinite(number) ? number : 0;
    }

    function money(value) {
      return numberValue(value).toFixed(2);
    }

    function formatDate(value) {
      if (!value) return '—';
      const date = new Date(value + 'T00:00:00');
      if (Number.isNaN(date.getTime())) return value;

      return date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: '2-digit',
      });
    }

    function setPaperSize(size) {
      if (!paper) return;

      paper.classList.remove('document-paper-a4', 'document-paper-letter');
      document.body.classList.remove('print-a4', 'print-letter');

      if (size === 'letter') {
        paper.classList.add('document-paper-letter');
        document.body.classList.add('print-letter');
      } else {
        paper.classList.add('document-paper-a4');
        document.body.classList.add('print-a4');
      }

      document.querySelectorAll('[data-paper-size]').forEach((button) => {
        button.classList.toggle('active', button.dataset.paperSize === size);
      });
    }

    function createItemRow() {
      const row = document.createElement('tr');

      row.innerHTML = `
        <td>
          <input class="item-desc" type="text" placeholder="Product or service description" />
        </td>
        <td>
          <input class="item-qty calc-field" type="number" value="1" min="0" step="1" />
        </td>
        <td>
          <input class="item-price calc-field" type="number" value="0" min="0" step="0.01" />
        </td>
        <td>
          <input class="item-discount calc-field" type="number" value="0" min="0" step="0.01" />
        </td>
        <td>
          <input class="item-tax calc-field" type="number" value="0" min="0" step="0.01" />
        </td>
        <td>
          <input class="item-amount" type="text" value="0.00" readonly />
        </td>
        <td>
          <button class="remove-item-btn" type="button" aria-label="Remove item">×</button>
        </td>
      `;

      return row;
    }

    function getRowsData() {
      return Array.from(itemsBody.querySelectorAll('tr')).map((row) => {
        const desc = row.querySelector('.item-desc')?.value.trim() || '';
        const qty = numberValue(row.querySelector('.item-qty')?.value);
        const price = numberValue(row.querySelector('.item-price')?.value);
        const discountRate = numberValue(row.querySelector('.item-discount')?.value);
        const taxRate = numberValue(row.querySelector('.item-tax')?.value);

        const base = qty * price;
        const discount = base * discountRate / 100;
        const taxable = Math.max(base - discount, 0);
        const tax = taxable * taxRate / 100;
        const amount = taxable + tax;

        const amountInput = row.querySelector('.item-amount');
        if (amountInput) amountInput.value = money(amount);

        return {
          desc,
          qty,
          price,
          discountRate,
          taxRate,
          base,
          discount,
          tax,
          amount,
        };
      });
    }

    function updatePreviewFields() {
      document.querySelectorAll('[data-preview]').forEach((target) => {
        const fieldId = target.dataset.preview;
        const input = document.getElementById(fieldId);

        if (!input) return;

        let value = input.value;

        if (input.type === 'date') {
          value = formatDate(value);
        }

        target.textContent = value || '—';
      });

      const documentType = document.getElementById('documentType')?.value || 'Quote';
      document.querySelectorAll('[data-preview-document-title]').forEach((target) => {
        target.textContent = documentType;
      });

      document.querySelectorAll('[data-preview-document-label]').forEach((target) => {
        target.textContent = `${documentType} No.`;
      });
    }

    function updateTotalsAndItems() {
      const rows = getRowsData();

      const totals = rows.reduce(
        (acc, row) => {
          acc.subtotal += row.base;
          acc.discount += row.discount;
          acc.tax += row.tax;
          acc.total += row.amount;
          return acc;
        },
        {
          subtotal: 0,
          discount: 0,
          tax: 0,
          total: 0,
        }
      );

      subtotalValue.textContent = money(totals.subtotal);
      discountValue.textContent = money(totals.discount);
      taxValue.textContent = money(totals.tax);
      totalValue.textContent = money(totals.total);

      if (previewSubtotal) previewSubtotal.textContent = money(totals.subtotal);
      if (previewDiscount) previewDiscount.textContent = money(totals.discount);
      if (previewTax) previewTax.textContent = money(totals.tax);
      if (previewTotal) previewTotal.textContent = money(totals.total);

      if (previewItemsBody) {
        previewItemsBody.innerHTML = '';

        rows.forEach((row, index) => {
          const tr = document.createElement('tr');

          tr.innerHTML = `
            <td>${index + 1}</td>
            <td>${row.desc || '—'}</td>
            <td>${row.qty || ''}</td>
            <td>${money(row.price)}</td>
            <td>${row.discountRate ? `${money(row.discountRate)}%` : ''}</td>
            <td>${row.taxRate ? `${money(row.taxRate)}%` : ''}</td>
            <td>${money(row.amount)}</td>
          `;

          previewItemsBody.appendChild(tr);
        });
      }
    }

    function updateAll() {
      updatePreviewFields();
      updateTotalsAndItems();
    }

    addItemBtn.addEventListener('click', () => {
      itemsBody.appendChild(createItemRow());
      updateAll();
    });

    itemsBody.addEventListener('click', (event) => {
      const target = event.target;

      if (!target.classList.contains('remove-item-btn')) return;

      const rows = itemsBody.querySelectorAll('tr');

      if (rows.length <= 1) {
        rows[0].querySelectorAll('input').forEach((input) => {
          input.value = input.type === 'number' ? '0' : '';
        });

        rows[0].querySelector('.item-qty').value = '1';
        rows[0].querySelector('.item-amount').value = '0.00';
      } else {
        target.closest('tr').remove();
      }

      updateAll();
    });

    document.addEventListener('click', (event) => {
      const resetButton = event.target.closest('[data-reset-form]');
      if (resetButton) {
        form.reset();
        itemsBody.innerHTML = '';
        itemsBody.appendChild(createItemRow());
        updateAll();
        setPaperSize('a4');
        return;
      }

      const printButton = event.target.closest('[data-print-document]');
      if (printButton) {
        window.print();
        return;
      }

      const paperButton = event.target.closest('[data-paper-size]');
      if (paperButton) {
        setPaperSize(paperButton.dataset.paperSize || 'a4');
      }
    });

    form.addEventListener('input', updateAll);
    form.addEventListener('change', updateAll);

    updateAll();
    setPaperSize('a4');
  </script>
</form>

<style>
  .quote-form {
    width: 100%;
  }

  .notice {
    margin: 0 0 24px;
    padding: 14px 16px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #f8fafc;
    color: #64748b;
    font-size: 14px;
  }

  .form-section {
    padding: 22px 0;
    border-top: 1px solid #e2e8f0;
  }

  .form-section:first-of-type {
    border-top: 0;
    padding-top: 0;
  }

  .form-section h2 {
    margin: 0 0 16px;
    color: #334155;
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .grid {
    display: grid;
    gap: 16px;
  }

  .grid.two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .grid.four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .mini-card {
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 18px;
    background: #ffffff;
  }

  .mini-card h3 {
    margin: 0 0 14px;
    color: #475569;
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 7px;
    color: #334155;
    font-size: 13px;
    font-weight: 800;
  }

  label + label {
    margin-top: 14px;
  }

  input,
  textarea,
  select {
    width: 100%;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    background: #ffffff;
    color: #0f172a;
    padding: 12px 13px;
    outline: none;
    transition:
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      background 0.18s ease;
  }

  textarea {
    resize: vertical;
  }

  input::placeholder,
  textarea::placeholder {
    color: #94a3b8;
  }

  input:focus,
  textarea:focus,
  select:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
  }

  .items-section {
    margin: 26px 0;
    padding: 0;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    background: #ffffff;
    overflow: hidden;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.04);
  }

  .items-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 26px 28px 22px;
    border-bottom: 1px solid #e5e7eb;
    background: linear-gradient(180deg, #ffffff, #fbfdff);
  }

  .items-header h2 {
    margin: 0;
    color: #0f172a;
    font-size: 24px;
    font-weight: 900;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .items-header p {
    margin: 7px 0 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.5;
  }

  .add-item-btn {
    border: 0;
    border-radius: 999px;
    background: #0f172a;
    color: #ffffff;
    padding: 12px 18px;
    font-size: 14px;
    font-weight: 900;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    box-shadow: 0 10px 22px rgba(15, 23, 42, 0.16);
  }

  .add-item-btn span {
    font-size: 20px;
    line-height: 1;
    margin-top: -1px;
  }

  .items-table-shell {
    padding: 0 20px 20px;
    overflow-x: auto;
    background: #ffffff;
  }

  .items-table {
    width: 100%;
    min-width: 980px;
    border-collapse: separate;
    border-spacing: 0 10px;
    table-layout: fixed;
  }

  .items-table thead th {
    padding: 14px 10px 8px;
    color: #64748b;
    background: transparent;
    font-size: 12px;
    font-weight: 900;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
    border: 0;
  }

  .items-table tbody td {
    padding: 0 8px;
    border: 0;
    background: transparent;
    vertical-align: middle;
  }

  .items-table input {
    height: 46px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #f8fafc;
    padding: 10px 12px;
    font-size: 14px;
  }

  .items-table input:hover,
  .items-table input:focus {
    background: #ffffff;
  }

  .items-table .item-desc {
    font-weight: 600;
  }

  .items-table .item-amount {
    color: #0f172a;
    font-weight: 900;
    background: #ffffff;
  }

  .col-description {
    width: 38%;
  }

  .col-small {
    width: 10%;
  }

  .col-medium {
    width: 13%;
  }

  .col-action {
    width: 48px;
  }

  .remove-item-btn {
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 999px;
    background: #fff1f2;
    color: #e11d48;
    font-size: 22px;
    font-weight: 800;
    line-height: 1;
    cursor: pointer;
    opacity: 0.55;
  }

  .items-table tbody tr:hover .remove-item-btn {
    opacity: 1;
  }

  .totals-card {
    margin: 0 20px 24px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid #dbeafe;
    border-radius: 20px;
    background: linear-gradient(180deg, #f8fbff, #ffffff);
    overflow: hidden;
  }

  .totals-card div {
    padding: 20px 18px;
    border-right: 1px solid #dbe3ef;
  }

  .totals-card div:last-child {
    border-right: 0;
  }

  .totals-card span {
    display: block;
    margin-bottom: 8px;
    color: #64748b;
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .totals-card strong {
    display: block;
    color: #0f172a;
    font-size: 24px;
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  @media (max-width: 900px) {
    .grid.two,
    .grid.four {
      grid-template-columns: 1fr;
    }

    .items-header {
      flex-direction: column;
      padding: 22px 20px 18px;
    }

    .add-item-btn {
      width: 100%;
      justify-content: center;
    }

    .totals-card {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .totals-card div {
      border-right: 0;
      border-bottom: 1px solid #dbe3ef;
    }
  }

  @media (max-width: 640px) {
    .totals-card {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    @page {
      margin: 0;
    }

    html,
    body {
      margin: 0 !important;
      padding: 0 !important;
      background: #ffffff !important;
    }

    body * {
      visibility: hidden !important;
    }

    #quoteEstimatePaper,
    #quoteEstimatePaper * {
      visibility: visible !important;
    }

    #quoteEstimatePaper {
      position: absolute;
      left: 0;
      top: 0;
      margin: 0 !important;
      box-shadow: none !important;
      background: #ffffff !important;
      overflow: hidden !important;
    }

    body.print-a4 #quoteEstimatePaper {
      width: 210mm !important;
      min-height: 297mm !important;
      padding: 12mm !important;
    }

    body.print-letter #quoteEstimatePaper {
      width: 8.5in !important;
      min-height: 11in !important;
      padding: 0.45in !important;
    }
  }
</style>
