---
import DocumentPaper from "../shared/DocumentPaper.astro";
---

<DocumentPaper paperId="quoteEstimatePaper" defaultSize="a4" className="quote-paper">
  <div class="paper-head">
    <div>
      <h3 data-preview-document-title>Quote</h3>
      <p class="paper-subtitle">Prepared for your review and approval</p>
    </div>

    <div class="paper-meta">
      <p><strong data-preview-document-label>Quote No.</strong> <span data-preview="documentNo">—</span></p>
      <p><strong>Issue Date</strong> <span data-preview="issueDate">—</span></p>
      <p><strong>Valid Until</strong> <span data-preview="validUntil">—</span></p>
    </div>
  </div>

  <div class="paper-grid two">
    <div class="paper-box">
      <h4>From</h4>
      <p data-preview="businessName">Your business name</p>
      <p data-preview="businessAddress">Business address</p>
      <p data-preview="businessContact">Business contact</p>
    </div>

    <div class="paper-box">
      <h4>To</h4>
      <p data-preview="clientName">Client name</p>
      <p data-preview="clientAddress">Client address</p>
      <p data-preview="clientContact">Client contact</p>
    </div>
  </div>

  <table class="paper-table">
    <thead>
      <tr>
        <th>No.</th>
        <th>Description</th>
        <th>Qty</th>
        <th>Unit Price</th>
        <th>Discount</th>
        <th>Tax</th>
        <th>Amount</th>
      </tr>
    </thead>

    <tbody id="quotePreviewItemsBody"></tbody>
  </table>

  <div class="paper-total-box">
    <p>
      <span>Subtotal</span>
      <strong id="quotePreviewSubtotal">0.00</strong>
    </p>

    <p>
      <span>Discount</span>
      <strong id="quotePreviewDiscount">0.00</strong>
    </p>

    <p>
      <span>Tax</span>
      <strong id="quotePreviewTax">0.00</strong>
    </p>

    <p class="grand-total">
      <span>Total</span>
      <strong id="quotePreviewTotal">0.00</strong>
    </p>
  </div>

  <div class="paper-grid two">
    <div class="paper-box">
      <h4>Terms</h4>
      <p data-preview="terms">—</p>
    </div>

    <div class="paper-box">
      <h4>Notes</h4>
      <p data-preview="notes">—</p>
    </div>
  </div>

  <div class="paper-signatures">
    <div>
      <span>Prepared By</span>
      <strong data-preview="preparedBy">—</strong>
    </div>

    <div>
      <span>Authorized Signature</span>
      <strong data-preview="signature">—</strong>
    </div>
  </div>
</DocumentPaper>

<style>
  .quote-paper {
    font-size: 12px;
  }

  .paper-head {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    border-bottom: 2px solid #0f172a;
    padding-bottom: 22px;
    margin-bottom: 24px;
  }

  .paper-head h3 {
    margin: 0;
    color: #0f172a;
    font-size: 30px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .paper-subtitle {
    margin: 8px 0 0;
    color: #64748b;
  }

  .paper-meta {
    min-width: 240px;
  }

  .paper-meta p {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin: 0 0 7px;
  }

  .paper-grid {
    display: grid;
    gap: 14px;
    margin-bottom: 14px;
  }

  .paper-grid.two {
    grid-template-columns: 1fr 1fr;
  }

  .paper-box {
    min-height: 112px;
    border: 1px solid #dbe3ef;
    padding: 14px;
    color: #334155;
  }

  .paper-box h4 {
    margin: 0 0 10px;
    color: #0f172a;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .paper-box p {
    margin: 0 0 7px;
    white-space: pre-line;
  }

  .paper-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 18px;
    font-size: 11px;
  }

  .paper-table th,
  .paper-table td {
    border: 1px solid #dbe3ef;
    padding: 8px;
    text-align: left;
    vertical-align: top;
  }

  .paper-table th {
    background: #f1f5f9;
    color: #0f172a;
    font-weight: 900;
  }

  .paper-total-box {
    width: 300px;
    margin: 26px 0 28px auto;
    border: 1px solid #dbe3ef;
    padding: 14px;
    font-size: 12px;
  }

  .paper-total-box p {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: 0 0 8px;
  }

  .paper-total-box p:last-child {
    margin-bottom: 0;
  }

  .paper-total-box .grand-total {
    border-top: 1px solid #dbe3ef;
    padding-top: 10px;
    margin-top: 10px;
    color: #0f172a;
    font-size: 14px;
  }

  .paper-signatures {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-top: 58px;
  }

  .paper-signatures div {
    border-top: 1px solid #94a3b8;
    padding-top: 10px;
  }

  .paper-signatures span {
    display: block;
    color: #64748b;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .paper-signatures strong {
    display: block;
    margin-top: 8px;
    color: #0f172a;
    font-size: 12px;
  }

  @media print {
    .paper-head {
      margin-bottom: 14px !important;
      padding-bottom: 14px !important;
    }

    .paper-head h3 {
      font-size: 22px !important;
    }

    .paper-box {
      min-height: auto !important;
      padding: 10px !important;
    }

    .paper-table {
      margin-top: 12px !important;
      font-size: 9.5px !important;
    }

    .paper-table th,
    .paper-table td {
      padding: 5px !important;
    }

    .paper-total-box {
      margin-top: 18px !important;
      margin-bottom: 20px !important;
      padding: 10px !important;
      font-size: 10px !important;
    }

    .paper-signatures {
      margin-top: 34px !important;
    }
  }
</style>
