---
import PaperSizeToggle from "./PaperSizeToggle.astro";

interface Props {
  backHref?: string;
  backLabel?: string;
  showBackButton?: boolean;
  showPaperToggle?: boolean;
  showResetButton?: boolean;
  resetButtonId?: string;
  activePaper?: "a4" | "letter";
  supportedPapers?: Array<"a4" | "letter">;
  paperDataAttributeName?: string;
  resetLabel?: string;
  printLabel?: string;
  printHref?: string;
  className?: string;
}

const {
  backHref = "#",
  backLabel = "Back",
  showBackButton = true,
  showPaperToggle = true,
  showResetButton = true,
  resetButtonId,
  activePaper = "a4",
  supportedPapers = ["letter", "a4"],
  paperDataAttributeName = "data-paper-size",
  resetLabel = "Reset Form",
  printLabel = "Print / Save as PDF",
  printHref,
  className = "",
} = Astro.props as Props;
---

<div class={`tool-action-bar no-print ${className}`.trim()}>
  <div class="tool-action-bar__left">
    {showBackButton && <a href={backHref} class="tool-btn tool-btn-secondary">{backLabel}</a>}
  </div>

  <div class="tool-action-bar__center">
    <slot name="center" />
  </div>

  <div class="tool-action-bar__right">
    {showPaperToggle && (
      <PaperSizeToggle
        activePaper={activePaper}
        papers={supportedPapers}
        dataAttributeName={paperDataAttributeName}
      />
    )}

    {showResetButton && (
      <button
        type="button"
        id={resetButtonId}
        class="tool-btn tool-btn-reset"
        data-reset-form-trigger={resetButtonId ? undefined : true}
        data-reset-form={resetButtonId ? undefined : true}
      >
        <span class="tool-btn__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path d="M12 5a7 7 0 1 1-6.67 9.12 1 1 0 1 1 1.91-.59A5 5 0 1 0 8.1 8.3H11a1 1 0 1 1 0 2H5a1 1 0 0 1-1-1V3a1 1 0 1 1 2 0v3.32A8.97 8.97 0 0 1 12 5z" fill="currentColor"></path>
          </svg>
        </span>
        <span>{resetLabel}</span>
      </button>
    )}

    {
      printHref ? (
        <a href={printHref} class="tool-btn tool-btn-primary" data-print-document>
          <span class="tool-btn__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
              <path d="M7 2h8l5 5v3h-2V8h-4V4H7v6H5V4a2 2 0 0 1 2-2z" fill="currentColor"></path>
              <path d="M6 12h12a3 3 0 0 1 3 3v4h-4v3H7v-3H3v-4a3 3 0 0 1 3-3zm3 8h6v-4H9v4z" fill="currentColor"></path>
              <path d="M16 9h3v3h-3z" fill="currentColor"></path>
            </svg>
          </span>
          <span>{printLabel}</span>
        </a>
      ) : (
        <button type="button" class="tool-btn tool-btn-primary" data-print-document>
          <span class="tool-btn__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
              <path d="M7 2h8l5 5v3h-2V8h-4V4H7v6H5V4a2 2 0 0 1 2-2z" fill="currentColor"></path>
              <path d="M6 12h12a3 3 0 0 1 3 3v4h-4v3H7v-3H3v-4a3 3 0 0 1 3-3zm3 8h6v-4H9v4z" fill="currentColor"></path>
              <path d="M16 9h3v3h-3z" fill="currentColor"></path>
            </svg>
          </span>
          <span>{printLabel}</span>
        </button>
      )
    }
  </div>
</div>

<style>
  .tool-action-bar {
    position: static;
    margin: 18px 0 20px;
    padding: 14px 16px;
    border: 1px solid #dbe4ef;
    border-radius: 16px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.06);
  }

  .tool-action-bar__left {
    flex: 0 0 auto;
  }

  .tool-action-bar__center {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    min-width: 0;
  }

  .tool-action-bar__right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    flex-wrap: wrap;
  }

  .tool-btn {
    min-height: 38px;
    padding: 0 14px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .tool-btn__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    flex: 0 0 auto;
  }

  .tool-btn__icon svg {
    width: 14px;
    height: 14px;
    display: block;
  }

  .tool-btn-secondary {
    border: 1px solid #dbe3ef;
    background: #ffffff;
    color: #374151;
  }

  .tool-btn-secondary:hover {
    border-color: #93c5fd;
    background: #eff6ff;
    color: #2563eb;
  }

  .tool-btn-reset {
    border: 1px dashed #d7dce5;
    background: #ffffff;
    color: #6b7280;
  }

  .tool-btn-reset:hover {
    border-color: #f59bb7;
    background: #fff8fb;
    color: #be185d;
  }

  .tool-btn-primary {
    border: 1px solid #2563eb;
    background: #2563eb;
    color: #ffffff;
    box-shadow: 0 8px 18px rgba(37, 99, 235, 0.16);
  }

  .tool-btn-primary:hover {
    background: #1d4ed8;
    border-color: #1d4ed8;
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(37, 99, 235, 0.18);
  }

  @media (max-width: 900px) {
    .tool-action-bar {
      flex-direction: column;
      align-items: stretch;
    }

    .tool-action-bar__left,
    .tool-action-bar__center,
    .tool-action-bar__right {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .tool-action-bar__right {
      flex-direction: column;
      align-items: stretch;
    }

    .tool-btn {
      width: 100%;
    }
  }
</style>
