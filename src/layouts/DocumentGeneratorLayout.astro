---
import ToolLayout from "./ToolLayout.astro";

interface FaqItem {
  question: string;
  answer: string;
}

interface RelatedTool {
  name: string;
  href: string;
  desc: string;
  title?: string;
  description?: string;
}

interface Props {
  title: string;
  description: string;
  pageTitle?: string;
  canonical?: string;
  eyebrow?: string;
  categoryLabel?: string;
  categoryHref?: string;
  intro: string;
  faqItems?: FaqItem[];
  faq?: FaqItem[];
  relatedTools?: RelatedTool[];
}

const {
  title,
  description,
  pageTitle,
  canonical,
  eyebrow,
  categoryLabel,
  categoryHref,
  intro,
  faqItems = [],
  faq = [],
  relatedTools = [],
} = Astro.props;

const normalizedFaqItems = faqItems.length > 0 ? faqItems : faq;
const normalizedRelatedTools = relatedTools.map((tool) => ({
  name: tool.name || tool.title || "",
  href: tool.href,
  desc: tool.desc || tool.description || "",
}));
---

<ToolLayout
  title={title}
  pageTitle={pageTitle}
  description={description}
  canonical={canonical}
  eyebrow={eyebrow}
  categoryLabel={categoryLabel}
  categoryHref={categoryHref}
  intro={intro}
  faqItems={normalizedFaqItems}
  relatedTools={normalizedRelatedTools}
>
  <section slot="form" class="document-generator-layout-shell">
    <div class="document-generator-layout-page">
      {Astro.slots.has("editor") ? <slot name="editor" /> : <slot name="form" />}
      <slot name="preview" />
    </div>
  </section>

  <slot name="content" slot="content" />
  <slot name="faq" slot="faq" />
  <slot />
</ToolLayout>

<style>
  .document-generator-layout-shell {
    grid-column: 1 / -1;
    min-width: 0;
  }

  .document-generator-layout-page {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: min(1180px, 100%);
    margin: 0 auto;
  }
</style>
