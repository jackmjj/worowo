---
import BaseLayout from "./BaseLayout.astro";
import RelatedTools from "../components/tools/RelatedTools.astro";
import ToolGuide from "../components/tools/ToolGuide.astro";
import Faq from "../components/tools/Faq.astro";
import { getRelatedTools } from "../lib/getRelatedTools";
import type { ToolKey } from "../data/toolDictionary";

interface FaqItem {
  question: string;
  answer: string;
}

interface RelatedTool {
  name: string;
  href: string;
  desc?: string;
}

interface Props {
  title: string;
  description: string;
  pageTitle?: string;
  canonical?: string;
  eyebrow?: string;
  categoryLabel?: string;
  categoryHref?: string;
  intro: string;
  faqItems?: FaqItem[];
  relatedTools?: RelatedTool[];
  currentToolKey?: ToolKey;
}

const {
  title,
  description,
  pageTitle = title,
  canonical,
  eyebrow = "Tool",
  categoryLabel = "Tools",
  categoryHref = "/",
  intro,
  faqItems = [],
  relatedTools = [],
  currentToolKey,
} = Astro.props;

const resolvedRelatedTools =
  currentToolKey
    ? getRelatedTools(currentToolKey).map((tool) => ({
        name: tool.shortTitle || tool.title,
        href: tool.href,
        desc: tool.description,
      }))
    : relatedTools;
---

<BaseLayout title={pageTitle} description={description} canonical={canonical}>
  <main class="tool-page">
    <section class="tool-hero">
      <div class="container">
        <nav class="tool-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>&gt;</span>
          <a href={categoryHref}>{categoryLabel}</a>
          <span>&gt;</span>
          <span>{title}</span>
        </nav>

        <div class="tool-hero-copy">
          <p class="eyebrow">{eyebrow}</p>
          <h1 class="tool-page-title">{title}</h1>
          <p class="tool-page-summary tool-intro">{intro}</p>
        </div>
      </div>
    </section>

    <section class="tool-main">
      <div class="container">
        <div class="tool-grid">
          <slot name="form" />
          <slot name="results" />
        </div>
      </div>
    </section>

    {resolvedRelatedTools.length > 0 && (
      <section class="tool-related">
        <div class="container">
          <RelatedTools tools={resolvedRelatedTools} />
        </div>
      </section>
    )}

    {Astro.slots.has("content") && (
      <section class="tool-content">
        <div class="container">
          <ToolGuide title="How It Works & Use Cases">
            <slot name="content" />
          </ToolGuide>
        </div>
      </section>
    )}

    {(faqItems.length > 0 || Astro.slots.has("faq")) && (
      <section class="tool-faq">
        <div class="container">
          <Faq items={faqItems}>
            <slot name="faq" />
          </Faq>
        </div>
      </section>
    )}

    <slot />
  </main>
</BaseLayout>

<style>
  .tool-page {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  }

  .tool-hero {
    padding: 22px 0 24px;
  }

  .tool-breadcrumb {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 0 0 16px;
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  .tool-breadcrumb a:hover {
    color: var(--primary);
  }

  .tool-hero-copy {
    max-width: 780px;
  }

  .tool-intro {
    max-width: 760px;
  }

  .tool-page-title {
    margin: 0 0 10px;
    font-size: clamp(2.15rem, 3vw, 2.9rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
  }

  .tool-page-summary {
    margin: 0;
    font-size: 1.12rem;
    color: var(--text-soft);
    max-width: 760px;
  }

  .tool-main {
    padding: 8px 0 34px;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: minmax(360px, 0.618fr) minmax(520px, 1fr);
    gap: 28px;
    align-items: stretch;
  }

  .tool-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 16px 40px -28px rgba(15, 23, 42, 0.25);
  }

  .tool-content,
  .tool-faq,
  .tool-related {
    padding: 0 0 28px;
  }

  @media (max-width: 980px) {
    .tool-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .tool-page-title {
      font-size: clamp(1.9rem, 8vw, 2.35rem);
    }

    .tool-page-summary {
      font-size: 1rem;
    }
  }
</style>
